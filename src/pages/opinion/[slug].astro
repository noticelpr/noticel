---
// Columnist profile: /opinion/<name>/ — picture, topic, bio, every column they wrote (newest first) and the other columnists.
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getStories, url , sectionUrl } from '../../lib/site';
import { COLUMNISTS, columnsBy, initials, photoSrc, type Columnist } from '../../lib/columnists';

export function getStaticPaths() {
  return COLUMNISTS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Columnist };
const cols = columnsBy(await getStories(), c);
// The names this columnist has signed with (with and without a title), to find their older columns in the archive
const names = [...new Set([c.name, c.name.replace(/^(Lcdo|Lcda|Lic|Dr|Dra)\.?\s+/i, '')])];
const others = COLUMNISTS.filter((o) => o.slug !== c.slug);
// Contact and social links from the profile (panel → Columnistas); only the ones filled in show
const handle = (v: string, site: string) => (/^https?:\/\//.test(v) ? v : `https://${site}/${v.replace(/^@/, '')}`);
const links = [
  c.email && { label: 'Correo', href: `mailto:${c.email}` },
  c.x && { label: 'X', href: handle(c.x, 'x.com') },
  c.instagram && { label: 'Instagram', href: handle(c.instagram, 'instagram.com') },
  c.facebook && { label: 'Facebook', href: handle(c.facebook, 'facebook.com') },
  c.website && { label: 'Sitio web', href: /^https?:\/\//.test(c.website) ? c.website : `https://${c.website}` },
].filter(Boolean) as Array<{ label: string; href: string }>;
// Videos on the profile (panel → Columnistas → Videos): YouTube and Vimeo play here; Facebook opens in a new tab
const videos = (c.videos ?? []).map((v) => {
  const yt = v.match(/(?:youtube(?:-nocookie)?\.com\/(?:embed\/|watch\?v=|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/)?.[1];
  const vm = v.match(/vimeo\.com\/(?:video\/)?(\d+)/)?.[1];
  return yt ? { kind: 'yt', src: `https://www.youtube-nocookie.com/embed/${yt}`, thumb: `https://i.ytimg.com/vi/${yt}/hqdefault.jpg`, href: `https://www.youtube.com/watch?v=${yt}` }
    : vm ? { kind: 'vimeo', src: `https://player.vimeo.com/video/${vm}`, thumb: '', href: `https://vimeo.com/${vm}` }
    : { kind: 'link', src: '', thumb: '', href: v };
});
const last = cols[0]?.data.date.toLocaleDateString('es-PR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Puerto_Rico' });
---
<Base title={`${c.name} · Opinión`} active="opinion" description={c.bio ?? `Columnas de ${c.name} en NotiCel.`}>
  <main class="wrap" id="main">
    <div class="crumbs"><a href={sectionUrl('opiniones')}>Opinión</a> / <span>Columnistas</span></div>
    <div class="art-grid">
      <div>
        <section class="cp-head">
          {c.photo ? <img class="cp-pic" src={photoSrc(c.photo)} alt={`Retrato de ${c.name}`} /> : <span class="cp-pic col-ini" aria-hidden="true">{initials(c.name)}</span>}
          <div class="cp-info">
            {c.role && <span class="col-role">{c.role}</span>}
            <h1>{c.name}{c.demo && <span class="sp-demo">EJEMPLO</span>}</h1>
            {c.bio && <p class="cp-bio">{c.bio}</p>}
            <ul class="cp-stats">
              <li><b data-cp-count>{cols.length}</b> <span data-cp-word>{cols.length === 1 ? 'columna' : 'columnas'}</span></li>
              {last && <li>Última: <b>{last}</b></li>}
            </ul>
            {links.length > 0 && <ul class="cp-links">{links.map((l) => <li><a href={l.href} rel="noopener me" target={l.href.startsWith('mailto:') ? undefined : '_blank'}>{l.label}</a></li>)}</ul>}
            {c.demo && <p class="cp-note">Perfil de ejemplo: este espacio será para un columnista real.</p>}
          </div>
        </section>

        <section data-cp-cols data-names={JSON.stringify(names)} data-built={cols.length}>
          <div class="sec-h"><h2>Columnas de {c.name}</h2></div>
          {cols.length > 0 ? (
            <div class="cp-list">{cols.map((s) => <StoryCard story={s} variant="item" />)}</div>
          ) : (
            <div class="empty"><p>{c.demo ? 'Este perfil es un ejemplo. Aquí aparecerán sus columnas.' : 'Su primera columna llega muy pronto.'}</p><a class="btn" href={sectionUrl('opiniones')}>Ver todas las columnas</a></div>
          )}
        </section>

        {videos.length > 0 && (
          <section class="cp-videos" aria-labelledby="cp-videos-h">
            <div class="sec-h"><h2 id="cp-videos-h">Videos de {c.name}</h2></div>
            <div class="cp-vgrid">{videos.map((v) => v.kind === 'link'
              ? <a class="cp-vlink" href={v.href} target="_blank" rel="noopener">Ver video ↗</a>
              : <div class="cp-vid"><iframe src={v.src} title={`Video de ${c.name}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>)}</div>
          </section>
        )}

        <AdSlot size="infeed" />

        <section>
          <div class="sec-h"><h2>Otros columnistas</h2></div>
          <div class="cp-others">
            {others.map((o) => (
              <a class="cp-other" href={url(`opinion/${o.slug}`)}>
                {o.photo ? <img src={photoSrc(o.photo)} alt="" loading="lazy" /> : <span class="col-ini" aria-hidden="true">{initials(o.name)}</span>}
                <b>{o.name}</b>
                {o.role && <small>{o.role}</small>}
              </a>
            ))}
          </div>
        </section>
      </div>
      <Sidebar />
    </div>
  </main>
  <script>
    // Older columns live only in the archive (not built pages): when the archive search finds more than the page
    // shows, the list and the count come from it (functions/api/buscar.js), newest first, 30 at a time.
    const box = document.querySelector<HTMLElement>('[data-cp-cols]');
    if (box) {
      const names: string[] = JSON.parse(box.dataset.names || '[]'), built = Number(box.dataset.built) || 0;
      const esc = (t = '') => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
      const day = (d: string) => new Date(d).toLocaleDateString('es-PR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Puerto_Rico' });
      const item = (r: any) => `<article class="item"><a href="${esc(r.path)}" tabindex="-1" aria-hidden="true"><div class="ph" style="--c:#1F1F1F" aria-hidden="true">${r.img ? `<img src="${esc(r.img)}" alt loading="lazy" decoding="async">` : ''}</div></a><div><span class="badge">Opiniones</span><a href="${esc(r.path)}"><h3 class="hl">${esc(r.title)}</h3></a><time class="time" datetime="${esc(r.date)}">${day(r.date)}</time></div></article>`;
      let page = 0, list: HTMLElement | null = null, more: HTMLButtonElement | null = null;
      const load = async () => {
        const q = new URLSearchParams([...names.map((n) => ['autor', n]), ['seccion', 'opiniones'], ['por', '30'], ['pagina', String(page + 1)]]);
        const d = await fetch(`/api/buscar?${q}`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
        if (!d?.results || (page === 0 && d.total <= built)) return; // the built list is already complete
        page++;
        if (!list) {
          box.querySelector('.empty')?.remove(); box.querySelector('.cp-list')?.remove();
          list = Object.assign(document.createElement('div'), { className: 'cp-list' }); box.append(list);
          const n = document.querySelector('[data-cp-count]'), w = document.querySelector('[data-cp-word]');
          if (n) n.textContent = d.total.toLocaleString('es-PR'); if (w) w.textContent = d.total === 1 ? 'columna' : 'columnas';
        }
        list.insertAdjacentHTML('beforeend', d.results.map(item).join(''));
        if (page * 30 < d.total) {
          if (!more) { more = Object.assign(document.createElement('button'), { type: 'button', className: 'btn', textContent: 'Ver más columnas' }); more.addEventListener('click', load); box.append(more); }
        } else more?.remove();
      };
      void load();
    }
  </script>
</Base>
