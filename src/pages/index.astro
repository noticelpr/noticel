---
// Home page, Noticias Xtra's layout in NotiCel's colors (the owner's request, 2026-10-28): main column on the left,
// right column (Sidebar) for the whole height of the page, so there are no empty gaps. On top, the edition line
// ("Portada · Lo principal de hoy · date"). How the top stories are picked: docs/como-funciona-la-portada.md.
import MarketsBar from '../components/MarketsBar.astro';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import VideoCard from '../components/VideoCard.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Sidebar from '../components/Sidebar.astro';
import Ph from '../components/Ph.astro';
import Label from '../components/Label.astro';
import HomeStrip from '../components/HomeStrip.astro';
import AdSlot from '../components/AdSlot.astro';
import LocalScores from '../components/deportes/LocalScores.astro';
import GamesTeaser from '../components/GamesTeaser.astro';
import { getStories, topOrder, pinTop, longDate, url, SITE, SECTIONS, VIDEOS, VIDEO_SOURCES, storyUrl, sectionUrl, type SectionId } from '../lib/site';

const stories = await getStories();
const F = SITE.features;
// Top spots: a pinned story (📌) keeps the main spot; the editor's "Principal de la Portada" pick comes next; then,
// among the last 36 hours, trending stories first, Puerto Rico next, the rest after (src/lib/site.ts). Columns
// (Opiniones) never take the top spots; they have their own box further down.
const ordered = pinTop(topOrder(stories)).filter((s) => s.data.section !== 'opiniones');
const lead = ordered[0];
// Each story appears once in the top area. Spots are filled in order of importance: the headlines under the main
// story (the editor's related stories, or else the next stories in line), the column beside it, the row of cards,
// the "Más noticias" block, then two more under the main story.
const related = (lead?.data.related ?? []).map((id) => stories.find((s) => s.id === id)).filter((s) => s !== undefined && s.id !== lead?.id);
const inLine = ordered.filter((s) => s.id !== lead?.id && !related.includes(s));
const take = (n: number) => inLine.splice(0, n);
const leadRelated = related.length ? related.slice(0, 3) : take(3);
const left = take(3);
const row = take(3);
const more = take(5);
const extra = take(2);
// Section boxes further down skip what's already in the top area
const topIds = new Set([lead, ...leadRelated, ...left, ...row, ...more, ...extra].filter(Boolean).map((s) => s!.id));
const restStories = stories.filter((s) => !topIds.has(s.id));
// Section boxes: NotiCel's most-read sections first (total views of their stories), Opiniones last.
// Noticias is already up top. Only sections with stories appear.
const viewsOf = (id: string) => stories.filter((s) => s.data.section === id).reduce((n, s) => n + s.data.views, 0);
const sectionIds = SECTIONS.map((s) => s.id)
  .filter((id) => id !== 'noticias' && restStories.some((s) => s.data.section === id))
  .sort((a, b) => Number(a === 'opiniones') - Number(b === 'opiniones') || viewsOf(b) - viewsOf(a)) as SectionId[];
// Section boxes sit side by side in pairs. To avoid blank space under a shorter box, each section is paired with the
// next one (in order) that shows the same number of stories (a box shows up to 4). No match: a full-width row.
const shown = (id: string) => Math.min(4, restStories.filter((s) => s.data.section === id).length);
const rows: SectionId[][] = [];
const queue = [...sectionIds];
while (queue.length) {
  const a = queue.shift()!;
  const j = queue.findIndex((b) => shown(b) === shown(a));
  rows.push(j >= 0 ? [a, queue.splice(j, 1)[0]] : [a]);
}
const today = longDate(new Date());
---
<Base active="home" topAd={false}>
  <HomeStrip />
  <div class="wrap home-grid nx-home" id="main">
    <main class="home-main">
      <header class="pt-ed">
        <h1 class="pt-name">Portada</h1>
        <p class="pt-day"><span>Lo principal de hoy</span><i class="pt-dot" aria-hidden="true"> · </i><time data-pt-today>{today}</time></p>
      </header>
      {!lead && <div class="empty"><p>Muy pronto publicaremos las primeras noticias.</p></div>}
      {lead && (
        <div class="home-hero">
          <article class="lead">
            {/* Headline sits on the photo so it is visible without scrolling */}
            <a class="lead-media" href={storyUrl(lead)}>
              <Ph sectionId={lead.data.section} image={lead.data.image} place={lead.data.place} league={lead.data.league} sizes="(max-width:760px) 100vw, 640px" priority />
              <div class="lead-over"><Label story={lead} /><h2>{lead.data.title}</h2></div>
            </a>
            {lead.data.description && <p class="dek">{lead.data.description}</p>}
            <ul class="related">{leadRelated.map((s) => <li><a href={storyUrl(s)} class="hl">{s.data.title}</a></li>)}</ul>
            {/* Fills the space under the main story (the column beside it is taller): two more headlines and an ad */}
            {extra.length > 0 && (
              <div class="lead-extra">
                <h2 class="lead-extra-h">Más titulares</h2>
                <div class="lead-extra-grid">{extra.map((s) => <StoryCard story={s} variant="item" />)}</div>
              </div>
            )}
            <AdSlot size="infeed" class="lead-ad" />
          </article>
          <div class="stack left">{left.map((s) => <StoryCard story={s} variant="mini" />)}</div>
        </div>
      )}

      {row.length > 0 && <div class="home-row">{row.map((s) => <StoryCard story={s} />)}</div>}

      {more.length > 0 && (
        <section>
          <div class="sec-h"><h2>Más noticias</h2><a href={sectionUrl('noticias')}>Ver todas</a></div>
          <div class="block">
            <StoryCard story={more[0]} variant="big" />
            <div class="list">{more.slice(1).map((s) => <StoryCard story={s} variant="item" />)}</div>
          </div>
        </section>
      )}

      <AdSlot size="infeed" />

      {/* BSN, Doble A and La Pro scores (DEMO until real scores are connected) */}
      <LocalScores />

      {F.videos && (
        <section>
          <div class="sec-h"><h2>Videos</h2><a href={url('videos')}>Ver todos</a></div>
          <div class="vx-home">
            <div class="vx-player">
              <div class="lg-video-frame">
                <iframe data-src={`https://www.youtube-nocookie.com/embed/videoseries?list=UU${VIDEO_SOURCES.noticel.channel.slice(2)}&autoplay=1&mute=1&rel=0&playsinline=1`} title="Lo más reciente de NotiCel en YouTube" loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              </div>
              <p class="vsrc">Lo más reciente de <a href={VIDEO_SOURCES.noticel.url} rel="noopener" target="_blank">NotiCel en YouTube</a></p>
            </div>
            <div class="vx-list">{VIDEOS.filter((v) => v.src === 'noticel').slice(0, 4).map((v) => <VideoCard video={v} />)}</div>
          </div>
        </section>
      )}

      <MarketsBar />

      <div class="home-sections">
        {rows.map((row, i) => (
          <>
            {row.map((id) => <div class:list={{ 'sec-wide': row.length === 1 }}><SectionBlock sectionId={id} stories={restStories} /></div>)}
            {i === 1 && i < rows.length - 1 && <AdSlot size="infeed" class="ad-span" />}
            {i === 3 && i < rows.length - 1 && <div class="ad-span"><GamesTeaser /></div>}
          </>
        ))}
      </div>

      {F.app && <section class="promo">
        <img src={url('icon-192.png')} alt="" />
        <div><h2>Descarga la app de NotiCel</h2><p>Recibe alertas de última hora y mira la transmisión en vivo desde tu celular.</p></div>
        <div class="stores">
          <button class="store" type="button" data-app><small>Descárgala en</small>App Store</button>
          <button class="store" type="button" data-app><small>Disponible en</small>Google Play</button>
        </div>
      </section>}
    </main>
    <Sidebar foro extras />
  </div>
  <script>
    // The page is built ahead of time: show the reader's real date (Puerto Rico time) in the edition line
    const el = document.querySelector<HTMLElement>('[data-pt-today]');
    if (el) el.textContent = new Date().toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Puerto_Rico' });
    // Old WordPress searches (noticel.com/?s=palabra) open the new search page
    const s = new URLSearchParams(location.search).get('s');
    if (s) location.replace(`${document.body.dataset.base}buscar/?q=${encodeURIComponent(s)}`);
  </script>
</Base>
