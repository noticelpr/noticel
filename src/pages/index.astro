---
// Home page, option 4 (chosen 2026-10-08, inspired by BBC News' front page): the main headline on the left in large
// type, its photo in the middle, two more stories with photos on the right; a row of four; Lo más leído in two
// columns; then Última hora, Destacadas, videos and each section as a row of four (most-read sections first).
// Right column below the top: Noticias Xtra's sidebar (Tendencias, lottery, Foro…). Each story appears once at the top.
import Markets from '../components/economia/Markets.astro';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import VideoCard from '../components/VideoCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Ph from '../components/Ph.astro';
import Label from '../components/Label.astro';
import Time from '../components/Time.astro';
import HomeStrip from '../components/HomeStrip.astro';
import AdSlot from '../components/AdSlot.astro';
import GamesTeaser from '../components/GamesTeaser.astro';
import { getStories, topOrder, pinTop, mostRead, inCategory, url, SITE, SECTIONS, VIDEOS, VIDEO_SOURCES, storyUrl, sectionUrl } from '../lib/site';

const stories = await getStories();
const F = SITE.features;
// Top spots: an editor's pin, then Puerto Rico first unless a U.S. or world story is trending (src/lib/site.ts)
const ordered = pinTop(topOrder(stories)).filter((s) => s.data.section !== 'opiniones');
const lead = ordered[0];
const used = new Set(lead ? [lead.id] : []);
const take = (list: typeof stories, n: number) => {
  const out = list.filter((s) => !used.has(s.id)).slice(0, n);
  out.forEach((s) => used.add(s.id));
  return out;
};
const related = (lead?.data.related ?? []).map((id) => stories.find((s) => s.id === id)).filter((s): s is (typeof stories)[number] => !!s);
const leadMore = take(related.length ? related : ordered, 2); // two short headlines under the main one
const right = take(ordered, 2);
const row4 = take(ordered, 4);
const breaking = take(stories.filter((s) => inCategory(s, 'ultima-hora')), 4);
const top10 = mostRead(stories, 10);
const featured = take(ordered.filter((s) => s.data.featured), 6);
const restStories = stories.filter((s) => !used.has(s.id));
// Section blocks, most-read sections first (total views of their stories), Opiniones last. Noticias is already up top.
const viewsOf = (id: string) => stories.filter((s) => s.data.section === id).reduce((n, s) => n + s.data.views, 0);
const sectionIds = SECTIONS.map((s) => s.id)
  .filter((id) => id !== 'noticias' && restStories.some((s) => s.data.section === id))
  .sort((a, b) => Number(a === 'opiniones') - Number(b === 'opiniones') || viewsOf(b) - viewsOf(a));
const sectionRows = sectionIds.map((id) => ({ id, list: restStories.filter((s) => s.data.section === id).slice(0, 4) }));
---
<Base active="home">
  <HomeStrip />
  {!lead && <div class="wrap"><div class="empty"><p>Muy pronto publicaremos las primeras noticias.</p></div></div>}
  {lead && (
    <section class="wrap bb-top" id="main">
      <div class="bb-hero">
        <div class="bb-lead">
          <Label story={lead} />
          <a href={storyUrl(lead)}><h1 class="hl">{lead.data.title}</h1></a>
          {lead.data.description && <p class="bb-dek">{lead.data.description}</p>}
          <Time date={lead.data.date} />
          {leadMore.length > 0 && <ul class="bb-more">{leadMore.map((s) => <li><a href={storyUrl(s)} class="hl">{s.data.title}</a></li>)}</ul>}
        </div>
        <a class="bb-photo" href={storyUrl(lead)} tabindex="-1" aria-hidden="true">
          <Ph sectionId={lead.data.section} image={lead.data.image} league={lead.data.league} sizes="(max-width:760px) 100vw, 620px" priority />
        </a>
        <div class="bb-side">
          {right.map((s) => (
            <article class="bb-side-item">
              <a href={storyUrl(s)} tabindex="-1" aria-hidden="true"><Ph sectionId={s.data.section} image={s.data.image} league={s.data.league} sizes="320px" /></a>
              <Label story={s} />
              <a href={storyUrl(s)}><h3 class="hl">{s.data.title}</h3></a>
              <Time date={s.data.date} />
            </article>
          ))}
        </div>
      </div>
      {row4.length > 0 && <div class="bb-row4">{row4.map((s) => <StoryCard story={s} />)}</div>}
      {top10.length > 0 && (
        <section class="bb-most" aria-labelledby="bb-most-h">
          <h2 id="bb-most-h">Lo más leído</h2>
          <ol>{top10.map((s, i) => <li><b>{i + 1}</b><a href={storyUrl(s)} class="hl">{s.data.title}</a></li>)}</ol>
        </section>
      )}
    </section>
  )}

  <div class="wrap home-grid">
    <main class="home-main">
      {breaking.length > 0 && (
        <section class="bb-sec">
          <div class="sec-h"><h2 class="bb-live">Última hora</h2><a href={url('category/ultima-hora')}>Ver todo</a></div>
          <div class="bb-row4">{breaking.map((s) => <StoryCard story={s} />)}</div>
        </section>
      )}

      {featured.length > 0 && (
        <section>
          <div class="sec-h"><h2>Destacadas</h2></div>
          <div class="bb-row4">{featured.slice(0, 4).map((s) => <StoryCard story={s} />)}</div>
        </section>
      )}

      <AdSlot size="infeed" />

      {F.videos && (
        <section>
          <div class="sec-h"><h2>Videos</h2><a href={url('videos')}>Ver todos</a></div>
          <div class="vx-home">
            <div class="vx-player">
              <div class="lg-video-frame">
                <iframe data-src={`https://www.youtube-nocookie.com/embed/videoseries?list=UU${VIDEO_SOURCES.noticel.channel.slice(2)}&autoplay=1&mute=1&rel=0&playsinline=1`} title="Lo más reciente de NotiCel en YouTube" loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              </div>
              <p class="vsrc">Lo más reciente de <a href={VIDEO_SOURCES.noticel.url} rel="noopener" target="_blank">NotiCel en YouTube</a></p>
            </div>
            <div class="vx-list">{VIDEOS.filter((v) => v.src === 'noticel').slice(0, 4).map((v) => <VideoCard video={v} />)}</div>
          </div>
        </section>
      )}

      {sectionRows.map((r, i) => r.list.length > 0 && (
        <>
          <section class="bb-sec">
            <div class="sec-h"><h2>{SECTIONS.find((x) => x.id === r.id)?.name}</h2><a href={sectionUrl(r.id)}>Ver todo</a></div>
            <div class="bb-row4">{r.list.map((s) => <StoryCard story={s} />)}</div>
          </section>
          {i === 1 && <AdSlot size="infeed" />}
          {i === 3 && <GamesTeaser />}
        </>
      ))}

      <Markets strip />

      {F.app && <section class="promo">
        <img src={url('icon-192.png')} alt="" />
        <div><h2>Descarga la app de NotiCel</h2><p>Recibe alertas de última hora y mira la transmisión en vivo desde tu celular.</p></div>
        <div class="stores">
          <button class="store" type="button" data-app><small>Descárgala en</small>App Store</button>
          <button class="store" type="button" data-app><small>Disponible en</small>Google Play</button>
        </div>
      </section>}
    </main>
    <Sidebar foro extras />
  </div>
  <script>
    // Old WordPress searches (noticel.com/?s=palabra) open the new search page
    const s = new URLSearchParams(location.search).get('s');
    if (s) location.replace(`${document.body.dataset.base}buscar/?q=${encodeURIComponent(s)}`);
  </script>
</Base>
