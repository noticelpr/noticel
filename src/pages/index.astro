---
// Home page, NotiCel arrangement (2026-10-08): Noticias Xtra's building blocks in NotiCel's own order.
//  1. Card strip (black band)  2. Big photo with the headline on it + "Lo último" timeline  3. Three headlines
//  4. Última Hora black band  5. Main column: Lo más leído, Destacadas, Videos, sections (most-read first), app;
//     right column: Noticias Xtra's sidebar (Tendencias, lottery, Foro…). Each story appears once at the top.
import Markets from '../components/economia/Markets.astro';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import VideoCard from '../components/VideoCard.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Sidebar from '../components/Sidebar.astro';
import Ph from '../components/Ph.astro';
import Label from '../components/Label.astro';
import Time from '../components/Time.astro';
import HomeStrip from '../components/HomeStrip.astro';
import AdSlot from '../components/AdSlot.astro';
import GamesTeaser from '../components/GamesTeaser.astro';
import { getStories, topOrder, pinTop, mostRead, inCategory, url, SITE, SECTIONS, VIDEOS, VIDEO_SOURCES, storyUrl, sectionUrl, timeOnly } from '../lib/site';

const stories = await getStories();
const F = SITE.features;
// Top spots: an editor's pin, then Puerto Rico first unless a U.S. or world story is trending (src/lib/site.ts)
const ordered = pinTop(topOrder(stories)).filter((s) => s.data.section !== 'opiniones');
const lead = ordered[0];
const used = new Set(lead ? [lead.id] : []);
const take = (list: typeof stories, n: number) => {
  const out = list.filter((s) => !used.has(s.id)).slice(0, n);
  out.forEach((s) => used.add(s.id));
  return out;
};
const related = (lead?.data.related ?? []).map((id) => stories.find((s) => s.id === id)).filter((s): s is (typeof stories)[number] => !!s);
const subs = take(related.length ? related : ordered, 3);
const latest = stories.filter((s) => s.id !== lead?.id && s.data.section !== 'opiniones').slice(0, 7); // a timeline: may repeat
const breaking = take(stories.filter((s) => inCategory(s, 'ultima-hora')), 8);
const top5 = mostRead(stories, 5);
const featured = take(ordered.filter((s) => s.data.featured), 6);
const restStories = stories.filter((s) => !used.has(s.id));
// Section blocks, most-read sections first (total views of their stories), Opiniones last. Noticias is already up top.
const viewsOf = (id: string) => stories.filter((s) => s.data.section === id).reduce((n, s) => n + s.data.views, 0);
const sectionIds = SECTIONS.map((s) => s.id)
  .filter((id) => id !== 'noticias' && restStories.some((s) => s.data.section === id))
  .sort((a, b) => Number(a === 'opiniones') - Number(b === 'opiniones') || viewsOf(b) - viewsOf(a));
const pairs = Array.from({ length: Math.ceil(sectionIds.length / 2) }, (_, i) => sectionIds.slice(i * 2, i * 2 + 2));
---
<Base active="home">
  <HomeStrip />
  {!lead && <div class="wrap"><div class="empty"><p>Muy pronto publicaremos las primeras noticias.</p></div></div>}
  {lead && (
    <section class="wrap nc-top" id="main">
      <div class="nc-hero">
        <a class="nc-lead" href={storyUrl(lead)}>
          <Ph sectionId={lead.data.section} image={lead.data.image} league={lead.data.league} sizes="(max-width:760px) 100vw, 900px" priority />
          <div class="nc-cap">
            <Label story={lead} />
            <h1 class="hl">{lead.data.title}</h1>
            {lead.data.description && <p>{lead.data.description}</p>}
          </div>
        </a>
        <aside class="nc-latest" aria-labelledby="nc-latest-h">
          <h2 class="nc-box-h" id="nc-latest-h">Lo último</h2>
          <ol class="nc-tl">
            {latest.map((s) => <li><span class="nc-tl-t">{timeOnly(s.data.date)}</span><a href={storyUrl(s)} class="hl">{s.data.title}</a></li>)}
          </ol>
          <a class="nc-more" href={sectionUrl('noticias')}>Todas las noticias ›</a>
        </aside>
      </div>
      {subs.length > 0 && (
        <div class="nc-subs">
          {subs.map((s) => (
            <article class="nc-sub">
              <Label story={s} />
              <a href={storyUrl(s)}><h3 class="hl">{s.data.title}</h3></a>
              <Time date={s.data.date} />
            </article>
          ))}
        </div>
      )}
    </section>
  )}

  {breaking.length > 0 && (
    <section class="nc-band" aria-labelledby="nc-band-h">
      <div class="wrap">
        <div class="nc-band-h"><h2 id="nc-band-h">Última hora</h2><a href={url('category/ultima-hora')}>Ver todo ›</a></div>
        <div class="nc-rail">
          {breaking.map((s) => (
            <a class="nc-rcard" href={storyUrl(s)}>
              <Ph sectionId={s.data.section} image={s.data.image} league={s.data.league} sizes="260px" />
              <h3 class="hl">{s.data.title}</h3>
              <Time date={s.data.date} />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="wrap home-grid">
    <main class="home-main">
      {top5.length > 0 && (
        <section>
          <div class="sec-h"><h2>Lo más leído</h2></div>
          <ol class="nc-most">{top5.map((s, i) => <li><b>{i + 1}</b><a href={storyUrl(s)} class="hl">{s.data.title}</a></li>)}</ol>
        </section>
      )}

      {featured.length > 0 && (
        <section>
          <div class="sec-h"><h2>Destacadas</h2></div>
          <div class="grid3">{featured.map((s) => <StoryCard story={s} />)}</div>
        </section>
      )}

      <AdSlot size="infeed" />

      {F.videos && (
        <section>
          <div class="sec-h"><h2>Videos</h2><a href={url('videos')}>Ver todos</a></div>
          <div class="vx-home">
            <div class="vx-player">
              <div class="lg-video-frame">
                <iframe data-src={`https://www.youtube-nocookie.com/embed/videoseries?list=UU${VIDEO_SOURCES.noticel.channel.slice(2)}&autoplay=1&mute=1&rel=0&playsinline=1`} title="Lo más reciente de NotiCel en YouTube" loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              </div>
              <p class="vsrc">Lo más reciente de <a href={VIDEO_SOURCES.noticel.url} rel="noopener" target="_blank">NotiCel en YouTube</a></p>
            </div>
            <div class="vx-list">{VIDEOS.filter((v) => v.src === 'noticel').slice(0, 4).map((v) => <VideoCard video={v} />)}</div>
          </div>
        </section>
      )}

      <div class="home-sections">
        {pairs.map((pair, i) => (
          <>
            {pair.map((id) => <div class:list={{ 'sec-wide': pair.length === 1 }}><SectionBlock sectionId={id} stories={restStories} /></div>)}
            {i === 1 && i < pairs.length - 1 && <AdSlot size="infeed" class="ad-span" />}
            {i === 3 && i < pairs.length - 1 && <div class="ad-span"><GamesTeaser /></div>}
          </>
        ))}
      </div>

      <Markets strip />

      {F.app && <section class="promo">
        <img src={url('icon-192.png')} alt="" />
        <div><h2>Descarga la app de NotiCel</h2><p>Recibe alertas de última hora y mira la transmisión en vivo desde tu celular.</p></div>
        <div class="stores">
          <button class="store" type="button" data-app><small>Descárgala en</small>App Store</button>
          <button class="store" type="button" data-app><small>Disponible en</small>Google Play</button>
        </div>
      </section>}
    </main>
    <Sidebar foro extras />
  </div>
  <script>
    // Old WordPress searches (noticel.com/?s=palabra) open the new search page
    const s = new URLSearchParams(location.search).get('s');
    if (s) location.replace(`${document.body.dataset.base}buscar/?q=${encodeURIComponent(s)}`);
  </script>
</Base>
