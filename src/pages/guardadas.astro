---
// Saved stories (same as Noticias Xtra's): the list lives only in this reader's browser (localStorage 'nc-saved'),
// filled by the Guardar button on each story page.
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Noticias guardadas" noindex description="Las noticias que guardaste para leer después.">
  <main id="main" class="wrap" tabindex="-1">
    <div class="crumbs"><a href={url()}>Portada</a></div>
    <div class="sv-head"><h1 class="page-h">Guardadas</h1><button type="button" class="tool" data-clear hidden>Borrar todas</button></div>
    <p class="time">Se guardan solo en este navegador. Para guardar una noticia, toca <strong>Guardar</strong> en la página de la noticia.</p>
    <div class="stack sv-list" data-list></div>
    <div class="empty" data-empty hidden>
      <h2>Todavía no has guardado noticias</h2>
      <p><a class="btn" href={url()}>Ir a la portada</a></p>
    </div>
  </main>
  <script>
    import { ask } from '../lib/dialogs';
    type Saved = { u: string; t: string; s: string; d: string; i: string; at: number };
    const list = document.querySelector<HTMLElement>('[data-list]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
    const read = (): Saved[] => { try { return JSON.parse(localStorage.getItem('nc-saved') || '[]'); } catch { return []; } };
    const write = (v: Saved[]) => { try { localStorage.setItem('nc-saved', JSON.stringify(v)); } catch { /* storage blocked */ } dispatchEvent(new Event('nc-saved-change')); };
    const fmt = (d: string) => new Date(d).toLocaleDateString('es-PR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Puerto_Rico' });
    const render = () => {
      const items = read();
      list.replaceChildren(...items.map((x) => {
        const row = document.createElement('article'); row.className = 'row';
        const box = document.createElement('div');
        if (x.s) { const k = document.createElement('span'); k.className = 'kicker'; k.textContent = x.s; box.append(k); }
        const a = document.createElement('a'); a.href = x.u;
        const h = document.createElement('h3'); h.className = 'hl'; h.textContent = x.t; a.append(h);
        const when = document.createElement('div'); when.className = 'time'; when.textContent = fmt(x.d);
        const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'tool sv-rm'; rm.textContent = 'Quitar';
        rm.setAttribute('aria-label', `Quitar de guardadas: ${x.t}`);
        rm.addEventListener('click', () => { write(read().filter((y) => y.u !== x.u)); render(); });
        box.append(a, when, rm);
        const pic = document.createElement('a'); pic.href = x.u; pic.tabIndex = -1; pic.setAttribute('aria-hidden', 'true');
        const ph = document.createElement('div'); ph.className = 'ph'; ph.style.setProperty('--c', '#006FA6');
        if (x.i) { const img = document.createElement('img'); img.src = x.i; img.alt = ''; img.loading = 'lazy'; ph.append(img); }
        pic.append(ph);
        row.append(box, pic);
        return row;
      }));
      empty.hidden = items.length > 0;
      clear.hidden = items.length === 0;
    };
    clear.addEventListener('click', async () => { if (await ask('¿Borrar todas las noticias guardadas?', { ok: 'Borrar todas', danger: true })) { write([]); render(); } });
    render();
  </script>
</Base>
