---
// Saved stories: the list lives only in this reader's browser (localStorage 'nc-saved').
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Noticias guardadas" noindex description="Las noticias que guardaste para leer después.">
  <main class="wrap" id="main">
    <div class="sec-h" style="margin-top:0"><h1 style="font-size:32px;margin:0;color:var(--purple)">Guardadas</h1><button type="button" class="tool" data-clear hidden>Borrar todas</button></div>
    <p class="sv-note">Se guardan solo en este navegador. Para guardar una noticia, toca <strong>Guardar</strong> en la página de la noticia.</p>
    <ul class="sv-list" data-list></ul>
    <div class="sv-empty" data-empty hidden>
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z" /></svg>
      <h2>Todavía no has guardado noticias</h2>
      <p><a href={url()}>Ir a la portada</a></p>
    </div>
  </main>
  <script>
    import { ask } from '../lib/dialogs';
    type Saved = { u: string; t: string; s: string; d: string; i: string; at: number };
    const list = document.querySelector<HTMLUListElement>('[data-list]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
    const read = (): Saved[] => { try { return JSON.parse(localStorage.getItem('nc-saved') || '[]'); } catch { return []; } };
    const write = (v: Saved[]) => { try { localStorage.setItem('nc-saved', JSON.stringify(v)); } catch { /* storage blocked */ } dispatchEvent(new Event('nc-saved-change')); };
    const fmt = (d: string) => new Date(d).toLocaleDateString('es-PR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Puerto_Rico' });
    const render = () => {
      const items = read();
      list.replaceChildren(...items.map((x) => {
        const li = document.createElement('li');
        li.className = 'sv-item';
        const a = document.createElement('a');
        a.href = x.u;
        const img = document.createElement('img');
        img.src = x.i; img.alt = ''; img.loading = 'lazy';
        const box = document.createElement('div');
        const sec = document.createElement('span'); sec.className = 'sv-sec'; sec.textContent = x.s;
        const h = document.createElement('h2'); h.className = 'hl'; h.textContent = x.t;
        const when = document.createElement('span'); when.className = 'sv-date'; when.textContent = fmt(x.d);
        box.append(sec, h, when);
        a.append(img, box);
        const rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'tool'; rm.textContent = 'Quitar';
        rm.setAttribute('aria-label', `Quitar de guardadas: ${x.t}`);
        rm.addEventListener('click', () => { write(read().filter((y) => y.u !== x.u)); render(); });
        li.append(a, rm);
        return li;
      }));
      empty.hidden = items.length > 0;
      clear.hidden = items.length === 0;
    };
    clear.addEventListener('click', async () => { if (await ask('¿Borrar todas las noticias guardadas?', { ok: 'Borrar todas', danger: true })) { write([]); render(); } });
    render();
  </script>
</Base>
