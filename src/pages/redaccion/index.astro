      type Snap = { ym: string; month: number; today: number; owed: number; n: number; day: string };
      const now = new Date(), ym = `${now.getFullYear()}-${now.getMonth()}`, dayKey = now.toDateString();
      const paintCard = (x: Snap | null) => {
        const box = $('[data-kpis]'); box.querySelector('[data-sales-kpi]')?.remove();
        box.insertAdjacentHTML('beforeend', kpi(`Ventas del mes${isDemo() ? ' · DEMO' : ''}`, x ? money(x.month) : '…', x ? `${money(x.day === dayKey ? x.today : 0)} hoy${x.owed ? ` · ${money(x.owed)} por cobrar` : ''}` : 'cargando…', 'analitica', x?.n ? 'good' : '').replace('class="pnl-kpi', 'data-sales-kpi data-earn-go class="pnl-kpi'));
      };
      const snapOf = (all: AdRequest[]): Snap => {
        const month = new Date(now.getFullYear(), now.getMonth(), 1).valueOf(), day = new Date(now.getFullYear(), now.getMonth(), now.getDate()).valueOf();
        const sold = all.filter((r) => r.status === 'aprobada' && Date.parse(r.created) >= month);
        const sum = (l: AdRequest[]) => l.reduce((a, r) => a + Number(r.total || 0), 0);
        return { ym, month: sum(sold), today: sum(sold.filter((r) => Date.parse(r.created) >= day)), owed: sum(sold.filter((r) => !r.paid)), n: sold.length, day: dayKey };
      };
      if (isDemo() || !hasBackend()) { paintCard(snapOf(isDemo() ? demoSales() : listRequests())); return; }
      const have = listRequests(), saved = get<Snap | null>('nc-sales-kpi', null);
      paintCard(have.length ? snapOf(have) : saved?.ym === ym ? saved : null); // the box is there right away
      const fresh = snapOf(await loadRequests());
      set('nc-sales-kpi', fresh); paintCard(fresh);
    }
    /** Inicio, periodistas: their latest stories and where each one stands (a story sent back is a draft with a note). */
    let myNews: Array<{ id: string; title: string; status: string; slug?: string | null; doc?: unknown }> = [];
    const storyUrl = (a: { id: string; slug?: string | null }) => new URL(`${root.dataset.base!.replace(/\/$/, '')}/noticia/${a.slug || a.id}/`, location.origin).toString();
    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
