        if (r?.ok) reads = ((await r.json()) as Array<{ n: number }>).reduce((a, x) => a + Number(x.n || 0), 0);
      }
      const money = (v: number) => v.toLocaleString('es-PR', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 });
      $('[data-rpm-v]').textContent = reads >= 100 ? money((income / reads) * 1000) : '—';
      $('[data-rpm-sub]').textContent = reads >= 100
        ? `Últimos 30 días: ${money(income)} en anuncios vendidos ÷ ${reads.toLocaleString('es-PR')} lecturas de noticias${demo ? ' (números de ejemplo)' : ''}. Cuando Google AdSense esté conectado, se suma lo que pague Google.`
        : 'Todavía no hay suficientes lecturas contadas (se cuentan desde el 5 de noviembre). Aparece cuando haya al menos 100.';
