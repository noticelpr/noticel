      barChart($('[data-earn-chart]'), series, (v) => (v >= 1000 ? `$${Math.round(v / 100) / 10}k` : `$${v}`));
      const group = (key: (r: AdRequest) => Array<[string, number]>) => { const g = new Map<string, number>(); sold.forEach((r) => key(r).forEach(([k, v]) => g.set(k, (g.get(k) ?? 0) + v))); return [...g].sort((a, b) => b[1] - a[1]); };
      $('[data-earn-pay]').innerHTML = rankRows(group((r) => [[payOf(r), Number(r.total)]]), money);
      $('[data-earn-fmt]').innerHTML = rankRows(group((r) => (r.formats.length ? r.formats : ['otro']).map((f) => [formatName(f), Number(r.total) / Math.max(1, r.formats.length)] as [string, number])), money);
