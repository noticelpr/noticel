          box.querySelectorAll<HTMLButtonElement>('[data-pub-sort]').forEach((b) => b.addEventListener('click', () => { pubSort = b.dataset.pubSort as typeof pubSort; box.querySelectorAll('[data-pub-sort]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); paintPub(); }));
