---
// Staff panel ("Panel de la redacción"): one login for everything waiting on the newsroom.
// Tabs: Inicio, Noticias (approve, quick look, every published story), Escribir, Fotos (photo library), Ventas, Comentarios,
// Anuncios, Analítica (Google Analytics through the 'analitica' Edge Function), Salud del sitio, Equipo. What each person
// sees depends on their role. Ingresos comes back when Stripe/ATH are connected.
// NotiCel version: same panel as Noticias Xtra, with NotiCel's categories and story addresses.
// Login: Supabase email + password, role from the `staff` table. "Por aprobar" lists the stories reporters sent for
// review (table `articles`) and the automatic news waiting as pull requests in GitHub; Salud reads the real GitHub status.
import Base from '../../layouts/Base.astro';
import '../../styles/panel.css';
import AdQueue from '../../components/AdQueue.astro';
import CommentQueue from '../../components/CommentQueue.astro';
import SalesDesk from '../../components/panel/SalesDesk.astro';
import Writer from '../../components/panel/Writer.astro';
import Tasks from '../../components/panel/Tasks.astro';
import PhotoLibrary from '../../components/panel/PhotoLibrary.astro';
import { getStories, url, SECTIONS, SITE, mainCategory, inCategory } from '../../lib/site';
import { hasBackend } from '../../lib/backend';
import { getCollection } from 'astro:content';
import fs from 'node:fs';

const stories = await getStories();
const hasBackendBuild = hasBackend(); // Supabase connected: real accounts and team
const secName = (id: string) => SECTIONS.find((x) => x.id === id)?.short ?? '';
// Everything on the site, for Escribir → Publicadas (with views once analytics is connected)
const published = stories.map((s) => ({ id: s.id, title: s.data.title, section: secName(mainCategory(s)), author: s.data.author, date: s.data.date.toISOString(), url: url(s.data.path), ai: s.data.aiAssisted }));
// The story pinned (📌) in the home page's main spot, for the reminder on Inicio
const pinnedStory = stories.filter((s) => s.data.pinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const pin = pinnedStory ? { title: pinnedStory.data.title, date: pinnedStory.data.date.toISOString(), url: url(pinnedStory.data.path) } : null;
// Stories pinned at the top of each category (newest pin per category), for the same reminder
const sectionPins = SECTIONS.map((sec) => {
  const p = stories.filter((s) => mainCategory(s) === sec.id && s.data.sectionPinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
  return p ? { section: sec.short, title: p.data.title, url: url(p.data.path) } : null;
}).filter(Boolean);
const recent = stories.filter((s) => !inCategory(s, 'opiniones')).slice(0, 12)
  .map((s) => ({ id: s.id, title: s.data.title, section: secName(mainCategory(s)), url: url(s.data.path), date: s.data.date.toISOString(), author: s.data.author }));
// Automatic news sources (official and primary only). None yet on NotiCel; same shape as Noticias Xtra's scripts/sources.json.
const srcs: Array<{ name: string; section: string; review: string }> = [];
// Salud del sitio: stories missing something, every web photo (checked in the browser) and story files scheduled ahead
const words = (t = '') => (t.replace(/<[^>]+>/g, ' ').match(/[\p{L}\p{N}]+/gu) || []).length;
const isWeb = (x = '') => /^https?:/.test(x);
const problems = stories.map((s) => {
  const d = s.data; const p: string[] = [];
  if (!d.image) p.push('sin foto propia');
  else if (!isWeb(d.image) && !fs.existsSync(`public/${d.image.replace(/^\//, '')}`)) p.push('la foto no existe');
  else if (!d.imageCredit && !d.imageCaption) p.push('foto sin crédito'); // WordPress captions carry the credit (e.g. "EFE/...")
  if (d.gallery.some((g) => !g.credit)) p.push('galería sin crédito');
  const w = words(s.body); if (w < 150) p.push(`solo ${w} palabras`);
  if (d.aiAssisted && !d.sources.length) p.push('sin fuentes'); // automated news must cite its official sources
  return p.length ? { id: s.id, title: d.title, date: d.date.toISOString(), p } : null;
}).filter(Boolean);
const webPhotos = stories.flatMap((s) => [s.data.image ?? '', ...s.data.gallery.map((g) => g.src)].filter(isWeb).map((src) => ({ id: s.id, title: s.data.title, src })));
const aheadFiles = (await getCollection('noticias', ({ data }) => !data.draft && data.date.valueOf() > Date.now()))
  .map((s) => ({ title: s.data.title, author: s.data.author, date: s.data.date.toISOString() }));
const TABS = [
  ['inicio', 'Inicio', '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>'],
  ['noticias', 'Noticias', '<path d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5"/>'],
  ['escribir', 'Escribir', '<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>'],
  ['fotos', 'Fotos', '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 8"/>'],
  ['comentarios', 'Comentarios', '<path d="M4 5h16v11H9l-5 4z"/>'],
  ['ventas', 'Ventas', '<path d="M3 7h18l-2 12H5z"/><path d="M8 7a4 4 0 0 1 8 0"/>'],
  ['anuncios', 'Anuncios', '<path d="M3 11v2l13 5V6L3 11z"/><path d="M16 9a3 3 0 0 1 0 6"/>'],
  ['analitica', 'Analítica', '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'],
  ['salud', 'Salud del sitio', '<path d="M3 12h4l2-5 4 10 2-5h6"/>'],
  ['equipo', 'Equipo', '<circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4a3.5 3.5 0 0 1 0 7M22 20a7 7 0 0 0-4-6.3"/>'],
];
---
<Base title="Panel de la redacción" description="Panel interno de NotiCel (uso del personal)." noindex staff>
  <main class="wrap pnl" id="main" data-pnl data-secs={JSON.stringify(Object.fromEntries(SECTIONS.map((x) => [x.id, x.short])))} data-pin={JSON.stringify(pin)} data-section-pins={JSON.stringify(sectionPins)} data-recent={JSON.stringify(recent)} data-published={JSON.stringify(published.map(({ id, title, section, author, date, url }) => ({ id, title, section, author, date, url })))} data-sources={JSON.stringify(srcs)} data-problems={JSON.stringify(problems)} data-photos={JSON.stringify(webPhotos)} data-ahead={JSON.stringify(aheadFiles)} data-base={url()} data-aikey={String(SITE.aiKeyConnected)}>
    <form class="pnl-login" data-login hidden>
      <p class="pnl-kicker">NotiCel</p>
      <h1>Panel de la redacción</h1>
      <p class="pnl-muted">Todo lo que te espera en un solo lugar: noticias por aprobar, comentarios, anuncios, ingresos y analítica.</p>
      {/* With the database: email and password; the role comes from the staff list. Preview: name and role. */}
      <div class="pnl-real" data-real hidden>
        <label for="pnl-mail">Correo</label>
        <input id="pnl-mail" type="email" autocomplete="username" />
        <label for="pnl-pass">Contraseña</label>
        <input id="pnl-pass" type="password" autocomplete="current-password" />
      </div>
      <div class="pnl-prev" data-prevlogin>
      <label for="pnl-name">Tu nombre</label>
      <input id="pnl-name" maxlength="30" autocomplete="name" placeholder="ej. Alfredo" />
      <label for="pnl-role">Rol</label>
      <select id="pnl-role">
        <option value="admin">Administrador: todo</option>
        <option value="editor">Editor: noticias, comentarios y analítica</option>
        <option value="ads">Ventas: clientes, anuncios e ingresos</option>
        <option value="reporter">Periodista: escribir sus noticias</option>
      </select>
      </div>
      <p class="cm-err" data-err hidden></p>
      <button type="submit" class="adp-btn">Entrar</button>
      <p class="pnl-note" data-prevlogin><span class="sp-demo">VISTA PREVIA</span> Sin contraseña por ahora. Con las cuentas, cada persona entra con su correo y su contraseña, y su rol lo asigna el administrador.</p>
    </form>

    <div class="pnl-app" data-pnl-app hidden>
      <aside class="pnl-side">
        <div class="pnl-me"><span class="pnl-av" data-av></span><span><b data-me></b><small data-role></small></span></div>
        <nav class="pnl-nav" aria-label="Secciones del panel">
          {TABS.map(([id, name, d]) => (
            <button type="button" data-tab={id} aria-current="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={d} /></svg>
              <span>{name}</span><b class="pnl-n" data-count={id}></b>
            </button>
          ))}
        </nav>
        <button type="button" class="pnl-out" data-logout>Salir</button>
      </aside>

      <div class="pnl-main">

        <!-- Inicio -->
        <section class="pnl-pane" data-pane="inicio">
          <h1 class="pnl-h">Buenos días, <span data-me></span></h1>
          <p class="pnl-muted" data-today></p>
          <div class="pnl-kpis" data-kpis></div>
          <h2 class="pnl-h2">Lo que te espera</h2>
          <ul class="pnl-todo" data-todo></ul>
          <Tasks />
        </section>

        <!-- Noticias -->
        <section class="pnl-pane" data-pane="noticias" hidden>
          <h1 class="pnl-h">Noticias</h1>
          <p class="pnl-muted">Aprueba lo que espera por ti, dale un vistazo a lo último que salió y busca cualquier noticia publicada para corregirla o quitarla.</p>
          <nav class="apn-tabs pnl-sub" role="tablist" aria-label="Noticias">
            <button type="button" role="tab" aria-selected="true" data-nf="pending">Por aprobar <b data-nn="pending"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="check">Vistazo rápido <b data-nn="check"></b></button>
            <button type="button" role="tab" aria-selected="false" data-nf="pub">Publicadas <b data-nn="pub"></b></button>
          </nav>
          <div class="pnl-list" data-news></div>
        </section>

        <!-- Escribir -->
        <section class="pnl-pane" data-pane="escribir" hidden>
          <Writer recent={recent.map(({ id, title }) => ({ id, title }))} published={published} />
        </section>

        <!-- Fotos -->
        <section class="pnl-pane" data-pane="fotos" hidden>
          <PhotoLibrary />
        </section>

        <!-- Ventas -->
        <section class="pnl-pane" data-pane="ventas" hidden>
          <SalesDesk />
        </section>

        <!-- Comentarios -->
        <section class="pnl-pane" data-pane="comentarios" hidden>
          <CommentQueue embedded />
        </section>

        <!-- Anuncios -->
        <section class="pnl-pane" data-pane="anuncios" hidden>
          <AdQueue embedded />
        </section>

        <!-- Analítica: real visits from Google Analytics (Edge Function "analitica") -->
        <section class="pnl-pane" data-pane="analitica" hidden>
          <header class="sd-head"><div><h1 class="pnl-h">Analítica <span class="sp-demo" data-an-demo hidden>DEMO</span></h1><p class="pnl-muted"><span data-an-real>Visitas reales del sitio, de Google Analytics.</span> <span data-an-at></span></p><p class="pnl-note" data-an-demo hidden><span class="sp-demo">DEMO</span> Números de ejemplo para mostrar cómo funciona esta pestaña. Con el panel real, aquí salen las visitas de Google Analytics.</p></div>
            <div class="pnl-range" role="group" aria-label="Período"><button type="button" data-range="1">Hoy</button><button type="button" data-range="7" aria-pressed="true">7 días</button><button type="button" data-range="28">28 días</button></div></header>
          <div data-an-msg hidden></div>
          <div data-an-body>
            <div class="pnl-kpis" data-an-kpis></div>
            <div class="pnl-card"><h2 class="pnl-h3" data-an-chart-h>Visitantes por día</h2><div class="pnl-chart" data-an-chart></div></div>
            <div class="pnl-grid2">
              <div class="pnl-card"><h2 class="pnl-h3">Noticias más leídas</h2><ol class="pnl-top" data-an-top></ol></div>
              <div class="pnl-card"><h2 class="pnl-h3">De dónde llegan</h2><div data-an-ref></div></div>
            </div>
            <div class="pnl-grid2">
              <div class="pnl-card"><h2 class="pnl-h3">Dónde están</h2><div data-an-geo></div></div>
              <div class="pnl-card"><h2 class="pnl-h3">Dispositivos</h2><div data-an-dev></div></div>
            </div>
            <p class="pnl-muted pnl-small">“Ahora mismo” es al instante. Las visitas de hoy pueden tardar unas horas en aparecer completas. Mientras el sitio tenga clave de acceso, solo cuentan quienes la conocen.</p>
          </div>
        </section>

        <!-- Salud -->
        <section class="pnl-pane" data-pane="salud" hidden>
          <h1 class="pnl-h">Salud del sitio</h1>
          <p class="pnl-muted">Estado real del sitio en este momento.</p>
          <div class="pnl-kpis" data-health></div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">¿Está todo en línea?</h2><ul class="sl-lights" data-lights></ul></div>
            <div class="pnl-card"><h2 class="pnl-h3">Programadas <small data-sched-n></small></h2><ul class="sl-list" data-sched></ul></div>
            <div class="pnl-card"><h2 class="pnl-h3">Comentarios y cuentas</h2><div data-sl-mod><p class="pnl-muted">Cargando…</p></div></div>
            <div class="pnl-card"><h2 class="pnl-h3">Espacio usado <small>plan gratis de Supabase</small></h2><div data-space><p class="pnl-muted">Cargando…</p></div></div>
          </div>
          <div class="pnl-card"><h2 class="pnl-h3">Noticias con problemas <small data-prob-n></small></h2><p class="pnl-muted pnl-small">Les falta algo: foto, crédito de la foto, texto o fuentes. Toca “Corregir” para arreglarla en Escribir.</p><ul class="sl-list" data-prob></ul><button type="button" class="pnl-link" data-prob-more hidden>Ver todas</button></div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Fotos rotas</h2><p class="pnl-muted pnl-small" data-ph-note></p><ul class="sl-list" data-sl-ph></ul><button type="button" class="adp-btn ghost-dark" data-ph-run>Revisar las fotos</button></div>
            <div class="pnl-card"><h2 class="pnl-h3">Errores al publicar</h2><p class="pnl-muted pnl-small">Si publicar, programar o quitar una noticia falla, queda anotado aquí.</p><ul class="sl-list" data-errs></ul><button type="button" class="pnl-link" data-errs-clear hidden>Borrar la lista</button></div>
          </div>
          <div class="pnl-grid2">
            <div class="pnl-card"><h2 class="pnl-h3">Cuentas y conexiones</h2><ul class="pnl-checks" data-accounts></ul></div>
            <div class="pnl-card"><h2 class="pnl-h3">Fuentes de noticias <small data-src-n></small></h2><ul class="pnl-srcs" data-sl-srcs></ul></div>
          </div>
          <div class="pnl-card"><h2 class="pnl-h3">Herramientas de Google</h2><ul class="sl-tools">
            <li><a href="https://search.google.com/search-console" target="_blank" rel="noopener">Search Console ↗</a><small>si Google encuentra las noticias nuevas y errores</small></li>
            <li><a href="https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fnoticel.com%2F" target="_blank" rel="noopener">Velocidad (PageSpeed) ↗</a><small>mide bien después del lanzamiento: mientras haya clave de acceso, Google ve la página de la clave</small></li>
            <li><a href="https://analytics.google.com/" target="_blank" rel="noopener">Google Analytics ↗</a><small>visitantes: cuando lo conectes, sus números salen en este panel</small></li>
          </ul></div>
        </section>

        <!-- Equipo -->
        <section class="pnl-pane" data-pane="equipo" hidden>
          <h1 class="pnl-h">Equipo</h1>
          <p class="pnl-muted">Quién entra al panel y qué puede hacer.</p>
          {hasBackendBuild && <p class="pnl-muted pnl-small">Para añadir a alguien: primero crea su cuenta en el sitio (Entrar → Crear cuenta). Luego escribe aquí su nombre, su correo o @usuario y su rol. Entra al panel con ese mismo correo y contraseña.</p>}
          <ul class="pnl-team" data-team></ul>
          <form class="pnl-add" data-add novalidate>
            <input placeholder="Nombre" data-add-name maxlength="30" aria-label="Nombre" />
            <input placeholder="Correo o @usuario" data-add-mail maxlength="60" aria-label="Correo o nombre de usuario" autocapitalize="off" />
            <select data-add-role aria-label="Rol"><option value="editor">Editor</option><option value="ads">Ventas</option><option value="reporter">Periodista</option><option value="admin">Administrador</option></select>
            <button type="submit" class="adp-btn">Añadir</button>
          </form>
          <h2 class="pnl-h2">Qué puede hacer cada rol</h2>
          <div class="pnl-tablewrap" data-perms></div>
        </section>
      </div>
    </div>
    <div class="apn-toast" data-ptoast role="status" hidden></div>
  </main>

  <script>
    import { ask, askText } from '../../lib/dialogs';
    import { getReports } from '../../lib/moderation';
    import { listRequests, loadRequests } from '../../lib/adrequests';
    import { isDemo, demoAnalytics } from '../../lib/demo';
    import { REPO } from '../../lib/repo';
    import { BACKEND, getAnalytics, hasBackend, staffApi, staffLogin, staffLogout, staffProfile, syncTeam, addToTeam, removeFromTeam } from '../../lib/backend';
    const root = document.querySelector<HTMLElement>('[data-pnl]')!;
    const RECENT: Array<{ id: string; title: string; section: string; url: string; date: string; author: string }> = JSON.parse(root.dataset.recent!);
    const SOURCES: Array<{ name: string; section: string; review: string }> = JSON.parse(root.dataset.sources!);
    const PROBLEMS: Array<{ id: string; title: string; date: string; p: string[] }> = JSON.parse(root.dataset.problems || '[]');
    const PHOTOS: Array<{ id: string; title: string; src: string }> = JSON.parse(root.dataset.photos || '[]');
    const AHEAD: Array<{ title: string; author: string; date: string }> = JSON.parse(root.dataset.ahead || '[]');
    const PIN: { title: string; date: string; url: string } | null = JSON.parse(root.dataset.pin || 'null');
    const SECTION_PINS: Array<{ section: string; title: string; url: string }> = JSON.parse(root.dataset.sectionPins || '[]');
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const get = <T,>(k: string, d: T): T => { try { return JSON.parse(localStorage.getItem(k) || 'null') ?? d; } catch { return d; } };
    const set = (k: string, v: unknown) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, JSON.stringify(v)); } catch { /* storage blocked */ } };
    const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
    const num = (n: number) => Math.round(n).toLocaleString('es-PR');
    const ago = (t: number) => { const m = Math.round((Date.now() - t) / 60000); return m < 60 ? `hace ${Math.max(1, m)} min` : m < 1440 ? `hace ${Math.round(m / 60)} h` : `hace ${Math.round(m / 1440)} d`; };
    const toast = (m: string) => { const t = $('[data-ptoast]'); t.textContent = m; t.hidden = false; clearTimeout((t as any).tm); (t as any).tm = setTimeout(() => (t.hidden = true), 3800); };

    // ---------- login + roles ----------
    type Staff = { name: string; role: 'admin' | 'editor' | 'ads' | 'reporter' };
    const ROLE_NAME = { admin: 'Administrador', editor: 'Editor', ads: 'Ventas', reporter: 'Periodista' };
    const ROLE_TABS: Record<Staff['role'], string[]> = {
      admin: ['inicio', 'noticias', 'escribir', 'fotos', 'ventas', 'comentarios', 'anuncios', 'analitica', 'salud', 'equipo'],
      editor: ['inicio', 'noticias', 'escribir', 'fotos', 'comentarios', 'analitica', 'salud'],
      ads: ['inicio', 'ventas', 'anuncios', 'comentarios', 'analitica'],
      reporter: ['inicio', 'escribir', 'fotos'],
    };
    const me = () => get<Staff | null>('nc-staff', null);

    type NewsState = Record<string, { status: 'ok' | 'removed'; at: number }>; // Vistazo rápido: what this editor already checked
    const news = () => get<NewsState>('nc-panel-news', {});
    const setNews = (id: string, v: NewsState[string]) => { set('nc-panel-news', { ...news(), [id]: v }); };
    const checkList = () => RECENT.slice(0, 6).filter((r) => !news()[`c-${r.id}`]);

    // ---------- real work waiting: stories sent for review (Supabase), automatic news (GitHub), reported comments ----------
    type Rev = { id: string; updated_at: string; doc: { title?: string; author?: string; owner?: string; section?: string; date?: string } };
    type Pr = { number: number; title: string; html_url: string; created_at: string };
    const LIVE: { review: Rev[]; prs: Pr[]; comments: number; at: number } = { review: [], prs: [], comments: 0, at: 0 };
    // Automatic news waiting as pull requests in NotiCel's GitHub repository (none until REPO is set in src/lib/repo.ts)
    const openPrs = (): Promise<Pr[]> => (REPO ? fetch(`https://api.github.com/repos/${REPO}/pulls?state=open&per_page=30`).then((r) => (r.ok ? r.json() : [])).catch(() => []) : Promise.resolve([]));
    async function loadLive(force = false) {
      if (!force && Date.now() - LIVE.at < 30000) return; LIVE.at = Date.now();
      if (!hasBackend()) { // preview and demo: the stories waiting for review on this device, plus GitHub
        LIVE.review = get<Array<{ id: string; status: string; updated: number } & Rev['doc']>>('nc-articles', []).filter((a) => a.status === 'review')
          .map((a) => ({ id: a.id, updated_at: new Date(a.updated).toISOString(), doc: a }));
        const pr = await openPrs();
        LIVE.prs = Array.isArray(pr) ? pr : [];
        paintCounts(); if (tab === 'inicio' || tab === 'noticias') paint[tab]?.(); return;
      }
      const [rv, cm, pr] = await Promise.all([
        staffApi('articles?status=eq.review&select=id,updated_at,doc&order=updated_at.desc'),
        staffApi('comments?status=eq.review&select=id', { headers: { Prefer: 'count=exact' } }),
        openPrs(),
      ]);
      if (rv?.ok) LIVE.review = await rv.json();
      if (cm?.ok) LIVE.comments = Number(cm.headers.get('content-range')?.split('/')[1]) || 0;
      LIVE.prs = Array.isArray(pr) ? pr : [];
      paintCounts(); if (tab === 'inicio' || tab === 'noticias') paint[tab]?.();
    }
    addEventListener('nc-articles-changed', () => void loadLive(true));
    const SEC_NAME: Record<string, string> = JSON.parse(root.dataset.secs || '{}');

