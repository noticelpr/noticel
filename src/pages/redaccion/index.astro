      if (op) {
        const a = myNews[Number(op.dataset.mnOpen)]; if (!a) return;
        if (a.status === 'published') { open(storyUrl(a), '_blank', 'noopener'); return; }
        // Not on the site yet: the same preview Escribir uses (the story page with this text)
        try { localStorage.setItem('nc-preview', JSON.stringify(a.doc ?? {})); } catch { toast('No se pudo abrir la vista previa.'); return; }
        open(`${root.dataset.base!.replace(/\/$/, '')}/redaccion/vista-previa/`, '_blank', 'noopener');
      }
