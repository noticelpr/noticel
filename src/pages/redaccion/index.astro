      const fm = [['rectangle'], ['valla'], ['rectangle', 'cuadrado'], ['leaderboard'], ['patrocinio'], ['takeover'], ['halfpage']];
      const pays = ['Tarjeta (Stripe)', 'ATH Móvil', 'Transferencia', 'Cheque'];
      return Array.from({ length: 46 }, (_, i) => {
