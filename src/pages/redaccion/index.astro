        // A Gerente invites salespeople only
        { const addSel = $<HTMLSelectElement>('[data-add-role]'); [...addSel.options].forEach((o) => (o.hidden = isMgr && !mgrCan(o.value))); if (isMgr && !mgrCan(addSel.value)) addSel.value = 'ads'; }
        // Only an owner sees "Hacer dueño" / "Quitar dueño" (supabase/dueno.sql lets only an owner give or take the mark)
        const iAmOwner = hasBackend() && team.some((m) => m.id && teamStatus[m.id]?.owner && teamStatus[m.id]?.email === myMail);
        $('[data-add-hidden-wrap]').hidden = !iAmOwner; // hidden members: the owner only (supabase/oculto.sql)
        $('[data-team]').innerHTML = team.map((m, i) => {
          const x = st(m.id), self = hasBackend() ? (x?.email ?? m.mail) === myMail : !i;
          if (isMgr && !mgrCan(m.role) && !self) return ''; // a Gerente sees Ventas, periodistas and editors
          if (isChief && !NEWSROOM.includes(m.role) && !self) return '';
          const chips = hasBackend() && x && !x.accepted ? '<span class="pnl-chip warn">Invitación sin aceptar</span>' : '';
          const locked = !!x?.hidden; // the owner, seen by another administrator: no tools
          // The administrator's tools for this person, behind the edit (pencil) button
          const canEdit = hasBackend() && (isAdm || (isMgr && mgrCan(m.role))) && !self && m.id && !locked;
          const tools = canEdit ? `${isAdm || isMgr ? `<label class="pnl-team-role">Rol<select data-role-set="${i}" aria-label="Rol de ${esc(m.name)}">${(isAdm ? ['admin', 'manager', 'editor', 'desk', 'ads', 'reporter', 'photo'] as const : MGR_ROLES).map((r) => `<option value="${r}" ${r === m.role ? 'selected' : ''}>${ROLE_NAME[r]}</option>`).join('')}</select></label>` : ''}
            <button type="button" class="pnl-link" data-team-pw="${i}">${x && !x.accepted ? 'Reenviar invitación' : 'Enviar enlace de contraseña'}</button>
            ${iAmOwner && m.role === 'admin' && x?.accepted ? `<button type="button" class="pnl-link" data-owner-set="${i}" data-owner-to="${x?.owner ? '0' : '1'}">${x?.owner ? 'Quitar dueño' : 'Hacer dueño'}</button>` : ''}
            ${iAmOwner && !x?.owner ? `<button type="button" class="pnl-link" data-hide-set="${i}" data-hide-to="${x?.invisible ? '0' : '1'}">${x?.invisible ? 'Mostrar al equipo' : 'Ocultar del equipo'}</button>` : ''}` : '';
          // Name with a badge for what they do; then their email, activity; the admin's tools on the right
          return `<li><span class="pnl-av sm">${esc(m.name[0]?.toUpperCase() ?? '?')}</span><span class="pnl-who"><span class="pnl-who-top"><b>${esc(m.name)}</b>${self ? '<small>(tú)</small>' : ''}<span class="role-badge role-${m.role}">${ROLE_NAME[m.role]}</span>${m.role === 'reporter' && isAdm ? `<label class="adb-check pnl-canphotos"><input type="checkbox" data-canphotos="${i}" ${m.canPhotos ? 'checked' : ''} /> Puede subir fotos</label>` : ''}${x?.owner || x?.hidden ? '<span class="role-badge role-owner">Dueño</span>' : ''}${x?.invisible ? '<span class="role-badge role-hidden" title="Solo tú lo ves en el equipo">Oculto</span>' : ''}</span><small>${esc(x?.email || m.mail)}</small>${chips ? `<span class="pnl-chips">${chips}</span>` : ''}${isAdm ? activityLine(m.id, m.name, m.role) : ''}</span>${tools || (!self && !locked && (isAdm || mgrCan(m.role))) ? `<details class="pnl-team-edit"><summary aria-label="Editar a ${esc(m.name)}" title="Editar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg></summary><div class="pnl-team-pop">${tools}${!self && !locked && (isAdm || mgrCan(m.role)) ? `<button type="button" class="pnl-link danger" data-rm="${i}">Quitar del equipo</button>` : ''}</div></details>` : ''}</li>`;
        }).join('');
        if (hasBackend() && (isAdm || isMgr || isChief) && !teamStatusLoading && !Object.keys(teamStatus).length) {
          teamStatusLoading = true;
          void Promise.all([teamAdmin('status'), staffApi('rpc/staff_activity_list', { method: 'POST', body: '{}' }).then((r) => (r?.ok ? r.json() : []))]).then(([st, act]) => {
            teamStatusLoading = false;
            activity = Object.fromEntries((Array.isArray(act) ? act : []).map((x: any) => [x.user_id, x]));
            if (st?.list) { teamStatus = Object.fromEntries(st.list.map((x: any) => [x.id, x])); paint.equipo(); }
          });
        }
        const can: Array<[string, Array<boolean | 'if-allowed'>]> = [
          ['Aprobar noticias', [true, true, false, false]], ['Escribir noticias', [true, true, false, true]], ['Publicar o programar', [true, true, false, false]],
          ['Clientes y propuestas', [true, false, true, false]], ['Moderar comentarios', [true, true, true, false]],
          ['Aprobar anuncios', [true, false, true, false]], ['Ver ingresos', [true, false, true, false]], ['Ver analítica', [true, true, false, false]],
          ['Salud del sitio', [true, true, false, false, false]], ['Perfiles de columnistas', [true, true, false, false, false]],
          ['Subir y organizar fotos', [true, true, false, 'if-allowed', true]], ['Usar fotos de la biblioteca', [true, true, false, true, true]],
          ['Manejar el equipo', [true, false, false, false, false]],
        ];
        can.forEach((row) => { if (row[1].length === 4) row[1].push(false); }); // the Fotoperiodista column
        $('[data-perms]').innerHTML = `<table class="pnl-table perms"><thead><tr><th></th><th>Admin</th><th>Editor</th><th>Ventas</th><th>Periodista</th><th>Fotoperiodista</th></tr></thead><tbody>${can.map(([k, v]) => `<tr><th scope="row">${k}</th>${v.map((x) => `<td>${x === 'if-allowed' ? '<span title="Solo si el administrador lo permite en Equipo">Si se le permite</span>' : x ? '✓' : '—'}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
      },
    };

    // ---------- actions ----------
    let nf = 'pending';
    // ---------- Noticias → Publicadas: every story on the site ----------
    const PUBLISHED: Array<{ id: string; title: string; section: string; author: string; date: string; url: string; views?: number }> = JSON.parse(root.dataset.published || '[]');
    let pubQ = '', pubSort: 'new' | 'views' = 'new'; const takenDown = new Set<string>();
    const plainTxt = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    function paintPub() {
      const words = plainTxt(pubQ.trim()).split(/\s+/).filter(Boolean);
      const found = PUBLISHED.filter((p) => words.every((w) => plainTxt(`${p.title} ${p.section} ${p.author}`).includes(w)));
      const rows = (pubSort === 'views' ? [...found].sort((a, b) => (b.views ?? 0) - (a.views ?? 0)) : found).slice(0, 60);
      const canEdit = ['admin', 'editor', 'desk'].includes(me()?.role ?? '');
      $('[data-pub-list]').innerHTML = rows.map((p) => `<article class="pnl-row" data-pub="${esc(p.id)}">
        <div><p class="pnl-muted">✍️ Escrita por <b>${esc(p.author || 'NotiCel')}</b> · ${esc(p.section)} · ${new Date(p.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}${p.views ? ` · 👁 <b>${Number(p.views).toLocaleString('es-PR')}</b> vistas` : ''}${takenDown.has(p.id) ? ' · <b class="pnl-down">Quitada: desaparece en unos minutos</b>' : ''}</p>
          <h2><a href="${p.url}" target="_blank" rel="noopener">${esc(p.title)}</a></h2></div>
        <div class="pnl-row-acts"><button type="button" class="adp-btn ghost-dark" data-pub-edit>Editar</button><a class="adp-btn ghost-dark" href="${p.url}" target="_blank" rel="noopener">Ver en el sitio ↗</a>${canEdit && !takenDown.has(p.id) ? '<button type="button" class="apr-reject" data-pub-down>Quitar del sitio</button>' : ''}${me()?.role === 'admin' && !takenDown.has(p.id) ? '<button type="button" class="apr-reject" data-pub-del title="Solo el administrador">Borrar para siempre</button>' : ''}</div></article>`).join('')
        || `<p class="apr-empty">No encontramos noticias con “${esc(pubQ)}”.</p>`;
    }
    // Changes show at once in the panel's lists (user, 2026-11-07). Vistazo rápido, Publicadas, «Noticias publicadas
    // hoy» and Salud come with the page, which only has a change after the site rebuilds (2–5 minutes). So an edit
    // (title, section, byline, date), a takedown or a deletion is kept on this device for 2 hours and laid over them.
    type Fix = { title?: string; section?: string; author?: string; date?: string; gone?: boolean; fixed?: boolean; at: number };
    const STORY_FIX = 'nc-story-fix';
    // Function declarations (hoisted): checkList, pubRender and paintProblems above use them
    function fixes(): Record<string, Fix> { try { const all = JSON.parse(localStorage.getItem('nc-story-fix') || '{}') as Record<string, Fix>; for (const k of Object.keys(all)) if (Date.now() - all[k].at > 2 * 36e5) delete all[k]; return all; } catch { return {}; } }
    function isGone(id: string) { return !!fixes()[id]?.gone; }
    const saveFix = (id: string, f: Omit<Fix, 'at'>) => {
      const all = fixes(); all[id] = { ...all[id], ...f, at: Date.now() };
      try { localStorage.setItem(STORY_FIX, JSON.stringify(all)); } catch { /* storage blocked */ }
    };
    const applyFixes = () => {
