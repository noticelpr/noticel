      const series = Array.from({ length: cut }, (_, i) => {
        const d = earnRange === 'ano' ? new Date(y, i, 1) : new Date(from.getFullYear(), from.getMonth(), i + 1);
        const v = sum(sold.filter((r) => { const c = new Date(r.created); return earnRange === 'ano' ? c.getMonth() === i : c.getDate() === i + 1; }));
        const l = earnRange === 'ano' ? d.toLocaleDateString('es-PR', { month: 'short' }) : d.toLocaleDateString('es-PR', { day: 'numeric', month: 'short' });
        return { label: l, value: v, tip: `${l}: ${money(v)}` };
      });
