      async salud() {
        $('[data-sl-admin]').hidden = me()?.role !== 'admin';
        const box = $('[data-health]');
        box.innerHTML = kpi('Última noticia', 'Cargando…') + kpi('Copia de noticel.com', 'Cargando…');
        void saludLive();
        try {
          // NotiCel's repository is public: read GitHub directly. The site rebuilds on Cloudflare; the GitHub job here is
          // the copy from noticel.com every 15 minutes (.github/workflows/sync-noticel.yml)
          if (!REPO) throw new Error('no repo');
          const api = `https://api.github.com/repos/${REPO}`;
          const [dep, prs] = await Promise.all([
            fetch(`${api}/actions/workflows/sync-noticel.yml/runs?per_page=1`).then((r) => r.json()),
            fetch(`${api}/pulls?state=open&per_page=50`).then((r) => r.json()),
          ]);
          if ([dep, prs].some((x: any) => typeof x?.message === 'string' && /rate limit/i.test(x.message))) throw new Error('limit');
          const run = (x: any) => x?.workflow_runs?.[0];
          const d = run(dep);
          const state = (r: any) => (!r ? ['Sin datos', ''] : r.status !== 'completed' ? ['Trabajando ahora', ''] : r.conclusion === 'success' ? ['Funciona ✓', 'good'] : ['Falló ✗', 'bad']);
          const [ds, dt] = state(d);
          const openPrs = Array.isArray(prs) ? prs.length : 0;
          box.innerHTML = [
            lastStoryKpi(),
            kpi('Copia de noticel.com', ds, d ? `cada 15 minutos · última ${ago(Date.parse(d.updated_at))}` : '', '', dt),
            kpi('Esperan aprobación', String(LIVE.review.length + openPrs), 'en Noticias → Por aprobar', 'noticias'),
          ].join('');
        } catch (e) { box.innerHTML = lastStoryKpi() + ((e as Error).message === 'limit' ? kpi('Estado', 'Vuelve en un rato', 'GitHub limita cuántas veces se consulta por hora; el sitio sigue funcionando') : (REPO ? kpi('Estado', 'No se pudo consultar GitHub', 'intenta en unos minutos', '', 'bad') : kpi('Repositorio en GitHub', 'Todavía no', ''))); }
        // Kept up to date by hand (no prices or deal terms here). Updated 2026-11-15.
        const acc: Array<[string, boolean, string]> = [
          ['Repositorio propio en GitHub', !!REPO, 'el código y las noticias del sitio nuevo'], ['Sitio de prueba publicado', true, 'en Cloudflare Pages; noticel.com sigue en WordPress hasta el cambio'],
          ['Copia de noticel.com cada 15 minutos', true, 'cada noticia publicada o editada en WordPress llega aquí'],
          ['Cuentas, comentarios y este panel (Supabase)', !!BACKEND.url, 'proyecto propio de NotiCel en Supabase'], ['Entrar con Google (administradores)', false, 'con la cuenta de Google de la empresa'],
          ['Biblioteca de fotos', true, 'reemplaza PhotoShelter; los originales pasan a Cloudflare R2 después'], ['Cloudflare R2', false, 'activado; falta conectarlo para fotos y archivo'],
          ['Archivo de WordPress', false, 'unas 230,000 noticias: copia en curso'],
          ['Correos automáticos (Resend)', false, 'invitaciones del equipo, códigos de entrada y correos a anunciantes'], ['Cobros de anuncios (Stripe)', false, 'cuenta propia de NotiCel'],
          ['Google Analytics', false, 'propiedad propia de NotiCel'], ['Google Search Console', false, 'noticel.com'], ['Google Ad Manager / AdSense', false, 'anuncios de Google'],
          ['Mensaje de consentimiento (Funding Choices)', false, 'aviso de cookies y anuncios'], ['Notificaciones de la app', false, 'la app de NotiCel (iPhone y Android)'],
          ['Versión en inglés', false, 'hoy la hace TranslatePress en WordPress'], ['EFE', false, 'noticias de agencia'],
        ];
        $('[data-accounts]').innerHTML = acc.map(([n, ok, why]) => `<li class="${ok ? 'ok' : ''}"><span>${ok ? '✓' : '○'} ${n}</span><small>${why}</small></li>`).join('');
      },

      equipo() {
        const s = me()!;
        const team = get<Array<{ id?: string; name: string; mail: string; role: Staff['role']; canPhotos?: boolean }>>('nc-staff-team', [
          { name: s.name, mail: 'tú', role: 'admin' }, { name: 'Editora (ejemplo)', mail: 'editora@ejemplo.com', role: 'editor' },
          { name: 'Ventas (ejemplo)', mail: 'ventas@ejemplo.com', role: 'ads' }, { name: 'Editor (ejemplo)', mail: 'editor@ejemplo.com', role: 'desk' }, { name: 'Periodista (ejemplo)', mail: 'periodista@ejemplo.com', role: 'reporter', editor: 'Editor (ejemplo)' },
        ]);
        // With accounts: whether each person accepted the invitation and set up the second step, and the admin's tools
        const st = (id?: string) => (id ? teamStatus[id] : undefined);
        const isAdm = s.role === 'admin', isMgr = s.role === 'manager', myMail = tokenInfo().email;
        // The Editor en jefe: the newsroom team, read only (who's on it and when they last signed in; user, 2026-11-03)
