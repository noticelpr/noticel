      // Mis periodistas: who they are, what's waiting for an editor, what was sent back, what they published, their tasks
      async periodistas() {
        type M = { id?: string; name: string; mail: string; role: string; editor?: string };
        const team = get<M[]>('nc-staff-team', []);
        const mine = team.filter((m) => m.role === 'reporter'); // every editor covers every periodista (user, 2026-11-02: no assigning)
        // Their stories: from the database (an Editor only gets their periodistas' by the database's rules), else this device
        type A = { id: string; title: string; status: string; note?: string; updated: number; date?: string; ownerId?: string; owner: string };
        let arts: A[] = [];
        if (hasBackend()) { const r = await listArticles(); if (r) arts = r.map((a) => ({ id: a.id, title: a.doc?.title ?? '', status: a.status === 'scheduled' && Date.parse(a.doc?.date) <= Date.now() ? 'published' : a.status, note: a.doc?.note, updated: Date.parse(a.updated_at), date: a.doc?.date, ownerId: a.owner ?? undefined, owner: a.doc?.owner ?? '' })); }
        else arts = get<A[]>('nc-articles', []);
        const of = (m: M) => arts.filter((a) => (m.id && a.ownerId ? a.ownerId === m.id : a.owner === m.name));
        const tasks = get<Array<{ owner: string; mates: string[]; status: string; due: string; title: string }>>('nc-tasks', []);
        const td = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
        const days = (n: number) => Date.now() - n * 864e5;
        // Advertisers each one referred: an editor checks a story about one of them for a conflict of interest
        const orders = (hasBackend() ? await loadRequests() : listRequests()).filter((r) => r.status !== 'rechazada');
        const refsOf = (m: M) => (m.id ? orders.filter((r) => referrerOf(r)?.id === m.id) : []).sort((a, b) => Date.parse(b.created) - Date.parse(a.created));
        const shown = mine;
        $('[data-pr-sub]').textContent = 'Todos los periodistas: lo que tiene cada uno por aprobar, devuelto, publicado, sus tareas y los anunciantes que refirió. Apruebas y publicas en Escribir.';
        $('[data-pr-list]').innerHTML = shown.map((m) => {
          const a = of(m), rev = a.filter((x) => x.status === 'review'), back = a.filter((x) => x.status === 'draft' && x.note?.trim()), drafts = a.filter((x) => x.status === 'draft' && !x.note?.trim());
          const pub = a.filter((x) => x.status === 'published'), pub7 = pub.filter((x) => x.updated >= days(7)).length, pub30 = pub.filter((x) => x.updated >= days(30)).length;
          const sched = a.filter((x) => x.status === 'scheduled'), last = pub.sort((x, y) => y.updated - x.updated)[0];
          const tk = tasks.filter((t) => t.status !== 'done' && (t.owner === m.name || t.mates.includes(m.name))), late = tk.filter((t) => t.due && t.due < td).length;
          const refs = refsOf(m);
          const row = (x: A, chip: string, tone: string) => `<li><span><b>${esc(x.title || 'Sin título')}</b><small>${ago(x.updated)}${x.note?.trim() && x.status === 'draft' ? ` · ${esc(x.note)}` : ''}</small></span><span class="pnl-chip ${tone}">${chip}</span></li>`;
          return `<article class="pnl-card pr-card">
            <header class="pr-h"><span class="pnl-av">${esc(m.name[0]?.toUpperCase() ?? '?')}</span><span class="pr-who"><b>${esc(m.name)}</b><small>${esc(m.mail)}</small></span></header>
            <div class="pr-stats">
              <button type="button" data-go="escribir" class="${rev.length ? 'warn' : ''}"><b>${rev.length}</b><span>por aprobar</span></button>
              <div class="${back.length ? 'bad' : ''}"><b>${back.length}</b><span>devueltas</span></div>
              <div><b>${drafts.length}</b><span>borradores</span></div>
              <div><b>${pub7}</b><span>publicadas · 7 días</span></div>
              <div><b>${pub30}</b><span>publicadas · 30 días</span></div>
              <div class="${late ? 'bad' : ''}"><b>${tk.length}</b><span>tareas${late ? ` · ${late} atrasada${late > 1 ? 's' : ''}` : ''}</span></div>
            </div>
            <p class="pnl-muted pnl-small">${last ? `Última publicada ${ago(last.updated)}: «${esc(last.title)}»` : 'Todavía no ha publicado noticias.'}</p>
            ${rev.length || back.length || sched.length ? `<ul class="mynews-list">${[...rev.map((x) => row(x, 'Por aprobar', 'warn')), ...sched.map((x) => row(x, 'Programada', '')), ...back.map((x) => row(x, 'Devuelta', 'bad'))].join('')}</ul>${rev.length ? '<button type="button" class="pnl-link" data-go="escribir">Aprobar en Escribir →</button>' : ''}` : ''}
            ${refs.length ? `<p class="pr-refs"><b>Anunciantes que refirió (${refs.length}):</b> ${[...new Set(refs.map((r) => r.client.business || r.client.name))].map((b) => esc(b)).join(' · ')} <small>· ojo con un conflicto de interés si escribe sobre ellos</small></p>` : ''}
            ${tk.length ? `<details class="pr-tasks"><summary>Sus tareas (${tk.length})</summary><ul>${tk.map((t) => `<li${t.due && t.due < td ? ' class="late"' : ''}>${esc(t.title)}${t.due ? ` <small>· ${t.due < td ? 'atrasada, ' : ''}${t.due}</small>` : ''}</li>`).join('')}</ul></details>` : ''}
          </article>`;
