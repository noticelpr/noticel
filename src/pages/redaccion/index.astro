---
// Staff panel ("Panel de la redacción"): one login for everything waiting on the newsroom.
// Tabs: Inicio, Noticias (approve, quick look, every published story), Escribir, Fotos (photo library), Ventas, Comentarios,
// Anuncios, Analítica (Google Analytics through the 'analitica' Edge Function), Salud del sitio, Equipo. What each person
// sees depends on their role. Ingresos comes back when Stripe/ATH are connected.
// NotiCel version: same panel as NotiCel (synced 2026-11-15), with NotiCel's categories, story addresses, photo
// library (Fotoperiodista, "Puede subir fotos") and no automatic writer: stories come only from NotiCel's journalists.
// Login: Supabase email + password, role from the `staff` table. "Por aprobar" lists the stories reporters sent for
// review (table `articles`) and the automatic news waiting as pull requests in GitHub; Salud reads the real GitHub status.
import Base from '../../layouts/Base.astro';
import '../../styles/panel.css';
import AdQueue from '../../components/AdQueue.astro';
import CommentQueue from '../../components/CommentQueue.astro';
import SalesDesk from '../../components/panel/SalesDesk.astro';
import Writer from '../../components/panel/Writer.astro';
import Tasks from '../../components/panel/Tasks.astro';
import TimeOff from '../../components/panel/TimeOff.astro';
import Personal from '../../components/panel/Personal.astro';
import Settings from '../../components/panel/Settings.astro';
import Documents from '../../components/panel/Documents.astro';
import Memos from '../../components/panel/Memos.astro';
import Referrals from '../../components/panel/Referrals.astro';
import Columnists from '../../components/panel/Columnists.astro';
import PhotoLibrary from '../../components/panel/PhotoLibrary.astro';
import { getStories, url, CATEGORY_OPTIONS, SECTIONS, SITE, mainCategory, inCategory, topOrder, pinTop, sectionTop, followNoticel } from '../../lib/site';
import Time from '../../components/Time.astro';
import Gauge from '../../components/panel/Gauge.astro';
import { hasBackend } from '../../lib/backend';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import speed from '../../data/velocidad.json';

const stories = await getStories();
const hasBackendBuild = hasBackend(); // Supabase connected: real accounts and team
// Inicio → "Ahora en la portada": what's at the top of the home page and of each section right now (NotiCel's order:
// src/lib/site.ts topOrder + pinTop, the same the home page uses; docs/como-funciona-la-portada.md)
type Spot = { place: string; title: string; url: string; date: Date; why: string; pin: boolean };
const homeOrder = followNoticel(pinTop(topOrder(stories)), 'home');
const homeSpots: Spot[] = homeOrder.slice(0, 4).map((s, i) => ({
  place: i === 0 ? 'Noticia principal' : `Al lado, ${i}.º`, title: s.data.title, url: url(s.data.path), date: s.data.date, pin: !!s.data.pinned && i === 0,
  why: i === 0 ? (s.data.pinned ? 'Fijada 📌 por un editor' : 'Como en noticel.com (hasta el cambio): la principal de su portada') : 'Como en noticel.com (hasta el cambio)',
}));
const sectionSpots: Spot[] = SECTIONS.filter((x) => x.id !== 'opiniones').flatMap((sec) => {
  const top = followNoticel(sectionTop(topOrder(stories.filter((s) => s.data.section === sec.id))), sec.id)[0];
  return top ? [{ place: sec.name, title: top.data.title, url: url(top.data.path), date: top.data.date, pin: !!top.data.sectionPinned,
    why: top.data.sectionPinned ? 'Fijada 📌 por un editor' : 'Automática: la más importante del día' }] : [];
});
const secName = (id: string) => CATEGORY_OPTIONS.find((x) => x.id === id)?.short ?? '';
// Everything on the site, for Escribir → Publicadas, with each story's views (noticel.com's own count, from its
// database: post_views_count; the site's own counter and Google Analytics add to it later)
const published = stories.map((s) => ({ id: s.id, title: s.data.title, section: secName(mainCategory(s)), author: s.data.author, date: s.data.date.toISOString(), url: url(s.data.path), ai: s.data.aiAssisted, views: s.data.views }));
// Analítica → «Lo más leído en noticel.com»: the most-viewed stories on the site
const topViewed = [...published].filter((p) => p.views > 0).sort((a, b) => b.views - a.views).slice(0, 20);
// The story pinned (📌) in the home page's main spot, for the reminder on Inicio
const pinnedStory = stories.filter((s) => s.data.pinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const pin = pinnedStory ? { title: pinnedStory.data.title, date: pinnedStory.data.date.toISOString(), url: url(pinnedStory.data.path) } : null;
// Stories pinned at the top of each category (newest pin per category), for the same reminder
const sectionPins = CATEGORY_OPTIONS.map((sec) => {
  const p = stories.filter((s) => mainCategory(s) === sec.id && s.data.sectionPinned).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
  return p ? { section: sec.short, title: p.data.title, url: url(p.data.path) } : null;
}).filter(Boolean);
const recent = stories.filter((s) => !inCategory(s, 'opiniones')).slice(0, 12)
  .map((s) => ({ id: s.id, title: s.data.title, section: secName(mainCategory(s)), url: url(s.data.path), date: s.data.date.toISOString(), author: s.data.author }));
// Salud del sitio: stories missing something, every web photo (checked in the browser) and story files scheduled ahead
const words = (t = '') => (t.replace(/<[^>]+>/g, ' ').match(/[\p{L}\p{N}]+/gu) || []).length;
const isWeb = (x = '') => /^https?:/.test(x);
// Salud del sitio → Velocidad y SEO: Google's daily scores (scripts/fetch-speed.mjs) and SEO checks of every story
type SpeedRow = { name: string; path: string; strategy: string; scores: Record<string, number>; lcp?: string; cls?: string; tbt?: string; fix: string[] };
const sp = speed as { updated: string | null; site?: string; error?: string; results: SpeedRow[] };
const speedPages = [...new Set(sp.results.map((r) => r.name))].map((name) => ({ name, mobile: sp.results.find((r) => r.name === name && r.strategy === 'mobile'), desktop: sp.results.find((r) => r.name === name && r.strategy === 'desktop') }));
const speedFix = [...new Set(sp.results.flatMap((r) => r.fix))].slice(0, 4);
const recentSeo = stories.filter((s) => Date.now() - s.data.date.valueOf() < 30 * 864e5);
const seoChecks: Array<[string, number, string]> = [
  ['Titular muy largo para Google (más de 70 letras)', recentSeo.filter((s) => s.data.title.length > 70).length, 'Google lo corta en los resultados. Ideal: 50 a 65.'],
  ['Resumen muy corto o muy largo', recentSeo.filter((s) => s.data.description.length < 70 || s.data.description.length > 170).length, 'Es el texto que sale debajo del titular en Google. Ideal: 70 a 160 letras.'],
  ['Sin foto', recentSeo.filter((s) => !s.data.image).length, 'Sin foto, Google, Facebook y WhatsApp muestran la noticia sin imagen.'],
  ['Foto sin descripción', recentSeo.filter((s) => s.data.image && !s.data.imageCaption).length, 'La descripción ayuda a Google Imágenes y a lectores con discapacidad visual.'],
];
const sitemapCount = (() => { try { return (fs.readFileSync('dist/sitemap.xml', 'utf8').match(/<loc>/g) || []).length; } catch { return stories.length; } })();
const problems = stories.map((s) => {
  const d = s.data; const p: string[] = [];
  if (!d.image) p.push('sin foto propia');
  else if (!isWeb(d.image) && !fs.existsSync(`public/${d.image.replace(/^\//, '')}`)) p.push('la foto no existe');
  else if (!d.imageCredit && !d.imageCaption) p.push('foto sin crédito'); // WordPress captions carry the credit (e.g. "EFE/...")
  if (d.gallery.some((g) => !g.credit)) p.push('galería sin crédito');
  const w = words(s.body); if (w < 150) p.push(`solo ${w} palabras`);
  if (d.aiAssisted && !d.sources.length) p.push('sin fuentes'); // automated news must cite its official sources
  return p.length ? { id: s.id, title: d.title, date: d.date.toISOString(), p } : null;
}).filter(Boolean);
const webPhotos = stories.flatMap((s) => [s.data.image ?? '', ...s.data.gallery.map((g) => g.src)].filter(isWeb).map((src) => ({ id: s.id, title: s.data.title, src })));
const aheadFiles = (await getCollection('noticias', ({ data }) => !data.draft && data.date.valueOf() > Date.now()))
  .map((s) => ({ title: s.data.title, author: s.data.author, date: s.data.date.toISOString() }));
const TABS = [
  ['inicio', 'Inicio', '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>'],
  ['memos', 'Memos', '<path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/>'],
  ['noticias', 'Noticias', '<path d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5"/>'],
  ['escribir', 'Escribir', '<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>'],
  ['periodistas', 'Mis periodistas', '<circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0"/><path d="M16 11l2 2 4-4"/>'],
  ['fotos', 'Fotos', '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 8"/>'],
  ['comentarios', 'Comentarios', '<path d="M4 5h16v11H9l-5 4z"/>'],
  ['ventas', 'Ventas', '<path d="M3 7h18l-2 12H5z"/><path d="M8 7a4 4 0 0 1 8 0"/>'],
  ['anuncios', 'Anuncios', '<path d="M3 11v2l13 5V6L3 11z"/><path d="M16 9a3 3 0 0 1 0 6"/>'],
  ['analitica', 'Analítica', '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'],
  ['salud', 'Salud del sitio', '<path d="M3 12h4l2-5 4 10 2-5h6"/>'],
  ['columnistas', 'Columnistas', '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/><path d="M17 3l3 3-5 5"/>'],
  ['referidos', 'Mis referidos', '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>'],
  ['equipo', 'Equipo', '<circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4a3.5 3.5 0 0 1 0 7M22 20a7 7 0 0 0-4-6.3"/>'],
  ['personal', 'Personal', '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8 15h3"/>'],
  ['ajustes', 'Ajustes', '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>'],
];
---
<Base title="Panel de la redacción" description="Panel interno de NotiCel (uso del personal)." noindex staff>
  <main class="wrap pnl" id="main" data-pnl data-secs={JSON.stringify(Object.fromEntries(CATEGORY_OPTIONS.map((x) => [x.id, x.short])))} data-pin={JSON.stringify(pin)} data-section-pins={JSON.stringify(sectionPins)} data-recent={JSON.stringify(recent)} data-published={JSON.stringify(published.map(({ id, title, section, author, date, url, views }) => ({ id, title, section, author, date, url, views })))} data-problems={JSON.stringify(problems)} data-photos={JSON.stringify(webPhotos)} data-ahead={JSON.stringify(aheadFiles)} data-base={url()}>
    <form class="pnl-login" data-login hidden>
      <p class="pnl-kicker">NotiCel</p>
      <h1>Panel de la redacción</h1>
      <p class="pnl-muted">Todo lo que te espera en un solo lugar: noticias por aprobar, comentarios, anuncios, ingresos y analítica.</p>
      {/* With the database: email and password; the role comes from the staff list. Preview: name and role. */}
      <div class="pnl-real" data-real hidden>
        <label for="pnl-mail">Correo</label>
        <input id="pnl-mail" type="email" autocomplete="username" />
        <label for="pnl-pass">Contraseña</label>
        <input id="pnl-pass" type="password" autocomplete="current-password" />
      </div>
      <div class="pnl-prev" data-prevlogin>
      <label for="pnl-name">Tu nombre</label>
      <input id="pnl-name" maxlength="30" autocomplete="name" placeholder="ej. Alfredo" />
      <label for="pnl-role">Rol</label>
      <select id="pnl-role">
        <option value="admin">Administrador: todo</option>
        <option value="editor">Editor en jefe: noticias, comentarios y analítica</option>
        <option value="desk">Editor: aprueba y publica las noticias de los periodistas</option>
        <option value="ads">Ventas: clientes, anuncios e ingresos</option>
        <option value="reporter">Periodista: escribir sus noticias</option>
        <option value="photo">Fotoperiodista: subir y organizar fotos</option>
      </select>
      </div>
      <p class="cm-err" data-err hidden></p>
      <button type="submit" class="adp-btn">Entrar</button>
      <button type="button" class="pnl-link pnl-forgot" data-forgot hidden>¿Olvidaste tu contraseña?</button>
      <p class="pnl-note" data-prevlogin><span class="sp-demo">VISTA PREVIA</span> Sin contraseña por ahora. Con las cuentas, cada persona entra con su correo y su contraseña, y su rol lo asigna el administrador.</p>
    </form>

    {/* Second step: a 6-digit code sent by email to each new sign-in (Edge Function "codigo") */}
    <form class="pnl-login pnl-mfa" data-mfa hidden novalidate>
      <p class="pnl-kicker">Verificación en dos pasos</p>
      <h1>Revisa tu correo</h1>
      <p class="pnl-muted" data-mfa-ask>Te enviamos un código de 6 números. Escríbelo aquí para entrar al panel.</p>
      <label for="pnl-code">Código</label>
      <input id="pnl-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" placeholder="123456" />
      <label class="adb-check pnl-remember"><input type="checkbox" data-mfa-remember /> Recordar este dispositivo por 30 días <small>(solo en tu computadora o celular personal)</small></label>
      <p class="cm-err" data-mfa-err hidden></p>
      <button type="submit" class="adp-btn">Verificar</button>
      <p class="pnl-muted pnl-small">¿No te llegó? Revisa la carpeta de spam o promociones. El código vence en 10 minutos.</p>
      <button type="button" class="pnl-link" data-mfa-again>Reenviar código</button>
      <button type="button" class="pnl-link" data-mfa-out>Salir</button>
    </form>
    {/* Create a password (invitation) or choose a new one (forgotten password link) */}
    <form class="pnl-login" data-setpw hidden novalidate>
      <p class="pnl-kicker">NotiCel</p>
      <h1 data-setpw-h>Crea tu contraseña</h1>
      <p class="pnl-muted" data-setpw-p>Bienvenido al equipo. Escoge la contraseña con la que vas a entrar al panel.</p>
      <label for="pnl-np1">Contraseña nueva</label>
      <input id="pnl-np1" type="password" autocomplete="new-password" minlength="8" />
      <label for="pnl-np2">Repítela</label>
      <input id="pnl-np2" type="password" autocomplete="new-password" minlength="8" />
      <p class="pnl-muted pnl-small">Al menos 8 caracteres, con letras y números.</p>
      <p class="cm-err" data-setpw-err hidden></p>
      <button type="submit" class="adp-btn">Guardar contraseña</button>
    </form>

    <div class="pnl-app" data-pnl-app hidden>
      <aside class="pnl-side">
        <div class="pnl-me"><span class="pnl-av" data-av></span><span><b data-me></b><small data-role></small><small class="pnl-mail" data-me-mail></small></span></div>
        <nav class="pnl-nav" aria-label="Secciones del panel">
          {TABS.map(([id, name, d]) => (
            <button type="button" data-tab={id} aria-current="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={d} /></svg>
              <span>{name}</span><b class="pnl-n" data-count={id}></b>
            </button>
          ))}
        </nav>
        <button type="button" class="pnl-out" data-myprof-open hidden>Mi perfil público</button>
        <button type="button" class="pnl-out" data-myacct-open hidden>Mi cuenta</button>
        <button type="button" class="pnl-out" data-logout>Salir</button>
      </aside>
      {/* Mi perfil público: what readers see on the author page (/author/…) when they tap the name on a story */}
      <dialog class="sd-dlg pnl-acct" data-myprof aria-labelledby="pnl-prof-h">
        <form method="dialog" class="sd-form" data-myprof-form novalidate>
          <header class="sd-dlg-h"><h2 id="pnl-prof-h">Mi perfil público</h2><button type="button" class="sd-x" data-myprof-close aria-label="Cerrar">✕</button></header>
          <p class="pnl-muted pnl-small">Es lo que ven los lectores cuando tocan tu nombre en una noticia: tu foto, tu cargo, una biografía corta y todas tus noticias, de la más reciente a la más vieja. Los cambios salen en el sitio en unos minutos.</p>
          <div class="pnl-prof-pic"><img data-pp-img alt="" hidden /><span class="col-ini" data-pp-ini></span>
            <label class="adp-btn ghost-dark">Subir foto<input type="file" accept="image/jpeg,image/png,image/webp" data-pp-file hidden /></label></div>
          <label>Nombre <small>(como sale en tus noticias)</small><input data-pp-name disabled /></label>
          <label>Cargo<input data-pp-role maxlength="60" placeholder="Ej.: Periodista de Deportes" /></label>
          <label>Biografía corta<textarea data-pp-bio rows="4" maxlength="400" placeholder="Quién eres, qué cubres y desde cuándo. 2 o 3 oraciones."></textarea></label>
          <p class="cm-err" data-pp-err hidden></p>
          <footer class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-myprof-close>Cerrar</button><button type="submit" class="adp-btn">Guardar perfil</button></footer>
        </form>
      </dialog>
      {/* Mi cuenta: change your password; your second step's status */}
      <dialog class="sd-dlg pnl-acct" data-myacct aria-labelledby="pnl-acct-h">
        <form method="dialog" class="sd-form" data-myacct-form novalidate>
          <header class="sd-dlg-h"><h2 id="pnl-acct-h">Mi cuenta</h2><button type="button" class="sd-x" data-myacct-close aria-label="Cerrar">✕</button></header>
          <p class="pnl-muted" data-myacct-mail></p>
          <p class="pnl-acct-ok">✓ Verificación en dos pasos activa (código por correo en cada entrada)</p>
          <p class="pnl-muted pnl-small">Los dispositivos que recordaste entran sin código por 30 días. Si perdiste uno, o usaste una computadora prestada: <button type="button" class="pnl-link" data-forget-devices>Olvidar mis dispositivos</button></p>
          <fieldset><legend>Cambiar contraseña</legend>
            <label>Contraseña actual<input type="password" data-cp-old autocomplete="current-password" /></label>
            <label>Contraseña nueva<input type="password" data-cp-new autocomplete="new-password" minlength="8" /></label>
            <label>Repítela<input type="password" data-cp-new2 autocomplete="new-password" minlength="8" /></label>
          </fieldset>
          <p class="cm-err" data-cp-err hidden></p>
          <footer class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-myacct-close>Cerrar</button><button type="submit" class="adp-btn">Cambiar contraseña</button></footer>
        </form>
      </dialog>
      {/* Inicio → «Noticias publicadas hoy»: opens on today; pick another day, or filter by section, author or words */}
      <dialog class="sd-dlg pnl-today" data-today-dlg aria-labelledby="pnl-today-h">
        <header class="sd-dlg-h"><h2 id="pnl-today-h">Noticias publicadas <small class="pnl-muted" data-today-n></small></h2><button type="button" class="sd-x" data-today-x aria-label="Cerrar">✕</button></header>
        <div class="pnl-today-f">
          <div class="pnl-today-day">
            <button type="button" class="adp-btn ghost-dark" data-today-step="-1" aria-label="Día anterior">‹</button>
            <input type="date" data-today-date aria-label="Fecha" />
            <button type="button" class="adp-btn ghost-dark" data-today-step="1" aria-label="Día siguiente">›</button>
            <button type="button" class="adp-btn ghost-dark" data-today-now>Hoy</button>
            <button type="button" class="adp-btn ghost-dark" data-today-all>Todas las fechas</button>
          </div>
          <div class="pnl-today-sel">
            <select data-today-sec aria-label="Sección"><option value="">Todas las secciones</option></select>
            <select data-today-au aria-label="Autor"><option value="">Todos los autores</option></select>
            <input type="search" data-today-q placeholder="Buscar en el título" aria-label="Buscar en el título" />
          </div>
        </div>
        <p class="pnl-muted pnl-today-sum" data-today-sum></p>
        <ul class="pnl-today-list" data-today-list></ul>
      </dialog>

      <div class="pnl-main">

        <!-- Inicio -->
        <section class="pnl-pane" data-pane="inicio">
          <h1 class="pnl-h">Buenos días, <span data-me></span></h1>
          <p class="pnl-muted" data-today></p>
          <div class="pnl-kpis" data-kpis></div>
          <h2 class="pnl-h2" data-todo-h>Lo que te espera</h2>
          <ul class="pnl-todo" data-todo></ul>
          {/* Periodistas: where each of their stories stands (filled by paintMyNews) */}
          <div class="pnl-card mynews" data-mynews hidden>
            <div class="mynews-h"><h2 class="pnl-h3">Mis noticias</h2><button type="button" class="pnl-link" data-go="escribir">Ir a Escribir</button></div>
            <ul class="mynews-list" data-mynews-list></ul>
          </div>
          {/* For the administrator and editors only (not Ventas or periodistas) */}
          <details class="pnl-card nowp" data-nowp open>
            <summary class="nowp-sum"><h2 class="pnl-h3">Ahora en la portada</h2></summary>
            <p class="pnl-muted pnl-small">Lo que la gente ve arriba ahora. Para cambiarlo: abre la noticia en Escribir → «Lugar en la Portada».</p>
            <ul class="nowp-list">
