    async function paintMyNews(name: string) {
      type Mine = { id: string; title: string; status: string; note?: string; updated: number; slug?: string | null; doc?: any };
      let rows: Mine[];
      if (hasBackend()) {
        const r = await listArticles(); if (!r) return;
        rows = r.map((a) => ({ id: a.id, title: a.doc?.title ?? '', status: a.status === 'scheduled' && Date.parse(a.doc?.date) <= Date.now() ? 'published' : a.status, note: a.doc?.note, updated: Date.parse(a.updated_at), owner: a.doc?.owner, slug: a.slug, doc: a.doc })).filter((a) => a.owner === name);
      } else rows = get<Array<Mine & { owner: string }>>('nc-articles', []).filter((a) => a.owner === name);
      const CHIP: Record<string, [string, string]> = { review: ['En revisión', 'warn'], scheduled: ['Programada', ''], published: ['Publicada', 'ok'], draft: ['Borrador', ''] };
      const list = rows.sort((a, b) => b.updated - a.updated).slice(0, 6);
      myNews = list;
      // How many people read each published story (last 28 days, Google Analytics; a periodista only gets their own)
      const reads: Record<string, number> = {};
      if (hasBackend() && list.some((a) => a.status === 'published')) {
        const d = await getAnalytics(28, 1000).catch(() => null);
        if (d && !('error' in d)) d.pages.forEach((p) => { const m = p.path.match(/^\/noticia\/([^/?#]+)/); if (m) reads[m[1]] = (reads[m[1]] ?? 0) + Number(p.views || 0); });
      }
      // Each one opens (user, 2026-11-03): a published story on the site, the others in the preview; published ones copy their link (Compartir)
      $('[data-mynews-list]').innerHTML = list.map((a, i) => {
        const back = a.status === 'draft' && !!a.note?.trim();
        const [label, tone] = back ? ['Devuelta con cambios', 'bad'] : CHIP[a.status] ?? [a.status, ''];
        const live = a.status === 'published';
        const ed = (a.doc?.edits ?? []).find((x: { by: string }) => x.by !== name) as { by: string; what: string[] } | undefined; // the latest change by someone else
        const nRead = live ? reads[a.slug || a.id] : undefined;
        return `<li><button type="button" class="mynews-open" data-mn-open="${i}" title="${live ? 'Ver en el sitio' : 'Vista previa'}"><b>${esc(a.title || 'Sin título')}</b><small>${live && hasBackend() ? `👁 ${nRead ? `${nRead.toLocaleString('es-PR')} ${nRead === 1 ? 'lectura' : 'lecturas'}` : 'sin lecturas todavía'} (28 días) · ` : ''}${ago(a.updated)}${back ? ` · ${esc(a.note!)}` : ''} · ${live ? 'Ver en el sitio ↗' : 'Vista previa ↗'}</small>${ed ? `<small class="mynews-ed">✏️ Editada por ${esc(ed.by)}: cambió ${esc(ed.what.join(', '))}</small>` : ''}</button><span class="mynews-acts"><span class="pnl-chip ${tone}">${label}</span>${live ? `<button type="button" class="pnl-link" data-mn-share="${i}">Compartir</button>` : ''}</span></li>`;
