        const a = myNews[Number(sh.dataset.mnShare)]; if (!a) return;
        const link = storyUrl(a);
        // Copies the link (user, 2026-11-03), on computers and phones alike; the button itself says so (no message)
        try { await navigator.clipboard.writeText(link); } catch { prompt('Copia este enlace:', link); return; }
        sh.classList.remove('copied'); void sh.offsetWidth; sh.classList.add('copied'); sh.textContent = '✓ Copiado';
        clearTimeout((sh as any).tm); (sh as any).tm = setTimeout(() => { sh.classList.remove('copied'); sh.textContent = 'Compartir'; }, 1800);
