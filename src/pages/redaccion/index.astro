      const name = me()?.name ?? '';
      if (ppVal('bio').length < 20) { err.textContent = 'Escribe una biografía corta (al menos una oración).'; err.hidden = false; return; }
      const res = await saveColumnist({ slug: profRow?.slug ?? slugOf(name), name, role: ppVal('role') || 'Periodista', bio: ppVal('bio'), photo: profPhoto || null, active: profRow?.active ?? true, sort: profRow?.sort ?? 50,
        kind: profRow?.kind ?? 'periodista', owner: profRow?.owner ?? tokenInfo().id });
      if (res) { err.textContent = /administrador o editor|error 400/.test(res) ? 'Falta un paso en la base de datos (supabase/perfiles.sql). Avísale al administrador.' : res; err.hidden = false; return; }
      prof.close(); toast('Perfil guardado. Sale en el sitio en unos minutos.');
    });

    let pinging = false;
    function start() {
      if (isDemo() && !me()) { set('nc-staff', { name: 'Invitado', role: 'admin' }); dispatchEvent(new Event('nc-staff-change')); } // demo: straight in, as the administrator
      // Real accounts: a session without the second step goes to the code screen first (the database requires it too)
      if (hasBackend() && !isDemo() && me() && staffToken() && !codeOk() && !verifiedOff) { void gate(); return; }
      if (hasBackend() && !isDemo() && me() && !staffToken()) set('nc-staff', null);
      // Signed in on the site with a team account (lib/account.ts alsoPanel): the panel session is there, so straight
      // to the emailed code (or in, if already verified) instead of the sign-in form
      if (hasBackend() && !isDemo() && !me() && staffToken()) { set('nc-staff', { name: '', role: 'reporter' }); void gate(); return; }
      const s = me();
      screen(s ? 'app' : 'login');
      $('[data-myacct-open]').hidden = !hasBackend() || isDemo();
      $('[data-myprof-open]').hidden = !hasBackend() || isDemo() || me()?.role === 'ads'; // the public profile is for bylines (author pages): not for Ventas
      if (!s) return;
      // The saved name and role are only a shortcut: check them against the database (a role change, or another person on this browser)
      if (hasBackend() && !isDemo()) void staffProfile().then((who) => { if (who && (who.role !== s.role || who.name !== s.name) && me()) { set('nc-staff', who); start(); } });
      ensureTeam();
      $$('[data-me]').forEach((e) => (e.textContent = s.name));
      $('[data-av]').textContent = s.name[0].toUpperCase();
      $('[data-role]').textContent = ROLE_NAME[s.role];
      $('[data-me-mail]').textContent = hasBackend() && !isDemo() ? tokenInfo().email : ''; // which account this browser is signed in with
      paintCounts(); showTab(location.hash.slice(1) || 'inicio');
      // Activity: one check-in a minute while the panel is open and in front (admin sees it in Equipo)
      if (hasBackend() && !isDemo() && !pinging) { pinging = true; const ping = () => { if (document.visibilityState === 'visible' && me()) void staffApi('rpc/staff_ping', { method: 'POST', body: '{}' }); }; ping(); setInterval(ping, 60000); }
      void loadLive(true); // what's really waiting (stories in review, automatic news, reported comments)
      if (hasBackend()) void loadRequests().then(() => { paintCounts(); if ((location.hash.slice(1) || 'inicio') === 'inicio') showTab('inicio'); }); // real ad requests for the counts and Inicio
    }
    // Real login (once BACKEND is set in src/lib/backend.ts): Supabase email + password, role from the `staff` table
    if (hasBackend()) { $('[data-real]').hidden = false; $('[data-forgot]').hidden = false; $$('[data-prevlogin]').forEach((e) => (e.hidden = true)); }
    $<HTMLFormElement>('[data-login]').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (hasBackend()) {
        const er = $('[data-err]'); er.hidden = true;
        const ok = await staffLogin($<HTMLInputElement>('#pnl-mail').value.trim(), $<HTMLInputElement>('#pnl-pass').value);
        const team = ok && (await onTeam());
        if (!team) { if (ok) staffLogout(); er.textContent = ok ? 'Tu cuenta no está en el equipo. Pídele al administrador que te invite.' : 'Correo o contraseña incorrectos.'; er.hidden = false; return; }
        void signInQuiet($<HTMLInputElement>('#pnl-mail').value.trim(), $<HTMLInputElement>('#pnl-pass').value); // also signed in on the site (comments, team badge)
        set('nc-staff', { name: '', role: 'reporter' }); start(); return; // start() asks for the code by email first; finish() then loads the real name and role
      }
      const name = $<HTMLInputElement>('#pnl-name').value.trim();
      if (name.length < 2) { const er = $('[data-err]'); er.textContent = 'Escribe tu nombre.'; er.hidden = false; return; }
      set('nc-staff', { name, role: $<HTMLSelectElement>('#pnl-role').value });
      start();
    });
    // Phone copies of Mi perfil público / Mi cuenta / Salir: they press the real buttons and show only when those would
    {
      const box = $('[data-mob-acct]');
      const sync = () => box.querySelectorAll<HTMLElement>('[data-mob]').forEach((b) => (b.hidden = $(`[${b.dataset.mob}]`).hidden));
      box.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mob]'); if (b) $(`[${b.dataset.mob}]`).click(); });
      new MutationObserver(sync).observe($('.pnl-side'), { subtree: true, attributes: true, attributeFilter: ['hidden'] }); sync();
    }
    $('[data-logout]').addEventListener('click', () => { staffLogout(); teamStatus = {}; set('nc-staff', null); set('nc-staff-pending', null); dispatchEvent(new Event('nc-staff-change')); start(); });
    // The comment and ad queues change counts when used
    root.addEventListener('click', () => setTimeout(paintCounts, 50));
    // An invitation or "forgot password" link opened the panel: create the password (and the second step) first
    void (hasBackend() && !isDemo() ? sessionFromLink() : Promise.resolve('')).then((link) => {
      if (link === 'invite') askPassword('invite');
      else if (link === 'recovery') askPassword('recovery');
      else {
        start();
        if (link === 'expired') void ask('Este enlace ya se usó o venció. Pide que te envíen otro desde Equipo, o entra con tu correo y contraseña.', { ok: 'Entendido', only: true });
      }
    });
  </script>
</Base>
