    }
    let earnSrc: 'todo' | 'linea' | 'directa' | 'vendedores' | 'periodistas' | 'google' = 'todo';
    /** Where an order's money comes from, by who sold it (user, 2026-11-02): the administrator or a Gerente
     *  ("Ventas directas"), a salesperson ("Vendedores"), a periodista's referral ("Periodistas"), or nobody: it came
     *  in on its own on Anúnciate ("linea"). */
    function sourceOf(r: AdRequest): 'linea' | 'directa' | 'vendedores' | 'periodistas' {
      const s = sellerOf(r)?.role;
      if (s === 'ads') return 'vendedores';
      if (isReferrer(s)) return 'periodistas'; // periodistas and editors who referred it
      if (s === 'admin' || s === 'manager') return 'directa';
