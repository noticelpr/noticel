        waiting.length ? `<button type="button" class="pnl-link" data-go="anuncios">${waiting.length} esperando aprobación (${money(sum(waiting))})</button>` : ''].filter(Boolean).join(' · ');
      // Sold per day of the month, or per month of the year (every one shows, even with no sales)
