      void paintRpm(all, demo);
      const now = new Date(), y = now.getFullYear(), m = now.getMonth();
      const [from, to] = earnRange === 'mes' ? [new Date(y, m, 1), new Date(y, m + 1, 1)] : earnRange === 'pasado' ? [new Date(y, m - 1, 1), new Date(y, m, 1)] : [new Date(y, 0, 1), new Date(y + 1, 0, 1)];
      const period = earnRange === 'ano' ? `en ${y}` : `en ${from.toLocaleDateString('es-PR', { month: 'long' })}`;
