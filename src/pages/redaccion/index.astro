    }
    /** Ingreso por cada 1,000 lecturas, last 30 days: approved ad sales (by order date) ÷ story reads (our counter).
     *  Compare it month to month: if it goes up, the ads earn more per reader, whatever the traffic did. */
    async function paintRpm(all: AdRequest[], demo: boolean) {
      const since = Date.now() - 30 * 864e5;
      const income = all.filter((r) => r.status === 'aprobada' && Date.parse(r.created) >= since).reduce((a, r) => a + Number(r.total || 0), 0);
