        const inMonth = Math.max((Date.now() - new Date(new Date().getFullYear(), new Date().getMonth(), 1).valueOf()) / 864e5, 0.25);
        const days = i < 12 ? (inMonth * i) / 12 : inMonth + ((i * 7.3) % 300), direct = i % 3 === 0, paid = i % 5 !== 1;
        return { id: `NC-EJ${i}`, created: new Date(Date.now() - days * 864e5).toISOString(), status: i % 9 === 4 ? 'revisar' : 'aprobada', paid,
          client: { name: '', business: `${biz[i % biz.length]} (ejemplo)`, email: '', phone: '', who: 'retail' }, formats: fm[i % fm.length], where: '', start: '', duration: '',
          total: [48, 89, 149, 210, 99, 350, 175][i % 7], lines: direct ? ['Venta directa', `Pago: ${paid ? pays[i % 4] : 'Pendiente'}`] : paid ? [`Pago: ${pays[i % 2]} · ejemplo`] : [], art: { mode: 'upload', files: [] }, link: '' } as AdRequest;
