      $('[data-next]').textContent = next ? t(`Te faltan ${money(next.at - biz.spentAll)} para ganarte ${next.gift.toLowerCase()}.`, `You’re ${money(next.at - biz.spentAll)} away from earning ${next.gift}.`) : t('¡Ganaste todos los premios!', 'You’ve earned every reward!');
