    }

    function renderAll() {
      const h = new Date().getHours();
      $('[data-greet]').textContent = `${h < 12 ? t('¡Buenos días', 'Good morning') : h < 19 ? t('¡Buenas tardes', 'Good afternoon') : t('¡Buenas noches', 'Good evening')}! 👋`;
      $('[data-av]').textContent = biz.initials; $('[data-av]').style.background = biz.color;
      $('[data-role]').textContent = w(biz.role);
      renderHome(); renderTodo(); renderCamps(); renderPay();
      const note = $('[data-mail-note]'); if (!note.hidden) note.hidden = true; // its text was in the other language
    }

    // Business switcher (agencies, and people with more than one business)
