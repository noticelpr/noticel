            const prog = c?.views ? `<div class="lc-prog"><p><span>${num(s.views)} ${t('de', 'of')} ${num(c.views)} ${t('vistas', 'views')}</span><b>${Math.min(100, Math.round((s.views / c.views) * 100))}%</b></p><i><em style="width:${Math.min(100, (s.views / c.views) * 100)}%"></em></i></div>` : '';
            const fmts = lang === 'en' ? FMTS_EN : FMTS;
            return `<article class="apr-card"><header><b>${esc((x.formats || []).map((f: string) => fmts[f] ?? FMTS[f] ?? f).join(', ') || t('Anuncio', 'Ad'))}</b><span class="apn-st ${cls}">${st}</span></header>
              <p class="apr-meta">${esc(when)} · ${t('Solicitud', 'Request')} ${esc(x.id)}</p>
              ${where ? `<p class="apr-where"><b>${t('Dónde sale:', 'Where it runs:')}</b> ${esc(where)}</p>` : ''}
              ${arts ? `<div class="apr-arts">${arts}</div>` : ''}
              ${c ? `<p class="apr-nums"><span><b>${num(s.views)}</b> ${t('veces que se vio', 'views')}</span><span><b>${num(s.clicks)}</b> ${t('toques', 'taps')}</span><span><b>${pct}%</b> ${t('de toques', 'of taps')}</span></p>${prog}` : ''}
            </article>`;
          });
          const k = q('[data-real-kpis]'); k.hidden = false;
          k.innerHTML = [[t('En el aire', 'Live'), num(live)], [t('Veces que se vio', 'Views'), num(views)], [t('Toques', 'Taps'), num(clicks)], [t('% de toques', '% of taps'), views ? `${((clicks / views) * 100).toFixed(1)}%` : '—']]
            .map(([l, v]) => `<div class="pnl-kpi"><span>${l}</span><b>${v}</b></div>`).join('');
          q('[data-real-list]').innerHTML = cards.join('');
        }
        repaintReal = () => void paintReal();
        void paintReal();
        addEventListener('nc-profile-change', () => void paintReal());
        addEventListener('storage', () => void paintReal());
      }
    }
    const page = document.querySelector<HTMLElement>('[data-apn]')!;
    const $ = (s: string) => page.querySelector<HTMLElement>(s)!;
    const n = (v: number) => Math.round(v).toLocaleString(loc());
    const money = (v: number) => `$${v.toLocaleString('en-US', { maximumFractionDigits: v < 10 ? 2 : 0, minimumFractionDigits: v < 10 ? 2 : 0 })}`;
    const SITE_CTR = 0.9; // site-wide average % of taps (demo)

    // ---- Two demo business accounts: a local business (owner) and an agency client (editor) ----
    // Campaign and invoice dates are ISO so they show in either language
    type Camp = { name: string; fmt: string; from: string; to: string; daysLeft: number; imp: number; clk: number; budget: number; used: number; st: 'Activa' | 'En revisión' | 'Pausada' | 'Terminó'; bg: string; line: string };
    type Biz = { name: string; initials: string; role: string; base: number; spentAll: number; inv: Array<[string, number, string]>; team: Array<[string, string]>; camps: Camp[]; top: string; color: string; regions: Array<[string, number]> };
    const BIZ: Record<string, Biz> = {
      panaderia: { name: 'Panadería La Esquina', initials: 'PE', role: 'Eres dueño de esta cuenta · Negocio local', base: 420, spentAll: 171, color: '#B45309', top: 'Metro',
        regions: [['Metro', 0.34], ['Norte', 0.16], ['Este', 0.13], ['Centro', 0.12], ['Sur', 0.11], ['Oeste', 0.09], ['Diáspora', 0.05]],
        inv: [['2026-10', 58, 'Pagada'], ['2026-09', 64, 'Pagada'], ['2026-08', 49, 'Pagada']],
        team: [['Tú', 'Dueño'], ['Carmen (gerente)', 'Puede editar'], ['Contable', 'Solo puede ver']],
        camps: [
          { name: 'Pan sobao de otoño', fmt: 'Rectángulo · Toda la isla', from: '2026-09-15', to: '2026-10-15', daysLeft: 13, imp: 9210, clk: 116, budget: 49, used: 28, st: 'Activa', bg: 'linear-gradient(135deg,#B45309,#F59E0B)', line: 'Pan sobao calientito' },
          { name: 'Quesitos 2×1', fmt: 'Valla digital · Metro', from: '2026-09-20', to: '2026-10-20', daysLeft: 18, imp: 12480, clk: 141, budget: 29, used: 12, st: 'Activa', bg: 'linear-gradient(135deg,#D7263D,#F28C28)', line: 'Quesitos 2×1 hoy' },
          { name: 'Café y desayuno', fmt: 'Entre noticias', from: '2026-11-01', to: '2026-11-30', daysLeft: 0, imp: 0, clk: 0, budget: 49, used: 0, st: 'En revisión', bg: 'linear-gradient(135deg,#5B3A1E,#A16207)', line: 'Desayuno criollo $5.99' },
          { name: 'Gran apertura Caguas', fmt: 'Rectángulo · Centro', from: '2026-08-10', to: '2026-08-31', daysLeft: 0, imp: 9840, clk: 157, budget: 25, used: 25, st: 'Terminó', bg: 'linear-gradient(135deg,#000000,#009DE9)', line: '¡Abrimos en Caguas!' },
        ] },
      ferreteria: { name: 'Ferretería Díaz', initials: 'FD', role: 'Puedes editar · Cuenta manejada por tu agencia', base: 900, spentAll: 1430, color: '#0E7490', top: 'Oeste',
        regions: [['Oeste', 0.52], ['Sur', 0.48]],
        inv: [['2026-10', 320, 'Pendiente'], ['2026-09', 345, 'Pagada'], ['2026-08', 305, 'Pagada']],
        team: [['Agencia Creativa PR', 'Administra'], ['Sr. Díaz', 'Dueño'], ['Tú', 'Puede editar']],
        camps: [
          { name: 'Temporada de huracanes', fmt: 'Media página · Oeste y Sur', from: '2026-09-01', to: '2026-11-30', daysLeft: 59, imp: 41200, clk: 455, budget: 297, used: 105, st: 'Activa', bg: 'linear-gradient(135deg,#0E7490,#22D3EE)', line: 'Generadores y plantas' },
          { name: 'Toma de portada: Black Friday', fmt: 'Toma de portada · 1 día', from: '2026-11-28', to: '2026-11-28', daysLeft: 0, imp: 0, clk: 0, budget: 99, used: 0, st: 'Pausada', bg: 'linear-gradient(135deg,#111827,#4B5563)', line: 'Black Friday −40%' },
        ] },
    };
    let biz = BIZ.panaderia;

    // Made-up but steady numbers (same every visit)
    const today = new Date(); today.setHours(12, 0, 0, 0);
    const series = (b: Biz) => {
      let seed = b.base; const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
      return Array.from({ length: 180 }, (_, i) => {
        const d = new Date(today.valueOf() - (179 - i) * 864e5); const wk = d.getDay() === 0 || d.getDay() === 6 ? 1.25 : 1;
        const imp = Math.round((b.base + i * 2.4 + rnd() * b.base * 0.35) * wk); return { d, imp, clk: Math.round(imp * (0.009 + rnd() * 0.007)) };
      });
    };
    let daily = series(biz);
    const SEC: Array<[string, number]> = [['Portada', 0.31], ['Deportes', 0.22], ['Puerto Rico', 0.17], ['Juegos NotiCel', 0.14], ['Clima', 0.09], ['Entretenimiento', 0.07]];

    const toast = (msg: string) => { const el = $('[data-toast]'); el.textContent = msg; el.hidden = false; clearTimeout((el as any).tm); (el as any).tm = setTimeout(() => (el.hidden = true), 3500); };
    const bars = (sel: string, rows: Array<[string, number]>, total: number) => {
      const max = Math.max(...rows.map((r) => r[1]));
      $(sel).innerHTML = rows.map(([name, s]) => `<li><span class="apn-b-name">${w(name)}</span><span class="apn-b-track"><i style="width:${(s / max) * 100}%"></i></span><b>${n(total * s)}</b></li>`).join('');
    };
    const fmtD = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString(loc(), o);
    const short = (iso: string) => fmtD(new Date(`${iso}T12:00:00`), { day: 'numeric', month: 'short' });
    const month = (ym: string) => { const d = new Date(`${ym}-15T12:00:00`), m = fmtD(d, { month: 'long' }); return `${m[0].toUpperCase()}${m.slice(1)} ${d.getFullYear()}`; };
    const act = (es: string, en: string) => `data-demo-act="${es}" data-demo-act-en="${en}"`;

    let range = 7;
    function renderHome() {
      const cur = daily.slice(-range), prev = daily.slice(-range * 2, -range);
      const sum = (a: typeof daily, k: 'imp' | 'clk') => a.reduce((s, x) => s + x[k], 0);
      const imp = sum(cur, 'imp'), clk = sum(cur, 'clk'), pClk = sum(prev, 'clk');
      const reach = Math.round(imp / (1.6 + range / 60)); // people see an ad a few times
      const ctr = (clk / imp) * 100;
      const spend = (biz.spentAll / 90) * range;
      const best = cur.reduce((a, b) => (b.imp > a.imp ? b : a));
      const when = range === 7 ? t('Esta semana', 'This week') : range === 30 ? t('En los últimos 30 días', 'In the last 30 days') : t('En los últimos 3 meses', 'In the last 3 months');
      const trend = pClk ? Math.round(((clk - pClk) / pClk) * 100) : 0;
      const good = ctr >= SITE_CTR;
      $('[data-story]').innerHTML = `<span class="apn-mood" aria-hidden="true">${good ? '😄' : '🙂'}</span><p>` + t(
        `<b>${when}, ${n(reach)} personas vieron tu anuncio y ${n(clk)} lo tocaron</b> para ir a tu negocio. ${good ? `Eso es <b>mejor que el promedio</b> del sitio (${SITE_CTR}%).` : `Eso está cerca del promedio del sitio (${SITE_CTR}%).`} ${trend >= 0 ? `Tuviste ${trend}% más toques que en el período anterior.` : `Tuviste ${Math.abs(trend)}% menos toques que en el período anterior.`}`,
        `<b>${when}, ${n(reach)} people saw your ad and ${n(clk)} tapped it</b> to visit your business. ${good ? `That’s <b>better than the site average</b> (${SITE_CTR}%).` : `That’s close to the site average (${SITE_CTR}%).`} ${trend >= 0 ? `You got ${trend}% more taps than in the previous period.` : `You got ${Math.abs(trend)}% fewer taps than in the previous period.`}`) + '</p>';
      const tile = (icon: string, k: string, v: string, hint: string) => `<div><span class="apn-k-h"><i aria-hidden="true">${icon}</i>${k}</span><b>${v}</b><small>${hint}</small></div>`;
      $('[data-kpis]').innerHTML = [
        tile('👀', t('Personas alcanzadas', 'People reached'), n(reach), t(`vieron tu anuncio ${n(imp)} veces`, `saw your ad ${n(imp)} times`)),
        tile('👆', t('Toques', 'Taps'), n(clk), t(`${ctr.toFixed(2)}% de las veces`, `${ctr.toFixed(2)}% of the time`)),
        tile('💵', t('Invertido', 'Invested'), money(Math.round(spend)), t('en este período', 'in this period')),
        tile('🎯', t('Costo por toque', 'Cost per tap'), money(spend / clk), t('por cada cliente que llegó', 'for each customer who came')),
      ].join('');
      // Line chart with hover/touch readout
      const box = $('[data-chart]');
      const W = Math.max(600, Math.min(1100, box.clientWidth || 720)), H = 230, L = 64, R = 14, T = 14, B = 30;
      const max = Math.ceil(Math.max(...cur.map((x) => x.imp)) / 200) * 200;
      const x = (i: number) => L + (i * (W - L - R)) / Math.max(1, cur.length - 1);
      const y = (v: number) => T + (H - T - B) * (1 - v / max);
      const grid = [0, 0.5, 1].map((f) => `<line x1="${L}" x2="${W - R}" y1="${y(max * f)}" y2="${y(max * f)}" class="apn-grid-l"/><text x="${L - 8}" y="${y(max * f) + 4}" class="apn-ax" text-anchor="end">${n(max * f)}</text>`).join('');
      const step = Math.ceil(cur.length / 6);
      const xl = cur.map((p, i) => (i % step === 0 ? `<text x="${x(i)}" y="${H - 8}" class="apn-ax" text-anchor="middle">${range === 7 ? fmtD(p.d, { weekday: 'short' }) : fmtD(p.d, { day: 'numeric', month: 'short' })}</text>` : '')).join('');
      const pts = cur.map((p, i) => `${x(i)},${y(p.imp)}`).join(' ');
      box.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${t('Veces que se vio tu anuncio por día', 'Times your ad was seen, per day')}">${grid}${xl}<polygon points="${L},${y(0)} ${pts} ${x(cur.length - 1)},${y(0)}" class="apn-area"/><polyline points="${pts}" class="apn-line"/><line class="apn-cur" data-cur y1="${T}" y2="${y(0)}" hidden/><circle r="5" class="apn-dot" data-dot hidden/><rect x="${L}" y="0" width="${W - L - R}" height="${H}" fill="transparent" data-hit/></svg>`;
      const svg = box.querySelector('svg')!;
      const read = (i: number) => {
        const p = cur[i];
        $('[data-read]').innerHTML = `<b>${fmtD(p.d, { weekday: 'long', day: 'numeric', month: 'long' })}:</b> ` + t(`se vio ${n(p.imp)} veces · ${n(p.clk)} toques`, `seen ${n(p.imp)} times · ${n(p.clk)} taps`);
        const c = svg.querySelector('[data-cur]')!, dot = svg.querySelector('[data-dot]')!;
        c.removeAttribute('hidden'); dot.removeAttribute('hidden');
        c.setAttribute('x1', String(x(i))); c.setAttribute('x2', String(x(i))); dot.setAttribute('cx', String(x(i))); dot.setAttribute('cy', String(y(p.imp)));
      };
      svg.querySelector('[data-hit]')!.addEventListener('pointermove', (e) => {
        const r = svg.getBoundingClientRect(); const vx = ((e as PointerEvent).clientX - r.left) * (W / r.width);
        read(Math.max(0, Math.min(cur.length - 1, Math.round(((vx - L) / (W - L - R)) * (cur.length - 1)))));
      });
      read(cur.length - 1);
      bars('[data-regions]', biz.regions, imp);
      bars('[data-sections]', SEC, imp);
      // Tips in plain words, from the numbers
      $('[data-tips]').innerHTML = [
        t(`Tu mejor día fue el <b>${fmtD(best.d, { weekday: 'long' })}</b>. Ese día es buen momento para una oferta.`, `Your best day was <b>${fmtD(best.d, { weekday: 'long' })}</b>. That’s a good day for an offer.`),
        t(`La región que más te vio fue <b>${biz.top}</b>. Si casi todos tus clientes son de ahí, anunciarte solo en esa región te sale más barato.`, `The region that saw you most was <b>${w(biz.top)}</b>. If most of your customers are from there, advertising only in that region costs less.`),
        t('Los anuncios con <b>precio o descuento</b> en el arte reciben más toques. Sube una segunda versión para que roten.', 'Ads with a <b>price or discount</b> in the artwork get more taps. Upload a second version so they rotate.'),
      ].map((s) => `<li>${s}</li>`).join('');
    }

    function renderTodo() {
      const items: string[] = [];
      biz.camps.forEach((c) => {
        if (c.st === 'Activa' && c.daysLeft <= 14) items.push(`<li class="warn"><span>⏳ ${t(`<b>${c.name}</b> termina en ${c.daysLeft} días.`, `<b>${c.name}</b> ends in ${c.daysLeft} days.`)}</span><button type="button" ${act(`Extender ${c.name}`, `Extend ${c.name}`)}>${t('Extender', 'Extend')}</button></li>`);
        if (c.st === 'En revisión') items.push(`<li><span>🕑 ${t(`El arte de <b>${c.name}</b> está en revisión. Te avisamos al aprobarlo (casi siempre en 1 día).`, `The artwork for <b>${c.name}</b> is in review. We’ll let you know when it’s approved (almost always within 1 day).`)}</span></li>`);
        if (c.st === 'Pausada') items.push(`<li><span>⏸️ ${t(`<b>${c.name}</b> está en pausa.`, `<b>${c.name}</b> is paused.`)}</span><button type="button" ${act(`Reanudar ${c.name}`, `Resume ${c.name}`)}>${t('Reanudar', 'Resume')}</button></li>`);
      });
      biz.inv.filter((i) => i[2] === 'Pendiente').forEach((i) => items.push(`<li class="warn"><span>💳 ${t(`Factura de ${month(i[0])} pendiente`, `Invoice for ${month(i[0])} pending`)}: <b>${money(i[1])}</b>.</span><button type="button" ${act('Pagar factura', 'Pay invoice')}>${t('Pagar', 'Pay')}</button></li>`));
      if (!items.length) items.push(`<li><span>✅ ${t('Todo al día. ¡Nada pendiente!', 'All caught up. Nothing to do!')}</span></li>`);
      $('[data-todo]').innerHTML = items.join('');
    }

    function renderCamps() {
      const groups: Array<[string, Camp[]]> = [[t('Activas', 'Active'), biz.camps.filter((c) => c.st === 'Activa')], [t('Próximas y en pausa', 'Upcoming and paused'), biz.camps.filter((c) => c.st === 'En revisión' || c.st === 'Pausada')], [t('Anteriores', 'Past'), biz.camps.filter((c) => c.st === 'Terminó')]];
      const ACTS: Record<string, string> = { Pausar: 'Pause', Extender: 'Extend', 'Cambiar arte': 'Change artwork', Reanudar: 'Resume', 'Cambiar fechas': 'Change dates', 'Repetir esta campaña': 'Repeat this campaign' };
      $('[data-camps]').innerHTML = groups.filter(([, l]) => l.length).map(([g, l]) => `<h3 class="apn-group">${g}</h3>` + l.map((c) => {
        const ctr = c.imp ? ((c.clk / c.imp) * 100).toFixed(2) + '%' : '—';
        const pct = Math.round((c.used / c.budget) * 100);
        const acts = c.st === 'Activa' ? ['Pausar', 'Extender', 'Cambiar arte'] : c.st === 'Pausada' ? ['Reanudar', 'Cambiar fechas'] : c.st === 'En revisión' ? ['Cambiar arte'] : ['Repetir esta campaña'];
        return `<article class="apn-camp">
          <div class="apn-prev" style="background:${c.bg}"><b>${c.line}</b><span>${biz.name}</span></div>
          <div class="apn-camp-body">
            <div class="apn-camp-top"><h4>${c.name}</h4><span class="apn-st ${c.st === 'Activa' ? 'on' : c.st === 'Terminó' ? '' : 'wait'}">${w(c.st)}</span></div>
            <p class="apn-small">${w(c.fmt)} · ${short(c.from)} – ${short(c.to)}${c.st === 'Activa' ? t(` · quedan ${c.daysLeft} días`, ` · ${c.daysLeft} days left`) : ''}</p>
            <dl class="apn-camp-k"><div><dt>${t('Se vio', 'Views')}</dt><dd>${c.imp ? n(c.imp) : '—'}</dd></div><div><dt>${t('Toques', 'Taps')}</dt><dd>${c.clk ? n(c.clk) : '—'}</dd></div><div><dt>${t('% toques', '% taps')}</dt><dd>${ctr}</dd></div></dl>
            <div class="apn-budget"><span>${t(`Presupuesto usado: ${money(c.used)} de ${money(c.budget)}`, `Budget used: ${money(c.used)} of ${money(c.budget)}`)}</span><span class="cx-bar"><span style="width:${pct}%"></span></span></div>
            <div class="apn-camp-acts">${acts.map((a) => `<button type="button" ${act(`${a}: ${c.name}`, `${ACTS[a]}: ${c.name}`)}>${t(a, ACTS[a])}</button>`).join('')}</div>
          </div></article>`;
      }).join('')).join('');
    }

    function renderPay() {
      const rewardsEn: Record<number, string> = JSON.parse(page.dataset.rewardsEn || '{}');
      const rewards: Array<{ at: number; gift: string }> = (JSON.parse(page.dataset.rewards!) as Array<{ at: number; gift: string }>).map((r) => ({ at: r.at, gift: lang === 'en' ? rewardsEn[r.at] ?? r.gift : r.gift }));
