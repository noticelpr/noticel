---
// DEMO: advertiser panel with made-up numbers, to show clients what they'll get.
// Built for small-business owners first (plain words, "how is my ad doing?" up top, quick actions), with what agencies
// need too (switch between client businesses, team roles). Accounts: one NotiCel login for everyone; a person
// can also belong to one or more business accounts (owner / can edit / can only view), like Facebook + Meta Business.
// The real version needs accounts and ad statistics from outside services (see src/lib/ads.ts) and should replace
// this page's data, not its look. Settings and demo actions are saved only on this device.
// English: ?lang=en, or the saved choice ('nc-ad-lang'), or automatically when the client ordered from /en/advertise/.
// Static text carries its English in data-en (inner HTML), data-en-href and data-en-label; the script uses t(es, en).
import Base from '../../layouts/Base.astro';
import { SITE, url } from '../../lib/site';
import { REWARDS, FORMATS, FORMATS_EN, REWARDS_EN } from '../../lib/ads';
const GLOSSARY = [
  ['Veces que se vio', 'Cada vez que tu anuncio apareció en la pantalla de alguien (en inglés, “impresiones”).', 'Views', 'Each time your ad appeared on someone’s screen (also called “impressions”).'],
  ['Personas alcanzadas', 'Cuántas personas distintas vieron tu anuncio. Una misma persona puede verlo varias veces.', 'People reached', 'How many different people saw your ad. The same person may see it several times.'],
  ['Toques', 'Las veces que alguien tocó o hizo clic en tu anuncio para ir a tu página, WhatsApp o tienda.', 'Taps', 'The times someone tapped or clicked your ad to go to your page, WhatsApp or store.'],
  ['% de toques', 'De cada 100 veces que se vio tu anuncio, cuántas veces lo tocaron. En sitios de noticias, más de 0.5% es bueno.', '% of taps', 'Out of every 100 times your ad was seen, how many times it was tapped. On news sites, more than 0.5% is good.'],
  ['Costo por toque', 'Lo que pagaste dividido entre los toques que recibiste.', 'Cost per tap', 'What you paid divided by the taps you got.'],
  ['Valla digital', 'Tu anuncio rota con otros cada 8 segundos en el mismo espacio, como una valla en la carretera.', 'Digital billboard', 'Your ad rotates with others every 8 seconds in the same space, like a billboard on the highway.'],
];
const order = url('publicidad'), orderEn = url('en/advertise');
const help = (subject: string) => (SITE.email ? `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}` : '');
---
<Base title="Panel de anunciante" noindex description="Ejemplo del panel de anunciante de NotiCel: cómo le va a tu anuncio, tus campañas, facturas, premios e informes por correo.">
  <main class="wrap apn" id="main" data-apn data-rewards={JSON.stringify(REWARDS)} data-rewards-en={JSON.stringify(REWARDS_EN)}
    data-fmts={JSON.stringify(Object.fromEntries(FORMATS.map((f) => [f.id, f.name])))} data-fmts-en={JSON.stringify(Object.fromEntries(Object.entries(FORMATS_EN).map(([k, f]) => [k, f.name])))}>
    <p class="apn-lang" data-langsw><button type="button" data-setlang="en" lang="en" aria-pressed="false">English</button><span aria-hidden="true">/</span><button type="button" data-setlang="es" lang="es" aria-pressed="true">Español</button></p>
    {/* Real panel: the signed-in client's own requests and campaigns (supabase/anunciante-panel.sql). The sample
        panel below shows in demo mode, or with ?ejemplo=1 ("Ver un ejemplo"). */}
    <section class="apr" data-real hidden>
      <header class="apr-h">
        <div><h1 data-en="Your advertiser panel">Tu panel de anunciante</h1><p class="apr-sub" data-real-sub data-en="How your ads are doing on NotiCel.">Cómo le va a tus anuncios en NotiCel.</p></div>
        <a class="adp-btn red" href={`${order}#campana`} data-en-href={`${orderEn}#campana`} data-en="+ New campaign">+ Nueva campaña</a>
      </header>
      <div class="apr-out" data-real-out hidden>
        <p data-en="Sign in with the <b>same email</b> you used to order your ad and you’ll see your campaigns here, how many times your ad was seen and how many people tapped it.">Entra con el <b>mismo correo</b> que usaste al pedir tu anuncio y aquí verás tus campañas, cuántas veces se vio tu anuncio y cuántas personas lo tocaron.</p>
        <div class="apr-acts"><button type="button" class="adp-btn red" data-real-login data-en="Sign in">Entrar</button><a class="adp-btn ghost-dark" href="?ejemplo=1" data-en="See an example">Ver un ejemplo</a></div>
      </div>
      <p class="apr-empty" data-real-empty hidden></p>
      <div class="pnl-kpis apr-kpis" data-real-kpis hidden></div>
      <div class="apr-list" data-real-list></div>
      <p class="apr-help" data-en={`Questions, or want to change something? Write to us from <a href="${orderEn}#contacto">I’d rather talk to someone</a>.`}>¿Preguntas o quieres cambiar algo? Escríbenos desde <a href={`${order}#contacto`}>Prefiero hablar con alguien</a>.</p>
    </section>
    <p class="pf-demo"><span class="sp-demo">DEMO</span> <span data-en="EXAMPLE panel with made-up data. This is how our advertisers will see their numbers.">Panel de ejemplo con datos ficticios. Así verán sus estadísticas nuestros anunciantes.</span></p>

    <header class="apn-hero">
      <span class="apn-av" data-av aria-hidden="true">PE</span>
      <div class="apn-hello">
        <p class="apn-greet" data-greet>¡Hola!</p>
        <label class="apn-switch">
          <span class="sr" data-en="Business account">Cuenta de negocio</span>
          <select data-biz>
            <option value="panaderia">Panadería La Esquina</option>
            <option value="ferreteria" data-en="Ferretería Díaz (agency client)">Ferretería Díaz (cliente de agencia)</option>
          </select>
        </label>
        <p class="apn-sub" data-role>Eres dueño de esta cuenta · Negocio local</p>
      </div>
      <div class="apn-actions">
        <a class="adp-btn red" href={`${order}#campana`} data-en-href={`${orderEn}#campana`} data-en="+ New campaign">+ Nueva campaña</a>
        <a class="adp-btn ghost-dark" href={url('perfil')} data-en="My reader profile">Mi perfil de lector</a>
      </div>
    </header>

    <nav class="apn-tabs" role="tablist" aria-label="Secciones del panel" data-en-label="Panel sections">
      <button type="button" role="tab" aria-selected="true" data-tab="inicio" data-en="Home">Inicio</button>
      <button type="button" role="tab" aria-selected="false" data-tab="campanas" data-en="My ads">Mis anuncios</button>
      <button type="button" role="tab" aria-selected="false" data-tab="pagos" data-en="Payments and rewards">Pagos y premios</button>
      <button type="button" role="tab" aria-selected="false" data-tab="ayuda" data-en="Help and settings">Ayuda y ajustes</button>
    </nav>

    <!-- ===== Inicio ===== -->
    <section data-panel="inicio">
      <div class="apn-range-row">
        <h2 class="apn-h" data-en="How is your advertising doing?">¿Cómo le va a tu publicidad?</h2>
        <div class="cx-tabs apn-range" role="tablist" aria-label="Período" data-en-label="Period">
          <button type="button" role="tab" aria-selected="true" data-range="7" data-en="This week">Esta semana</button>
          <button type="button" role="tab" aria-selected="false" data-range="30" data-en="30 days">30 días</button>
          <button type="button" role="tab" aria-selected="false" data-range="90" data-en="3 months">3 meses</button>
        </div>
      </div>
      <div class="apn-story" data-story aria-live="polite"></div>
      <section class="apn-kpis" data-kpis></section>

      <div class="apn-grid">
        <section class="apn-card apn-wide">
          <h3 data-en="Views per day">Veces que se vio, por día</h3>
          <div class="apn-chart" data-chart></div>
          <p class="apn-read" data-read></p>
        </section>
        <section class="apn-card">
          <h3 data-en="To do">Pendientes</h3>
          <ul class="apn-todo" data-todo></ul>
        </section>
        <section class="apn-card">
          <h3 data-en="💡 Tips for you">💡 Consejos para ti</h3>
          <ul class="apn-tips" data-tips></ul>
        </section>
        <section class="apn-card"><h3 data-en="Where did they see you?">¿Dónde te vieron?</h3><ul class="apn-bars" data-regions></ul></section>
        <section class="apn-card"><h3 data-en="Where on the site?">¿En qué parte del sitio?</h3><ul class="apn-bars" data-sections></ul></section>
      </div>
    </section>

    <!-- ===== Mis anuncios ===== -->
    <section data-panel="campanas" hidden>
      <h2 class="apn-h" data-en="My ads">Mis anuncios</h2>
      <div class="apn-camps" data-camps></div>
    </section>

    <!-- ===== Pagos y premios ===== -->
    <section data-panel="pagos" hidden>
      <h2 class="apn-h" data-en="Payments and rewards">Pagos y premios</h2>
      <div class="apn-grid">
        <section class="apn-card">
          <h3 data-en="🎁 Rewards">🎁 Premios</h3>
          <p class="apn-spent"><span data-en="You’ve invested">Has invertido</span> <b data-spent></b></p>
          <div class="cx-bar apn-prog"><span data-prog></span></div>
          <p class="apn-small" data-next></p>
          <ul class="apn-gifts" data-gifts></ul>
        </section>
        <section class="apn-card">
          <h3 data-en="Invoices">Facturas</h3>
          <ul class="apn-inv" data-invoices></ul>
          <p class="apn-small" data-en="Payment method: card ending in •••• (set up with your representative).">Forma de pago: tarjeta terminada en •••• (se configura con tu representante).</p>
        </section>
      </div>
    </section>

    <!-- ===== Ayuda y ajustes ===== -->
    <section data-panel="ayuda" hidden>
      <h2 class="apn-h" data-en="Help and settings">Ayuda y ajustes</h2>
      <div class="apn-grid">
        <section class="apn-card">
          <h3 data-en="📧 Email report">📧 Informe por correo</h3>
          <p class="apn-small" data-en="We send you your numbers automatically, in plain words.">Te enviamos tus números automáticamente, en palabras sencillas.</p>
          <form class="apn-mail" data-mail>
            <label><span data-en="How often?">¿Cada cuánto?</span>
              <select name="freq"><option value="weekly" data-en="Every Monday">Cada lunes</option><option value="monthly" data-en="On the 1st of every month">El día 1 de cada mes</option><option value="off" data-en="Don’t send">No enviar</option></select>
            </label>
            <label><span data-en="To which email?">¿A qué correo?</span><input name="to" type="email" value="ventas@panaderialaesquina.com" /></label>
            <label class="adb-check"><input type="checkbox" name="alerts" checked /> <span data-en="Let me know when a campaign is about to end">Avísame cuando una campaña esté por terminar</span></label>
            <button type="submit" class="adp-btn" data-en="Save">Guardar</button>
            <p class="adp-note" data-mail-note hidden></p>
          </form>
        </section>
        <section class="apn-card">
          <h3 data-en="👥 Your team">👥 Tu equipo</h3>
          <p class="apn-small" data-en="Who can sign in to this business account with their own login.">Quién puede entrar a esta cuenta de negocio con su propio usuario.</p>
          <ul class="apn-team" data-team></ul>
          <button type="button" class="adp-btn ghost-dark" data-demo-act="Invitar a alguien" data-demo-act-en="Invite someone" data-en="+ Invite someone">+ Invitar a alguien</button>
        </section>
        <section class="apn-card apn-wide">
          <h3 data-en="What does each number mean?">¿Qué significa cada número?</h3>
          <div class="apn-gloss">
            {GLOSSARY.map(([t, d, te, de]) => <details><summary data-en={te}>{t}</summary><p data-en={de}>{d}</p></details>)}
          </div>
        </section>
        <section class="apn-card apn-wide apn-help">
          <div><h3 data-en="Need help?">¿Necesitas ayuda?</h3><p class="apn-small" data-en="Your representative can help with the artwork, the dates or any question.">Tu representante te ayuda con el arte, las fechas o cualquier duda.</p></div>
          <a class="adp-btn red" href={help('Ayuda con mi panel de anunciante') || `${order}#contacto`} data-en-href={help('Help with my advertiser panel') || `${orderEn}#contacto`} data-en="Write to us">Escríbenos</a>
        </section>
      </div>
    </section>

    <div class="apn-toast" data-toast role="status" hidden></div>
  </main>
  <style>
    .apn-lang{display:flex;justify-content:flex-end;align-items:center;gap:6px;margin:0 0 8px;font-size:13px;color:var(--muted)}
    .apn-lang button{background:none;border:0;padding:4px 2px;font:inherit;color:inherit;cursor:pointer}
    .apn-lang button[aria-pressed="true"]{font-weight:700;color:var(--text,inherit);text-decoration:underline;text-underline-offset:3px}
  </style>
  <script>
    import { hasBackend, BACKEND, freshToken } from '../../lib/backend';
    import { loggedIn, askLogin, token } from '../../lib/account';
    import { isDemo } from '../../lib/demo';
    // ---- Language: ?lang=en, else the saved choice, else English if the client ordered in English (see paintReal) ----
    const LS = 'nc-ad-lang';
    const pick = (v: string | null) => (v === 'en' || v === 'es' ? v : null);
    const asked = pick(new URLSearchParams(location.search).get('lang')) ?? pick((() => { try { return localStorage.getItem(LS); } catch { return null; } })());
    let lang: 'es' | 'en' = asked ?? 'es';
    const t = (es: string, en: string) => (lang === 'en' ? en : es);
    const loc = () => t('es-PR', 'en-US');
    // A few fixed words from the sample data (statuses, roles, regions, sections, formats)
    const WORDS: Record<string, string> = {
      Activa: 'Active', 'En revisión': 'In review', Pausada: 'Paused', Terminó: 'Ended', Pagada: 'Paid', Pendiente: 'Pending',
      Tú: 'You', 'Carmen (gerente)': 'Carmen (manager)', Contable: 'Accountant', 'Sr. Díaz': 'Mr. Díaz',
      Dueño: 'Owner', 'Puede editar': 'Can edit', 'Solo puede ver': 'Can only view', Administra: 'Manages',
      'Eres dueño de esta cuenta · Negocio local': 'You own this account · Local business', 'Puedes editar · Cuenta manejada por tu agencia': 'You can edit · Account managed by your agency',
      Norte: 'North', Este: 'East', Centro: 'Central', Sur: 'South', Oeste: 'West', Diáspora: 'Diaspora',
      Portada: 'Home page', Deportes: 'Sports', Clima: 'Weather', Entretenimiento: 'Entertainment',
      'Rectángulo · Toda la isla': 'Rectangle · Whole island', 'Valla digital · Metro': 'Digital billboard · Metro', 'Entre noticias': 'Between stories',
      'Rectángulo · Centro': 'Rectangle · Central', 'Media página · Oeste y Sur': 'Half page · West and South', 'Toma de portada · 1 día': 'Home page takeover · 1 day',
    };
    const w = (s: string) => (lang === 'en' ? WORDS[s] ?? s : s);
    // Static text: swap each [data-en] element's inner HTML (the Spanish is kept in data-es), links and labels
    function applyLang() {
      document.documentElement.lang = lang;
      document.title = document.title.replace(lang === 'en' ? 'Panel de anunciante' : 'Advertiser panel', t('Panel de anunciante', 'Advertiser panel'));
      document.querySelectorAll<HTMLElement>('[data-en]').forEach((el) => { el.dataset.es ??= el.innerHTML; el.innerHTML = lang === 'en' ? el.dataset.en! : el.dataset.es; });
      document.querySelectorAll<HTMLElement>('[data-en-href]').forEach((el) => { el.dataset.esHref ??= el.getAttribute('href')!; el.setAttribute('href', lang === 'en' ? el.dataset.enHref! : el.dataset.esHref); });
      document.querySelectorAll<HTMLElement>('[data-en-label]').forEach((el) => { el.dataset.esLabel ??= el.getAttribute('aria-label')!; el.setAttribute('aria-label', lang === 'en' ? el.dataset.enLabel! : el.dataset.esLabel); });
      document.querySelectorAll<HTMLElement>('[data-setlang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setlang === lang)));
    }
    let repaintReal = () => {};
    if (lang === 'en') applyLang();
    document.querySelectorAll<HTMLElement>('[data-setlang]').forEach((b) => b.addEventListener('click', () => {
      lang = b.dataset.setlang as 'es' | 'en';
      try { localStorage.setItem(LS, lang); } catch { /* storage blocked */ }
      const u = new URL(location.href); if (u.searchParams.has('lang')) { u.searchParams.delete('lang'); history.replaceState(null, '', u); } // a reload keeps the choice
      applyLang(); renderAll(); repaintReal();
    }));
    // ---- Real advertiser panel ----
    {
      const main = document.querySelector<HTMLElement>('[data-apn]')!;
      const real = main.querySelector<HTMLElement>('[data-real]')!;
      const sample = new URLSearchParams(location.search).has('ejemplo');
      if (hasBackend() && !isDemo() && !sample) {
        // Hide the sample panel; show the client's own
        [...main.children].forEach((el) => { if (el !== real && !(el as HTMLElement).matches('[data-toast], [data-langsw], script, style')) (el as HTMLElement).style.display = 'none'; }); // their own styles would override `hidden`
        real.hidden = false;
        const q = (s: string) => real.querySelector<HTMLElement>(s)!;
        const FMTS: Record<string, string> = JSON.parse(main.dataset.fmts || '{}'), FMTS_EN: Record<string, string> = JSON.parse(main.dataset.fmtsEn || '{}');
        const num = (v: number) => Math.round(v).toLocaleString(loc());
        const day = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString(loc(), { day: 'numeric', month: 'short', year: 'numeric' });
        const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
        // Through noticel.com/sb/… first (Cloudflare relay, cloudflare/password-gate.js): ad blockers like Brave Shields
        // block the database's own address; straight to the database when the relay isn't there
        const rest = async (path: string, tk: string) => {
          const init = { headers: { apikey: BACKEND.anonKey, Authorization: `Bearer ${tk}` } };
          if (location.hostname.endsWith('noticel.com')) {
            const r = await fetch(`${location.origin}/sb/rest/v1/${path}`, init).catch(() => null);
            if (r && r.status !== 404 && r.status !== 405 && (r.headers.get('content-type') || '').includes('json')) return r;
          }
          return fetch(`${BACKEND.url.replace(/\/$/, '')}/rest/v1/${path}`, init);
        };
        q('[data-real-login]').addEventListener('click', () => askLogin(t('Entra con el correo que usaste al pedir tu anuncio.', 'Sign in with the email you used to order your ad.')));
        async function paintReal() {
          // The reader account and the staff panel's login are separate (and may use different emails): look up each
          // one's own requests with its own login, then put them together
          const email = (k: string) => { try { return (JSON.parse(localStorage.getItem(k) || 'null')?.user?.email as string) || ''; } catch { return ''; } };
          const logins = [
            { t: loggedIn() ? await token() : undefined, who: email('nc-session') },
            { t: await freshToken(), who: email('nc-staff-session') },
          ].filter((l) => l.t && l.who).filter((l, i, all) => all.findIndex((x) => x.who.toLowerCase() === l.who.toLowerCase()) === i);
          const tk = logins[0]?.t;
          const who = logins.map((l) => l.who).join(t(' y ', ' and '));
          q('[data-real-out]').hidden = !!tk;
          if (!tk) { q('[data-real-kpis]').hidden = true; q('[data-real-list]').innerHTML = ''; q('[data-real-empty]').hidden = true; return; }
          const lists = await Promise.all(logins.map(async (l) => {
            const r = await rest(`ad_requests?select=id,created_at,status,client,formats,start,duration,views,total&order=created_at.desc&client->>email=ilike.${encodeURIComponent(l.who)}`, l.t!).catch(() => null);
            return r?.ok ? ((await r.json()) as any[]) : [];
          }));
          const reqs: any[] = lists.flat().filter((x, i, all) => all.findIndex((y) => y.id === x.id) === i).sort((a, b) => b.created_at.localeCompare(a.created_at));
          // Ordered from /en/advertise/ and no choice made: English
          if (!asked && lang === 'es' && reqs.some((x) => x.client?.lang === 'en')) { lang = 'en'; applyLang(); renderAll(); }
          const email0 = reqs[0]?.client?.email ?? '';
          if (!reqs.length) {
            q('[data-real-kpis]').hidden = true; q('[data-real-list]').innerHTML = '';
            const e = q('[data-real-empty]'); e.hidden = false;
            e.innerHTML = t(`Entraste como <b>${esc(who)}</b> y no hay anuncios pedidos con ${logins.length > 1 ? 'esos correos' : 'ese correo'}. Si pediste tu anuncio con otro correo, sal y entra con ese. <a href="?ejemplo=1">Ver un ejemplo</a>`,
              `You’re signed in as <b>${esc(who)}</b> and there are no ads ordered with ${logins.length > 1 ? 'those emails' : 'that email'}. If you ordered your ad with a different email, sign out and sign in with that one. <a href="?ejemplo=1">See an example</a>`);
            return;
          }
          q('[data-real-empty]').hidden = true;
          q('[data-real-sub]').textContent = `${reqs[0].client?.business ?? ''} · ${email0}`;
          const ids = reqs.map((x) => x.id.toLowerCase());
          const inList = `in.(${ids.map((i) => `"${i}"`).join(',')})`;
          const [cr, sr] = await Promise.all([rest(`ad_campaigns?select=id,start_date,end_date,status,views,sizes,takeover,creatives&id=${inList}`, tk), rest(`ad_stats?select=campaign_id,views,clicks&campaign_id=${inList}`, tk)]).catch(() => [null, null]);
          const camps: Record<string, any> = Object.fromEntries((cr?.ok ? await cr.json() : []).map((c: any) => [c.id, c]));
          const stats: Record<string, any> = Object.fromEntries((sr?.ok ? await sr.json() : []).map((s: any) => [s.campaign_id, s]));
          const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
          let live = 0, views = 0, clicks = 0;
          const cards = reqs.map((x) => {
            const c = camps[x.id.toLowerCase()], s = stats[x.id.toLowerCase()] ?? { views: 0, clicks: 0 };
            let st = t('En revisión', 'In review'), cls = 'wait', when = t(`Pedido el ${day(x.created_at.slice(0, 10))}`, `Ordered ${day(x.created_at.slice(0, 10))}`);
            if (x.status === 'cambios') { st = t('Te pedimos cambios', 'We asked for changes'); cls = 'warn'; }
            else if (x.status === 'rechazada') { st = t('No aprobado', 'Not approved'); cls = 'off'; }
            else if (x.status === 'disenar') { st = t('Lo estamos diseñando', 'We’re designing it'); }
            else if (c) {
              views += s.views; clicks += s.clicks;
              const done = c.status === 'ended' || c.end_date < today || (c.views != null && s.views >= c.views);
              if (done) { st = t('Terminado', 'Ended'); cls = 'off'; when = `${day(c.start_date)} – ${day(c.end_date)}`; }
              else if (c.status === 'paused') { st = t('En pausa', 'Paused'); cls = 'warn'; }
              else if (c.start_date > today) { st = t(`Empieza el ${day(c.start_date)}`, `Starts ${day(c.start_date)}`); when = t(`Hasta el ${day(c.end_date)}`, `Until ${day(c.end_date)}`); }
              else { st = t('En el aire', 'Live'); cls = 'on'; live++; when = c.views ? t(`Hasta cumplir ${num(c.views)} vistas`, `Until it reaches ${num(c.views)} views`) : t(`Hasta el ${day(c.end_date)}`, `Until ${day(c.end_date)}`); }
            }
            const pct = s.views ? ((s.clicks / s.views) * 100).toFixed(1) : '0.0';
            // Which spaces it fills, and the ad itself in each size
            const SPACE: Record<string, string> = lang === 'en'
              ? { leaderboard: 'Top and bottom banner', rectangle: 'Rectangle', infeed: 'Between stories', halfpage: 'Half page (computers)' }
              : { leaderboard: 'Banner de arriba y de abajo', rectangle: 'Rectángulo', infeed: 'Entre noticias', halfpage: 'Media página (computadora)' };
            const where = c ? (c.takeover ? t('Todos los espacios del sitio, solo tu marca', 'Every ad space on the site, only your brand') : (c.sizes || []).map((z: string) => SPACE[z] ?? z).join(' · ')) : '';
