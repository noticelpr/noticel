---
// 2048: slide the tiles (arrow keys or swipe). Two equal tiles merge into their sum; reach 2048 to win.
// Best score and the game in progress are kept only on this device.
import Base from '../../layouts/Base.astro';
import GameLayout from '../../components/GameLayout.astro';
---
<Base title="2048" description="Desliza las fichas y une los números iguales hasta llegar a 2048.">
  <main class="wrap" id="main">
    <GameLayout id="2048">
      <div class="jg-game g48" data-g48>
        <div class="g48-top">
          <div class="g48-score"><small>Puntos</small><b data-score>0</b></div>
          <div class="g48-score"><small>Mejor</small><b data-best>0</b></div>
          <button type="button" class="jg-btn" data-new>Juego nuevo</button>
        </div>
        <div class="g48-board" data-board aria-label="Tablero 4 por 4" tabindex="0"></div>
        <p class="jg-msg" aria-live="polite" data-msg></p>
        <div class="g48-pad" aria-label="Mover">
          <button type="button" data-dir="up" aria-label="Arriba">▲</button>
          <button type="button" data-dir="left" aria-label="Izquierda">◀</button>
          <button type="button" data-dir="down" aria-label="Abajo">▼</button>
          <button type="button" data-dir="right" aria-label="Derecha">▶</button>
        </div>
        <p class="jg-help">Usa las flechas del teclado, desliza el dedo sobre el tablero o toca los botones. Une fichas iguales para sumarlas.</p>
      </div>
    </GameLayout>
  </main>
  <script>
    import { award } from '../../lib/points';
    type Dir = 'up' | 'down' | 'left' | 'right';
    const box = document.querySelector<HTMLElement>('[data-g48]')!;
    const boardEl = box.querySelector<HTMLElement>('[data-board]')!;
    const $ = (s: string) => box.querySelector<HTMLElement>(s)!;
    const get = <T,>(k: string, d: T): T => { try { return JSON.parse(localStorage.getItem(k) || '') ?? d; } catch { return d; } };
    const set = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* storage blocked */ } };
    let grid: number[][] = [], score = 0, best = get<number>('nc-2048-best', 0), won = false, over = false;
    const cells: HTMLElement[] = [];
    for (let i = 0; i < 16; i++) { const c = document.createElement('span'); c.className = 'g48-cell'; boardEl.append(c); cells.push(c); }

    function addTile() {
      const empty: Array<[number, number]> = [];
      grid.forEach((row, r) => row.forEach((v, c) => { if (!v) empty.push([r, c]); }));
      if (!empty.length) return null;
      const [r, c] = empty[Math.floor(Math.random() * empty.length)];
      grid[r][c] = Math.random() < 0.9 ? 2 : 4;
      return r * 4 + c;
    }
    function start() {
      grid = [...Array(4)].map(() => [0, 0, 0, 0]); score = 0; won = false; over = false;
      addTile(); addTile(); $('[data-msg]').textContent = ''; save(); paint();
    }
    function save() { set('nc-2048-game', { grid, score, won }); }
    function paint(newAt: number | null = null, merged: number[] = []) {
      grid.flat().forEach((v, i) => {
        const c = cells[i];
        c.textContent = v ? String(v) : '';
        c.className = `g48-cell${v ? ` t${Math.min(v, 4096)}` : ''}${i === newAt ? ' new' : ''}${merged.includes(i) ? ' pop' : ''}`;
      });
      $('[data-score]').textContent = String(score); $('[data-best]').textContent = String(best);
    }
    // Slide one row to the left; returns the new row, points earned and which positions merged
    function slide(row: number[]) {
      const vals = row.filter(Boolean); const out: number[] = []; const merged: number[] = []; let pts = 0;
      for (let i = 0; i < vals.length; i++) {
        if (vals[i] === vals[i + 1]) { out.push(vals[i] * 2); pts += vals[i] * 2; merged.push(out.length - 1); i++; }
        else out.push(vals[i]);
      }
      while (out.length < 4) out.push(0);
      return { out, pts, merged };
    }
    const canMove = () => grid.some((row, r) => row.some((v, c) => !v || v === row[c + 1] || v === grid[r + 1]?.[c]));
    function move(d: Dir) {
      if (over) return;
      let moved = false, pts = 0; const mergedAt: number[] = [];
      for (let k = 0; k < 4; k++) {
        // Read the line in the direction of the move, slide it, and write it back
        const idx = [0, 1, 2, 3].map((i) => d === 'left' ? [k, i] : d === 'right' ? [k, 3 - i] : d === 'up' ? [i, k] : [3 - i, k]);
        const line = idx.map(([r, c]) => grid[r][c]);
        const { out, pts: p, merged } = slide(line);
        if (out.some((v, i) => v !== line[i])) moved = true;
        out.forEach((v, i) => { const [r, c] = idx[i]; grid[r][c] = v; });
        merged.forEach((i) => { const [r, c] = idx[i]; mergedAt.push(r * 4 + c); });
        pts += p;
      }
      if (!moved) return;
      score += pts;
      if (score > best) { best = score; set('nc-2048-best', best); }
      const at = addTile();
      if (!won && grid.flat().includes(2048)) { won = true; award('2048', 150, '¡Llegaste a 2048!'); $('[data-msg]').textContent = '¡Llegaste a 2048! 🎉 Puedes seguir jugando.'; }
      if (!canMove()) { over = true; award('2048', Math.floor(score / 200), `Partida de 2048: ${score}`); $('[data-msg]').textContent = `Se acabaron las jugadas. Puntos: ${score}.`; }
      save(); paint(at, mergedAt);
    }
    box.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => move(b.dataset.dir as Dir)));
    $('[data-new]').addEventListener('click', start);
    addEventListener('keydown', (e) => {
      const d = ({ ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right' } as Record<string, Dir>)[e.key];
      if (d) { e.preventDefault(); move(d); }
    });
    // Swipe on the board
    let sx = 0, sy = 0;
    boardEl.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    boardEl.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;
      move(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : (dy > 0 ? 'down' : 'up'));
    });
    boardEl.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });
    // Continue a saved game, or start a new one
    const saved = get<{ grid: number[][]; score: number; won: boolean } | null>('nc-2048-game', null);
    if (saved?.grid?.length === 4) { grid = saved.grid; score = saved.score; won = saved.won; over = !canMove(); paint(); if (over) $('[data-msg]').textContent = 'Se acabaron las jugadas. Toca "Juego nuevo".'; }
    else start();
  </script>
</Base>
