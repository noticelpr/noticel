---
// Search page (same as Noticias Xtra's): the browser loads search-index.json and looks for every word typed.
// Old WordPress searches (noticel.com/?s=...) are sent here from the home page.
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../lib/site';
---
<Base title="Buscar" noindex>
  <main id="main" class="wrap" tabindex="-1">
    <div class="crumbs"><a href={url()}>Portada</a></div>
    <h1 class="page-h" id="searchTitle">Buscar noticias</h1>
    <form class="page-search" role="search" action={url('buscar')} method="get">
      <label for="pageq" class="sr">Buscar noticias</label>
      <input id="pageq" name="q" type="search" placeholder="Un pueblo, una persona o un tema, como “Bayamón”" />
      <button class="btn" type="submit">Buscar</button>
    </form>
    <p class="time" id="searchCount" aria-live="polite"></p>
    <div class="art-grid">
      <div class="stack" id="results" data-index={url('search-index.json')}></div>
      <Sidebar />
    </div>
  </main>
  <script>
    const box = document.getElementById('results')!;
    const q = (new URLSearchParams(location.search).get('q') ?? '').trim();
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const input = document.getElementById('pageq') as HTMLInputElement;
    input.value = q;
    if (!q) {
      input.focus();
      box.innerHTML = '<div class="empty"><p>Escribe un pueblo, una persona o un tema, como “Bayamón” o “béisbol”.</p></div>';
    } else {
      document.getElementById('searchTitle')!.textContent = `Resultados para “${q}”`;
      document.title = `${q} | Buscar | NotiCel`;
      const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      const fmt = (d: string) => new Date(d).toLocaleString('es-PR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Puerto_Rico' });
      type Item = { url: string; title: string; description: string; section: string; author: string; date: string; image: string; tags: string[]; text: string };
      fetch(box.dataset.index!)
        .then((r) => r.json())
        .then((items: Item[]) => {
          const words = norm(q).split(/\s+/).filter(Boolean);
          // Every word must appear; headline and topic matches come first, then the newest
          const score = (i: Item) => { const head = norm(`${i.title} ${i.tags.join(' ')}`); return words.filter((w) => head.includes(w)).length; };
          const hits = items
            .filter((i) => { const all = norm(`${i.title} ${i.description} ${i.tags.join(' ')} ${i.author} ${i.text}`); return words.every((w) => all.includes(w)); })
            .sort((a, b) => score(b) - score(a) || Date.parse(b.date) - Date.parse(a.date));
          document.getElementById('searchCount')!.textContent = `${hits.length} ${hits.length === 1 ? 'noticia' : 'noticias'}`;
          box.innerHTML = hits.length
            ? hits.slice(0, 60).map((i) => `<article class="row"><div>${i.section ? `<span class="kicker">${esc(i.section)}</span>` : ''}<a href="${i.url}"><h3 class="hl">${esc(i.title)}</h3></a>${i.description ? `<p class="sr-dek">${esc(i.description)}</p>` : ''}<div class="time">${fmt(i.date)} · <span class="au">${esc(i.author)}</span></div></div><a href="${i.url}" tabindex="-1" aria-hidden="true"><div class="ph" style="--c:#006FA6">${i.image ? `<img src="${esc(i.image)}" alt="" loading="lazy">` : ''}</div></a></article>`).join('')
            : `<div class="empty"><p>No encontramos noticias con “${esc(q)}”. Prueba con otra palabra, como un pueblo o un tema.</p></div>`;
        })
        .catch(() => { box.innerHTML = '<div class="empty"><p>No se pudo cargar la búsqueda. Recarga la página para intentarlo otra vez.</p></div>'; });
    }
  </script>
</Base>
