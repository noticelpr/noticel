---
// Video page: YouTube player (NotiCel or BSN channel), credit and link to the original, more videos
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import VideoCard from '../../components/VideoCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE, VIDEOS, VIDEO_SOURCES, section, url, type Video , sectionUrl } from '../../lib/site';

export function getStaticPaths() {
  if (!SITE.features.videos) return [];
  return VIDEOS.map((v) => ({ params: { id: v.id }, props: { video: v } }));
}
const { video } = Astro.props as { video: Video };
const source = VIDEO_SOURCES[video.src];
const more = [...VIDEOS.filter((v) => v.id !== video.id && v.src === video.src), ...VIDEOS.filter((v) => v.src !== video.src)].slice(0, 6);
---
<Base title={video.title} active="videos" image={`https://i.ytimg.com/vi/${video.yt}/hqdefault.jpg`}>
  <main class="wrap" id="main">
    <div class="art-grid">
      <div class="art">
        <div class="crumbs"><a href={url('videos')}>Videos</a> / <a href={sectionUrl(video.section)}>{section(video.section).name}</a></div>
        <Player yt={video.yt} title={video.title} />
        <h1 style="font-size:30px;margin-top:14px">{video.title}</h1>
        <p class="vsrc">
          Video: <a href={source.url} rel="noopener" target="_blank">{source.name}</a>, en YouTube · duración {video.duration} ·
          <a href={`https://www.youtube.com/watch?v=${video.yt}`} rel="noopener" target="_blank">Ver en YouTube ↗</a>
        </p>
        <div class="sec-h"><h2>Más videos</h2></div>
        <div class="autogrid">{more.map((v) => <VideoCard video={v} />)}</div>
      </div>
      <Sidebar newsletter={false} />
    </div>
  </main>
</Base>
