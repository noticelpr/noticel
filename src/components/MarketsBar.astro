---
// Thin market bar (one line that slides sideways on phones): Puerto Rico companies, oil and gold, and the stock market.
// Used on the home page and on Economía. Prices come from src/lib/markets.ts at build time.
import { getMarkets, fmtPrice, curOf, pctOf } from '../lib/markets';
import { categoryUrl } from '../lib/site';
const markets = (await getMarkets()).list.filter((q) => q.group === 'pr' || q.group === 'mp' || q.group === 'us').slice(0, 12);
---
{markets.length > 0 && (
      <section class="ncs-tape" aria-label="Mercados">
        <a class="ncs-tape-h" href={categoryUrl('economia')}>Mercados</a>
        <div class="ncs-tape-row">
          {markets.map((q) => { const p = pctOf(q); return <span class="ncs-tape-i"><b>{q.name}</b> {curOf(q)}{fmtPrice(q)}{q.suf ?? ''} <em class:list={[p >= 0 ? 'up' : 'down']}>{p >= 0 ? '▲' : '▼'} {Math.abs(p).toFixed(2)}%</em></span>; })}
        </div>
      </section>
    )}
