---
// Ventas → "+ Anuncio vendido": the sales team puts a directly sold ad on the site by itself, with whatever terms were
// agreed (each deal is different): the spaces, the images, by dates or by views, and where it shows. Saving publishes
// the campaign right away (ad_campaigns, like approving a request) and keeps the deal on record in the team's client
// list (sales_leads, as a won sale): amount paid, how and when, invoice number, salesperson and the agreed terms.
// It also adds an approved request for the client (ad_requests, lines starting "Venta directa"), so the automatic emails
// go out (the deal in writing, live, ending soon, results: supabase/functions/correos) and the client sees the campaign
// in the advertiser panel with their email. "Idioma de los correos al cliente" → English saves client.lang 'en', so those emails go in English.
// Any size (owner, 2026-11-16): each image gets a standard size or a custom width × height, and the campaign can be
// limited to some pages (Portada, noticias, secciones, a section) and, for the wide banner, to the top or the bottom.
// The agreed price is also kept in ad_campaign_deals (private; supabase/precios-anuncios.sql). Ventas → Campañas →
// "Editar" opens this same form to change a campaign that's running or scheduled (event 'nc-campaign-edit').
import { VOLUME_TIERS, PREPAY_DISCOUNT, DIRECT_MAX_DISCOUNT, COMUNICADO_PRICES, PAGE_CHOICES, SPACE_BOXES } from '../../lib/ads';
import { SECTIONS } from '../../lib/site';
const boxes = (b: ReadonlyArray<readonly [number, number]>) => b.map(([w, h]) => `${w} × ${h}`).join(', ');
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
---
<button type="button" class="adp-btn" data-ds-open>+ Anuncio vendido</button>
<dialog class="sd-dlg ds-dlg" data-ds-dlg aria-labelledby="ds-h">
  <form method="dialog" class="sd-form" data-ds-form novalidate>
    <header class="sd-dlg-h"><h2 id="ds-h" data-ds-title>Anuncio vendido</h2><button type="button" class="sd-x" data-ds-close aria-label="Cerrar">✕</button></header>
    <p class="pnl-muted pnl-small ds-intro">Para ventas que cerraste directamente. Antes de guardar verás un resumen para revisarlo. <span data-ds-intro>El anuncio sale en el sitio en la fecha que pongas</span> y la venta queda en <b>Ganadas</b> con sus datos.</p>
    <div class="ds-mode ds-what" role="radiogroup" aria-label="Qué vendiste" data-ds-new>
      <label class="sd-chk"><input type="radio" name="what" value="ad" checked /><span>Anuncio<small>banner, rectángulo, toma…</small></span></label>
      <label class="sd-chk"><input type="radio" name="what" value="com" /><span>Comunicado de prensa<small>sale como «Comunicado pagado»</small></span></label>
    </div>
    <div class="sd-fields">
      <fieldset><legend>Cliente</legend>
        <div class="sd-2">
          <label>Negocio<input name="business" required maxlength="60" /></label>
          <label data-ds-new>Persona de contacto<input name="contact" maxlength="60" /></label>
          <label data-ds-new>Teléfono<input name="phone" type="tel" maxlength="20" /></label>
          <label data-ds-new>Correo <small>(le llegan la confirmación y los resultados)</small><input name="email" type="email" maxlength="80" /></label>
          <label data-ds-new>Idioma de los correos al cliente<select name="lang"><option value="es" selected>Español</option><option value="en">English</option></select></label>
          <label data-ds-new>Referido por <small>(si un periodista te pasó el cliente)</small><select name="ref" data-ds-ref><option value="">Nadie</option></select></label>
        </div>
      </fieldset>
      {/* Comunicado pagado: goes to Escribir "En revisión" for an editor to publish (src/lib/comunicados.ts) */}
      <fieldset data-ds-com hidden><legend>El comunicado</legend>
        <div class="ds-mode" role="radiogroup">
          <label class="sd-chk"><input type="radio" name="comKind" value="ready" checked /><span>Ya lo tiene escrito<small>{money(COMUNICADO_PRICES.ready)} · lo revisamos y le damos formato</small></span></label>
          <label class="sd-chk"><input type="radio" name="comKind" value="written" /><span>Lo escribimos nosotros<small>{money(COMUNICADO_PRICES.written)} · con los datos del cliente</small></span></label>
        </div>
        <div class="sd-2">
          <label>Sección<select name="comSection">{SECTIONS.filter((x) => x.id !== 'opinion').map((x) => <option value={x.id}>{x.name}</option>)}</select></label>
          <label>Título<input name="comTitle" maxlength="140" /></label>
        </div>
        <label>Resumen en una oración<input name="comSummary" maxlength="220" /></label>
        <label>Texto del comunicado, o los datos para escribirlo<textarea name="comText" rows="6" maxlength="8000"></textarea></label>
        <label class="ds-lab">Foto (opcional)<input type="file" accept="image/jpeg,image/png,image/webp" data-ds-com-photo /></label>
      </fieldset>
      <fieldset data-ds-ad><legend>El anuncio</legend>
        <p class="ds-lab">Espacios</p>
        <div class="sd-fmts ds-sizes">
          <label class="sd-chk"><input type="checkbox" name="size" value="leaderboard" /><span>Banner de arriba y abajo<small>{boxes(SPACE_BOXES.leaderboard.desktop)} · celular {boxes(SPACE_BOXES.leaderboard.phone)}</small></span></label>
          <label class="sd-chk"><input type="checkbox" name="size" value="rectangle" checked /><span>Al lado de las noticias<small>{boxes(SPACE_BOXES.rectangle.desktop)}</small></span></label>
          <label class="sd-chk"><input type="checkbox" name="size" value="halfpage" /><span>Media página<small>{boxes(SPACE_BOXES.halfpage.desktop)}</small></span></label>
          <label class="sd-chk"><input type="checkbox" name="size" value="infeed" /><span>Entre noticias y dentro de la noticia<small>{boxes(SPACE_BOXES.infeed.desktop)}</small></span></label>
          <label class="sd-chk"><input type="checkbox" name="takeover" /><span>Toma de portada<small>todos los espacios del sitio</small></span></label>
        </div>
        <p class="pnl-muted pnl-small">En celular, todos los espacios menos el banner de arriba muestran cuadrados (300 × 300), rectángulos (300 × 250, 336 × 280) o banners de celular (320 × 100, 320 × 50).</p>
        <label class="ds-lab">Imágenes del anuncio <small>(una por tamaño; cada espacio usa la que le queda)</small>
          <input name="files" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-ds-files /></label>
        <p class="pnl-muted pnl-small">Debajo de cada imagen escoge el tamaño que se vendió (uno estándar u «Otro tamaño» con ancho × alto). Regla: el anuncio sale en los espacios que tienen su misma forma (15% de margen), achicado para caber, nunca estirado ni cortado.</p>
        <div class="ds-thumbs" data-ds-thumbs></div>
        <p class="sd-warn" data-ds-fitwarn hidden></p>
        {/* Ajustar: makes a version of an uploaded image for each space that has none (whole + blurred edges, or cropped) */}
        <div class="ds-fit" data-ds-fit hidden></div>
        <div class="sd-2">
          <label>Enlace al tocar el anuncio<input name="link" type="url" maxlength="300" placeholder="https://…" /></label>
          <label>Dónde sale<select name="regions"><option value="all">Puerto Rico y la diáspora</option><option value="island">Solo Puerto Rico</option><option value="diaspora">Solo la diáspora</option></select></label>
        </div>
        <p class="ds-lab">Páginas <small>(sin marcar ninguna: en todas)</small></p>
        <div class="sd-fmts ds-sizes">
          {PAGE_CHOICES.map((p) => <label class="sd-chk sm"><input type="checkbox" name="page" value={p.id} /><span>{p.name}</span></label>)}
        </div>
        <details class="ds-secs"><summary class="ds-lab">Solo en algunas secciones <small>(su página y sus noticias)</small></summary>
          <div class="sd-fmts ds-sizes">
            {SECTIONS.map((x) => <label class="sd-chk sm"><input type="checkbox" name="page" value={`seccion:${x.id}`} /><span>{x.name}</span></label>)}
          </div>
        </details>
        <label data-ds-banner hidden>Banner ancho<select name="banner"><option value="">Arriba y abajo</option><option value="top">Solo el de arriba</option><option value="bottom">Solo el de abajo</option></select></label>
        <p class="ds-lab">Cómo se vendió</p>
        <div class="ds-mode" role="radiogroup">
          <label class="sd-chk"><input type="radio" name="mode" value="time" checked /><span>Por tiempo<small>sale entre dos fechas</small></span></label>
          <label class="sd-chk"><input type="radio" name="mode" value="views" /><span>Por vistas<small>termina sola al cumplirlas</small></span></label>
        </div>
        <div class="sd-2">
          <label>Empieza<input name="start" type="date" required /></label>
          <label data-ds-end>Termina<input name="end" type="date" /></label>
          <label data-ds-views hidden>Vistas vendidas<input name="views" type="number" min="1000" step="1000" value="10000" /></label>
        </div>
      </fieldset>
      <fieldset><legend>Precio y pago</legend>
        <div class="ds-mode" role="radiogroup" aria-label="¿Ya pagó?" data-ds-new>
          <label class="sd-chk"><input type="radio" name="state" value="paid" checked /><span>Pagada<small>el cliente ya pagó</small></span></label>
          <label class="sd-chk"><input type="radio" name="state" value="due" /><span>Por pagar<small>queda en «Por cobrar»</small></span></label>
        </div>
        <div class="sd-2">
          <label>Precio acordado ($) <small>(se guarda en la base de datos, solo lo ve Ventas)</small><input name="price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="antes de descuentos" /></label>
          <label data-ds-new><span data-ds-method-l>Forma de pago</span><select name="method"><option>ATH Móvil</option><option>Tarjeta</option><option>Transferencia</option><option>Cheque</option><option>Efectivo</option><option>Factura a la agencia</option><option>Intercambio (canje)</option><option>Cortesía</option><option>Otra</option></select></label>
        </div>
        <div class="ds-disc" data-ds-new>
          <p class="ds-lab">Descuentos <small>(hasta {DIRECT_MAX_DISCOUNT}% en total)</small></p>
          <label>Por volumen<select name="volume" data-ds-volume><option value="0">Sin descuento</option>{VOLUME_TIERS.map((t) => <option value={t.pct} data-from={t.from}>{t.pct}% · desde {money(t.from)}</option>)}</select></label>
          <label class="sd-chk sm"><input type="checkbox" name="prepay" data-ds-prepay /><span>Pronto pago: pagó todo por adelantado (−{PREPAY_DISCOUNT}%)</span></label>
          <p class="pnl-muted pnl-small" data-ds-disc-hint></p>
          <p class="ds-total"><span>Total a cobrar</span><b data-ds-total>$0</b></p>
        </div>
        <div class="sd-2" data-ds-new>
          <label data-ds-paidon>Fecha del pago<input name="paidOn" type="date" /></label>
          <label>Factura o recibo #<input name="invoice" maxlength="40" /></label>
        </div>
        <label>Lo que se acordó<textarea name="terms" rows="3" maxlength="800" placeholder="ej. 2 meses + 2 semanas gratis; cambia el arte a mitad de campaña; paga la mitad ahora y la mitad el 15…"></textarea></label>
      </fieldset>
    </div>
    <p class="cm-err" data-ds-err hidden></p>
    <footer class="sd-dlg-f">
      <button type="button" class="adp-btn ghost-dark" data-ds-close>Cancelar</button>
      <button type="submit" class="adp-btn" data-ds-save>Guardar y publicar</button>
    </footer>
  </form>
</dialog>

<script>
  import { publishCampaign, hasBackend, staffApi, uploadStoryFile, uploadAdImage, saveDeal, getDeal, logActivity, type CampaignRow } from '../../lib/backend';
  import { comunicadoToEscribir } from '../../lib/comunicados';
  import type { AdRequest } from '../../lib/adrequests';
  import { kickEmails } from '../../lib/adrequests';
  import { sharedList } from '../../lib/shared';
  import { myId, teamList, codeOf, isReferrer } from '../../lib/sellers';
  import type { AdSize, Campaign, Placement } from '../../lib/ads';
  import { VOLUME_TIERS, PREPAY_DISCOUNT, DIRECT_MAX_DISCOUNT, COMUNICADO_PRICES, STANDARD_SIZES, boxFor } from '../../lib/ads';
  import { fitImage, placeImage, imageFrom } from '../../lib/adcreative';
  import { tell, ask } from '../../lib/dialogs';
  const dlg = document.querySelector<HTMLDialogElement>('[data-ds-dlg]');
  const form = document.querySelector<HTMLFormElement>('[data-ds-form]');
  if (dlg && form) {
    const $ = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const iso = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
    const today = iso(new Date());
    const addDays = (s: string, n: number) => { const d = new Date(`${s}T12:00:00`); d.setDate(d.getDate() + n); return iso(d); };
    const money = (n: number) => `$${(Math.round(n * 100) / 100).toLocaleString('en-US', { maximumFractionDigits: 2 })}`;
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    // Which spaces an ad of this size fits on computers (the same rule the site uses: src/lib/ads.ts, boxFor); the top
    // banner also counts phone banners (320 × 100, 320 × 50). On phones the other spaces take squares and phone banners.
    const SPACES: AdSize[] = ['leaderboard', 'rectangle', 'halfpage', 'infeed'];
    const NAME: Record<AdSize, string> = { leaderboard: 'Banner de arriba y abajo', infeed: 'Entre noticias', rectangle: 'Al lado de las noticias', halfpage: 'Media página' };
    const fits = (w: number, h: number, s: AdSize) => !!(boxFor(w, h, s, false) || (s === 'leaderboard' && boxFor(w, h, s, true)));
    // w × h: the picture's real pixels; sw × sh: the size sold (a standard size or a custom one), used to place it
    type Img = { data: string; w: number; h: number; name: string; sw: number; sh: number; custom?: boolean };
    const fitsImg = (m: Img, s: AdSize) => fits(m.sw, m.sh, s);
    /** The standard size with the same shape as the picture (closest in pixels), or the picture's own size. */
    const sizeFor = (w: number, h: number): [number, number] => {
      const same = STANDARD_SIZES.filter((z) => Math.abs(w / h - z.w / z.h) / (z.w / z.h) < 0.03).sort((a, b) => Math.abs(a.w - w) - Math.abs(b.w - w));
      return same.length ? [same[0].w, same[0].h] : [w, h];
    };
    const makeImg = (data: string, w: number, h: number, name: string): Img => { const [sw, sh] = sizeFor(w, h); return { data, w, h, name, sw, sh, custom: !STANDARD_SIZES.some((z) => z.w === sw && z.h === sh) }; };
    let editing: CampaignRow | null = null; // Ventas → Campañas → Editar
    let editImgs = '';
    let imgs: Img[] = [];
    const leads = sharedList<any>('sales_leads', 'nc-leads', 'nc-leads');

    const sizes = (): AdSize[] => ($<HTMLInputElement>('[name="takeover"]').checked ? ['leaderboard', 'rectangle', 'halfpage', 'infeed'] : [...form.querySelectorAll<HTMLInputElement>('[name="size"]:checked')].map((c) => c.value as AdSize));
    /** Price, discounts (volume by the price's tier, fast pay only when paid up front, capped) and the total. */
    function pricing() {
      const d = new FormData(form), price = Math.max(0, Number(d.get('price')) || 0), paidState = d.get('state') === 'paid';
      const best = [...VOLUME_TIERS].reverse().find((t) => price >= t.from)?.pct ?? 0;
      const vol = Math.min(Number(d.get('volume')) || 0, best), prepay = paidState && !!d.get('prepay') ? PREPAY_DISCOUNT : 0;
      const pct = Math.min(DIRECT_MAX_DISCOUNT, vol + prepay);
      const total = Math.round(price * (1 - pct / 100) * 100) / 100;
      return { price, best, vol, prepay, pct, total, paidState };
    }
    function paintPrice() {
      const p = pricing();
      // Only the tiers this price reaches can be chosen; picked automatically the first time it qualifies
      const sel = $<HTMLSelectElement>('[data-ds-volume]');
      [...sel.options].forEach((o) => (o.disabled = Number(o.value) > p.best));
      if (Number(sel.value) > p.best) sel.value = String(p.best);
      if (p.best && sel.dataset.auto !== String(p.best)) { sel.value = String(p.best); sel.dataset.auto = String(p.best); }
      const pp = $<HTMLInputElement>('[data-ds-prepay]'); pp.disabled = !p.paidState; if (!p.paidState) pp.checked = false;
      $('[data-ds-paidon]').hidden = !p.paidState;
      $('[data-ds-method-l]').textContent = p.paidState ? 'Forma de pago' : 'Cómo va a pagar';
      const q = pricing();
      $('[data-ds-disc-hint]').textContent = !q.price ? 'Escribe el precio para ver los descuentos.' : `${q.best ? `Por este precio le toca hasta ${q.best}% por volumen.` : `Por volumen: desde ${money(VOLUME_TIERS[0].from)}.`}${q.paidState ? '' : ' Pronto pago solo si paga todo por adelantado.'}${q.pct ? ` Descuento total: ${q.pct}% (−${money(q.price - q.total)}).` : ''}`;
      $('[data-ds-total]').textContent = money(q.total);
    }
    const isCom = () => (form.elements.namedItem('what') as RadioNodeList).value === 'com';
    let comPhoto = '';
    function paint() {
      // Anuncio or Comunicado: each shows its own part of the form; a comunicado starts at its price
      const com = isCom(); $('[data-ds-com]').hidden = !com; $('[data-ds-ad]').hidden = com;
      const priceIn = $<HTMLInputElement>('[name="price"]'), kindPrice = String(COMUNICADO_PRICES[(new FormData(form).get('comKind') === 'written' ? 'written' : 'ready')]);
      if (com && (!priceIn.value || priceIn.dataset.auto === priceIn.value)) { priceIn.value = kindPrice; priceIn.dataset.auto = kindPrice; }
      paintPrice();
      const byViews = (form.elements.namedItem('mode') as RadioNodeList).value === 'views';
      $('[data-ds-end]').hidden = byViews; $('[data-ds-views]').hidden = !byViews;
      $('[data-ds-thumbs]').innerHTML = imgs.map((m, i) => {
        const where = SPACES.filter((s) => fitsImg(m, s)).map((s) => NAME[s]);
        const std = STANDARD_SIZES.map((z) => `<option value="${z.w}x${z.h}"${!m.custom && z.w === m.sw && z.h === m.sh ? ' selected' : ''}>${z.w} × ${z.h} · ${esc(z.name)}</option>`).join('');
        const off = Math.abs(m.w / m.h - m.sw / m.sh) / (m.sw / m.sh) > 0.03; // the picture isn't the shape of the size picked
        return `<figure><img src="${m.data}" alt=""><figcaption>${m.w && m.h ? `Imagen: ${m.w} × ${m.h}` : ''}
          <label class="ds-size">Tamaño vendido<select data-ds-size="${i}" aria-label="Tamaño de la imagen ${i + 1}">${std}<option value="custom"${m.custom ? ' selected' : ''}>Otro tamaño…</option></select></label>
          ${m.custom ? `<span class="ds-custom"><input type="number" min="10" max="4000" value="${m.sw}" data-ds-cw="${i}" aria-label="Ancho en píxeles"> × <input type="number" min="10" max="4000" value="${m.sh}" data-ds-ch="${i}" aria-label="Alto en píxeles"></span>` : ''}
          ${off ? '<small class="sd-warn">⚠ La imagen no tiene la forma de ese tamaño: se verá completa, con espacio a los lados.</small>' : ''}
          <small>${where.length ? `Sale en: ${esc(where.join(', '))}` : 'Este tamaño no le queda a ningún espacio'}</small></figcaption><button type="button" class="sd-x sm" data-ds-rm="${i}" aria-label="Quitar">✕</button></figure>`;
      }).join('');
      $('[data-ds-banner]').hidden = !sizes().includes('leaderboard') || $<HTMLInputElement>('[name="takeover"]').checked;
      const missing = imgs.length ? sizes().filter((s) => !imgs.some((m) => fitsImg(m, s))) : [];
      const w = $('[data-ds-fitwarn]'); w.hidden = !missing.length;
      if (missing.length) w.textContent = `Falta una imagen para: ${missing.map((s) => NAME[s]).join(', ')}. Ajústala aquí abajo o sube una de ese tamaño.`;
      paintFit(missing);
    }

    // ---- Ajustar: a version of an uploaded image for a space it doesn't fit ----
    // One box per missing space; banners get both the computer (728 × 90) and the phone (320 × 100) version.
    const TARGET: Record<AdSize, Array<[number, number]>> = { leaderboard: [[728, 90], [320, 100]], infeed: [[728, 90], [320, 100]], rectangle: [[300, 250]], halfpage: [[300, 600]] };
    type Fit = { src: number; mode: 'fit' | 'fill'; zoom: number; x: number; y: number };
    const fitState = new Map<AdSize, Fit>();
    const fitOf = (sp: AdSize) => fitState.get(sp) ?? (fitState.set(sp, { src: 0, mode: 'fit', zoom: 1, x: 0, y: 0 }), fitState.get(sp)!);
    function paintFit(missing: AdSize[]) {
      const box = $('[data-ds-fit]');
      // Banner de arriba and Entre noticias share the same shapes: one box covers both
      const list = missing.filter((sp, i) => !(sp === 'infeed' && missing.includes('leaderboard')) || i < 0);
      box.hidden = !list.length || !imgs.length;
      if (box.hidden) { box.innerHTML = ''; return; }
      box.innerHTML = list.map((sp) => { const f = fitOf(sp); return `<div class="ds-fit-card" data-fit="${sp}">
        <p class="ds-fit-h"><b>Ajustar para ${esc(NAME[sp])}${sp === 'leaderboard' && missing.includes('infeed') ? ' y Entre noticias' : ''}</b>${imgs.length > 1 ? ` <select data-fit-src aria-label="Imagen">${imgs.map((m, i) => `<option value="${i}" ${i === f.src ? 'selected' : ''}>${esc(m.name || `Imagen ${i + 1}`)}</option>`).join('')}</select>` : ''}</p>
        <div class="ds-fit-modes" role="group"><button type="button" data-fit-mode="fit" aria-pressed="${f.mode === 'fit'}">Completa</button><button type="button" data-fit-mode="fill" aria-pressed="${f.mode === 'fill'}">Recortar</button></div>
        <div class="ds-fit-prev">${TARGET[sp].map(([w, h]) => `<figure><canvas data-fit-c="${w}x${h}" style="aspect-ratio:${w}/${h};max-width:${Math.min(w, 520)}px"></canvas><figcaption>${w} × ${h}${w === 320 ? ' (celular)' : ''}</figcaption></figure>`).join('')}</div>
        <label class="ds-fit-zoom" ${f.mode === 'fill' ? '' : 'hidden'}>Zoom <input type="range" min="1" max="3" step="0.05" value="${f.zoom}" data-fit-zoom /> <small>Arrastra la imagen para moverla</small></label>
        <p class="pnl-muted pnl-small">${f.mode === 'fit' ? 'Completa: se ve toda la imagen; los lados se llenan con la misma imagen difuminada.' : 'Recortar: la imagen llena el espacio; lo que sobra se corta.'}</p>
        <button type="button" class="adp-btn" data-fit-use>Usar esta versión</button>
      </div>`; }).join('');
      list.forEach((sp) => void drawFit(sp));
    }
    async function drawFit(sp: AdSize) {
      const card = $(`[data-fit="${sp}"]`), f = fitOf(sp), src = imgs[f.src] ?? imgs[0]; if (!card || !src) return;
      const img = await imageFrom(src.data);
      card.querySelectorAll<HTMLCanvasElement>('[data-fit-c]').forEach((c) => {
        const [w, h] = c.dataset.fitC!.split('x').map(Number);
        if (f.mode === 'fit') fitImage(c, w, h, img);
        else { const used = placeImage(c, w, h, img, { zoom: f.zoom, x: f.x * w, y: f.y * h }); if (w === TARGET[sp][0][0]) { f.x = used.x / w; f.y = used.y / h; } }
      });
    }
    // Controls (they don't go through the form's change → paint, so the boxes stay open while adjusting)
    const fitBox = $('[data-ds-fit]');
    fitBox.addEventListener('change', (e) => e.stopPropagation());
    fitBox.addEventListener('input', (e) => {
