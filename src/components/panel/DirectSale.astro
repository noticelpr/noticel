      const pagoTxt = pr.paidState ? `${s('method')}${s('paidOn') ? ` · ${s('paidOn')}` : ''}` : `Pendiente (pagará con ${s('method')})`;
      const lines = ['Venta directa', `Pago: ${pagoTxt}`, `Precio: $${pr.price.toFixed(2)}`,
        ...(pr.vol ? [`Descuento por volumen (${pr.vol}%)`] : []), ...(pr.prepay ? [`Descuento por pronto pago (${pr.prepay}%)`] : []),
        ...(pr.pct ? [`Total con ${pr.pct}% de descuento: $${pr.total.toFixed(2)}`] : []),
        ...(s('invoice') ? [`Factura: ${s('invoice')}`] : []), ...(s('terms') ? [`Acordado: ${s('terms')}`] : [])];
      const fmtIds = takeover ? ['takeover'] : sz;
      const where = s('regions') === 'island' ? 'Solo Puerto Rico' : s('regions') === 'diaspora' ? 'Solo la diáspora' : 'Puerto Rico y la diáspora';
      const duration = byViews ? `${views!.toLocaleString('en-US')} vistas` : `${Math.round((Date.parse(`${camp.end}T12:00:00`) - Date.parse(`${camp.start}T12:00:00`)) / 864e5) + 1} días`;
      // Who sold it goes in too, read below
      let seller = ''; try { seller = JSON.parse(localStorage.getItem('nc-staff') || '{}').name ?? ''; } catch { /* storage blocked */ }
      if (seller) lines.push(`Vendido por: ${seller}`);
      if (s('ref')) lines.push(`Referido: ${s('ref')}`); // a periodista's referral: they earn the referral rate too
      {
        const made = await staffApi('ad_requests', { method: 'POST', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ id: rid, status: 'revisar', paid: false,
          client: { name: s('contact') || s('business'), business: s('business'), email: s('email'), phone: s('phone'), who: 'retail', ...(s('lang') === 'en' ? { lang: 'en' } : {}) },
          formats: fmtIds, placement: where, start: camp.start, duration, total: pr.total, lines, views: views ?? null, art: { mode: 'upload', files }, link: cleanL || null }) });
        if (made?.ok) {
          const paidNow = pr.paidState && pr.total > 0 && s('method') !== 'Cortesía';
          await staffApi(`ad_requests?id=eq.${rid}`, { method: 'PATCH', body: JSON.stringify({ status: wait ? 'revisar' : 'aprobada', paid: paidNow }) });
          if (s('email')) kickEmails(2000); // the emails go out only with the client's address
        }
        if (wait && !made?.ok) return fail('No se pudo guardar el pedido. Revisa tu sesión (sal y vuelve a entrar) e intenta otra vez.');
      }
      // The deal, on record in Ventas → Ganadas
      const who = seller;
      const paid = pr.total;
      const sale = { campaignId: id, paid, due: !pr.paidState, price: pr.price, discount: pr.pct, method: s('method'), paidOn: s('paidOn'), invoice: s('invoice'), terms: s('terms'), soldBy: who, byViews, views, sizes: sz, takeover };
      const what = takeover ? 'Toma de portada' : sz.map((x) => NAME[x]).join(', ');
      const record = `Venta directa: ${what}, ${byViews ? `${views!.toLocaleString('es-PR')} vistas desde el ${s('start')}` : `del ${s('start')} al ${s('end')}`}. ${pr.paidState ? 'Pagado' : 'Por cobrar'} $${paid.toLocaleString('en-US')} (${s('method')}${s('paidOn') ? `, ${s('paidOn')}` : ''})${s('invoice') ? ` · factura ${s('invoice')}` : ''}${who ? ` · vendido por ${who}` : ''}.${s('terms') ? ` Acordado: ${s('terms')}` : ''}`;
      leads.save([{ id: `L-${id.slice(2).toUpperCase()}`, created: Date.now(), business: s('business'), contact: s('contact'), phone: s('phone'), email: s('email'), who: 'retail', channel: 'Venta directa',
        fmt: takeover ? ['takeover'] : [], start: s('start'), end: camp.end, days: 1, aud: s('regions') === 'all' ? 'all' : s('regions'), reg: [], design: false, prepay: false, founder: false,
        requests: s('terms'), budget: '', follow: '', stage: 'won', extra: 0, extraAmt: 0, views, custom: [], notes: [{ at: Date.now(), text: record }], total: paid,
        converted: new Date().toISOString(), sale, owner: myId(), ownerName: who }, ...leads.load()]);
      dispatchEvent(new Event('nc-campaigns'));
      dlg.close();
      dispatchEvent(new Event('nc-sale')); // Mis comisiones and Inicio count it right away
      if (wait) return void tell(`✓ Enviado: el anuncio de ${s('business')} está en Anuncios → Por revisar. Sale en el sitio cuando el administrador o el Gerente lo apruebe (te avisa tu Inicio). La venta quedó en Ventas → Ganadas.`, 'Perfecto');
      void tell(`✓ Listo: el anuncio de ${s('business')} ${camp.start <= today ? 'ya sale en el sitio' : `sale el ${camp.start}`}. La venta quedó en Ventas → Ganadas y en tus comisiones.${s('email') ? ` ${s('business')} recibirá por correo la confirmación con lo acordado.` : ' Sin correo del cliente, no se le envían correos.'}`, 'Perfecto');
    });
  }
</script>
