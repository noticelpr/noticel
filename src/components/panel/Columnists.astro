---
// Panel → Columnistas (2026-10-29, the owner's request): create and edit columnist profiles (name, position, bio,
// photo, contact and social links) and switch each one on (shows on the site) or off (hidden).
// Saved in NotiCel's Supabase (supabase/columnistas.sql); the site reads the profiles that are on when it is built.
// Without the database (preview or demo), changes stay on this device only.
// 2026-11-17 (user): requests from «¿Quieres ser columnista?» on the Opiniones page, «Invitar a un columnista» and
// columnists' requests to take a column down (supabase/columnistas-solicitudes.sql, supabase/columnas-quitar.sql), for
// the administrator, the Editor en jefe and the Editors. Approving or inviting creates the profile turned off.
import { COLUMNISTS } from '../../lib/columnists';
const start = COLUMNISTS.map((c, i) => ({ slug: c.slug, name: c.name, role: c.role ?? 'Columnista', bio: c.bio ?? '', photo: c.photo ?? '', active: true, sort: i + 1 }));
---
<div class="cl" data-cl data-start={JSON.stringify(start)}>
  <header class="cl-head">
    <div>
      <h1 class="pnl-h">Columnistas</h1>
      <p class="pnl-muted">Crea y edita los perfiles de los columnistas. Con el interruptor decides quién sale en el sitio.</p>
    </div>
    <div class="cl-btns"><button type="button" class="adp-btn ghost-dark" data-cl-invite-open>Invitar a un columnista</button><button type="button" class="adp-btn" data-cl-new>+ Nuevo columnista</button></div>
  </header>

  {/* Requests from the Opiniones page and invitations (user, 2026-11-17; supabase/columnistas-solicitudes.sql) */}
  <form class="pnl-card cl-invite" data-cl-invite hidden novalidate>
    <h2 class="pnl-h3">Invitar a un columnista</h2>
    <p class="pnl-muted pnl-small">Le llega un correo invitándolo a escribir en Opiniones, con un botón para crear su cuenta de columnista. Con esa cuenta solo puede enviar columnas (las aprueba un editor) y ver sus lecturas y comentarios.</p>
    <div class="cl-two"><label>Nombre completo<input name="iname" maxlength="40" placeholder="Como firmará sus columnas" /></label><label>Correo<input name="imail" type="email" maxlength="120" autocapitalize="off" /></label></div>
    <label>Tema o cargo <small>(opcional, sale bajo su nombre)</small><input name="irole" maxlength="80" placeholder="Ej.: Economía y familia" /></label>
    <label>Mensaje personal <small>(opcional, sale en el correo)</small><textarea name="imsg" rows="3" maxlength="600" placeholder="Ej.: Hola, leímos tus escritos sobre la economía de la familia y nos encantaría tenerte en Opinión."></textarea></label>
    <p class="cm-err" data-cl-ierr hidden></p>
    <div class="cl-actions"><button type="submit" class="adp-btn" data-cl-isend>Enviar invitación</button><button type="button" class="adp-btn ghost-dark" data-cl-invite-cancel>Cancelar</button></div>
  </form>
  <section class="cl-req" data-cl-req hidden>
    <h2 class="pnl-h2">Solicitudes para ser columnista <span class="pnl-n" data-cl-req-n></span></h2>
    <ul class="cl-req-list" data-cl-req-list></ul>
    <details class="cl-req-old"><summary>Solicitudes respondidas</summary><ul class="cl-req-list" data-cl-req-old></ul></details>
  </section>
  {/* Columnist accounts (user, 2026-11-17): remove one (no more panel, profile off, columns stay) or bring one back.
      The administrator and the Editor en jefe; Editors see the list. supabase/columnistas-baja.sql */}
  <section class="cl-req" data-cl-acc hidden>
    <h2 class="pnl-h2">Cuentas de columnistas</h2>
    <ul class="cl-acc-list" data-cl-acc-list></ul>
    <details class="cl-req-old" data-cl-before-box hidden><summary>Columnistas anteriores</summary><ul class="cl-acc-list" data-cl-before></ul></details>
  </section>
  <section class="cl-req" data-cl-down hidden>
    <h2 class="pnl-h2">Pedidos para quitar columnas <span class="pnl-n" data-cl-down-n></span></h2>
    <ul class="cl-req-list" data-cl-down-list></ul>
  </section>
  <p class="pnl-note" data-cl-note></p>
  <p class="cl-missing" data-cl-missing hidden>Falta preparar la base de datos: en Supabase → SQL Editor, corre el archivo <b>supabase/columnistas.sql</b> (una sola vez).</p>
  <ul class="cl-list" data-cl-list></ul>

  <form class="cl-form" data-cl-form hidden novalidate>
    <h2 class="pnl-h2" data-cl-form-h>Nuevo columnista</h2>
    <div class="cl-grid">
      <div class="cl-photo">
        <span class="cl-pic" data-cl-pic aria-hidden="true"></span>
        <label class="adp-btn ghost-dark cl-up">Subir foto<input type="file" accept="image/jpeg,image/png,image/webp" data-cl-file hidden /></label>
        <input name="photo" placeholder="o pega el enlace de la foto" aria-label="Enlace de la foto" autocomplete="off" />
        <button type="button" class="pnl-link" data-cl-nophoto>Quitar foto</button>
      </div>
      <div class="cl-fields">
        <label>Nombre completo<input name="name" required maxlength="80" placeholder="Como firma sus columnas" /></label>
        <p class="pnl-note">Tiene que ser igual al autor de sus columnas (por ejemplo, «Lcdo. Ramón Alejandro Pabón»), para que el sitio las junte en su perfil.</p>
        <label>Cargo o posición<input name="role" maxlength="80" placeholder="Ej.: Abogado y analista político" /></label>
        <label>Biografía<textarea name="bio" rows="5" maxlength="700" placeholder="Quién es, a qué se dedica y de qué escribe."></textarea></label>
        <label>Videos <small>(uno por línea: YouTube, Facebook o Vimeo; salen en su perfil)</small><textarea name="videos" rows="4" placeholder="https://www.youtube.com/watch?v=…"></textarea></label>
        <div class="cl-two">
          <label>Correo público<input name="email" type="email" maxlength="80" placeholder="opcional" autocapitalize="off" /></label>
          <label>Sitio web<input name="website" maxlength="120" placeholder="opcional" autocapitalize="off" /></label>
          <label>X (Twitter)<input name="x" maxlength="80" placeholder="@usuario o enlace" autocapitalize="off" /></label>
          <label>Instagram<input name="instagram" maxlength="80" placeholder="@usuario o enlace" autocapitalize="off" /></label>
          <label>Facebook<input name="facebook" maxlength="120" placeholder="usuario o enlace" autocapitalize="off" /></label>
          <label>Orden en la lista<input name="sort" type="number" min="0" max="999" placeholder="1" /></label>
        </div>
        <label class="adb-check"><input type="checkbox" name="active" checked /> Mostrar en el sitio</label>
        <p class="cm-err" data-cl-err hidden></p>
        <div class="cl-actions">
          <button type="submit" class="adp-btn" data-cl-save>Guardar</button>
          <button type="button" class="adp-btn ghost-dark" data-cl-cancel>Cancelar</button>
          <button type="button" class="pnl-link danger cl-del" data-cl-del hidden>Borrar perfil</button>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  import { hasBackend, listColumnists, saveColumnist, setColumnistActive, uploadColumnistPhoto, staffApi, teamAdmin, tokenInfo, deleteColumnist, type ColumnistRow } from '../../lib/backend';
  import { isDemo } from '../../lib/demo';
  import { ask, askText } from '../../lib/dialogs';
  const root = document.querySelector<HTMLElement>('[data-cl]');
  if (root) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const form = $<HTMLFormElement>('[data-cl-form]');
    const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const LOCAL = 'nc-columnists';
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const slugify = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const initials = (n: string) => n.replace(/^Lcd[oa]\.?\s*/u, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
    const pic = (c: { name: string; photo?: string | null }) => (c.photo ? `<img src="${esc(c.photo)}" alt="" />` : `<span>${esc(initials(c.name || '?'))}</span>`);
    const toast = (m: string) => { const t = document.querySelector<HTMLElement>('[data-ptoast]'); if (!t) return; t.textContent = m; t.hidden = false; clearTimeout((t as any).tm); (t as any).tm = setTimeout(() => (t.hidden = true), 3800); };
    let rows: ColumnistRow[] = [];
    let editing: ColumnistRow | null = null;
    const live = () => hasBackend();

    const readLocal = (): ColumnistRow[] => { try { const v = JSON.parse(localStorage.getItem(LOCAL) || 'null'); if (Array.isArray(v)) return v; } catch { /* storage blocked */ } return JSON.parse(root.dataset.start || '[]'); };
    const writeLocal = () => { try { localStorage.setItem(LOCAL, JSON.stringify(rows)); } catch { /* storage blocked */ } };

    async function load() {
      $('[data-cl-note]').textContent = live()
        ? 'Los cambios salen en el sitio la próxima vez que el sitio se actualice (cuando se publica). Un columnista apagado deja de salir en Opiniones; sus columnas siguen publicadas.'
        : 'VISTA PREVIA: sin la base de datos, los cambios se guardan solo en este dispositivo.';
      if (!live()) { rows = readLocal(); return paint(); }
      $('[data-cl-list]').innerHTML = '<li class="cl-empty">Cargando…</li>';
      const r = await listColumnists();
      $('[data-cl-missing]').hidden = r !== 'missing';
      if (r === 'missing') { rows = readLocal(); return paint(); }
      if (!r) { $('[data-cl-list]').innerHTML = '<li class="cl-empty">No se pudo cargar. Revisa tu conexión.</li>'; return; }
      rows = r; paint();
    }

    function paint() {
      const sorted = [...rows].sort((a, b) => Number(b.active) - Number(a.active) || (a.sort ?? 0) - (b.sort ?? 0) || a.name.localeCompare(b.name));
      $('[data-cl-list]').innerHTML = sorted.map((c) => `
        <li class="cl-card${c.active ? '' : ' off'}">
          <span class="cl-pic">${pic(c)}</span>
          <span class="cl-who"><b>${esc(c.name)}</b><small>${esc(c.role || 'Columnista')}</small>${c.bio ? `<span class="cl-bio">${esc(c.bio)}</span>` : '<span class="cl-bio cl-nobio">Sin biografía todavía</span>'}</span>
          <label class="cl-switch" title="${c.active ? 'Sale en el sitio' : 'No sale en el sitio'}"><input type="checkbox" data-cl-on="${esc(c.slug)}" ${c.active ? 'checked' : ''} /><i aria-hidden="true"></i><span>${c.active ? 'En el sitio' : 'Apagado'}</span></label>
          <button type="button" class="pnl-link" data-cl-edit="${esc(c.slug)}">Editar</button>
        </li>`).join('') || '<li class="cl-empty">Todavía no hay columnistas. Crea el primero con «+ Nuevo columnista».</li>';
    }

    function open(c: ColumnistRow | null) {
      editing = c;
      $('[data-cl-form-h]').textContent = c ? `Editar: ${c.name}` : 'Nuevo columnista';
      form.reset();
      for (const k of ['name', 'role', 'bio', 'photo', 'email', 'website', 'x', 'instagram', 'facebook'] as const) f(k).value = (c?.[k] as string) ?? '';
      f('videos').value = (c?.videos ?? []).join('\n');
      f('sort').value = String(c?.sort ?? rows.length + 1);
      f('active').checked = c ? c.active : true;
      $('[data-cl-del]').hidden = !c || role() !== 'admin'; // the administrator deletes a profile for good (owner, 2026-11-17)
      $('[data-cl-err]').hidden = true;
      showPic();
      form.hidden = false;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      f('name').focus({ preventScroll: true });
    }
    const showPic = () => { $('[data-cl-pic]').innerHTML = pic({ name: f('name').value, photo: f('photo').value.trim() }); };

    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-cl-new]')) open(null);
      const ed = t.closest<HTMLElement>('[data-cl-edit]'); if (ed) open(rows.find((r) => r.slug === ed.dataset.clEdit) ?? null);
      if (t.closest('[data-cl-cancel]')) { form.hidden = true; editing = null; }
      if (t.closest('[data-cl-nophoto]')) { f('photo').value = ''; showPic(); }
      if (t.closest('[data-cl-del]') && editing) {
        const c = editing;
        if (!(await ask(`¿Borrar el perfil de ${c.name} para siempre? Deja de salir en Opinión y no se puede recuperar desde el panel. Sus columnas publicadas no se borran.`, { ok: 'Borrar perfil', danger: true }))) return;
        if (live() && !(await deleteColumnist(c.slug))) return toast('No se pudo borrar. ¿Ya corriste supabase/columnistas-borrar.sql?');
        rows = rows.filter((r) => r.slug !== c.slug); if (!live()) writeLocal();
        form.hidden = true; editing = null; paint(); toast(`Perfil de ${c.name} borrado.`);
      }
    });
    form.addEventListener('input', (e) => { const n = (e.target as HTMLInputElement).name; if (n === 'photo' || n === 'name') showPic(); });

    // The on/off switch on each card
    root.addEventListener('change', async (e) => {
      const box = (e.target as HTMLElement).closest<HTMLInputElement>('[data-cl-on]');
      if (box) {
        const c = rows.find((r) => r.slug === box.dataset.clOn); if (!c) return;
        const on = box.checked;
        if (live()) { box.disabled = true; const ok = await setColumnistActive(c.slug, on); box.disabled = false; if (!ok) { box.checked = !on; return toast('No se pudo cambiar. Revisa tu conexión.'); } }
        c.active = on; if (!live()) writeLocal(); paint();
        return toast(on ? `${c.name} sale en el sitio.` : `${c.name} quedó apagado: no sale en el sitio.`);
      }
      // Photo upload: square-ish picture, up to 5 MB
      const file = (e.target as HTMLInputElement).closest<HTMLInputElement>('[data-cl-file]')?.files?.[0];
      if (file) {
        if (file.size > 5 * 1024 * 1024) return toast('La foto pesa más de 5 MB. Escoge una más liviana.');
        if (!live()) { const fr = new FileReader(); fr.onload = () => { f('photo').value = String(fr.result); showPic(); }; return fr.readAsDataURL(file); }
        toast('Subiendo la foto…');
        const ext = (file.type.split('/')[1] || 'jpg').replace('jpeg', 'jpg');
        const url = await uploadColumnistPhoto(`${slugify(f('name').value || 'columnista')}-${Date.now()}.${ext}`, file);
        if (!url) return toast('No se pudo subir la foto. ¿Ya corriste supabase/columnistas.sql?');
        f('photo').value = url; showPic(); toast('Foto lista. Recuerda guardar.');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = f('name').value.trim().replace(/\s+/g, ' ');
      const err = (m: string) => { const el = $('[data-cl-err]'); el.textContent = m; el.hidden = false; };
      if (name.length < 3) return err('Escribe el nombre completo del columnista.');
      const slug = editing?.slug ?? slugify(name);
      if (!editing && rows.some((r) => r.slug === slug)) return err('Ya existe un columnista con ese nombre. Búscalo en la lista y edítalo.');
      const v = (k: string) => f(k).value.trim() || null;
      const videos = f('videos').value.split(/\s+/).map((x) => x.trim()).filter((x) => /^https?:\/\//.test(x)).slice(0, 24);
      const row: ColumnistRow = { videos, slug, name, role: v('role') ?? 'Columnista', bio: v('bio'), photo: v('photo'), email: v('email'), website: v('website'), x: v('x'), instagram: v('instagram'), facebook: v('facebook'), active: f('active').checked, sort: Number(f('sort').value) || 0 };
      const btn = $<HTMLButtonElement>('[data-cl-save]'); btn.disabled = true;
      const problem = live() ? await saveColumnist(row) : '';
      btn.disabled = false;
      if (problem) return err(problem);
      rows = [...rows.filter((r) => r.slug !== slug), row];
      if (!live()) writeLocal();
      form.hidden = true; editing = null; paint();
      toast(`Guardado: ${name}.`);
    });

    // ---------- Requests, invitations and take-down requests (user, 2026-11-17) ----------
    type Req = { id: string; created_at: string; name: string; email: string; phone?: string; profession: string; topics: string; bio: string; links?: string; status: 'nueva' | 'aprobada' | 'rechazada'; note?: string; reviewed_at?: string };
    type Down = { id: string; created_at: string; slug: string; url?: string; title: string; reason: string; status: string };
    let reqs: Req[] = [], downs: Down[] = [], asked = false; // asked: loaded once (a missing table must not be asked again on every count)
    const role = () => { try { return JSON.parse(localStorage.getItem('nc-staff') || 'null')?.role ?? ''; } catch { return ''; } };
    const canReview = () => ['admin', 'editor', 'desk'].includes(role()); // administrator, Editor en jefe, Editor
    const when = (d: string) => new Date(d).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Puerto_Rico' });
    const linkify = (t: string) => esc(t).replace(/(https?:\/\/[^\s,]+)/g, '<a href="$1" target="_blank" rel="noopener nofollow">$1</a>');
    // The menu's count (index.astro listens); sent once the page's own script is listening
    const badge = () => setTimeout(() => dispatchEvent(new CustomEvent('nc-col-requests', { detail: reqs.filter((x) => x.status === 'nueva').length + downs.filter((x) => x.status === 'pedida').length })), 0);
    const stamp = () => ({ reviewed_at: new Date().toISOString(), reviewed_by: tokenInfo().id || null });
    const notLive = () => (isDemo() ? 'DEMO' : 'VISTA PREVIA');
    // Demo and preview: one sample of each, labeled EJEMPLO (no real person)
    const SAMPLE_REQ: Req = { id: 'ejemplo', created_at: new Date().toISOString(), name: 'Columnista (EJEMPLO)', email: 'ejemplo@correo.com', profession: 'Economista', topics: 'La economía de la familia y el costo de vida', bio: 'EJEMPLO para mostrar cómo se ve una solicitud: economista con experiencia en banca y en la universidad.', status: 'nueva' };
    const SAMPLE_DOWN: Down = { id: 'ejemplo-quitar', created_at: new Date().toISOString(), slug: 'ejemplo', title: 'Columna de ejemplo (EJEMPLO)', reason: 'EJEMPLO: quiero corregir un dato y volver a enviarla.', status: 'pedida' };
    function paintDowns() {
      const open = downs.filter((x) => x.status === 'pedida' || x.status === 'quitando');
      $('[data-cl-down]').hidden = !canReview() || !open.length;
      $('[data-cl-down-n]').textContent = open.length ? String(open.length) : '';
      $('[data-cl-down-list]').innerHTML = open.map((x) => `<li class="cl-rq">
        <div class="cl-rq-h"><b>${esc(x.title || x.slug)}</b><small>${when(x.created_at)}</small></div>
        <p><span class="cl-rq-k">Por qué:</span> ${esc(x.reason)}</p>
        ${x.url ? `<p><a href="${esc(x.url)}" target="_blank" rel="noopener">Ver la columna ↗</a></p>` : ''}
        <div class="cl-actions"><button type="button" class="adp-btn" data-dn-ok="${esc(x.id)}" ${x.status === 'quitando' ? 'disabled' : ''}>${x.status === 'quitando' ? 'Quitando…' : 'Quitar del sitio'}</button><button type="button" class="pnl-link" data-dn-no="${esc(x.id)}">Mantenerla</button></div>
      </li>`).join('');
      badge();
    }
    async function loadDowns() {
      if (!canReview()) return;
      if (!live()) { if (!downs.length) downs = [SAMPLE_DOWN]; return paintDowns(); }
      const r = await staffApi('column_takedowns?select=*&status=eq.pedida&order=created_at.asc');
      if (!r?.ok) return; // supabase/columnas-quitar.sql not run yet
      downs = await r.json(); paintDowns();
    }
    // Escribir took the column down (or couldn't): nc-takedown → nc-takedown-done
    addEventListener('nc-takedown-done', async (e) => {
      const { id, ok } = (e as CustomEvent).detail as { id: string; ok: boolean };
      const x = downs.find((d) => d.slug === id && d.status === 'quitando'); if (!x) return;
      if (ok) { await staffApi(`column_takedowns?id=eq.${x.id}`, { method: 'PATCH', body: JSON.stringify({ status: 'quitada', ...stamp() }) }); toast(`«${x.title}» se quitó del sitio.`); }
      x.status = 'pedida';
      void loadDowns();
    });
    // ---------- Columnist accounts: remove and bring back (user, 2026-11-17; supabase/columnistas-baja.sql) ----------
    const canRemove = () => ['admin', 'editor'].includes(role()); // administrator and Editor en jefe; Editors see the list
    type Acc = { id: string; name: string; email: string; accepted: boolean; lastSignIn: string | null };
    type Gone = { user_id: string; name: string; email: string; removed_at: string; note?: string | null };
    let accs: Acc[] = [], gone: Gone[] = [];
    function paintAccounts() {
      $('[data-cl-acc]').hidden = !canReview() || (!accs.length && !gone.length);
      $('[data-cl-acc-list]').innerHTML = accs.map((a) => `<li class="cl-acc"><span class="cl-acc-who"><b>${esc(a.name)}</b><small>${esc(a.email)} · ${a.accepted ? `última entrada ${a.lastSignIn ? when(a.lastSignIn) : '—'}` : 'invitación sin aceptar'}</small></span><span class="cl-acc-btns"><button type="button" class="pnl-link" data-person="${esc(JSON.stringify({ id: a.id, name: a.name, role: 'columnist', mail: a.email }))}">Ver ficha</button>${canRemove() ? `<button type="button" class="pnl-link danger" data-acc-off="${esc(a.id)}">Quitar acceso</button>` : ''}</span></li>`).join('')
        || '<li class="cl-empty">Ahora mismo no hay cuentas de columnista.</li>';
      $('[data-cl-before-box]').hidden = !gone.length;
      $('[data-cl-before]').innerHTML = gone.map((g) => `<li class="cl-acc"><span class="cl-acc-who"><b>${esc(g.name)}</b><small>${esc(g.email)} · sin acceso desde ${when(g.removed_at)}${g.note ? ` · ${esc(g.note)}` : ''}</small></span>${canRemove() ? `<button type="button" class="adp-btn ghost-dark" data-acc-back="${esc(g.user_id)}">Traer de vuelta</button>` : ''}</li>`).join('');
    }
    async function loadAccounts() {
      if (!canReview()) return;
      if (!live()) {
        if (!accs.length && !gone.length) {
          accs = [{ id: 'ejemplo', name: 'Columnista (EJEMPLO)', email: 'ejemplo@correo.com', accepted: true, lastSignIn: new Date().toISOString() }];
          gone = [{ user_id: 'ejemplo2', name: 'Columnista anterior (EJEMPLO)', email: 'ejemplo2@correo.com', removed_at: new Date(Date.now() - 20 * 864e5).toISOString(), note: 'EJEMPLO: dejó de escribir' }];
        }
      } else {
        const r = await teamAdmin('columnists');
        if (!r || r.error) return; // the "equipo" function isn't updated yet
        accs = r.list ?? []; gone = r.before ?? [];
      }
      paintAccounts();
    }
    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const off = t.closest<HTMLButtonElement>('[data-acc-off]'), back = t.closest<HTMLButtonElement>('[data-acc-back]');
      if (off) {
        const a = accs.find((x) => x.id === off.dataset.accOff); if (!a) return;
        if (!(await ask(`¿Quitar el acceso de columnista a ${a.name}? Ya no podrá entrar al panel y su perfil deja de salir en Opiniones. Sus columnas publicadas siguen en el sitio. Podrás traerlo de vuelta cuando quieras.`, { ok: 'Quitar acceso', danger: true }))) return;
        const notify = await ask(`¿Le enviamos un correo a ${a.email} avisándole que su cuenta fue desactivada? El correo le agradece su tiempo y le dice que sus columnas siguen publicadas.`, { ok: 'Sí, avisarle', cancel: 'No avisar' });
        const note = await askText('Nota interna (opcional): por qué se quitó el acceso. Solo la ve la redacción.', { ok: 'Guardar', placeholder: 'Ej.: dejó de escribir' });
        if (!live()) {
          accs = accs.filter((x) => x !== a); gone = [{ user_id: a.id, name: a.name, email: a.email, removed_at: new Date().toISOString(), note: note?.trim() || null }, ...gone]; paintAccounts();
          return toast(`${notLive()}: no se quita nada de verdad${notify ? ' ni se envía el correo' : ''}.`);
        }
        off.disabled = true; off.textContent = 'Quitando…';
        const r = await teamAdmin('columnist_off', { id: a.id, notify, note: note ?? '' });
        if (!r?.ok) { off.disabled = false; off.textContent = 'Quitar acceso'; return toast(r?.error ?? 'No se pudo quitar el acceso.'); }
        toast(`${a.name} ya no tiene acceso${notify ? ' y recibirá el correo' : ''}. Sus columnas siguen publicadas.`);
        await loadAccounts(); await load();
      }
      if (back) {
        const g = gone.find((x) => x.user_id === back.dataset.accBack); if (!g) return;
        if (!(await ask(`¿Traer de vuelta a ${g.name}? Le llegará un correo de bienvenida a ${g.email} para crear su contraseña otra vez, y su perfil vuelve a salir en Opiniones.`, { ok: 'Traer de vuelta' }))) return;
        if (!live()) {
          gone = gone.filter((x) => x !== g); accs = [...accs, { id: g.user_id, name: g.name, email: g.email, accepted: false, lastSignIn: null }]; paintAccounts();
          return toast(`${notLive()}: no se envía ningún correo.`);
        }
        back.disabled = true; back.textContent = 'Enviando…';
        const r = await teamAdmin('invite', { email: g.email, name: g.name.slice(0, 40), role: 'columnist', reason: 'regreso' });
        if (!r?.ok) { back.disabled = false; back.textContent = 'Traer de vuelta'; return toast(r?.error ?? 'No se pudo enviar.'); }
        toast(`Listo. ${g.name} recibirá el correo de bienvenida.`);
        await loadAccounts(); await load();
      }
    });

    async function loadReqs() {
      if (!canReview()) return;
      asked = true;
      void loadDowns(); void loadAccounts();
      if (!live()) { if (!reqs.length) reqs = [SAMPLE_REQ]; paintReqs(); badge(); return; }
      const r = await staffApi('columnist_requests?select=*&order=created_at.desc&limit=200');
      if (!r?.ok) return; // supabase/columnistas-solicitudes.sql not run yet
      reqs = await r.json(); paintReqs(); badge();
    }
    function paintReqs() {
      const open = reqs.filter((x) => x.status === 'nueva'), old = reqs.filter((x) => x.status !== 'nueva');
      $('[data-cl-req]').hidden = !canReview();
      $('[data-cl-req-n]').textContent = open.length ? String(open.length) : '';
      const card = (x: Req) => `<li class="cl-rq">
        <div class="cl-rq-h"><b>${esc(x.name)}</b><small>${esc(x.profession)} · ${when(x.created_at)}</small></div>
        <p><span class="cl-rq-k">Temas:</span> ${esc(x.topics)}</p>
        <p><span class="cl-rq-k">Sobre la persona:</span> ${esc(x.bio)}</p>
        <p><span class="cl-rq-k">Contacto:</span> <a href="mailto:${esc(x.email)}">${esc(x.email)}</a>${x.phone ? ` · ${esc(x.phone)}` : ''}</p>
        ${x.links ? `<p><span class="cl-rq-k">Enlaces:</span> ${linkify(x.links)}</p>` : ''}
        ${x.status === 'nueva' ? `<div class="cl-actions"><button type="button" class="adp-btn" data-rq-ok="${esc(x.id)}">Aprobar y enviar su cuenta</button><button type="button" class="pnl-link danger" data-rq-no="${esc(x.id)}">Rechazar</button></div>`
          : `<p class="pnl-chip ${x.status === 'aprobada' ? 'good' : ''}">${x.status === 'aprobada' ? 'Aprobada' : 'Rechazada'}${x.reviewed_at ? ` · ${when(x.reviewed_at)}` : ''}${x.note ? ` · ${esc(x.note)}` : ''}</p>`}
      </li>`;
      $('[data-cl-req-list]').innerHTML = open.map(card).join('') || '<li class="cl-empty">No hay solicitudes nuevas. Llegan desde «¿Quieres ser columnista?» en la página de Opiniones.</li>';
      $('[data-cl-req-old]').innerHTML = old.map(card).join('') || '<li class="cl-empty">Ninguna todavía.</li>';
    }
    // Approved request or a direct invitation → an account (Edge Function "equipo", role Columnista) and a profile,
    // turned off until their first column is out. Returns '' or the problem to show.
    async function makeColumnist(name: string, email: string, title: string, bio: string | null, reason: 'solicitud' | 'invitacion', message = ''): Promise<string> {
      if (!live()) return `${notLive()}: sin la base de datos no se envían invitaciones.`;
      const res = await teamAdmin('invite', { email, name: name.slice(0, 40), role: 'columnist', reason, message: message.slice(0, 600) });
      if (!res?.ok) return res?.error ?? 'No se pudo enviar la invitación.';
      if (!rows.length) { const all = await listColumnists(); if (Array.isArray(all)) rows = all; } // the list may not have loaded yet
      const slug = slugify(name);
      if (!rows.some((r) => r.slug === slug)) {
        const row: ColumnistRow = { slug, name, role: title || 'Columnista', bio, photo: null, email: null, website: null, x: null, instagram: null, facebook: null, active: false, sort: rows.length + 1, kind: 'columnista', owner: res.id ?? null }; // owner: they can edit it from Mi perfil público
        if (!(await saveColumnist(row))) rows = [...rows, row];
        paint();
      }
      return '';
    }
    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const inv = $<HTMLFormElement>('[data-cl-invite]');
      if (t.closest('[data-cl-invite-open]')) { inv.hidden = false; inv.reset(); $('[data-cl-ierr]').hidden = true; (inv.elements.namedItem('iname') as HTMLInputElement).focus(); return; }
      if (t.closest('[data-cl-invite-cancel]')) { inv.hidden = true; return; }
      // Take-down requests
      const dOk = t.closest<HTMLButtonElement>('[data-dn-ok]'), dNo = t.closest<HTMLButtonElement>('[data-dn-no]');
      const d = downs.find((q) => q.id === (dOk?.dataset.dnOk ?? dNo?.dataset.dnNo));
      if (d && dOk) {
        if (!(await ask(`¿Quitar «${d.title}» del sitio? Desaparece en unos minutos y queda como borrador en Escribir.`, { ok: 'Quitar del sitio', danger: true }))) return;
        if (!live()) { downs = downs.filter((x) => x !== d); paintDowns(); return toast(`${notLive()}: no se quita nada del sitio.`); }
        d.status = 'quitando'; paintDowns();
        dispatchEvent(new CustomEvent('nc-takedown', { detail: { id: d.slug } })); // Escribir takes it down (nc-takedown-done)
        return;
      }
      if (d && dNo) {
        if (!(await ask(`¿Mantener «${d.title}» en el sitio? El columnista verá que la redacción la mantuvo.`, { ok: 'Mantenerla' }))) return;
        if (!live()) { downs = downs.filter((x) => x !== d); paintDowns(); return toast(`${notLive()}: la columna se queda en el sitio.`); }
        await staffApi(`column_takedowns?id=eq.${d.id}`, { method: 'PATCH', body: JSON.stringify({ status: 'mantenida', ...stamp() }) });
        toast('La columna se queda en el sitio.'); void loadDowns(); return;
      }
      // Requests to be a columnist
      const ok = t.closest<HTMLButtonElement>('[data-rq-ok]'), no = t.closest<HTMLButtonElement>('[data-rq-no]');
      const x = reqs.find((q) => q.id === (ok ? ok.dataset.rqOk : no?.dataset.rqNo)); if (!x) return;
      if (ok) {
        if (!(await ask(`¿Aprobar a ${x.name}? Le llegará un correo a ${x.email} para crear su cuenta de columnista.`, { ok: 'Aprobar y enviar' }))) return;
        ok.disabled = true; ok.textContent = 'Enviando…';
        const problem = await makeColumnist(x.name, x.email, x.profession, x.bio, 'solicitud');
        if (problem) { ok.disabled = false; ok.textContent = 'Aprobar y enviar su cuenta'; return toast(problem); }
        await staffApi(`columnist_requests?id=eq.${x.id}`, { method: 'PATCH', body: JSON.stringify({ status: 'aprobada', ...stamp() }) });
        toast(`Aprobada. ${x.name} recibirá el correo para crear su cuenta. Su perfil quedó apagado: enciéndelo cuando salga su primera columna.`);
      } else {
        const note = await askText(`¿Rechazar la solicitud de ${x.name}? Puedes escribir una nota interna (opcional). La persona no recibe correo.`, { ok: 'Rechazar', danger: true, placeholder: 'Nota interna (opcional)' });
        if (note === null) return;
        if (!live()) { x.status = 'rechazada'; x.note = note.trim() || undefined; x.reviewed_at = new Date().toISOString(); paintReqs(); badge(); return toast(`${notLive()}: rechazada solo en esta pantalla.`); }
        await staffApi(`columnist_requests?id=eq.${x.id}`, { method: 'PATCH', body: JSON.stringify({ status: 'rechazada', note: note.trim() || null, ...stamp() }) });
        toast('Solicitud rechazada.');
      }
      await loadReqs();
    });
    $<HTMLFormElement>('[data-cl-invite]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fm = e.target as HTMLFormElement, g = (n: string) => (fm.elements.namedItem(n) as HTMLInputElement).value.trim();
      const err = (m: string) => { const el = $('[data-cl-ierr]'); el.textContent = m; el.hidden = !m; };
      if (g('iname').length < 3) return err('Escribe su nombre completo.');
      if (!/^\S+@\S+\.\S+$/.test(g('imail'))) return err('Escribe un correo válido.');
      const btn = $<HTMLButtonElement>('[data-cl-isend]'); btn.disabled = true; err('');
      const problem = await makeColumnist(g('iname').replace(/\s+/g, ' '), g('imail').toLowerCase(), g('irole'), null, 'invitacion', g('imsg'));
      btn.disabled = false;
      if (problem) return err(problem);
      fm.hidden = true; toast(`Invitación enviada a ${g('imail')}. Su perfil quedó apagado: enciéndelo cuando salga su primera columna.`);
    });
    // The menu's count shows from the start (administrator, Editor en jefe, Editor)
    if (canReview()) void loadReqs();
    let lastRole = role();
    addEventListener('nc-staff-change', () => { const r = role(); if (r !== lastRole) { lastRole = r; reqs = []; downs = []; accs = []; gone = []; asked = false; } if (canReview() && !asked) void loadReqs(); });

    // Load the first time the tab opens
    const pane = root.closest<HTMLElement>('[data-pane]');
    let loaded = false;
    const check = () => { if (pane && !pane.hidden && !loaded) { loaded = true; void load(); void loadReqs(); } };
    if (pane) new MutationObserver(check).observe(pane, { attributes: true, attributeFilter: ['hidden'] });
    check();
  }
</script>
