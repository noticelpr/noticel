---
// Photo library (src/lib/photos.ts), version 2 (2026-11-15): like PhotoShelter, and better.
//   · Upload many at once by dragging them in; the details saved inside each photo (IPTC/XMP/EXIF from the camera,
//     Lightroom or Photo Mechanic) fill the form by themselves; the same photo isn't uploaded twice.
//   · Albums by event (PhotoShelter's galleries), filters (album, photographer, rights, dates, stars, my photos),
//     star ratings, usage rights with an end date, sensitive photos blurred in the grid.
//   · Select several photos and edit them together; download; use a photo in a story with one click.
//   · Who uploads: administrators, editors, Fotoperiodistas, and reporters the administrator allowed (panel → Equipo).
//   mode="pane"   → the panel's Fotos tab
//   mode="picker" → a window inside Escribir: opened with the event nc-photo-open {target}, and "Usar esta foto"
//                   sends nc-photo-pick {photo, target} back to the editor
interface Props { mode?: 'pane' | 'picker' }
const { mode = 'pane' } = Astro.props;
const picker = mode === 'picker';
const tools = `
  <div class="pl-tools">
    <input type="search" class="pl-q" data-pl-q placeholder="Buscar: persona, lugar, tema, fotógrafo…" aria-label="Buscar fotos" />
    <select class="pl-sel" data-pl-album aria-label="Álbum" hidden><option value="">Todos los álbumes</option></select>
    <div class="pnl-range pl-src" role="group" aria-label="Fuente"><button type="button" data-pl-src="all" aria-pressed="true">Todas</button><button type="button" data-pl-src="lib" aria-pressed="false">Biblioteca</button><button type="button" data-pl-src="pub" aria-pressed="false">Publicadas</button></div>
    <button type="button" class="pnl-link" data-pl-ftoggle hidden aria-expanded="false">Filtros</button>
    <button type="button" class="pnl-link" data-pl-seltoggle hidden>Seleccionar</button>
  </div>
  <div class="pl-filters" data-pl-filters hidden>
    <label>Fotógrafo<input data-pl-f="photographer" placeholder="Nombre" /></label>
    <label>Derechos<select data-pl-f="rights"><option value="">Todos</option><option value="propia">Nuestras</option><option value="agencia">Agencia</option><option value="cedida">Cedidas</option><option value="libre">Licencia libre</option><option value="archivo">Archivo</option></select></label>
    <label>Desde<input type="date" data-pl-f="from" /></label>
    <label>Hasta<input type="date" data-pl-f="to" /></label>
    <label>Estrellas<select data-pl-f="minRating"><option value="">Todas</option><option value="3">★★★ o más</option><option value="4">★★★★ o más</option><option value="5">★★★★★</option></select></label>
    <label class="adb-check"><input type="checkbox" data-pl-f="mine" /> Solo mis fotos</label>
    <button type="button" class="pnl-link" data-pl-fclear>Limpiar</button>
  </div>
  <div class="pl-selbar" data-pl-selbar hidden><b data-pl-seln>0 seleccionadas</b><button type="button" class="adp-btn ghost-dark" data-pl-bulk>Editar juntas</button><button type="button" class="pnl-link" data-pl-selall>Seleccionar todas las visibles</button><button type="button" class="pnl-link" data-pl-selnone>Cancelar</button></div>`;
---
{picker ? (
  <dialog class="sd-dlg pl-dlg" data-pl-dlg aria-label="Biblioteca de fotos">
    <div class="pl" data-pl data-mode="picker">
      <header class="pl-head"><h2 class="pnl-h3">Elegir de la biblioteca</h2><button type="button" class="sd-x" data-pl-close aria-label="Cerrar">✕</button></header>
      <Fragment set:html={tools} />
      <div class="pl-head-btns"><button type="button" class="adp-btn ghost-dark" data-pl-upopen>+ Subir fotos</button></div>
      <p class="pnl-muted pnl-small" data-pl-count></p>
      <p class="sd-warn" data-pl-warn hidden></p>
      <div class="pl-grid" data-pl-grid></div>
      <div class="pl-more" data-pl-more aria-hidden="true"></div>
    </div>
  </dialog>
) : (
  <div class="pl" data-pl data-mode="pane">
    <header class="sd-head"><div><h1 class="pnl-h">Fotos</h1><p class="pnl-muted">La biblioteca de fotos de NotiCel: sube, organiza en álbumes por evento, busca y usa las fotos en las noticias sin salir del panel.</p></div>
      <div class="pl-head-btns"><button type="button" class="adp-btn ghost-dark" data-pl-albnew hidden>+ Nuevo álbum</button><button type="button" class="adp-btn" data-pl-upopen>+ Subir fotos</button></div></header>
    <Fragment set:html={tools} />
    <p class="pnl-muted pnl-small" data-pl-count></p>
    <p class="sd-warn" data-pl-warn hidden></p>
    <div class="pl-grid" data-pl-grid></div>
    <div class="pl-more" data-pl-more aria-hidden="true"></div>
  </div>
)}

<script>
  import { searchLibrary, searchPublished, addPhoto, updatePhoto, deletePhoto, checkV2, hasV2, listAlbums, createAlbum, setAlbumCover, findDuplicate, updateMany, canUpload, RIGHTS, type Photo, type Meta, type Album, type Filters } from '../../lib/photos';
  import { readPhotoInfo, fingerprint, type PhotoInfo } from '../../lib/photo-meta';
  import { ask } from '../../lib/dialogs';
  import { isDemo } from '../../lib/demo';
  const esc = (s = '') => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const me = () => { try { return JSON.parse(localStorage.getItem('nc-staff') || 'null') as { name: string; role: string; canPhotos?: boolean } | null; } catch { return null; } };
  const mayUpload = () => isDemo() || canUpload(me());
  const toast = (t: string) => dispatchEvent(new CustomEvent('nc-toast', { detail: t }));
  const stars = (n = 0) => (n > 0 ? '★'.repeat(n) : '');
  const rightsOptions = Object.entries(RIGHTS).map(([k, v]) => `<option value="${k}">${esc(v)}</option>`).join('');
  let albums: Album[] = [];
  const albumOptions = (first = 'Sin álbum') => `<option value="">${first}</option>${albums.map((a) => `<option value="${a.id}">${esc(a.name)}${a.event_date ? ` · ${new Date(`${a.event_date}T12:00`).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}` : ''}</option>`).join('')}`;

  // ---------- shared windows: one photo's details, upload, new album, edit several ----------
  const v2Fields = `
    <div class="wr-2 pl-v2"><label>Fotógrafo<input name="photographer" maxlength="120" placeholder="Quién tomó la foto" /></label><label>Álbum<select name="album_id"></select></label></div>
    <div class="wr-2 pl-v2"><label>Derechos de uso<select name="rights">${rightsOptions}</select></label><label>Se puede usar hasta<input name="rights_until" type="date" /></label></div>
    <label class="pl-v2">Nota de derechos<input name="rights_note" maxlength="200" placeholder="ej. EFE, solo uso editorial" /></label>
    <div class="wr-2 pl-v2"><label>Estrellas<select name="rating"><option value="0">Sin estrellas</option><option value="1">★</option><option value="2">★★</option><option value="3">★★★</option><option value="4">★★★★</option><option value="5">★★★★★</option></select></label>
      <label class="adb-check pl-sens"><input type="checkbox" name="sensitive" /> Imagen sensible (sale borrosa en la biblioteca)</label></div>`;
  const shell = document.createElement('div');
  shell.innerHTML = `
    <dialog class="sd-dlg pl-view" data-plv aria-label="Foto"><div class="pl-view-in">
      <div class="pl-view-img"><img data-plv-img alt="" /></div>
      <form class="sd-form pl-view-f" data-plv-f novalidate>
        <header class="sd-dlg-h"><h2 data-plv-h>Foto</h2><button type="button" class="sd-x" data-plv-close aria-label="Cerrar">✕</button></header>
        <p class="pnl-muted pnl-small" data-plv-info></p>
        <label>Qué se ve (pie de foto)<textarea name="caption" rows="2" maxlength="300"></textarea></label>
        <label>Crédito<input name="credit" maxlength="160" placeholder="Foto: Nombre / NotiCel" /></label>
        <div class="wr-2"><label>Lugar<input name="place" maxlength="120" /></label><label>Fecha de la foto<input name="taken_on" type="date" /></label></div>
        <label>Personas<input name="people" maxlength="200" placeholder="Quién aparece" /></label>
        <label>Etiquetas<input name="tags" maxlength="300" placeholder="Palabras para encontrarla, separadas por comas" /></label>
        ${v2Fields}
        <label>Enlace de la licencia (opcional)<input name="credit_url" type="url" maxlength="500" /></label>
        <p class="cm-err" data-plv-err hidden></p>
        <div class="sd-dlg-f"><button type="button" class="apr-reject" data-plv-del hidden>Borrar</button><a class="pnl-link" data-plv-dl download target="_blank" rel="noopener">Descargar</a><button type="button" class="pnl-link" data-plv-cover hidden>Portada del álbum</button><button type="button" class="pnl-link" data-plv-copy>Copiar enlace</button>
          <button type="submit" class="adp-btn ghost-dark" data-plv-save>Guardar cambios</button><button type="button" class="adp-btn" data-plv-use hidden>Usar esta foto</button></div>
      </form></div></dialog>
    <dialog class="sd-dlg pl-up" data-plu aria-label="Subir fotos"><form class="sd-form" data-plu-f novalidate>
      <header class="sd-dlg-h"><h2>Subir fotos a la biblioteca</h2><button type="button" class="sd-x" data-plu-close aria-label="Cerrar">✕</button></header>
      <label class="pl-drop" data-plu-drop><input type="file" name="files" accept="image/*" multiple class="sr" /><b>Arrastra las fotos aquí</b><span>o toca para escogerlas (hasta 100 a la vez). Leemos el pie, las palabras clave, el crédito y la fecha que ya traen de la cámara, Lightroom o Photo Mechanic.</span></label>
      <ul class="pl-up-list" data-plu-list></ul>
      <p class="pnl-muted pnl-small">Lo que escribas aquí se usa en las fotos que no lo traen. Marca «Reemplazar» para ponerlo en todas.</p>
      <label class="pl-v2">Álbum<select name="album_id"></select></label>
      <label>Qué se ve (pie de foto)<textarea name="caption" rows="2" maxlength="300" placeholder="ej. Conferencia de prensa sobre la reforma energética en La Fortaleza"></textarea></label>
      <div class="wr-2"><label class="pl-v2">Fotógrafo<input name="photographer" maxlength="120" /></label><label>Crédito<input name="credit" maxlength="160" placeholder="Foto: Nombre / NotiCel" /></label></div>
      <div class="wr-2"><label>Lugar<input name="place" maxlength="120" placeholder="San Juan" /></label><label>Fecha de la foto<input name="taken_on" type="date" /></label></div>
      <label>Personas<input name="people" maxlength="200" placeholder="Quién aparece" /></label>
      <label>Etiquetas<input name="tags" maxlength="300" placeholder="ej. gobierno, energía, LUMA" /></label>
      <div class="wr-2 pl-v2"><label>Derechos de uso<select name="rights">${rightsOptions}</select></label><label>Nota de derechos<input name="rights_note" maxlength="200" placeholder="opcional" /></label></div>
      <label class="adb-check pl-v2"><input type="checkbox" name="sensitive" /> Imágenes sensibles (salen borrosas en la biblioteca)</label>
      <label class="adb-check"><input type="checkbox" name="override" /> Reemplazar los datos que traen las fotos con estos</label>
      <label class="adb-check"><input type="checkbox" name="rights_ok" required /> Estas fotos son nuestras o tenemos permiso para usarlas.</label>
      <p class="cm-err" data-plu-err hidden></p>
      <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-plu-close>Cancelar</button><button type="submit" class="adp-btn" data-plu-go>Subir</button></div>
    </form></dialog>
    <dialog class="sd-dlg pl-up" data-pla aria-label="Nuevo álbum"><form class="sd-form" data-pla-f novalidate>
      <header class="sd-dlg-h"><h2>Nuevo álbum</h2><button type="button" class="sd-x" data-pla-close aria-label="Cerrar">✕</button></header>
      <label>Nombre del evento<input name="name" maxlength="120" required placeholder="ej. Desfile de Puertorriqueñidad 2026" /></label>
      <div class="wr-2"><label>Fecha<input name="event_date" type="date" /></label><label>Lugar<input name="place" maxlength="120" /></label></div>
      <label>Notas<textarea name="notes" rows="2" maxlength="400"></textarea></label>
      <p class="cm-err" data-pla-err hidden></p>
      <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-pla-close>Cancelar</button><button type="submit" class="adp-btn">Crear álbum</button></div>
    </form></dialog>
    <dialog class="sd-dlg pl-up" data-plb aria-label="Editar varias fotos"><form class="sd-form" data-plb-f novalidate>
      <header class="sd-dlg-h"><h2 data-plb-h>Editar varias fotos</h2><button type="button" class="sd-x" data-plb-close aria-label="Cerrar">✕</button></header>
      <p class="pnl-muted pnl-small">Solo se cambian los campos que llenes; lo demás de cada foto se queda igual.</p>
      <label>Álbum<select name="album_id"></select></label>
      <label>Qué se ve (pie de foto)<textarea name="caption" rows="2" maxlength="300"></textarea></label>
      <div class="wr-2"><label>Fotógrafo<input name="photographer" maxlength="120" /></label><label>Crédito<input name="credit" maxlength="160" /></label></div>
      <div class="wr-2"><label>Lugar<input name="place" maxlength="120" /></label><label>Fecha de la foto<input name="taken_on" type="date" /></label></div>
      <label>Etiquetas<input name="tags" maxlength="300" /></label>
      <div class="wr-2"><label>Derechos de uso<select name="rights"><option value="">Sin cambiar</option>${rightsOptions}</select></label><label>Estrellas<select name="rating"><option value="">Sin cambiar</option><option value="0">Quitar</option><option value="3">★★★</option><option value="4">★★★★</option><option value="5">★★★★★</option></select></label></div>
      <p class="cm-err" data-plb-err hidden></p>
      <div class="sd-dlg-f"><button type="button" class="adp-btn ghost-dark" data-plb-close>Cancelar</button><button type="submit" class="adp-btn">Aplicar</button></div>
    </form></dialog>`;
  document.body.append(shell);
  const $s = <T extends HTMLElement = HTMLElement>(q: string) => shell.querySelector<T>(q)!;
  const view = $s<HTMLDialogElement>('[data-plv]'), vf = $s<HTMLFormElement>('[data-plv-f]');
  const up = $s<HTMLDialogElement>('[data-plu]'), uf = $s<HTMLFormElement>('[data-plu-f]');
  const adlg = $s<HTMLDialogElement>('[data-pla]'), af = $s<HTMLFormElement>('[data-pla-f]');
  const bdlg = $s<HTMLDialogElement>('[data-plb]'), bf = $s<HTMLFormElement>('[data-plb-f]');
  const val = (f: HTMLFormElement, k: string) => { const el = f.elements.namedItem(k) as HTMLInputElement | null; return !el ? '' : el.type === 'checkbox' ? (el.checked ? '1' : '') : el.value.trim(); };
  const metaOf = (f: HTMLFormElement): Meta => {
    const m: Meta = { caption: val(f, 'caption'), credit: val(f, 'credit'), credit_url: val(f, 'credit_url'), place: val(f, 'place'), people: val(f, 'people'), tags: val(f, 'tags'), taken_on: val(f, 'taken_on') || null };
    if (hasV2()) Object.assign(m, { photographer: val(f, 'photographer'), album_id: val(f, 'album_id') || null, rights: (val(f, 'rights') || 'propia') as Meta['rights'], rights_note: val(f, 'rights_note'), rights_until: val(f, 'rights_until') || null, rating: Number(val(f, 'rating')) || 0, sensitive: !!val(f, 'sensitive') });
    return m;
  };
  const showV2 = () => shell.querySelectorAll<HTMLElement>('.pl-v2').forEach((e) => (e.hidden = !hasV2()));
  const fillAlbumSelects = () => { shell.querySelectorAll<HTMLSelectElement>('select[name="album_id"]').forEach((s) => { const cur = s.value; s.innerHTML = albumOptions(s.closest('[data-plb]') ? 'Sin cambiar' : 'Sin álbum'); s.value = cur; }); };

  const libs: Array<{ reload: () => void; refreshAlbums: () => void }> = [];
  let viewing: { photo: Photo; lib: boolean; onPick?: (p: Photo) => void; done: () => void } | null = null;
  let selection = new Set<string>();
  let v2Ready: Promise<void> | null = null;
  const ensureV2 = () => (v2Ready ??= (async () => { if (!isDemo() && await checkV2()) albums = await listAlbums(); showV2(); fillAlbumSelects(); libs.forEach((l) => l.refreshAlbums()); })());

  document.querySelectorAll<HTMLElement>('[data-pl]').forEach((root) => {
    const pickerMode = root.dataset.mode === 'picker';
    const dlg = root.closest<HTMLDialogElement>('[data-pl-dlg]');
    const q$ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s);
    const grid = q$('[data-pl-grid]')!, more = q$('[data-pl-more]')!, count = q$('[data-pl-count]')!, warn = q$('[data-pl-warn]')!;
    const qIn = q$<HTMLInputElement>('[data-pl-q]')!, albSel = q$<HTMLSelectElement>('[data-pl-album]')!;
    let q = '', src: 'all' | 'lib' | 'pub' = 'all', page = 0, done = false, busy = false, run = 0, items: Array<{ p: Photo; lib: boolean }> = [], libTotal = 0, pubLeft: Photo[] = [];
    let target = '', selecting = false; const filters: Filters = {};

    const card = (p: Photo, lib: boolean, i: number) => `<button type="button" class="pl-item${p.sensitive ? ' sens' : ''}${p.id && selection.has(p.id) ? ' picked' : ''}" data-i="${i}" title="${esc(p.caption || p.story || '')}">
      <img src="${esc(p.thumb || p.src)}" alt="${esc(p.caption || '')}" loading="lazy" decoding="async" />
      <span class="pl-cap">${esc(p.caption || p.story || 'Sin descripción')}${p.photographer ? `<small>${esc(p.photographer)}</small>` : ''}</span>
      ${lib ? '' : '<span class="pl-tag">Publicada</span>'}${p.rights && p.rights !== 'propia' ? `<span class="pl-tag pl-r">${esc(RIGHTS[p.rights].split(' ')[0])}</span>` : ''}
      ${p.rating ? `<span class="pl-stars">${stars(p.rating)}</span>` : ''}${lib && selecting ? `<span class="pl-check" aria-hidden="true">${p.id && selection.has(p.id) ? '✓' : ''}</span>` : ''}</button>`;
    async function next() {
      if (busy || done) return; busy = true; const mine = run;
      await ensureV2();
      const add: Array<{ p: Photo; lib: boolean }> = [];
      const filtering = Object.values(filters).some(Boolean);
      if (src !== 'pub' && page >= 0) {
        const r = await searchLibrary(q, page, filters);
        if (mine !== run) return;
        if (!r) { warn.textContent = isDemo() ? 'Modo demo: aquí también sale la biblioteca de fotos del equipo. Ahora ves las fotos que ya salieron en noticias.' : 'La biblioteca del equipo todavía no está conectada (falta correr supabase/fotos.sql). Por ahora ves las fotos ya publicadas.'; warn.hidden = false; page = -1; }
        else { warn.hidden = true; libTotal = r.total; add.push(...r.rows.map((p) => ({ p, lib: true }))); page = r.rows.length < 48 ? -1 : page + 1; }
      }
      if (page < 0 || src === 'pub') { // the team's library is done: then the published ones (not when filtering the library)
        if (!pubLeft.length && !items.some((x) => !x.lib) && src !== 'lib' && !filtering) pubLeft = await searchPublished(q);
        if (mine !== run) return;
        if (src !== 'lib' && !filtering) add.push(...pubLeft.splice(0, 48).map((p) => ({ p, lib: false })));
        if (!pubLeft.length) done = true;
      }
      const start = items.length; items.push(...add);
      grid.insertAdjacentHTML('beforeend', add.map((x, k) => card(x.p, x.lib, start + k)).join(''));
      const pubCount = items.filter((x) => !x.lib).length + pubLeft.length;
      count.textContent = items.length ? `${src === 'pub' ? '' : `${libTotal.toLocaleString('es-PR')} en la biblioteca`}${src === 'all' && !filtering ? ' · ' : ''}${src === 'lib' || filtering ? '' : `${pubCount} publicadas`}${q ? ` con “${q}”` : ''}` : (q || filtering ? 'No encontramos fotos con esa búsqueda.' : 'Todavía no hay fotos. Toca “Subir fotos” para empezar.');
      busy = false;
      if (!done && more.getBoundingClientRect().top < innerHeight + 600) void next(); // keep filling while the end is in view
    }
    function reload() { run++; items = []; page = 0; done = false; busy = false; pubLeft = []; grid.innerHTML = ''; count.textContent = 'Buscando…'; void next(); }
    const refreshAlbums = () => {
      albSel.hidden = !hasV2(); const cur = albSel.value;
      albSel.innerHTML = `<option value="">Todos los álbumes</option>${albums.map((a) => `<option value="${a.id}">${esc(a.name)} (${a.count ?? 0})</option>`).join('')}`; albSel.value = cur;
      q$('[data-pl-ftoggle]')!.hidden = !hasV2();
      q$('[data-pl-seltoggle]')!.hidden = !hasV2() || pickerMode || !mayUpload();
      const nb = q$('[data-pl-albnew]'); if (nb) nb.hidden = !hasV2() || !mayUpload();
      root.querySelectorAll<HTMLElement>('[data-pl-upopen]').forEach((b) => (b.hidden = !mayUpload()));
    };
    new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) void next(); }, { root: pickerMode ? dlg : null, rootMargin: '600px' }).observe(more);
    let t = 0; qIn.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { q = qIn.value.trim(); reload(); }, 300); });
    albSel.addEventListener('change', () => { filters.album = albSel.value || undefined; reload(); });
    root.querySelectorAll<HTMLButtonElement>('[data-pl-src]').forEach((b) => b.addEventListener('click', () => {
      src = b.dataset.plSrc as typeof src; root.querySelectorAll('[data-pl-src]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); reload();
    }));
    // Filters
    const fbox = q$('[data-pl-filters]')!;
    q$('[data-pl-ftoggle]')!.addEventListener('click', (e) => { fbox.hidden = !fbox.hidden; (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(!fbox.hidden)); });
    fbox.addEventListener('change', (e) => {
      const el = (e.target as HTMLInputElement).closest<HTMLInputElement>('[data-pl-f]'); if (!el) return;
      const k = el.dataset.plF as keyof Filters;
      if (k === 'mine') filters.mine = el.checked ? me()?.name : undefined;
      else if (k === 'minRating') filters.minRating = Number(el.value) || undefined;
      else (filters as Record<string, unknown>)[k] = el.value || undefined;
      reload();
    });
    q$('[data-pl-fclear]')!.addEventListener('click', () => { fbox.querySelectorAll<HTMLInputElement>('[data-pl-f]').forEach((i) => (i.type === 'checkbox' ? (i.checked = false) : (i.value = ''))); const a = filters.album; Object.keys(filters).forEach((k) => delete (filters as Record<string, unknown>)[k]); filters.album = a; reload(); });
    // Select several
    const bar = q$('[data-pl-selbar]')!;
    const paintSel = () => { bar.hidden = !selecting; q$('[data-pl-seln]')!.textContent = `${selection.size} ${selection.size === 1 ? 'seleccionada' : 'seleccionadas'}`; grid.querySelectorAll<HTMLElement>('[data-i]').forEach((b) => { const x = items[Number(b.dataset.i)]; const on = !!x.p.id && selection.has(x.p.id); b.classList.toggle('picked', on); const c = b.querySelector('.pl-check'); if (c) c.textContent = on ? '✓' : ''; }); };
    q$('[data-pl-seltoggle]')!.addEventListener('click', () => { selecting = !selecting; selection.clear(); grid.innerHTML = ''; grid.insertAdjacentHTML('beforeend', items.map((x, i) => card(x.p, x.lib, i)).join('')); paintSel(); });
    q$('[data-pl-selnone]')!.addEventListener('click', () => { selecting = false; selection.clear(); grid.innerHTML = ''; grid.insertAdjacentHTML('beforeend', items.map((x, i) => card(x.p, x.lib, i)).join('')); paintSel(); });
    q$('[data-pl-selall]')!.addEventListener('click', () => { items.forEach((x) => x.lib && x.p.id && selection.add(x.p.id)); paintSel(); });
    q$('[data-pl-bulk]')!.addEventListener('click', () => { if (!selection.size) return toast('Escoge al menos una foto.'); bf.reset(); fillAlbumSelects(); $s('[data-plb-h]').textContent = `Editar ${selection.size} ${selection.size === 1 ? 'foto' : 'fotos'}`; $s('[data-plb-err]').hidden = true; bdlg.showModal(); });
    grid.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-i]'); if (!b) return;
      const x = items[Number(b.dataset.i)];
      if (selecting) { if (!x.lib || !x.p.id) return toast('Solo se pueden editar juntas las fotos de la biblioteca.'); selection.has(x.p.id) ? selection.delete(x.p.id) : selection.add(x.p.id); paintSel(); return; }
      open(x.p, x.lib, pickerMode ? (p) => { dispatchEvent(new CustomEvent('nc-photo-pick', { detail: { photo: p, target } })); dlg?.close(); } : undefined, () => reload());
    });
    root.querySelectorAll('[data-pl-upopen]').forEach((b) => b.addEventListener('click', () => openUpload(filters.album)));
    q$('[data-pl-albnew]')?.addEventListener('click', () => { af.reset(); $s('[data-pla-err]').hidden = true; adlg.showModal(); });
    libs.push({ reload, refreshAlbums });
    refreshAlbums();
    if (pickerMode && dlg) {
      addEventListener('nc-photo-open', (e) => { target = (e as CustomEvent).detail?.target ?? ''; dlg.showModal(); if (!items.length) reload(); qIn.focus(); });
      q$('[data-pl-close]')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    } else {
      // The pane loads when its tab opens
      const pane = root.closest<HTMLElement>('[data-pane]');
      if (pane) new MutationObserver(() => { if (!pane.hidden && !items.length) reload(); }).observe(pane, { attributes: true, attributeFilter: ['hidden'] });
      if (!pane || !pane.hidden) reload();
    }
  });
  const reloadAll = () => libs.forEach((l) => l.reload());
  const refreshAlbumsAll = async () => { albums = await listAlbums(); fillAlbumSelects(); libs.forEach((l) => l.refreshAlbums()); };

  // ---------- one photo: details, edit, delete, download, use ----------
  function open(p: Photo, lib: boolean, onPick: ((p: Photo) => void) | undefined, refresh: () => void) {
    viewing = { photo: p, lib, onPick, done: refresh };
    fillAlbumSelects(); showV2();
    $s<HTMLImageElement>('[data-plv-img]').src = p.src;
    $s('[data-plv-h]').textContent = lib ? 'Foto de la biblioteca' : 'Foto publicada';
    const when = p.created_at ? ` el ${new Date(p.created_at).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}` : '';
    $s('[data-plv-info]').innerHTML = lib
      ? `Subida por ${esc(p.uploaded_by_name || '—')}${when}${p.width ? ` · ${p.width}×${p.height}` : ''}${p.camera ? ` · ${esc(p.camera)}` : ''}${p.rights_until ? ` · <b>Uso permitido hasta ${new Date(`${p.rights_until}T12:00`).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}</b>` : ''}`
      : `${p.storyUrl ? `Salió en <a href="${esc(p.storyUrl)}" target="_blank" rel="noopener">${esc(p.story || 'una noticia')}</a>` : esc(p.section || '')}`;
    const canEdit = lib && mayUpload();
    ['caption', 'credit', 'credit_url', 'place', 'people', 'tags', 'taken_on', 'photographer', 'album_id', 'rights', 'rights_note', 'rights_until', 'rating', 'sensitive'].forEach((k) => {
      const el = vf.elements.namedItem(k) as HTMLInputElement | null; if (!el) return;
      const v = (p as Record<string, unknown>)[k === 'credit_url' && !lib ? 'creditUrl' : k];
      if (el.type === 'checkbox') el.checked = !!v; else el.value = String(v ?? (k === 'rights' ? 'propia' : k === 'rating' ? '0' : ''));
      el.disabled = !canEdit;
    });
    const role = me()?.role ?? '';
    $s('[data-plv-save]').hidden = !canEdit;
    $s('[data-plv-del]').hidden = !(lib && ['admin', 'editor'].includes(role));
    $s('[data-plv-use]').hidden = !onPick;
    $s('[data-plv-cover]').hidden = !(lib && canEdit && p.album_id);
    const dl = $s<HTMLAnchorElement>('[data-plv-dl]'); dl.href = p.original || p.src;
    $s('[data-plv-err]').hidden = true;
    view.showModal();
  }
  const verr = (t: string) => { const e = $s('[data-plv-err]'); e.textContent = t; e.hidden = false; };
  vf.addEventListener('submit', async (e) => {
    e.preventDefault(); if (!viewing?.lib || !viewing.photo.id) return;
    const m = metaOf(vf); if (!m.credit.trim()) return verr('El crédito es obligatorio.');
    if (!(await updatePhoto(viewing.photo.id, m))) return verr('No se pudo guardar. Solo quien la subió o un editor puede cambiarla.');
    Object.assign(viewing.photo, m); toast('Cambios guardados.'); view.close(); viewing.done(); if (hasV2()) void refreshAlbumsAll();
  });
  $s('[data-plv-use]').addEventListener('click', () => {
    if (!viewing?.onPick) return;
    const p = viewing.lib ? { ...viewing.photo, ...metaOf(vf) } : viewing.photo; // what the reporter sees (and maybe edited) goes into the story
    view.close(); viewing.onPick(p);
  });
  $s('[data-plv-cover]').addEventListener('click', async () => { if (!viewing?.photo.album_id) return; await setAlbumCover(viewing.photo.album_id, viewing.photo.thumb); toast('Es la portada del álbum.'); void refreshAlbumsAll(); });
  $s('[data-plv-copy]').addEventListener('click', async () => { try { await navigator.clipboard.writeText(viewing!.photo.src); toast('Enlace copiado.'); } catch { toast(viewing!.photo.src); } });
  $s('[data-plv-del]').addEventListener('click', async () => {
    if (!viewing?.photo.id || !(await ask('¿Borrar esta foto de la biblioteca? Las noticias que ya la usan seguirán mostrándola solo si está publicada en otro lugar.', { ok: 'Borrar', danger: true }))) return;
    if (await deletePhoto(viewing.photo)) { toast('Foto borrada.'); view.close(); viewing.done(); } else verr('No se pudo borrar. Solo los editores y el administrador pueden borrar fotos.');
  });
  $s('[data-plv-close]').addEventListener('click', () => view.close());
  view.addEventListener('click', (e) => { if (e.target === view) view.close(); });

  // ---------- new album ----------
  shell.querySelectorAll('[data-pla-close]').forEach((b) => b.addEventListener('click', () => adlg.close()));
  af.addEventListener('submit', async (e) => {
    e.preventDefault(); const name = val(af, 'name'); const err = $s('[data-pla-err]');
    if (name.length < 3) { err.textContent = 'Escribe el nombre del evento.'; err.hidden = false; return; }
    const a = await createAlbum({ name, event_date: val(af, 'event_date'), place: val(af, 'place'), notes: val(af, 'notes') }, me()?.name ?? '');
    if (!a) { err.textContent = 'No se pudo crear. ¿Ya corriste supabase/fotos-v2.sql?'; err.hidden = false; return; }
    adlg.close(); toast(`Álbum «${a.name}» creado.`); await refreshAlbumsAll();
  });

  // ---------- edit several at once ----------
  shell.querySelectorAll('[data-plb-close]').forEach((b) => b.addEventListener('click', () => bdlg.close()));
  bf.addEventListener('submit', async (e) => {
    e.preventDefault();
    const patch: Partial<Meta> = {};
    (['caption', 'photographer', 'credit', 'place', 'tags', 'taken_on', 'album_id', 'rights'] as const).forEach((k) => { const v = val(bf, k); if (v) (patch as Record<string, unknown>)[k] = v; });
    const r = val(bf, 'rating'); if (r !== '') patch.rating = Number(r);
    if (!Object.keys(patch).length) { const er = $s('[data-plb-err]'); er.textContent = 'Llena al menos un campo.'; er.hidden = false; return; }
    const n = await updateMany([...selection], patch);
    bdlg.close(); toast(n ? `${n} ${n === 1 ? 'foto actualizada' : 'fotos actualizadas'}.` : 'No se pudo. Solo quien las subió o un editor puede cambiarlas.');
    selection.clear(); reloadAll(); void refreshAlbumsAll();
  });

  // ---------- upload: many at once; each photo's own saved details are used, the form fills what's missing ----------
  type Item = { file: File; info: PhotoInfo; hash?: string; dup?: Photo | null; url: string };
  let files: Item[] = [];
  const list = $s('[data-plu-list]');
  const paintFiles = () => {
    list.innerHTML = files.map((f, i) => `<li data-fi="${i}" class="${f.dup ? 'dup' : ''}"><img src="${f.url}" alt="" /><span><b>${esc(f.info.caption || f.info.headline || f.file.name)}</b><small>${esc([f.info.photographer, f.info.takenOn, f.info.keywords?.slice(0, 4).join(', ')].filter(Boolean).join(' · ') || `${(f.file.size / 1048576).toFixed(1)} MB`)}${f.dup ? ' · <em>Ya está en la biblioteca: no se subirá</em>' : ''}</small></span><button type="button" class="sd-x" data-fx="${i}" aria-label="Quitar">✕</button></li>`).join('');
  };
  async function openUpload(album?: string) {
    if (!mayUpload()) return toast('Tu cuenta no puede subir fotos. Pídele al administrador que lo permita en Equipo.');
    await ensureV2(); uf.reset(); files.forEach((f) => URL.revokeObjectURL(f.url)); files = []; paintFiles(); fillAlbumSelects(); showV2();
    if (album) (uf.elements.namedItem('album_id') as HTMLSelectElement).value = album;
    if (me()?.role === 'photo') (uf.elements.namedItem('photographer') as HTMLInputElement).value = me()!.name; // a photojournalist's own photos
    $s('[data-plu-err]').hidden = true; up.showModal();
  }
  const pickFiles = async (l: FileList | null) => {
    if (!l) return;
    const add = [...l].filter((f) => f.type.startsWith('image/') || /\.(jpe?g|png|webp|heic)$/i.test(f.name)).slice(0, 100 - files.length);
    for (const file of add) files.push({ file, info: {}, url: URL.createObjectURL(file) });
    paintFiles();
    // Read each photo's saved details and check it isn't already in the library
    for (const it of files) {
      if (it.hash) continue;
      it.info = await readPhotoInfo(it.file);
      it.hash = await fingerprint(it.file).catch(() => undefined);
      it.dup = it.hash && hasV2() ? await findDuplicate(it.hash) : null;
      paintFiles();
    }
    // The first photo's details suggest the batch's place and date when the form is empty
    const first = files.find((f) => f.info.city || f.info.takenOn)?.info;
    if (first) { const pl = uf.elements.namedItem('place') as HTMLInputElement, dt = uf.elements.namedItem('taken_on') as HTMLInputElement; if (!pl.value) pl.value = first.place ? `${first.place}, ${first.city ?? ''}`.replace(/, $/, '') : first.city ?? ''; if (!dt.value && first.takenOn) dt.value = first.takenOn; }
  };
  (uf.elements.namedItem('files') as HTMLInputElement).addEventListener('change', (e) => pickFiles((e.target as HTMLInputElement).files));
  list.addEventListener('click', (e) => { const x = (e.target as HTMLElement).closest<HTMLElement>('[data-fx]'); if (!x) return; const [gone] = files.splice(Number(x.dataset.fx), 1); URL.revokeObjectURL(gone.url); paintFiles(); });
  const drop = $s('[data-plu-drop]');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('on'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('on'));
  drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('on'); void pickFiles(e.dataTransfer?.files ?? null); });
  shell.querySelectorAll('[data-plu-close]').forEach((b) => b.addEventListener('click', () => up.close()));
  /** One photo's details: its own saved ones first, the form fills what's missing (or replaces, if chosen). */
  const metaFor = (it: Item, batch: Meta, replace: boolean): Meta => {
    const i = it.info, pick = (own: string | undefined, form: string | undefined | null) => (replace ? form || own || '' : own || form || '');
    const photographer = pick(i.photographer, batch.photographer);
    const credit = pick(i.credit && i.photographer && !i.credit.includes(i.photographer) ? `Foto: ${i.photographer} / ${i.credit}` : i.credit || (i.photographer ? `Foto: ${i.photographer} / NotiCel` : ''), batch.credit) || (photographer ? `Foto: ${photographer} / NotiCel` : '');
    const tags = [...new Set([...(replace ? [] : i.keywords ?? []), ...(batch.tags ? batch.tags.split(',').map((t) => t.trim()) : [])].filter(Boolean))].join(', ');
    return { ...batch, caption: pick(i.caption || i.headline, batch.caption), photographer, credit, tags, place: pick(i.place ? `${i.place}${i.city ? `, ${i.city}` : ''}` : i.city, batch.place), taken_on: pick(i.takenOn, batch.taken_on) || null, camera: i.camera ?? '' };
  };
  uf.addEventListener('submit', async (e) => {
    e.preventDefault(); const err = $s('[data-plu-err]'); err.hidden = true;
    const say = (t: string) => { err.textContent = t; err.hidden = false; };
    const todo = files.filter((f) => !f.dup);
    if (!files.length) return say('Escoge al menos una foto.');
    if (!todo.length) return say('Todas estas fotos ya están en la biblioteca.');
    const batch = metaOf(uf), replace = !!val(uf, 'override');
    const missing = todo.filter((it) => !metaFor(it, batch, replace).credit.trim());
    if (missing.length) return say(`Escribe el crédito o el fotógrafo: ${missing.length === 1 ? 'una foto no lo trae' : `${missing.length} fotos no lo traen`}.`);
    if (!val(uf, 'rights_ok')) return say('Confirma que las fotos son nuestras o que tenemos permiso.');
    const go = $s<HTMLButtonElement>('[data-plu-go]'); go.disabled = true;
    let ok = 0; const bad: string[] = []; let cover = '';
    for (let i = 0; i < files.length; i++) {
      const it = files[i]; if (it.dup) continue;
      const li = list.querySelector<HTMLElement>(`[data-fi="${i}"]`); li?.classList.add('on'); go.textContent = `Subiendo ${ok + bad.length + 1} de ${todo.length}…`;
      const r = await addPhoto(it.file, metaFor(it, batch, replace), me()?.name ?? '', it.hash);
      li?.classList.remove('on'); li?.classList.add(r.photo ? 'ok' : 'bad');
      if (r.photo) { ok++; cover ||= r.photo.thumb; } else bad.push(r.error!);
      if (r.error?.includes('supabase/fotos.sql')) break;
    }
    go.disabled = false; go.textContent = 'Subir';
    if (batch.album_id && cover && !albums.find((a) => a.id === batch.album_id)?.cover) await setAlbumCover(batch.album_id, cover);
    reloadAll(); if (hasV2()) void refreshAlbumsAll();
    if (bad.length) return say(`${ok ? `Se subieron ${ok}. ` : ''}${bad.slice(0, 3).join(' ')}`);
    up.close(); toast(ok === 1 ? 'Foto subida a la biblioteca.' : `${ok} fotos subidas a la biblioteca.`);
  });
</script>
