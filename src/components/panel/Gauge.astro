---
// A score from 0 to 100 as a ring, like Google's PageSpeed report: green 90+, orange 50–89, red under 50.
interface Props { value?: number; label?: string }
const { value, label } = Astro.props;
const tone = value === undefined ? 'none' : value >= 90 ? 'good' : value >= 50 ? 'warn' : 'bad';
const r = 20, c = 2 * Math.PI * r;
const dash = value === undefined ? 0 : (Math.max(0, Math.min(100, value)) / 100) * c;
---
<span class={`gauge ${tone}`} role="img" aria-label={`${label ? `${label}: ` : ''}${value ?? 'sin dato'} de 100`}>
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <circle class="gauge-bg" cx="24" cy="24" r={r} />
    {value !== undefined && <circle class="gauge-arc" cx="24" cy="24" r={r} stroke-dasharray={`${dash} ${c}`} transform="rotate(-90 24 24)" />}
  </svg>
  <b>{value ?? '—'}</b>
</span>
