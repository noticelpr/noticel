        if (n.classList.contains('wr-raw')) return decodeURIComponent(n.dataset.html || '');
        if (n.classList.contains('wr-embed')) return n.dataset.size || n.dataset.align ? embedFor(n.dataset.url!, { size: n.dataset.size, align: n.dataset.align }) ?? '' : n.dataset.url ?? '';
        if (n.classList.contains('wr-doc')) { // an uploaded PDF goes to public/documentos/ when published (with accounts)
          const d = docOf(n); if (d.src.startsWith('data:')) d.src = `${root.dataset.base!.replace(/\/$/, '')}/documentos/${(cur?.id ?? 'doc').toLowerCase()}-${d.title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').slice(0, 40)}.pdf`;
