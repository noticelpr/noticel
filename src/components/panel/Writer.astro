    const y = (v: string) => JSON.stringify(v);

    // ---------- open a story that is already on the site (AI or older) in the editor ----------
    // The story file: from NotiCel's GitHub repository when it exists (newest), else from the site itself (redaccion/archivo/)
    const RAW = REPO ? `https://raw.githubusercontent.com/${REPO}/${BRANCH}/src/content/noticias/` : `${BASE}/redaccion/archivo/`;
    const MANAGED = new Set(['title', 'description', 'categories', 'path', 'place', 'date', 'author', 'image', 'imageCaption', 'imageCredit',
      'breaking', 'topStory', 'live', 'pinned', 'homeLead', 'sectionLead', 'sectionPinned', 'aiAssisted', 'draft', 'sources', 'related', 'correction', 'gallery']);
    const BROAD = ['noticias', 'ultima-hora', 'uncategorized']; // never the main category when a story has a more specific one
    const unq = (v: string) => { v = v.trim(); try { return v.startsWith('"') ? JSON.parse(v) : v.replace(/^'(.*)'$/, '$1'); } catch { return v; } };
    const inline = (t: string) => esc(t.replace(/\\([*_`[\]\\])/g, '$1'))
      .replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/(^|[^*])\*([^*\s][^*]*?)\*/g, '$1<i>$2</i>')
      .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>').replace(/ {2}\n/g, '<br>');
    /** Markdown story body → the editor's HTML (blocks it can't edit are kept as they are). */
    function mdToHtml(src: string) {
      return src.trim().split(/\n{2,}/).map((b) => {
        const t = b.trim();
        if (t.startsWith('<')) return `<figure class="wr-raw" contenteditable="false" data-html="${encodeURIComponent(t)}">${t}</figure>`;
        if (/^https?:\/\/\S+$/.test(t)) return `<figure class="wr-embed" contenteditable="false" data-url="${esc(t)}"></figure>`;
        if (/^###\s/.test(t)) return `<h3>${inline(t.replace(/^###\s+/, ''))}</h3>`;
        if (/^##\s/.test(t)) return `<h2>${inline(t.replace(/^##\s+/, ''))}</h2>`;
        if (t === '---') return '<hr>';
        if (/^>\s?/.test(t)) return `<blockquote>${inline(t.replace(/^>\s?/gm, ''))}</blockquote>`;
        const lines = t.split('\n');
        if (lines.every((l) => /^[-*]\s/.test(l))) return `<ul>${lines.map((l) => `<li>${inline(l.replace(/^[-*]\s+/, ''))}</li>`).join('')}</ul>`;
        if (lines.every((l) => /^\d+\.\s/.test(l))) return `<ol>${lines.map((l) => `<li>${inline(l.replace(/^\d+\.\s+/, ''))}</li>`).join('')}</ol>`;
        return `<p>${inline(t)}</p>`;
      }).join('');
    }
    /** A story file from the site → an article in the editor that updates that same story when published. */
    function fromFile(id: string, text: string): Art | null {
      const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/); if (!m) return null;
      const fm: Record<string, string> = {}; const sources: Src[] = []; const related: string[] = []; const extra: string[] = []; const gallery: Gal[] = [];
      let key = '';
      for (const line of m[1].split('\n')) {
        const top = line.match(/^([A-Za-z]\w*):\s*(.*)$/);
        if (top) { key = top[1]; if (MANAGED.has(key)) fm[key] = top[2]; else extra.push(line); continue; }
        if (!MANAGED.has(key)) { extra.push(line); continue; }
        const nm = line.match(/^\s*-\s*name:\s*(.*)$/), ur = line.match(/^\s+url:\s*(.*)$/), li = line.match(/^\s*-\s*(.*)$/);
        if (key === 'sources' && nm) sources.push({ name: unq(nm[1]) });
        else if (key === 'sources' && ur && sources.length) sources[sources.length - 1].url = unq(ur[1]);
        else if (key === 'related' && li) related.push(unq(li[1]));
        else if (key === 'gallery') {
          const gs = line.match(/^\s*-\s*src:\s*(.*)$/), gk = line.match(/^\s+(caption|credit|creditUrl):\s*(.*)$/);
          if (gs) gallery.push({ src: unq(gs[1]), caption: '', credit: '' });
          else if (gk && gallery.length) (gallery[gallery.length - 1] as Record<string, string>)[gk[1]] = unq(gk[2]);
        }
      }
      const yes = (k: string) => fm[k] === 'true';
      let cats: string[] = []; try { cats = JSON.parse(fm.categories || '[]'); } catch { /* not a list */ }
      const main = cats.find((c) => !BROAD.includes(c)) ?? cats[0] ?? 'noticias';
      const d = new Date(unq(fm.date || '')); const local = isNaN(+d) ? localNow() : new Date(+d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      return { id: `A-${Date.now().toString(36)}`, status: 'published', updated: Date.now(), owner: me()?.name ?? '', slug: id,
        title: unq(fm.title || ''), description: unq(fm.description || ''), section: main, league: '', path: unq(fm.path || '') || undefined, cats: cats.filter((c) => c !== main),
        place: unq(fm.place || ''), author: unq(fm.author || 'NotiCel'), date: local, image: unq(fm.image || ''), imageUrl: '',
        imageCaption: unq(fm.imageCaption || ''), imageCredit: unq(fm.imageCredit || ''),
        breaking: yes('breaking'), trending: false, featured: yes('topStory'), live: yes('live'), pinned: yes('pinned'), homeLead: yes('homeLead'), sectionLead: yes('sectionLead'), sectionPinned: yes('sectionPinned'),
        aiAssisted: yes('aiAssisted'), fmExtra: extra.join('\n').trim() || undefined,
        sources, related, gallery, correction: unq(fm.correction || ''), body: mdToHtml(m[2]) };
    }
    /** A story on the site as an article of the team (opened before, or brought from its file now). */
    async function storyArt(id: string): Promise<Art | null> {
      if (DB) await refresh(); // the team's latest: someone may have opened this story already
      const have = load().find((a) => a.slug === id); if (have) return have;
      toast('Abriendo la noticia…');
      const r = await fetch(`${RAW}${encodeURIComponent(id)}.md?t=${Date.now()}`).catch(() => null);
      const a = r?.ok ? fromFile(id, await r.text()) : null;
      if (!a) { toast('No pudimos abrir esa noticia. Intenta otra vez en un minuto.'); return null; }
      if (!(await store(a))) return null; // saved for the team, linked to the story on the site
      return a;
    }
    async function importStory(id: string) {
      const a = await storyArt(id); if (!a) return;
      openEditor(a); toast('Lista para editar. Al tocar “Actualizar”, se corrige la misma noticia en el sitio.');
    }
    /** Takes a story off the site (its file gets draft: true; the site rebuilds in about 2 minutes). It stays in
     *  Escribir → Borradores, so it can be corrected and published again. Editors and the admin only. */
    async function takeDown(id: string): Promise<boolean> {
      if (!canPublish()) { toast('Solo los editores y el administrador pueden quitar noticias del sitio.'); return false; }
      const a = await storyArt(id); if (!a || !a.slug) return false;
      if (!DB) { toast(`${PREV}, la noticia se quita del sitio.`); return false; }
      const file = toFile(a).replace(/^draft: false$/m, 'draft: true');
      const r = await publishArticle({ id: a.id, slug: a.slug, file, title: a.title, scheduled: false });
      if (!r.ok) { toast(`No se pudo quitar: ${r.error}`); void logPanelError(me()?.name ?? '', `Quitar: ${a.title}`, r.error ?? ''); return false; }
      await store({ ...a, status: 'draft', updated: Date.now(), note: `Quitada del sitio el ${new Date().toLocaleDateString('es-PR', { day: 'numeric', month: 'short' })}. Corrígela y publícala otra vez si hace falta.` });
      await refresh(); renderList(); dispatchEvent(new Event('nc-articles-changed'));
