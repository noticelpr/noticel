    // ---------- insert panels, opened next to the button (or the block) that called them ----------
    const pops = Object.fromEntries($$<HTMLDialogElement>('[data-pop]').map((d) => [d.dataset.pop!, d]));
    let popAnchor: HTMLElement | null = null, editing: HTMLElement | null = null, linkRange: Range | null = null, imgData = '';
    function placePop(d: HTMLDialogElement) {
