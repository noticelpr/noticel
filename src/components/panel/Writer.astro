    // ---------- the story file (same shape as src/content.config.ts) ----------
    const md = {
      text: (s: string) => s.replace(/ /g, ' ').replace(/([*_`[\]\\])/g, '\\$1'),
      inline(n: Node): string {
        if (n.nodeType === 3) return md.text(n.textContent ?? '');
        if (!(n instanceof HTMLElement)) return '';
        const inner = [...n.childNodes].map(md.inline).join('');
        const tag = n.tagName;
        if (tag === 'STRONG' || tag === 'B') return inner.trim() ? `**${inner}**` : inner;
