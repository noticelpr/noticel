    addEventListener('nc-edit-story', (e) => void importStory((e as CustomEvent).detail.id)); // "Editar" in Noticias → Vistazo rápido

    /** The gallery in the story file. Without a main photo, the first gallery photo becomes the main one (toFile). */
    const galleryYaml = (a: Art) => {
      const g = (a.gallery ?? []).filter((x) => x.src && !x.src.startsWith('data:'));
      const list = a.image || a.imageUrl ? g : g.slice(1);
