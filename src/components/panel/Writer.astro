          const cap = [n.dataset.cap, n.dataset.credit].filter(Boolean).join(' ') || (n.querySelector('figcaption span')?.textContent ?? n.querySelector('figcaption')?.textContent ?? '').trim();
          const src = n.dataset.src || n.querySelector('img')?.getAttribute('src') || '';
