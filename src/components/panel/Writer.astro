      const cats = [...new Set([a.section, ...(a.cats ?? []).filter((c) => c !== a.section), ...(a.breaking ? ['ultima-hora'] : [])])];
      return ['---', `title: ${y(a.title)}`, `description: ${y(a.description)}`, `date: ${date.toISOString()}`, `author: ${y(a.author || 'NotiCel')}`,
        `path: ${y(pathOf(a))}`, `categories: ${JSON.stringify(cats)}`, ...(a.place ? [`place: ${y(a.place)}`] : []),
        ...(a.image || a.imageUrl ? [`image: ${y(a.imageUrl || (a.image.startsWith('data:') ? `imagenes/${a.id.toLowerCase()}.jpg` : a.image))}`, ...(a.imageCaption ? [`imageCaption: ${y(a.imageCaption)}`] : []), ...(a.imageCredit ? [`imageCredit: ${y(a.imageCredit)}`] : [])] : []),
        ...gy,
