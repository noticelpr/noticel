    };
    function toFile(a: Art) {
      const gy = galleryYaml(a); // before the first gallery photo is promoted, so it isn't listed twice
      if (!(a.image || a.imageUrl) && a.gallery?.[0]?.src && !a.gallery[0].src.startsWith('data:')) a = { ...a, imageUrl: a.gallery[0].src, imageCaption: a.gallery[0].caption, imageCredit: a.gallery[0].credit };
      const date = new Date(a.date || Date.now());
