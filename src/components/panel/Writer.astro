    const reviewArt = async (id: string) => { await refresh(); const a = load().find((x) => x.id === id); if (!a) toast('Esa noticia ya no está en revisión.'); return a; };
    addEventListener('nc-open-article', async (e) => { const a = await reviewArt((e as CustomEvent).detail.id); if (a) openEditor(a); });
    addEventListener('nc-approve-article', async (e) => { const a = await reviewArt((e as CustomEvent).detail.id); if (a) await goLive(structuredClone(a)); renderList(); dispatchEvent(new Event('nc-articles-changed')); });
    addEventListener('nc-return-article', async (e) => {
      const { id, note } = (e as CustomEvent).detail; const a = await reviewArt(id); if (!a) return;
      if (await store({ ...a, status: 'draft', note, updated: Date.now() })) toast('Devuelta al periodista con tu nota.');
      renderList(); dispatchEvent(new Event('nc-articles-changed'));
    });
    addEventListener('beforeunload', () => { if (cur && dirty) void persist(); });
    addEventListener('nc-staff-change', () => { if (!cur) renderList(); }); // signed in or out: show that person's list
    // Demo mode: a few sample stories in every list, the first time (they stay on this device only)
    if (DEMO && !load().length) {
      const ago = (h: number) => Date.now() - h * 36e5, at = (h: number) => new Date(Date.now() + h * 36e5 - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      const p = (t: string) => t.split('\n').map((x) => `<p>${x}</p>`).join('');
      const S = (o: Partial<Art>): Art => ({ ...blank(), owner: 'Periodista (ejemplo)', author: 'Periodista (ejemplo)', sources: [{ name: 'Comunicado de prensa (ejemplo)' }], ...o } as Art);
      [
        S({ id: 'A-EJ1', status: 'review', updated: ago(1), section: 'noticias', title: '(Ejemplo) Municipio inaugura una cancha bajo techo en el barrio Pueblo', description: 'La obra costó $1.2 millones y estará abierta al público desde el lunes, según el alcalde.', place: 'Caguas',
          body: p('Esta es una noticia de ejemplo para mostrar cómo trabaja el panel. Un periodista la escribió y la envió a revisión.\nEl editor la lee, la corrige si hace falta y la aprueba con un toque. En el panel real, la noticia sale en el sitio en unos 2 minutos.') }),
        S({ id: 'A-EJ2', status: 'review', updated: ago(3), section: 'voleibol', title: '(Ejemplo) Equipo juvenil de voleibol clasifica a la final del torneo regional', description: 'Las jugadoras ganaron en cuatro sets y buscan el título el sábado.', place: 'Ponce',
          body: p('Noticia de ejemplo de la sección de Deportes, esperando la aprobación de un editor.\nDesde aquí el editor puede aprobarla, abrirla en el editor o devolverla al periodista con una nota.') }),
        S({ id: 'A-EJ3', status: 'scheduled', updated: ago(5), section: 'economia', date: at(20), title: '(Ejemplo) Feria de empleo con 40 patronos se celebra mañana en el centro de convenciones', description: 'Habrá entrevistas en el momento y talleres para preparar el resumé.', place: 'San Juan',
          body: p('Noticia de ejemplo programada: sale sola a la hora escogida, sin que nadie tenga que estar despierto para publicarla.') }),
        S({ id: 'A-EJ4', status: 'draft', updated: ago(0.5), owner: me()?.name ?? 'Invitado', author: me()?.name ?? 'Invitado', section: 'entretenimiento', title: '(Ejemplo) Festival de bomba y plena llena la plaza este fin de semana', description: 'Borrador de ejemplo: el editor guarda solo, cada pocos segundos.', place: 'Loíza',
          body: p('Borrador de ejemplo. Prueba a escribir aquí: el texto se guarda solo, y puedes añadir fotos, videos y publicaciones de redes.') }),
        S({ id: 'A-EJ5', status: 'draft', updated: ago(26), section: 'gobierno', title: '(Ejemplo) Agencia anuncia horario extendido para renovar licencias', description: 'Las oficinas abrirán los sábados durante octubre.', place: 'Bayamón',
          body: p('Otro borrador de ejemplo, de un periodista del equipo.') }),
      ].forEach((a) => void store(a));
      setTimeout(() => dispatchEvent(new Event('nc-articles-changed')), 0); // Noticias → Por aprobar picks them up
    }
    if (DB) { $('[data-wr-list]').innerHTML = '<p class="apr-empty">Cargando las noticias del equipo…</p>'; refresh().then(renderList); } else renderList();
  }
</script>
