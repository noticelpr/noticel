    start.min = new Date(Date.now() + 864e5).toISOString().slice(0, 10);

    // Regions
    const setRegion = (id: string) => { regs.has(id) ? regs.delete(id) : regs.add(id); calc(); };
    wf.querySelectorAll<SVGElement>('.adb-reg').forEach((el) => el.addEventListener('click', () => setRegion(el.dataset.reg!)));
    wf.querySelectorAll<HTMLButtonElement>('[data-reg-btn]').forEach((b) => b.addEventListener('click', () => setRegion(b.dataset.regBtn!)));

    // ---- Fair share: estimated views, and full spaces (user, 2026-11-06; src/lib/ads.ts) ----
    let inv: AdInventory | null = null;
    void adInventory().then((x) => { inv = x; calc(); });
    function fairNote(fmts: ReturnType<typeof picked>) {
      const el = $('[data-fair]');
      const spaces = [...new Set(fmts.map((f) => spaceOf(f.slots)).filter(Boolean))] as AdSize[];
      if (!inv || !spaces.length) { el.hidden = true; return; }
      const from = val('start') || start.min;
      // A full space: the ad starts on the first day a place opens
      const open = spaces.map((sp) => nextOpen(inv!.busy, sp, from)).sort().pop()!;
      const day = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString(EN ? 'en-US' : 'es-PR', { day: 'numeric', month: 'long' });
      let full = '';
      if (open > from) { start.value = open; full = t(`Ese espacio está lleno hasta entonces: tu anuncio empieza el ${day(open)}. `, `That space is full until then: your ad starts on ${day(open)}. `); }
      const est = spaces.map((sp) => estimateViews(inv!.reads30, sp, adsOn(inv!.busy, sp, open))).filter(Boolean) as Array<[number, number]>;
      const lo = est.reduce((a, e) => a + e[0], 0), hi = est.reduce((a, e) => a + e[1], 0);
      const n = (x: number) => x.toLocaleString('en-US');
      el.textContent = full + (lo ? t(`Vistas estimadas: unas ${n(lo)} a ${n(hi)} al mes (según nuestras lecturas de los últimos 30 días; es un estimado, no una garantía).`, `Estimated views: about ${n(lo)} to ${n(hi)} a month (from our reads in the last 30 days; an estimate, not a guarantee).`) : '');
      el.hidden = !el.textContent;
    }

    // ---- Price ----
    let total = 0, where = '', summary: string[] = [];
    let lastAud = 'all';
    function calc() {
      const d = new FormData(wf);
      const fmts = picked();
      const len = Number(d.get('months')) || 30; /* 'sub' (monthly subscription) counts as one month */ const months = len / 30; const days = Math.max(1, Math.min(14, Number(d.get('days')) || 1)); // 'months' holds the length in days
      const aud = String(d.get('aud'));
      if (aud === 'regions' && lastAud !== 'regions' && !regs.size) regs.add('metro');
      if (aud !== 'regions') regs.clear();
      lastAud = aud;
      $('[data-map-wrap]').hidden = aud !== 'regions';
      const hasTk = fmts.some((f) => f.per === 'día'), tkByViews = hasTk && d.get('tkmode') === 'vistas';
      $('[data-days-wrap]').hidden = !hasTk;
      $('[data-tk-days]').hidden = !hasTk || tkByViews; $('[data-tk-views]').hidden = !tkByViews;
      $('[data-tk-help]').textContent = tkByViews ? t(`Tu marca en todos los espacios del sitio desde el día que escojas hasta cumplir las vistas; luego termina sola. $${cfg.tkCpm} por cada 1,000 vistas.`, `Your brand in every ad space on the site from the day you choose until the views are delivered; then it ends by itself. $${cfg.tkCpm} per 1,000 views.`) : t('Tu marca en todos los espacios del sitio durante los días que escojas.', 'Your brand in every ad space on the site for the days you choose.');
      // Display ads are bought by views; section sponsorship by time; the takeover by days
      // By views only while SELL_BY_VIEWS is on (src/lib/ads.ts); otherwise every monthly format is bought by time
      const byViews = fmts.some((f) => f.cpm > 0), byTime = fmts.some((f) => f.id === 'patrocinio' || (f.per === 'mes' && !f.cpm));
      $('[data-views-wrap]').hidden = !byViews && fmts.length > 0;
      $('[data-time-wrap]').hidden = !byTime;
      const views = byViews ? Number(d.get('views')) || 10000 : 0;
      wf.querySelectorAll<SVGElement>('.adb-reg').forEach((el) => el.classList.toggle('on', regs.has(el.dataset.reg!)));
      wf.querySelectorAll<SVGElement>('[data-lbl]').forEach((el) => el.classList.toggle('on', regs.has(el.dataset.lbl!)));
      wf.querySelectorAll<HTMLButtonElement>('[data-reg-btn]').forEach((b) => b.setAttribute('aria-pressed', String(regs.has(b.dataset.regBtn!))));
      const factor = aud === 'all' ? cfg.audience.all : aud === 'island' ? cfg.audience.island : aud === 'diaspora' ? cfg.audience.diaspora : Math.min(cfg.audience.island, regs.size * cfg.audience.perRegion);
      where = aud === 'all' ? t('Puerto Rico y la diáspora', 'Puerto Rico and the U.S.') : aud === 'island' ? t('Solo Puerto Rico', 'Puerto Rico only') : aud === 'diaspora' ? t('Solo la diáspora', 'Puerto Ricans in the U.S. only') : cfg.regions.filter((r) => regs.has(r.id)).map((r) => r.name).join(', ');
      $('[data-aud-hint]').textContent = t(`Toca las regiones donde quieres salir. Pagas ${Math.round(factor * 100)}% del precio.`, `Tap the regions where you want to show. You pay ${Math.round(factor * 100)}% of the price.`);

      // Price math lives in src/lib/ads.ts (quote), shared with the sales desk
      const q = quote({ formats: fmts.map((f) => f.id), days: len, takeoverDays: days, takeoverViews: tkByViews ? Number(d.get('tkviews')) || 50000 : 0, views, aud: aud as QuoteInput['aud'], regions: regs.size,
        who: String(d.get('who') || 'retail') as QuoteInput['who'], prepay: !!d.get('prepay'), founder: !!d.get('founder'), design: d.get('mode') === 'design', lang: cfg.lang, recurring: subOn() });
      $('[data-sub-note]').hidden = !subOn();
      try { fairNote(fmts); } catch { /* the estimate never blocks the price */ }
      const { lines, off, design } = q;
      total = q.total;
      $('[data-design-price]').textContent = `${money(cfg.design)} · ${t('lo diseñamos en todos los tamaños', 'we design it in every size')}`;

      const rows = lines.map(([n, c]) => `<li><span>${n}</span><b>${money(c)}</b></li>`);
      if (!fmts.length) rows.push(`<li class="adb-empty">${t('Escoge al menos un anuncio.', 'Choose at least one ad.')}</li>`);
      q.discounts.forEach(([n, a]) => rows.push(`<li class="adb-off"><span>${n}</span><b>−${money(a)}</b></li>`));
      if (q.capped > 0.5) rows.push(`<li class="adb-off"><span>${t('Tope de descuento', 'Discount cap')} (${cfg.max}%)</span><b>+${money(q.capped)}</b></li>`);
      if (design !== null) rows.push(`<li><span>${t('Diseño del anuncio', 'Ad design')}</span><b>${design ? money(design) : t('Gratis', 'Free')}</b></li>`);
