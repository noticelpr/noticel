    {/* Comunicado de prensa pagado (src/lib/comunicados.ts): published in its section with a "Comunicado pagado" label */}
  </main>
  <script>
    import { drawAd, loadImage, THEMES } from '../../lib/adcreative';
    import { saveRequest, markPaid, sharedRequests, shrink, sendContact, cardPayment, type ArtFile } from '../../lib/adrequests';
    import { quote, RENEWS, nextOpen, adsOn, estimateViews, spaceOf, type QuoteInput, type AdSize } from '../../lib/ads';
    import { loggedIn, token as accountToken, accountInfo, askLogin, api } from '../../lib/account';
    import { hasBackend, adInventory, type AdInventory } from '../../lib/backend';

    // English page (/en/advertise/): <html lang="en">
    const EN = document.documentElement.lang === 'en';
    const t = (es: string, en: string) => (EN ? en : es);

    const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
    // A salesperson's own link (?v=<code>, panel → Ventas → Mis comisiones): orders in the next 30 days are credited to them
    const refCode = (() => {
      const v = new URLSearchParams(location.search).get('v');
      try {
        if (v && /^[a-f0-9]{8}$/.test(v)) localStorage.setItem('nc-ref', JSON.stringify({ code: v, at: Date.now() }));
        const r = JSON.parse(localStorage.getItem('nc-ref') || 'null');
        return r && Date.now() - r.at < 30 * 864e5 ? String(r.code) : '';
      } catch { return v && /^[a-f0-9]{8}$/.test(v) ? v : ''; }
    })();
    // A salesperson's "send the prices" link (…#precios): the price table opens by itself
    if (location.hash === '#precios') { const d = document.getElementById('precios') as HTMLDetailsElement | null; if (d) { d.open = true; setTimeout(() => d.scrollIntoView({ block: 'start' }), 300); } }
    const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    // ---- Contact form: goes straight to the panel's Ventas (sendContact); without the database, the email app as before ----
    const cf = document.querySelector<HTMLFormElement>('[data-ad-form]')!;
    cf.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(cf); const v = (k: string) => String(d.get(k) || '').trim();
      const er = cf.querySelector<HTMLElement>('[data-err]')!, note = cf.querySelector<HTMLElement>('[data-note]')!;
      const msg = !v('nombre') || !v('negocio') ? t('Escribe tu nombre y el de tu negocio.', 'Enter your name and your business name.') : !emailOk(v('correo')) ? t('Escribe un correo válido, por ejemplo nombre@negocio.com.', 'Enter a valid email, for example name@business.com.') : '';
      er.textContent = msg; er.hidden = !msg; if (msg) return;
      const btn = cf.querySelector<HTMLButtonElement>('button[type="submit"]')!; btn.disabled = true;
      const sent = await sendContact({ name: v('nombre'), business: v('negocio'), email: v('correo'), phone: v('telefono'), message: EN ? `[English] ${v('mensaje')}` : v('mensaje') });
      btn.disabled = false;
      if (sent === true) { cf.reset(); note.textContent = t('¡Recibimos tu mensaje! Nuestro equipo de ventas te contactará en 1 día laborable.', 'We got your message! Our sales team will contact you within 1 business day, in English.'); note.hidden = false; return; }
      if (sent !== 'preview') { er.textContent = t('No pudimos enviar tu mensaje. Revisa tu conexión e intenta otra vez.', "We couldn't send your message. Check your connection and try again."); er.hidden = false; return; }
      if (!cf.dataset.email) { note.textContent = t('Gracias. El envío se activará muy pronto, cuando publiquemos el correo de ventas.', 'Thank you. Sending will be turned on very soon, when we publish the sales email.'); note.hidden = false; return; }
      location.href = `mailto:${cf.dataset.email}?subject=${encodeURIComponent(`Publicidad: ${v('negocio')}`)}&body=${encodeURIComponent([`Nombre: ${v('nombre')}`, `Negocio: ${v('negocio')}`, `Correo: ${v('correo')}`, `Teléfono: ${v('telefono')}`, '', v('mensaje')].join('\n'))}`;
      note.textContent = t('Se abrió tu correo con el mensaje listo. Solo tienes que enviarlo.', 'Your email app opened with the message ready. Just send it.'); note.hidden = false;
    });

    // ---- Step-by-step guide ----
    type Fmt = { id: string; name: string; price: number; per: string; art: number[][]; slots: string[]; cpm: number };
    type Cfg = { lang: 'es' | 'en'; formats: Fmt[]; audience: { all: number; island: number; diaspora: number; perRegion: number }; launch: { pct: number; months: number };
      duration: Array<{ months: number; pct: number }>; other: Array<{ id: string; pct: number }>; max: number; rewards: Array<{ at: number; gift: string }>;
      volume: Array<{ from: number; pct: number }>; design: number; designFree: number; upload: { maxMB: number; types: string[] };
      pay: { stripe: boolean; stripeTest: boolean; athMovilToken: string }; comunicado: { ready: number; written: number }; regions: Array<{ id: string; name: string }>; tkCpm: number };
    const wf = document.querySelector<HTMLFormElement>('[data-wiz]')!;
    const cfg: Cfg = JSON.parse(wf.dataset.cfg!);
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => wf.querySelector<T>(s)!;
    const val = (k: string) => String(new FormData(wf).get(k) ?? '').trim();
    const picked = () => { const ids = new FormData(wf).getAll('fmt'); if (wf.querySelector<HTMLInputElement>('[data-tk-alias]')?.checked) ids.push('takeover'); return cfg.formats.filter((f) => ids.includes(f.id)); };
    const subOn = () => new FormData(wf).get('months') === 'sub' && !picked().some((f) => f.per === 'día'); // the takeover is by days: never a subscription
    const timeLabel = () => (subOn() ? (EN ? RENEWS.en : RENEWS.es) : (wf.querySelector<HTMLInputElement>('[name="months"]:checked')!.nextElementSibling as HTMLElement).textContent!.replace(/\s*−\d+%/, ''));
    const viewsPicked = () => (picked().some((f) => f.cpm > 0) ? Number(new FormData(wf).get('views')) || 10000 : 0);
    // What the client bought: views for display ads, time for sponsorship, days for the takeover
    // Takeover: by days, or by views (it owns every ad space until they're delivered)
    const tkViews = () => (picked().some((f) => f.id === 'takeover') && new FormData(wf).get('tkmode') === 'vistas' ? Number(new FormData(wf).get('tkviews')) || 50000 : 0);
    const tkLabel = () => { if (!picked().some((f) => f.id === 'takeover')) return ''; const v = tkViews(), n = Number(new FormData(wf).get('days')) || 1; return v ? t(`toma de portada hasta ${v.toLocaleString('en-US')} vistas`, `home page takeover until ${v.toLocaleString('en-US')} views`) : t(`${n} día${n > 1 ? 's' : ''} de toma de portada`, `${n} day${n > 1 ? 's' : ''} of home page takeover`); };
    const durLabel = () => [viewsPicked() ? `${viewsPicked().toLocaleString('en-US')} ${t('vistas', 'views')}` : '', picked().some((f) => f.id === 'patrocinio') ? timeLabel() : '', tkLabel()].filter(Boolean).join(' + ') || timeLabel();
    const regs = new Set<string>();
    let step = 1;
    let files: ArtFile[] = [];
    let logo: HTMLImageElement | null = null; let logoData = '';

    const start = $<HTMLInputElement>('[data-start]');
