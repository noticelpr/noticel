              {SELL_BY_VIEWS && VIEW_DISCOUNTS.map((d) => <li><b>{d.pct}%</b><span>{t('Desde', 'From')} {d.from.toLocaleString('en-US')} {t('vistas', 'views')}</span></li>)}
              {DURATION_DISCOUNTS.filter((d) => d.months <= 6).map((d) => <li><b>{d.pct}%</b><span>{en ? `${d.months}-month ${SELL_BY_VIEWS ? 'sponsorships' : 'campaigns'}` : `${SELL_BY_VIEWS ? 'Patrocinios' : 'Campañas'} de ${d.months} meses`}</span></li>)}
