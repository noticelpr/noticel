    });
    wf.querySelectorAll<HTMLButtonElement>('[data-cta]').forEach((b) => b.addEventListener('click', () => { $<HTMLInputElement>('[name="cta"]').value = b.dataset.cta!; drawPreviews(); }));
    function drawPreviews() {
      if (val('mode') !== 'design') return;
      ['title', 'msg', 'cta'].forEach((k) => { const el = $<HTMLInputElement>(`[name="${k}"]`); $(`[data-count="${k}"]`).textContent = `${el.value.length}/${el.maxLength}`; });
      const sizes = [...new Map(picked().flatMap((f) => f.art).map((s) => [s.join('x'), s])).values()].slice(0, 3);
      const theme = THEMES.find((t) => t.id === val('theme')) ?? THEMES[0];
      const box = $('[data-previews]');
      box.innerHTML = sizes.map(([w, h]) => `<figure><canvas data-w="${w}" data-h="${h}" style="aspect-ratio:${w}/${h};max-width:${w}px"></canvas><figcaption>${w} × ${h}</figcaption></figure>`).join('') || `<p class="wiz-help">${t('Escoge un anuncio en el paso 1.', 'Choose an ad in step 1.')}</p>`;
      box.querySelectorAll<HTMLCanvasElement>('canvas').forEach((c) => drawAd(c, Number(c.dataset.w), Number(c.dataset.h), { title: val('title'), msg: val('msg'), cta: val('cta'), business: val('negocio') }, theme, logo));
    }

    // ---- Steps ----
    // Nothing moves on without what the team needs (user, 2026-11-06): the missing field is marked and focused
    let bad = '';
    const need = (name: string, msg: string) => { bad = name; return msg; };
    // A link typed without https:// (tunegocio.com, facebook.com/…) gets it added; a phone number becomes a WhatsApp link
    function fixLink() {
      const el = wf.querySelector<HTMLInputElement>('[name="link"]')!;
      let v = el.value.trim();
      if (/^\+?1?[\s-]*\(?[2-9]\d{2}\)?[\s.-]*\d{3}[\s.-]*\d{4}$/.test(v)) v = `https://wa.me/1${v.replace(/\D/g, '').slice(-10)}`;
      else if (v && !/^https?:\/\//i.test(v)) v = `https://${v.replace(/^\/+/, '')}`;
      el.value = v;
    }
    function check(n: number): string {
      bad = '';
      if (n === 1 && !picked().length) return t('Escoge al menos un anuncio.', 'Choose at least one ad.');
      if (n === 2 && val('aud') === 'regions' && !regs.size) return t('Toca al menos una región en el mapa.', 'Tap at least one region on the map.');
      if (n === 2 && !val('start')) return need('start', t('Escoge la fecha en que empieza.', 'Choose the start date.'));
      if (n === 3 && val('mode') === 'upload' && !files.length) return t('Sube tu anuncio, o escoge “Créenlo por mí”.', 'Upload your ad, or choose “Create it for me”.');
      if (n === 3 && val('mode') === 'design' && !val('title')) return need('title', t('Escribe el título de tu anuncio.', "Write your ad's headline."));
      if (n === 3 && val('mode') === 'design' && !val('msg')) return need('msg', t('Escribe un mensaje corto para tu anuncio (qué ofreces, dónde, horario).', 'Write a short message for your ad (what you offer, where, hours).'));
      if (n === 3) fixLink();
      if (n === 3 && !val('link')) return need('link', t('Escribe a dónde lleva tu anuncio: tu página, Facebook, Instagram o WhatsApp.', 'Enter where your ad goes: your website, Facebook, Instagram or WhatsApp.'));
      if (n === 3 && !/^https?:\/\/[^\s/]+\.[^\s]+$/.test(val('link'))) return need('link', t('Revisa el enlace, por ejemplo tunegocio.com o facebook.com/tunegocio.', 'Check the link, for example yourbusiness.com or facebook.com/yourbusiness.'));
      if (n === 4 && !val('nombre')) return need('nombre', t('Escribe tu nombre.', 'Enter your name.'));
      if (n === 4 && !val('negocio')) return need('negocio', t('Escribe el nombre de tu negocio.', 'Enter your business name.'));
      if (n === 4 && !emailOk(val('correo'))) return need('correo', t('Escribe un correo válido, por ejemplo nombre@negocio.com.', 'Enter a valid email, for example name@business.com.'));
      if (n === 4 && val('telefono').replace(/\D/g, '').length < 10) return need('telefono', t('Escribe tu teléfono con el código de área (10 dígitos), para llamarte si hace falta.', 'Enter your phone with area code (10 digits), so we can call you if needed.'));
      return '';
    }
    const err = (m: string) => {
      const e = $('[data-err]'); e.textContent = m; e.hidden = !m;
      wf.querySelectorAll('.wiz-bad').forEach((x) => x.classList.remove('wiz-bad'));
      const f = m && bad ? wf.querySelector<HTMLInputElement>(`[name="${bad}"]`) : null;
      if (f) { f.classList.add('wiz-bad'); setTimeout(() => f.focus(), 50); f.addEventListener('input', () => f.classList.remove('wiz-bad'), { once: true }); }
      return !!m;
    };
    function go(n: number) {
      step = n;
      wf.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
