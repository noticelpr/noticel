---
// Anúnciate (/publicidad/) and its English version (/en/advertise/), for advertisers who don't speak Spanish: a short page built around one step-by-step guide (one question at a time):
//   1 format → 2 where and when → 3 the ad (upload it, or write what it should say and we create it) → 4 details and pay.
// Requests go to the approval page (src/pages/publicidad/aprobar.astro) for the one employee who reviews and designs ads.
// Prices, discounts, payments and where requests are saved: src/lib/ads.ts. Everything else is folded into "Preguntas".
import Base from '../../layouts/Base.astro';
import { SITE, url, SECTIONS } from '../../lib/site';
import { FORMATS, REGIONS, AUDIENCE, LAUNCH_DISCOUNT, DURATION_DISCOUNTS, OTHER_DISCOUNTS, MAX_DISCOUNT, REWARDS, VOLUME_TIERS, AGENCY_COMMISSION, WEEK_SHARE, periodCost, VIEW_PACKS, VIEW_DISCOUNTS, LAUNCH_VIEWS,
  DESIGN_FEE, DESIGN_FREE_FROM_MONTHS, UPLOAD, PAYMENTS, APPROVAL_HOURS, ROTATE_SECONDS, TAKEOVER_CPM, TAKEOVER_VIEW_PACKS, SELL_BY_VIEWS,
  FORMATS_EN, REGIONS_EN, REWARDS_EN, OTHER_DISCOUNTS_EN, COMUNICADO_PRICES, SELF_SERVE, SUBSCRIPTION_DISCOUNT, type Lang } from '../../lib/ads';
import { THEMES } from '../../lib/adcreative';

const { lang = 'es' } = Astro.props as { lang?: Lang };
const en = lang === 'en';
const t = (es: string, eng: string) => (en ? eng : es);
// Formats, regions and rewards in the page's language (English texts: src/lib/ads.ts)
// The ads a client buys here by themselves (SELF_SERVE); the rest are sold through Ventas
const SELF = FORMATS.filter((f) => SELF_SERVE.includes(f.id));
const fmt = (f: (typeof FORMATS)[number]) => (en ? { ...f, ...FORMATS_EN[f.id] } : f);
const regName = (id: string) => (en ? REGIONS_EN[id]?.name : undefined) ?? REGIONS.find((r) => r.id === id)!.name;
const regTowns = (r: (typeof REGIONS)[number]) => (en ? REGIONS_EN[r.id]?.towns : undefined) ?? r.towns;
const gift = (r: (typeof REWARDS)[number]) => (en ? REWARDS_EN[r.at] : undefined) ?? r.gift;
const per = (p: string) => (en ? (p === 'día' ? 'day' : 'month') : p);

const money = (n: number) => `$${n.toLocaleString('en-US')}`;
// Cheapest way in: the smallest views package of the cheapest display ad
const cheapest = SELL_BY_VIEWS ? Math.min(...FORMATS.filter((f) => 'cpm' in f).map((f) => ('cpm' in f ? f.cpm : 99) * (VIEW_PACKS[0] / 1000)))
  : Math.min(...SELF.filter((f) => f.per === 'mes').map((f) => f.price)); // by time (launch): the cheapest month on sale here
const fromText = SELL_BY_VIEWS ? `${t('por', 'per')} ${VIEW_PACKS[0].toLocaleString('en-US')} ${t('vistas', 'views')}` : t('al mes', 'a month');
// Simplified map of Puerto Rico (viewBox 0 0 690 215): the island outline, cut into regions
const ISLAND = 'M46 13L132 20L231 20L330 23L396 26L462 36L554 56L554 99L512 142L485 175L413 191L330 201L231 191L149 198L99 191L33 198L36 149L26 116L10 59Z';
const CUTS: Record<string, string> = {
  oeste: 'M0 0H120V215H0Z', norte: 'M120 0H370V88L120 92Z', metro: 'M370 0H470V100L370 88Z',
  centro: 'M120 92L370 88L470 100V140L120 145Z', sur: 'M120 145L470 140V215H120Z', este: 'M470 0H562V215H470Z',
};
const LABELS: Record<string, [number, number]> = { oeste: [64, 108], norte: [245, 58], metro: [420, 62], centro: [292, 120], sur: [292, 176], este: [514, 112], islas: [622, 172] };
// Campaign length in days (prices: src/lib/ads.ts quote; a week costs WEEK_SHARE of the month)
const DURATIONS = [
  // Monthly subscription first and chosen by default (user, 2026-11-06): the simplest for a small business; charged every month by card, cancel anytime (src/lib/ads.ts)
  { v: 'sub', label: t('Cada mes, se renueva solo', 'Monthly, renews automatically'), off: SUBSCRIPTION_DISCOUNT },
  { v: '7', label: t('1 semana', '1 week'), off: 0 }, { v: '14', label: t('2 semanas', '2 weeks'), off: 0 }, { v: '30', label: t('1 mes', '1 month'), off: 0 },
  ...DURATION_DISCOUNTS.map((d) => ({ v: String(d.months * 30), label: `${d.months} ${t('meses', 'months')}`, off: d.pct })),
];
// Rate card for the price table: week, month and 3 months (with the length discount) for each format
const rate = (f: (typeof FORMATS)[number]) => f.per === 'día' ? null : { week: Math.round(periodCost(f.price, 7)), month: f.price, three: Math.round(f.price * 3 * (1 - (DURATION_DISCOUNTS[0]?.pct ?? 0) / 100)) };
const rewards = REWARDS.map((r) => ({ ...r, gift: gift(r) }));
const cfg = { comunicado: COMUNICADO_PRICES, lang, formats: FORMATS.map((f) => ({ id: f.id, name: fmt(f).name, price: f.price, per: f.per, art: f.art, slots: f.slots, cpm: SELL_BY_VIEWS && 'cpm' in f ? f.cpm : 0 })), audience: AUDIENCE, launch: LAUNCH_DISCOUNT, duration: DURATION_DISCOUNTS,
  other: OTHER_DISCOUNTS, max: MAX_DISCOUNT, rewards, volume: VOLUME_TIERS, design: DESIGN_FEE, designFree: DESIGN_FREE_FROM_MONTHS, upload: UPLOAD,
  pay: PAYMENTS, regions: REGIONS.map(({ id }) => ({ id, name: regName(id) })), tkCpm: TAKEOVER_CPM };
const CTAS = en ? ['Call today', 'Visit us', 'Order now', 'Message us on WhatsApp', 'See deals'] : ['Llama hoy', 'Visítanos', 'Ordena ya', 'Escríbenos por WhatsApp', 'Ver ofertas'];
const DISC_EN: Record<string, string> = OTHER_DISCOUNTS_EN;
---
<Base lang={lang} title={t('Anúnciate', 'Advertise')} description={en ? `Advertise on NotiCel, Puerto Rico's news site, from ${money(cheapest)} ${fromText}: create your ad in 4 steps, pay online, and it runs within ${APPROVAL_HOURS} hours.` : `Anúnciate en NotiCel desde ${money(cheapest)} ${fromText}: crea tu anuncio en 4 pasos, paga en línea y sale en ${APPROVAL_HOURS} horas.`}>
  <main class="wrap ad-page" id="main">
    <section class="adp-hero adp-hero-s">
      <p class="adp-kicker">{t('Publicidad en NotiCel', 'Advertising on NotiCel')}<a class="adp-lang" href={url(en ? 'publicidad' : 'en/advertise')} hreflang={en ? 'es' : 'en'} lang={en ? 'es' : 'en'}>{en ? 'Español' : 'English'}</a></p>
      <h1>{t('Anúnciate desde', 'Advertise from')} {money(cheapest)} {fromText}</h1>
      <p class="adp-lead">{en ? `Create your ad in 4 steps, pay online, and it runs within ${APPROVAL_HOURS} hours. Reach Puerto Rico and Puerto Ricans in the U.S.` : `Crea tu anuncio en 4 pasos, paga en línea y sale en ${APPROVAL_HOURS} horas.`}</p>
      {/* First, what to publish (user, 2026-11-06): an ad, or a press release; each opens its own form */}
      <div class="adp-pick" role="group" aria-label={t('¿Qué quieres publicar?', 'What do you want to publish?')}>
        <a class="adp-pick-c" href="#campana" data-pick="ad" data-start>
          <span class="adp-pick-i" aria-hidden="true">📣</span>
          <b>{t('Anuncio', 'Ad')}</b>
          <small>{t(`Tu marca en la portada, las noticias y el celular. Desde ${money(cheapest)} ${fromText}.`, `Your brand on the home page, the stories and phones. From ${money(cheapest)} ${fromText}.`)}</small>
        </a>
        <a class="adp-pick-c" href="#comunicado" data-pick="com" hidden>
          <span class="adp-pick-i" aria-hidden="true">📰</span>
          <b>{t('Comunicado de prensa', 'Press release')}</b>
          <small>{t(`Publicado en su sección con la etiqueta «Comunicado pagado». Desde ${money(COMUNICADO_PRICES.ready)}.`, `Published in its section, labeled "Paid release". From ${money(COMUNICADO_PRICES.ready)}.`)}</small>
        </a>
      </div>
      <div class="adp-ctas"><a class="adp-btn ghost" href="#contacto">{t("Prefiero hablar con alguien", "I'd rather talk to someone")}</a></div>
      <script is:inline>
        // Which form shows: the one picked, or the one a link asks for (#campana, #comunicado, a salesperson's ?v=,
        // coming back from paying). With none, just the choice.
        (function () {
          var show = function (which, scroll) {
            document.querySelectorAll('[data-flow]').forEach(function (el) { el.hidden = el.getAttribute('data-flow') !== which; });
            // The big banner only on the first screen (user, 2026-11-06: repeated on every screen it got annoying)
            document.querySelector('.adp-hero').classList.toggle('adp-hero-off', !!which);
            // In a form: questions and contact hidden behind the small "¿Dudas?" line
            document.querySelectorAll('[data-extra]').forEach(function (el) { el.hidden = !!which; });
            document.querySelector('[data-help]').hidden = !which;
            var el = which && document.querySelector('[data-flow="' + which + '"]');
            if (el && scroll) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          };
          var fromUrl = function () {
            var q = new URLSearchParams(location.search);
            if (location.hash === '#comunicado') return 'ad'; // NotiCel: paid press releases are off for now
            if (location.hash === '#campana' || q.has('v') || q.has('r') || q.has('pagado') || q.has('cancelado')) return 'ad';
            return '';
          };
          // Read now, while the page is loading: the payment script clears ?pagado / ?cancelado from the address before
          // DOMContentLoaded, and then the confirmation would be hidden (user, 2026-11-07)
          var initial = fromUrl();
          document.addEventListener('DOMContentLoaded', function () { show(initial, false); });
          addEventListener('hashchange', function () { var w = fromUrl(); if (w) show(w, true); });
          document.addEventListener('click', function (e) {
            var p = e.target.closest && e.target.closest('[data-pick]');
            // A link to the questions or to contact opens that part, then the page goes to it
            var x = e.target.closest && e.target.closest('a[href="#preguntas"], a[href="#contacto"]');
            if (x) { var sec = document.querySelector(x.getAttribute('href')); if (sec) sec.hidden = false; }
            if (p) { e.preventDefault(); history.replaceState(null, '', p.getAttribute('href')); show(p.getAttribute('data-pick'), true); return; }
            if (e.target.closest && e.target.closest('[data-pick-back]')) { history.replaceState(null, '', location.pathname + location.search.replace(/([?&])(pagado|cancelado|r)=[^&]*/g, '$1')); show('', false); scrollTo({ top: 0, behavior: 'smooth' }); }
          });
        })();
      </script>
    </section>

    <section class="wiz" id="campana" aria-labelledby="wiz-h" data-flow="ad" hidden>
      <button type="button" class="wiz-backlink" data-pick-back>{t('‹ Volver', '‹ Back')}</button>
      <h2 id="wiz-h" class="sr">{t("Crea tu anuncio", "Create your ad")}</h2>
      <ol class="wiz-prog" aria-label={t('Pasos', 'Steps')}>
        <li><button type="button" data-goto="1" aria-current="step">{t("Anuncio", "Ad")}</button></li>
        <li><button type="button" data-goto="2">{t("Cuándo", "When")}</button></li>
        <li><button type="button" data-goto="3">{t("Tu arte", "Your artwork")}</button></li>
        <li><button type="button" data-goto="4">{t("Pago", "Payment")}</button></li>
      </ol>

      <form class="wiz-form" data-wiz data-cfg={JSON.stringify(cfg)} data-email={SITE.email} novalidate>
        <!-- 1 · Format -->
        <fieldset class="wiz-step" data-step="1">
          <legend>{t("¿Qué anuncio quieres?", "Which ad do you want?")}</legend>
          <p class="wiz-help">{t("Se ve grande en celular, donde lee la mayoría, y al lado de las noticias en computadora.", "It shows big on phones, where most people read, and beside the news on computers.")}</p>
          <div class="wiz-fmts wiz-fmts-one">
            {SELF.map((f) => (
              <label class="wiz-fmt">
                <input type="checkbox" name="fmt" value={f.id} checked data-keep />
                <b>{fmt(f).name}</b>
                <span class="wiz-price">{SELL_BY_VIEWS && 'cpm' in f ? <>{money(f.cpm)}<small>/1,000 {t('vistas', 'views')}</small></> : <>{money(f.price)}<small>/{per(f.per)}</small></>}</span>
                <span class="wiz-about">{fmt(f).about}</span>
              </label>
            ))}
            {/* Takeover until the views are met: the same "Toma de portada" bought by views (step 2 shows the packs) */}
            {SELL_BY_VIEWS && <label class="wiz-fmt wiz-fmt-tk">
              <input type="checkbox" data-tk-alias />
              <span class="wiz-pop">{t("Todo el sitio", "Whole site")}</span>
              <b>{t("Toma total por vistas", "Full takeover by views")}</b>
              <span class="wiz-price">{money(TAKEOVER_CPM)}<small>/1,000 {t("vistas", "views")}</small></span>
              <span class="wiz-about">{t("Tu marca en todos los espacios del sitio, sin otras marcas, hasta cumplir las vistas que compres. Luego termina sola.", "Your brand in every ad space on the site, no other brands, until the views you buy are delivered. Then it ends by itself.")}</span>
            </label>}
          </div>
        </fieldset>

        <!-- 2 · Where and when -->
        <fieldset class="wiz-step" data-step="2" hidden>
          <legend>{t("¿Cuándo?", "When?")}</legend>
          {/* "¿Quién lo ve?" removed (user, 2026-11-06): every ad is seen by everyone (Puerto Rico and the diaspora).
              The sales desk can still sell audience options; regions are planned for NotiCel first. */}
          <input type="hidden" name="aud" value="all" />
          <div class="wiz-map" data-map-wrap hidden>
            <svg class="adb-map" viewBox="0 0 690 215" role="group" aria-label={t("Mapa de regiones de Puerto Rico", "Map of Puerto Rico regions")}>
              <defs><clipPath id="adb-isla"><path d={ISLAND} /></clipPath></defs>
              <g clip-path="url(#adb-isla)">
                {Object.entries(CUTS).map(([id, d]) => <path class="adb-reg" data-reg={id} d={d}><title>{regName(id)}</title></path>)}
              </g>
              <g class="adb-reg" data-reg="islas"><title>{regName("islas")}</title><ellipse cx="618" cy="143" rx="50" ry="9" /><ellipse cx="660" cy="80" rx="13" ry="6" /></g>
              <path class="adb-outline" d={ISLAND} />
              {Object.entries(LABELS).map(([id, [x, y]]) => <text x={x} y={y} class="adb-lbl" data-lbl={id}>{id === 'islas' ? t('Islas', 'Islands') : regName(id)}</text>)}
            </svg>
            <div class="adb-regs">{REGIONS.map((r) => <button type="button" data-reg-btn={r.id} aria-pressed="false" title={regTowns(r)}>{regName(r.id)}</button>)}</div>
            <p class="wiz-help" data-aud-hint></p>
          </div>
          <div data-views-wrap>
            <p class="wiz-q">{t("¿Cuántas vistas quieres?", "How many views do you want?")}</p>
            <div class="wiz-chips">
              {VIEW_PACKS.map((v) => { const d = [...VIEW_DISCOUNTS].reverse().find((x) => v >= x.from); return <label><input type="radio" name="views" value={v} checked={v === 10000} /><span>{v.toLocaleString('en-US')}{d && <small> −{d.pct}%</small>}</span></label>; })}
            </div>
            <p class="wiz-help">{t("Pagas por vistas reales: cuenta cuando tu anuncio aparece en la pantalla de un lector. Cuando se cumplen, tu anuncio termina solo y te avisamos.", "You pay for real views: one counts when your ad appears on a reader's screen. When they're delivered, your ad ends by itself and we let you know.")}</p>
          </div>
          <div data-time-wrap>
          <p class="wiz-q" data-time-q>{t("¿Por cuánto tiempo?", "For how long?")}</p>
          {/* Monthly first, as a card of its own; then the fixed lengths (user, 2026-11-06: clearer for a small business) */}
          <div class="wiz-chips wiz-time-sub">
            <label><input type="radio" name="months" value="sub" checked /><span><b>{t('Cada mes', 'Monthly')} <small>−{SUBSCRIPTION_DISCOUNT}%</small></b><em>{t('Recomendado · se renueva solo y cancelas cuando quieras', 'Recommended · renews by itself, cancel anytime')}</em></span></label>
          </div>
          <p class="wiz-help" data-sub-note hidden>{t('Se cobra a tu tarjeta cada mes y tu anuncio sigue saliendo. Cancelas cuando quieras (escríbenos y lo cancelamos): sale hasta el final del mes pagado. Solo con tarjeta.', 'Your card is charged every month and your ad keeps running. Cancel anytime (write to us and we cancel it): it runs until the end of the paid month. Card only.')}</p>
          <p class="wiz-time-or">{t('O escoge un tiempo fijo (se paga una sola vez):', 'Or pick a fixed time (paid once):')}</p>
          <div class="wiz-chips">
            {DURATIONS.filter((d) => !['sub', '14', '360'].includes(d.v)) /* fewer buttons (user, 2026-11-06): 1 week, 1, 3 and 6 months */.map((d) => <label><input type="radio" name="months" value={d.v} /><span>{d.label}{d.off > 0 && <small> −{d.off}%</small>}</span></label>)}
          </div>
          </div>
          <div data-days-wrap hidden>
            <p class="wiz-q">{SELL_BY_VIEWS ? t('Toma de portada: ¿por días o por vistas?', 'Home page takeover: by days or by views?') : t('Toma de portada: ¿cuántos días?', 'Home page takeover: how many days?')}</p>
            <div class="wiz-chips">
              <label><input type="radio" name="tkmode" value="dias" checked /><span>{t("Por días", "By days")}</span></label>
              {SELL_BY_VIEWS && <label><input type="radio" name="tkmode" value="vistas" /><span>{t("Por vistas", "By views")}</span></label>}
            </div>
            <div class="wiz-chips" data-tk-views hidden>
              {TAKEOVER_VIEW_PACKS.map((v) => <label><input type="radio" name="tkviews" value={v} checked={v === 50000} /><span>{v.toLocaleString('en-US')}</span></label>)}
            </div>
            <p class="wiz-help" data-tk-help></p>
          </div>
          <div class="wiz-row">
            <label>{t("Empieza el", "Starts on")}<input type="date" name="start" data-start /></label>
          {/* Fair share (src/lib/ads.ts): an estimate of views, and the next free date when the space is full */}
          <p class="wiz-help wiz-fair" data-fair hidden></p>
            <label data-tk-days>{t("Días de toma de portada", "Takeover days")}<input type="number" name="days" min="1" max="14" value="1" /></label>
          </div>
        </fieldset>

        <!-- 3 · The ad -->
        <fieldset class="wiz-step" data-step="3" hidden>
          <legend>{t("Tu anuncio", "Your ad")}</legend>
          <div class="wiz-two">
            <label class="wiz-mode"><input type="radio" name="mode" value="upload" checked /><b>{t("Ya tengo mi anuncio", "I already have my ad")}</b><span>{t("Súbelo y lo revisamos.", "Upload it and we'll review it.")}</span></label>
            <label class="wiz-mode"><input type="radio" name="mode" value="design" /><b>{t("Créenlo por mí", "Create it for me")}</b><span data-design-price>{money(DESIGN_FEE)} · {t('lo diseñamos en todos los tamaños', 'we design it in every size')}</span></label>
          </div>

          <div class="wiz-pane" data-pane="upload">
            <p class="wiz-help" data-sizes></p>
            <label class="wiz-drop">
              <input type="file" accept={UPLOAD.types.join(',')} multiple data-files />
              <b>{t("Toca para subir tu anuncio", "Tap to upload your ad")}</b>
              <span>{en ? `JPG, PNG, GIF or WEBP · up to ${UPLOAD.maxMB} MB each` : `JPG, PNG, GIF o WEBP · hasta ${UPLOAD.maxMB} MB cada uno`}</span>
            </label>
            <ul class="wiz-thumbs" data-thumbs></ul>
          </div>

          <div class="wiz-pane" data-pane="design" hidden>
            <div class="wiz-design">
              <div class="wiz-fields">
                <label class="wiz-drop sm">
                  <input type="file" accept={UPLOAD.types.join(',')} data-logo />
                  <b data-logo-label>{t("Sube tu logo (opcional)", "Upload your logo (optional)")}</b>
                </label>
                <label>{t("¿Qué dice el título?", "Headline")} <small data-count="title">0/30</small><input name="title" maxlength="30" placeholder={t("Ej. Pan sobao calientito", "E.g. Fresh bread every morning")} /></label>
                <label>{t("Mensaje corto", "Short message")} <small data-count="msg">0/80</small><textarea name="msg" rows="2" maxlength="80" placeholder={t("Ej. Todos los días desde las 6 a.m. en Bayamón", "E.g. Every day from 6 a.m. in Bayamón")}></textarea></label>
                <label>{t("Botón", "Button")} <small data-count="cta">0/24</small><input name="cta" maxlength="24" placeholder={t("Ej. Llama hoy", "E.g. Call today")} /></label>
                <div class="wiz-sugg">{CTAS.map((c) => <button type="button" data-cta={c}>{c}</button>)}</div>
                <p class="wiz-q">{t("Colores", "Colors")}</p>
                <div class="wiz-themes">
                  {THEMES.map((t, i) => <label title={t.name}><input type="radio" name="theme" value={t.id} checked={i === 0} /><span style={`background:linear-gradient(135deg,${t.a},${t.b})`}></span><b class="sr">{t.name}</b></label>)}
                </div>
                <label>{t("Algo más para quien lo diseña (opcional)", "Anything else for the designer (optional)")}<textarea name="notes" rows="2" placeholder={t("Ej. Incluye el teléfono 787-555-0100", "E.g. Include the phone number 787-555-0100")}></textarea></label>
              </div>
              <div class="wiz-previews">
                <p class="wiz-q">{t("Así se verá", "How it will look")}</p>
                <div data-previews></div>
                <p class="wiz-help">{t("Nuestro equipo lo revisa y lo mejora antes de publicarlo.", "Our team reviews and polishes it before it runs.")}</p>
              </div>
            </div>
          </div>

          <label class="wiz-link">{t("¿A dónde lleva tu anuncio cuando lo tocan?", "Where should your ad go when tapped?")} <small>{t("Tu página, Facebook, Instagram o WhatsApp", "Your website, Facebook, Instagram or WhatsApp")}</small>
            <input name="link" type="text" inputmode="url" placeholder={t("https://tu-negocio.com o https://wa.me/1787…", "https://your-business.com or https://wa.me/1787…")} />
          </label>
        </fieldset>

        <!-- 4 · Details and payment -->
        <fieldset class="wiz-step" data-step="4" hidden>
          <legend>{t("Tus datos y pago", "Your details and payment")}</legend>
          <div class="wiz-pay">
            <div class="wiz-fields">
              <div class="wiz-row">
                <label>{t("Tu nombre", "Your name")}<input name="nombre" autocomplete="name" /></label>
                <label>{t("Negocio", "Business")}<input name="negocio" autocomplete="organization" /></label>
                <label>{t("Correo", "Email")}<input name="correo" type="email" autocomplete="email" /></label>
                <label>{t("Teléfono", "Phone")}<input name="telefono" type="tel" autocomplete="tel" /></label>
              </div>
              <label>{t("Soy", "I am")}
                <select name="who"><option value="retail">{t("Negocio local", "A local business")}</option><option value="agency">{t("Agencia o marca grande", "An agency or large brand")}</option><option value="nonprofit">{t("Sin fines de lucro (−50%)", "A nonprofit (−50%)")}</option></select>
              </label>
              {/* First-time discount: only for a signed-in client whose account never ordered (checked again by the database) */}
              <label class="adb-check" data-founder-wrap><input type="checkbox" name="founder" data-founder disabled /> {t("Es mi primera vez anunciándome aquí", "It's my first time advertising here")} (−{LAUNCH_DISCOUNT.pct}%)</label>
              <p class="wiz-help founder-note" data-founder-note></p>
            </div>
            <div class="wiz-sum">
