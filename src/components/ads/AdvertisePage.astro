              : <tr><td>{fmt(f).name}<small>{fmt(f).size}{!SELF_SERVE.includes(f.id) && <> · {t('con Ventas', 'through sales')}</>}</small></td><td colspan="3"><b>{money(f.price)}</b> {t('por', 'per')} {per(f.per)}{f.per === 'mes' && ` · ${money(rate(f)!.week)} ${t('por semana', 'per week')}`}</td></tr>)}</tbody>
