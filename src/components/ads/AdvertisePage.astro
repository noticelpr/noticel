      paintThumbs(); drawPreviews();
    }

    // ---- Upload ----
    const fitsSize = (w: number, h: number) => picked().flatMap((f) => f.art).some(([aw, ah]) => Math.abs(w / h - aw / ah) / (aw / ah) < 0.08);
    function paintThumbs() {
      $('[data-thumbs]').innerHTML = files.map((f, i) => {
        const ok = fitsSize(f.w, f.h);
        return `<li><img src="${f.data}" alt="" /><span><b>${f.name.replace(/</g, '&lt;')}</b><small class="${ok ? 'ok' : 'warn'}">${f.w} × ${f.h} ${ok ? t('✓ Buen tamaño', '✓ Good size') : t('⚠ Otro tamaño: lo adaptamos', "⚠ Different size: we'll adapt it")}</small></span><button type="button" data-rm="${i}" aria-label="${t('Quitar', 'Remove')}">✕</button></li>`;
      }).join('');
    }
    $<HTMLInputElement>('[data-files]').addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement; const er = $('[data-err]'); er.hidden = true;
      for (const file of [...(input.files || [])].slice(0, 6)) {
        if (!cfg.upload.types.includes(file.type)) { er.textContent = `${file.name}: ${t('usa JPG, PNG, GIF o WEBP.', 'use JPG, PNG, GIF or WEBP.')}`; er.hidden = false; continue; }
        if (file.size > cfg.upload.maxMB * 1048576) { er.textContent = t(`${file.name} pesa más de ${cfg.upload.maxMB} MB.`, `${file.name} is larger than ${cfg.upload.maxMB} MB.`); er.hidden = false; continue; }
        const img = await loadImage(file);
