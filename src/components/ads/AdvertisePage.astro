    }
    const top = () => document.getElementById('campana')!.scrollIntoView({ behavior: 'smooth' });
    $('[data-next]').addEventListener('click', () => { if (!err(check(step))) { go(step + 1); top(); } });
    $('[data-back]').addEventListener('click', () => { go(step - 1); top(); });
    document.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => {
      const k = Number(b.dataset.goto);
      for (let i = 1; i < k; i++) if (err(check(i))) { go(i); err(check(i)); return; } // finish earlier steps first
      go(k);
    }));
    // "Toma total por vistas" is the takeover bought by views: it checks Toma de portada and picks "Por vistas"
    const tkAlias = wf.querySelector<HTMLInputElement>('[data-tk-alias]')!;
    const tkBox = wf.querySelector<HTMLInputElement>('input[name="fmt"][value="takeover"]')!;
    const tkMode = (v: string) => wf.querySelector<HTMLInputElement>(`input[name="tkmode"][value="${v}"]`)!;
    wf.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.matches('[data-keep]') && !t.checked) { t.checked = true; return; } // the only ad sold here: always picked
      // Only one of the two takeover cards at a time; the alias counts as Toma de portada bought by views
      // The full takeover already owns every space: picking it clears the other cards, and picking another card clears it
      // (Both only exist while selling by views; by time there is just "Toma de portada" by days)
      if (tkAlias && tkMode('vistas')) {
        if (t === tkAlias && t.checked) { wf.querySelectorAll<HTMLInputElement>('input[name="fmt"]').forEach((b) => (b.checked = false)); tkMode('vistas').checked = true; }
        else if (t.name === 'fmt' && t.checked && tkAlias.checked) tkAlias.checked = false;
        if (t === tkBox && t.checked) tkMode('dias').checked = true;
