      g.innerHTML = gift ? `🎁 ${t('Te ganas', 'You earn')}: <b>${gift.gift}</b>` : next ? t(`🎁 Te faltan ${money(next.at - total)} para ganarte ${next.gift.toLowerCase()}.`, `🎁 Spend ${money(next.at - total)} more to earn ${next.gift.replace(/^1 free/, 'a free')}.`) : '';
      $<HTMLButtonElement>('[data-pay]').textContent = `${t('Pagar', 'Pay')} ${money(total)}`;
      summary = [...lines.map(([n, c]) => `${n}: ${money(c)}`), ...q.discounts.map(([n, a]) => `${t('Descuento', 'Discount')}: ${n} −${money(a)}`), `${t('Descuentos', 'Discounts')}: −${money(off)}`, design !== null ? `${t('Diseño', 'Design')}: ${design ? money(design) : t('gratis', 'free')}` : ''].filter(Boolean);
