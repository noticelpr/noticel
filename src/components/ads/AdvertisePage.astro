    };
    function done(p: Pending, how: string, confirmedByStripe = false) {
      if (!confirmedByStripe) void markPaid(p.id); // a card payment is marked paid by Stripe itself
      try { localStorage.removeItem('nc-ad-pending'); } catch { /* storage blocked */ }
      $('[data-done-ref]').textContent = `${how} · ${t('Solicitud', 'Request')} ${p.id}`;
      $('[data-done-email]').textContent = p.email || t('tu correo', 'your email');
      $('[data-done-design]').hidden = p.mode !== 'design';
      if (sharedRequests()) {
        // The order (with its images, or the logo and text to design it) is already saved: nothing to email.
        // Only a "Créenlo por mí" order without a logo gets a tip to send one by replying to the confirmation.
        const noLogo = p.mode === 'design' && !p.logo;
        $('[data-send]').hidden = !noLogo; $<HTMLAnchorElement>('[data-send-link]').hidden = true;
        if (noLogo) { $('[data-send-label]').textContent = t('¿Tienes logo?', 'Have a logo?'); $('[data-send-text]').textContent = t('Contesta el correo de confirmación que te enviamos y adjúntalo. Si no tienes, lo diseñamos con el nombre de tu negocio.', "Reply to the confirmation email we sent you and attach it. If you don't have one, we'll design it with your business name."); }
      } else if (salesEmail) {
        $('[data-send]').hidden = false;
        $('[data-send-text]').textContent = p.mode === 'design' ? t('envíanos tu logo por correo (si tienes uno). Ya incluimos lo que escribiste.', 'email us your logo (if you have one). What you wrote is already included.') : t('envíanos por correo las imágenes de tu anuncio.', 'email us the images of your ad.');
        $<HTMLAnchorElement>('[data-send-link]').href = `mailto:${salesEmail}?subject=${encodeURIComponent(`${t('Mi anuncio', 'My ad')} ${p.id}: ${p.business}`)}&body=${encodeURIComponent(p.body)}`;
      } else {
        $('[data-send]').hidden = false;
        $('[data-send-text]').textContent = t('te escribiremos a tu correo para recibir tu anuncio.', "we'll email you to receive your ad.");
        $('[data-send-link]').hidden = true;
      }
      show('done');
    }
    function payErr(m: string) { const e = $('[data-pay-err]'); e.textContent = m; e.hidden = !m; }

    // ATH Móvil web button (loaded once, only when set up)
    let athLoaded = false;
    function setupATH(p: Pending) {
      if (!cfg.pay.athMovilToken) return;
      const w = window as any;
      const ok = p.amount >= 1 && p.amount <= 1500;
      wf.querySelector<HTMLElement>('#ATHMovil_Checkout_Button_payment')!.hidden = !ok;
      $('[data-ath-note]').textContent = ok ? t('Se abre ATH Móvil para confirmar el pago.', 'ATH Móvil opens to confirm the payment.') : t('ATH Móvil acepta pagos de $1 a $1,500. Usa tarjeta para esta cantidad.', 'ATH Móvil accepts payments from $1 to $1,500. Use a card for this amount.');
      w.ATHM_Checkout = { env: 'production', publicToken: cfg.pay.athMovilToken, timeout: 600, theme: 'btn', lang: EN ? 'en' : 'es',
        total: p.amount, subtotal: p.amount, tax: 0, metadata1: p.id.slice(0, 40), metadata2: p.business.slice(0, 40),
        items: [{ name: t('Anuncio en NotiCel', 'Ad on NotiCel'), description: p.id, quantity: '1', price: String(p.amount), tax: '0', metadata: p.business.slice(0, 40) }], phoneNumber: '' };
      w.authorizationATHM = async () => {
        try {
          const r = await w.authorization(); const d = r?.data ?? r;
          if (d?.ecommerceStatus === 'COMPLETED') done(p, `${t('Pagado con ATH Móvil', 'Paid with ATH Móvil')}${d.referenceNumber ? ` · ${t('referencia', 'reference')} ${d.referenceNumber}` : ''}`);
          else payErr(t('No pudimos confirmar el pago de ATH Móvil. Si se cobró, escríbenos y lo resolvemos.', "We couldn't confirm the ATH Móvil payment. If you were charged, write to us and we'll fix it."));
        } catch { payErr(t('No pudimos confirmar el pago de ATH Móvil. Si se cobró, escríbenos y lo resolvemos.', "We couldn't confirm the ATH Móvil payment. If you were charged, write to us and we'll fix it.")); }
      };
      w.cancelATHM = async () => payErr(t('Cancelaste el pago de ATH Móvil. Puedes intentarlo otra vez.', 'You canceled the ATH Móvil payment. You can try again.'));
      w.expiredATHM = async () => payErr(t('Se acabó el tiempo para pagar con ATH Móvil. Intenta otra vez.', 'Time ran out to pay with ATH Móvil. Try again.'));
      if (!athLoaded) { athLoaded = true; const sc = document.createElement('script'); sc.src = 'https://payments.athmovil.com/api/modal/js/athmovil_base.js'; document.body.append(sc); }
    }

    wf.addEventListener('submit', async (e) => {
      e.preventDefault();
      for (let i = 1; i <= 4; i++) if (check(i)) { go(i); err(check(i)); return; }
      // Their account, along the way (user, 2026-11-02): to follow the ad, see its results and order again. Signing up
      // (or in) here carries on with the order by itself.
      if (hasBackend() && !loggedIn()) {
        waitingAccount = true;
        err(t('Último paso: crea tu cuenta gratis (o entra) para enviar tu anuncio y seguir sus resultados.', 'Last step: create your free account (or sign in) to send your ad and follow its results.'));
        askLogin(t('Crea tu cuenta para enviar tu anuncio. Con ella sigues sus resultados y pides el próximo más rápido.', 'Create your account to send your ad. With it you follow its results and order the next one faster.'), { mode: 'up', email: val('correo') });
        return;
      }
      const mode = val('mode') as 'upload' | 'design';
      const id = `NC-${Date.now().toString(36).toUpperCase()}`;
      const designFiles: ArtFile[] = [];
      if (mode === 'design') wf.querySelectorAll<HTMLCanvasElement>('[data-previews] canvas').forEach((c) => designFiles.push({ name: `${c.dataset.w}x${c.dataset.h}.png`, w: Number(c.dataset.w), h: Number(c.dataset.h), data: c.toDataURL('image/png') }));
      // The first-time discount goes with the client's own sign-in, and only with their account's email
      const firstTime = !!new FormData(wf).get('founder');
      if (firstTime && founderEmail && val('correo').toLowerCase() !== founderEmail.toLowerCase()) { err(t(`El descuento de primera vez es para el correo de tu cuenta (${founderEmail}).`, `The first-time discount is for your account's email (${founderEmail}).`)); return; }
      const userTok = firstTime ? await accountToken() : undefined;
      const go4 = wf.querySelector<HTMLButtonElement>('button[type="submit"]'); if (go4) go4.disabled = true;
      const sent = await saveRequest({
        id, created: new Date().toISOString(), status: mode === 'design' ? 'disenar' : 'revisar', paid: false,
        client: { name: val('nombre'), business: val('negocio'), email: val('correo'), phone: val('telefono'), who: val('who'), ...(EN ? { lang: 'en' as const } : {}) },
        formats: picked().map((f) => f.id), where, start: val('start'), duration: durLabel(), views: viewsPicked() || undefined, takeoverViews: tkViews() || undefined, total: Math.round(total), lines: refCode ? [...summary, `Referido: ${refCode}`] : summary,
        art: mode === 'upload' ? { mode, files } : { mode, files: designFiles, logo: logoData, title: val('title'), msg: val('msg'), cta: val('cta'), theme: val('theme'), notes: val('notes') },
        link: val('link'),
      }, userTok);
      if (go4) go4.disabled = false;
      if (sent === true && firstTime) { founderUsed = true; void founderCheck(); }
      if (sent !== true) { err(sent || t('No pudimos enviar tu solicitud. Revisa tu conexión e intenta otra vez (las imágenes de hasta 5 MB).', "We couldn't send your request. Check your connection and try again (images up to 5 MB).")); return; }
      const amount = amountOf(total);
      const body = [...(EN ? ['(English-speaking client / Cliente en inglés)'] : []), `Solicitud: ${id}`, `Nombre: ${val('nombre')}`, `Negocio: ${val('negocio')}`, `Correo: ${val('correo')}`, `Teléfono: ${val('telefono')}`, '',
        ...summary, `Dónde: ${where}`, `Empieza: ${val('start')} · ${durLabel()}`, `Total pagado: $${amount.toFixed(2)}`, `Enlace: ${val('link') || '—'}`, '',
        mode === 'design' ? `Créenlo por mí:
Título: ${val('title')}
Mensaje: ${val('msg')}
Botón: ${val('cta')}
Colores: ${val('theme')}
Notas: ${val('notes')}

(Adjunto mi logo si tengo uno.)` : '(Adjunto las imágenes de mi anuncio.)'].join('\n');
      pending = { id, email: val('correo'), business: val('negocio'), mode, amount, body, logo: !!logoData };
      if (!canPay && sharedRequests()) {
        // Online payments aren't set up yet, but the request reached the team: they contact the client to pay
        show('done');
        $('[data-done-h]').textContent = t('¡Recibimos tu solicitud!', 'We got your request!');
        $('[data-done-ref]').textContent = `${t('Solicitud', 'Request')} ${id}`; $('[data-done-email]').textContent = val('correo'); $('[data-done-design]').hidden = mode !== 'design';
        const n = $('[data-done-note]'); n.hidden = false;
        n.textContent = t('Nuestro equipo de ventas la revisará y te escribirá en 1 día laborable para coordinar el pago y la fecha de salida. No se ha cobrado nada todavía.', 'Our sales team will review it and write to you, in English, within 1 business day to arrange payment and the start date. Nothing has been charged yet.');
        return;
      }
      if (!canPay) {
        // Preview: nothing is charged or sent
        show('done');
        $('[data-done-h]').textContent = t('Así funcionará (vista previa)', 'How it will work (preview)');
        $('[data-done-ref]').textContent = ''; $('[data-done-email]').textContent = val('correo'); $('[data-done-design]').hidden = mode !== 'design';
        const n = $('[data-done-note]'); n.hidden = false;
        n.textContent = t('Los pagos en línea se activan muy pronto: no se cobró nada ni se envió tu anuncio. Para anunciarte hoy, usa “Prefiero hablar con alguien” más abajo.', 'Online payments are coming very soon: nothing was charged and your ad was not sent. To advertise today, use “I\'d rather talk to someone” below.');
        return;
      }
      try { localStorage.setItem('nc-ad-pending', JSON.stringify(pending)); } catch { /* storage blocked */ }
      // A subscription is charged every month by card: ATH Móvil only takes one-time payments
      const sub = subOn();
      $('[data-pay-total]').textContent = `$${amount.toFixed(2)}${sub ? t(' al mes', '/month') : ''}`;
      wf.querySelectorAll<HTMLElement>('.wiz-method').forEach((m) => { if (m.querySelector('#ATHMovil_Checkout_Button_payment')) m.hidden = sub; });
      payErr(''); if (!sub) setupATH(pending); show('pay');
    });
    wf.querySelector<HTMLButtonElement>('[data-stripe]')?.addEventListener('click', async (e) => {
      if (!pending) return;
      const b = e.currentTarget as HTMLButtonElement; b.disabled = true; payErr('');
      const r = await cardPayment(pending.id);
      if (r.url) { location.href = r.url; return; }
      b.disabled = false;
      payErr(r.error || t('No se pudo abrir la página de pago. Revisa tu conexión e intenta otra vez.', "The payment page couldn't open. Check your connection and try again."));
    });
    $('[data-pay-back]').addEventListener('click', () => { go(4); show('steps'); });
    $('[data-again]').addEventListener('click', () => { files = []; paintThumbs(); go(1); show('steps'); });

    // ---- First-time discount: signed in, and the account never ordered before ----
    let founderEmail = '', founderUsed = false;
    async function founderCheck() {
      const box = wf.querySelector<HTMLInputElement>('[data-founder]')!, wrap = wf.querySelector<HTMLElement>('[data-founder-wrap]')!, note = wf.querySelector<HTMLElement>('[data-founder-note]')!;
      const off = (msg: string) => { box.checked = false; box.disabled = true; note.innerHTML = msg; calc(); };
      if (!sharedRequests()) { wrap.hidden = false; box.disabled = false; note.textContent = ''; return; } // preview without the database
      if (!loggedIn()) {
        wrap.hidden = false;
        return off(`${t('¿Primera vez? Entra a tu cuenta para el descuento de primera vez.', 'First time? Sign in for the first-time discount.')} <button type="button" class="pnl-link" data-founder-login>${t('Entrar o crear cuenta', 'Sign in or create an account')}</button>`);
      }
      const info = await accountInfo(); founderEmail = info?.email ?? '';
      // Their own orders (the database only shows a client the orders made with their account's email)
      const r = founderUsed ? null : await api('ad_requests?select=status');
      const mine: Array<{ status: string }> = r?.ok ? await r.json() : [];
      if (founderUsed || mine.some((x) => x.status !== 'rechazada')) { wrap.hidden = true; box.checked = false; note.textContent = ''; calc(); return; } // already used
      wrap.hidden = false; box.disabled = false; if (!box.dataset.touched) box.checked = true;
      note.textContent = t(`Para tu cuenta (${founderEmail}): usa este mismo correo en el pedido.`, `For your account (${founderEmail}): use this same email in the order.`);
      const mail = wf.querySelector<HTMLInputElement>('[name="correo"]')!; if (!mail.value) mail.value = founderEmail;
      calc();
    }
    // "Crear mi anuncio": straight into step 1, its first choice ready to tap
    document.querySelector('[data-start]')?.addEventListener('click', (e) => {
      e.preventDefault(); go(1);
      document.getElementById('campana')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => wf.querySelector<HTMLInputElement>('input[name="fmt"], input[type="radio"], input[type="checkbox"]')?.focus({ preventScroll: true }), 500);
    });
    wf.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-founder-login]')) askLogin(t('Entra para usar el descuento de primera vez.', 'Sign in to use the first-time discount.')); });
    wf.querySelector('[data-founder]')!.addEventListener('change', (e) => ((e.target as HTMLElement).dataset.touched = '1'));
    let waitingAccount = false; // the order waits for the account it asked for
    addEventListener('nc-profile-change', () => { void founderCheck(); if (waitingAccount && loggedIn()) { waitingAccount = false; err(''); wf.requestSubmit(); } });
    void founderCheck();

    go(1);

    // ---- Comunicado de prensa: its own short order (src/lib/comunicados.ts) ----
    const cform = document.querySelector<HTMLFormElement>('[data-com-form]')!;
    const PRICE = { ready: Number(cfg.comunicado.ready), written: Number(cfg.comunicado.written) };
    let comPhoto: ArtFile | null = null;
    const comKind = () => (new FormData(cform).get('kind') === 'written' ? 'written' : 'ready');
    const comPaint = () => {
      const k = comKind();
      cform.querySelector('[data-com-pay]')!.textContent = `${cfg.pay.stripe ? t('Pagar', 'Pay') : t('Enviar', 'Send')} ${money(PRICE[k])}`;
      cform.querySelector('[data-com-text-l]')!.textContent = k === 'written' ? t('Los datos: qué pasó, cuándo, dónde, quién, y una cita si quieres', 'The facts: what, when, where, who, and a quote if you like') : t('El comunicado', 'The press release');
    };
    cform.addEventListener('change', comPaint); comPaint();
    cform.querySelector<HTMLInputElement>('[data-com-photo]')!.addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0]; comPhoto = null; if (!f) return;
      if (f.size > 5 * 1048576) { (e.target as HTMLInputElement).value = ''; return void (cform.querySelector('[data-com-err]')!.textContent = t('La foto pesa más de 5 MB.', 'The photo is larger than 5 MB.')); }
      const img = await loadImage(f); comPhoto = { name: f.name, w: img.naturalWidth, h: img.naturalHeight, data: shrink(img, 1600, 'image/jpeg') };
    });
    cform.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(cform), v = (k: string) => String(d.get(k) ?? '').trim(), er = cform.querySelector<HTMLElement>('[data-com-err]')!;
      const k = comKind();
      const msg = v('title').length < 5 ? t('Escribe el título.', 'Write the headline.') : v('text').length < (k === 'written' ? 40 : 200) ? (k === 'written' ? t('Danos más datos para escribirlo (qué, cuándo, dónde, quién).', 'Give us more facts to write it (what, when, where, who).') : t('Pega el comunicado completo.', 'Paste the whole press release.'))
        : !v('nombre') || !v('negocio') ? t('Escribe tu nombre y el de tu negocio.', 'Enter your name and your business name.') : !emailOk(v('correo')) ? t('Escribe un correo válido.', 'Enter a valid email.') : '';
      er.textContent = msg; er.hidden = !msg; if (msg) return;
      const btn = cform.querySelector<HTMLButtonElement>('[data-com-pay]')!; btn.disabled = true;
      const id = `NC-${Date.now().toString(36).toUpperCase()}`;
      const sent = await saveRequest({ id, created: new Date().toISOString(), status: k === 'written' ? 'disenar' : 'revisar', paid: false,
        client: { name: v('nombre'), business: v('negocio'), email: v('correo'), phone: v('telefono'), who: 'retail', ...(EN ? { lang: 'en' as const } : {}) },
        formats: ['comunicado'], where: '', start: new Date().toISOString().slice(0, 10), duration: k === 'written' ? 'Comunicado (lo escribimos)' : 'Comunicado (escrito por el cliente)', total: PRICE[k],
        lines: [`Sección: ${v('section')}`, `Comunicado de prensa: ${k === 'written' ? 'lo escribimos nosotros' : 'escrito por el cliente'}`, ...(refCode ? [`Referido: ${refCode}`] : [])],
        art: { mode: k === 'written' ? 'design' : 'upload', files: comPhoto ? [comPhoto] : [], title: v('title'), cta: v('summary'), msg: v('text') }, link: '' });
      if (sent !== true) { btn.disabled = false; er.textContent = sent || t('No pudimos enviarlo. Revisa tu conexión e intenta otra vez.', "We couldn't send it. Check your connection and try again."); er.hidden = false; return; }
      if (cfg.pay.stripe) {
        const pay = await cardPayment(id);
        if (pay.url) { location.href = pay.url; return; }
        btn.disabled = false; er.textContent = pay.error || t('Recibimos tu comunicado, pero no se abrió el pago. Te escribiremos para cobrarlo.', 'We got your release, but the payment page did not open. We will write to you to collect.'); er.hidden = false; return;
      }
      cform.reset(); comPaint(); btn.disabled = false;
      const dn = cform.querySelector<HTMLElement>('[data-com-done]')!; dn.hidden = false;
      dn.textContent = t(`¡Recibimos tu comunicado (${id})! Ventas te escribirá en 1 día laborable para coordinar el pago. No se ha cobrado nada todavía.`, `We got your press release (${id})! Sales will write to you within 1 business day to arrange payment. Nothing has been charged yet.`);
    });
    // Back from Stripe's payment page: ?pagado=1 (paid; Stripe already told the database) or ?cancelado=1 (back to paying)
    const back = new URLSearchParams(location.search);
    if (back.has('pagado') || back.has('cancelado')) {
      let p: Pending | null = null;
      try { p = JSON.parse(localStorage.getItem('nc-ad-pending') || 'null'); } catch { /* storage blocked */ }
      if (p && back.get('r') && back.get('r') !== p.id) p = null;
      if (back.has('pagado')) {
        // Another device or a cleared browser: no saved order here, so only the confirmation
        p ??= { id: back.get('r') ?? '', email: '', business: '', mode: 'upload', amount: 0, body: '' };
        pending = p; done(p, t('Pagado con tarjeta', 'Paid by card'), true);
      } else if (p) {
        pending = p; $('[data-pay-total]').textContent = `$${p.amount.toFixed(2)}`; setupATH(p); show('pay');
        payErr(t('No se completó el pago. Puedes intentarlo otra vez.', 'The payment was not completed. You can try again.'));
      }
      history.replaceState(null, '', location.pathname + location.hash);
    }

  </script>
</Base>
