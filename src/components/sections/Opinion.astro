---
// Opinión: half the page for the columnists (each links to their profile), half for the latest columns in order
// and the most read. Phones: columnists in a sideways row, then the columns. Columnists: src/data/columnistas.json.
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import GamesTeaser from '../../components/GamesTeaser.astro';
import Time from '../../components/Time.astro';
import { getStories, mostRead, SITE, url , storyUrl } from '../../lib/site';
import { COLUMNISTS, columnistOf, columnsBy, initials } from '../../lib/columnists';

const all = await getStories();
const columns = all.filter((s) => s.data.section === 'opiniones');
const top = mostRead(columns, 5);
const pic = (author: string) => columnistOf(author)?.photo;
---
<Base title="Opiniones" active="opiniones" description={`Columnas, editoriales y la voz de los lectores en ${SITE.name}.`}>
  <main class="wrap op" id="main">
    <header class="op-head">
      <h1>Opinión</h1>
      <p>Columnas, editoriales y la voz de los lectores</p>
    </header>

    <div class="op-split">
      <section class="op-people" aria-labelledby="op-ppl">
        <h2 id="op-ppl" class="op-h">Nuestros columnistas</h2>
        <ul class="op-ppl-list">
          {COLUMNISTS.map((c) => {
            const last = columnsBy(all, c)[0];
            return (
              <li>
                <a class="op-person" href={url(`opinion/${c.slug}`)}>
                  {c.photo ? <img class="col-pic" src={url(c.photo)} alt="" /> : <span class="col-pic col-ini" aria-hidden="true">{initials(c.name)}</span>}
                  <span class="op-person-t">
                    <b>{c.name}{c.demo && <span class="sp-demo">EJEMPLO</span>}</b>
                    {c.role && <span class="col-role">{c.role}</span>}
                    {c.bio && <span class="op-bio">{c.bio}</span>}
                    <span class="op-last">{last ? `Última: ${last.data.title}` : 'Ver perfil ›'}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
        <div class="op-extra">
          <a class="op-box" href={url('foro')}><b>💬 Foro NotiCel</b><span>¿Tienes una opinión? Abre un tema y vota por las mejores ideas.</span></a>
          <div class="op-box"><b>✍️ Escribe para Opinión</b><span>Envíanos tu columna de hasta 700 palabras, con tu nombre completo y una línea sobre ti.</span>
            {SITE.email ? <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Columna para Opinión')}`}>Enviar columna ›</a> : <small>Muy pronto publicaremos el correo para enviar columnas.</small>}
          </div>
        </div>
      </section>

      <div class="op-right">
        <section aria-labelledby="op-new">
          <h2 id="op-new" class="op-h">Últimas columnas</h2>
          {columns.length > 0 ? (
            <ol class="op-latest">
              {columns.slice(0, 10).map((s) => { const c = columnistOf(s.data.author); return (
                <li>
                  <a class="op-col" href={storyUrl(s)}>
                    <span class="op-by">
                      {pic(s.data.author) ? <img src={url(pic(s.data.author)!)} alt="" /> : <span class="col-ini" aria-hidden="true">{initials(s.data.author)}</span>}
                      <span><b>{s.data.author}</b>{c?.role && <small>{c.role}</small>}</span>
                    </span>
                    <h3 class="hl">{s.data.title}</h3>
                    <p>{s.data.description}</p>
                    <Time date={s.data.date} />
                  </a>
                </li>
              ); })}
            </ol>
          ) : (
            <p class="op-empty">Muy pronto publicaremos las primeras columnas.</p>
          )}
        </section>

        <section class="op-top" aria-labelledby="op-read">
          <h2 id="op-read" class="op-h">Más leídas</h2>
          {top.length > 0 ? (
            <ol>
              {top.map((s, i) => (
                <li><span class="op-n">{i + 1}</span><a href={storyUrl(s)}><b class="hl">{s.data.title}</b><small>{s.data.author}</small></a></li>
              ))}
            </ol>
          ) : <p class="op-empty">Todavía no hay columnas.</p>}
        </section>
      </div>
    </div>

    <AdSlot size="infeed" />
    <GamesTeaser />
  </main>
</Base>
