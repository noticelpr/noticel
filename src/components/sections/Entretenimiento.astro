---
// Entretenimiento: tabloid feel (hot pink + yellow, big uppercase headlines, mosaic),
// same site header, fonts and colors underneath. Horóscopo and Trivia live here too.
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import Time from '../../components/Time.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getStories, topOrder, sectionTop, url , storyUrl } from '../../lib/site';
import { SIGNS, horoscope, signOfTheDay, triviaOfTheDay, todayLong } from '../../lib/daily';
import { upcomingEvents, dateTile, dateLong, calendarLink } from '../../lib/events';

const stories = (await getStories()).filter((s) => s.data.section === 'entretenimiento');
const [lead, ...rest] = sectionTop(topOrder(stories));
const side = rest.slice(0, 2);
const mosaic = rest.slice(2);
const buzz = stories.slice(0, 5);
const todaySign = signOfTheDay();
const trivia = triviaOfTheDay();
const href = (s: (typeof stories)[number]) => storyUrl(s);
const events = upcomingEvents();
const DAY = 86400000;
// "Hoy", "Mañana", "En 23 días" (exact dates only)
const countdown = (d: string) => {
  if (d.length < 10) return '';
  const n = Math.ceil((Date.parse(`${d}T00:00:00-04:00`) - Date.now()) / DAY);
  return n <= 0 ? 'Hoy' : n === 1 ? 'Mañana' : `En ${n} días`;
};
// Column span of each mosaic tile (3 columns): every fifth tile is wide, and the last
// tile stretches to fill its row so there is no empty gap at the end.
let col = 0;
const spans = mosaic.map((_, i) => {
  let w = i % 5 === 0 ? 2 : 1;
  if (col + w > 3) col = 0;
  if (i === mosaic.length - 1) w = 3 - col;
  col = (col + w) % 3;
  return w;
});
---
<Base title="Entretenimiento" active="entretenimiento" description="Farándula, música, cine, televisión y cultura de Puerto Rico. Horóscopo y Trivia NotiCel.">
  <div class="tb">
    <section class="tb-band">
      <div class="wrap">
        <div class="tb-title">
          <span class="tb-star" aria-hidden="true">★</span>
          <h1>NotiCel <span>Entretenimiento</span></h1>
          <p>Farándula, música, cine, televisión y cultura boricua</p>
        </div>
        <nav class="tb-chips" aria-label="Entretenimiento">
          <a href="#lo-ultimo">Lo último</a>
          <a href="#comentan">Lo que todos comentan</a>
          {events.length > 0 && <a href="#eventos">Eventos</a>}
          <a href={url('horoscopo')}>Horóscopo</a>
          <a href={url('juegos/trivia')}>Trivia NotiCel</a>
        </nav>
      </div>
    </section>

    <div class="wrap tb-page" id="main">
      {lead ? (
        <div class="tb-top">
          <a class="tb-lead" href={href(lead)}>
            <Ph sectionId="entretenimiento" image={lead.data.image} sizes="(max-width:760px) 100vw, 760px" priority />
            <span class="tb-flag">Exclusiva NotiCel</span>
            <div class="tb-lead-text"><h2>{lead.data.title}</h2><p>{lead.data.description}</p></div>
          </a>
          <div class="tb-side">
            {side.map((s, i) => (
              <a class:list={['tb-side-card', i === 0 ? 'pink' : 'yellow']} href={href(s)}>
                <Ph sectionId="entretenimiento" image={s.data.image} />
                <h3>{s.data.title}</h3>
              </a>
            ))}
          </div>
          <aside class="tb-buzz" id="comentan">
            <h2>Lo que todos comentan</h2>
            <ol>{buzz.map((s) => <li><a href={href(s)}>{s.data.title}</a></li>)}</ol>
          </aside>
        </div>
      ) : (
        <div class="tb-empty"><span aria-hidden="true">★</span><h2>¡Muy pronto!</h2><p>Farándula, música, cine y televisión de Puerto Rico.</p></div>
      )}

      {events.length > 0 && (
        <section class="tb-events" id="eventos" aria-labelledby="eventos-h">
          <div class="tb-events-h"><h2 class="tb-h" id="eventos-h">Próximos eventos</h2><span>{events.length} {events.length === 1 ? 'evento' : 'eventos'}</span></div>
          <div class="tb-ev-list">
            {events.map((e) => {
              const t = dateTile(e.date);
              const cal = calendarLink(e);
              const cd = countdown(e.date);
              return (
                <article class="tb-ev">
                  <div class="tb-ev-date" aria-hidden="true"><span>{t.top}</span><b>{t.big}</b><span>{t.year}</span></div>
                  <div class="tb-ev-body">
                    <p class="tb-ev-kind">{e.kind}{cd && <em>{cd}</em>}</p>
                    <h3>{e.title}</h3>
                    <ul class="tb-ev-facts">
                      <li><span class="sr">Fecha:</span>{dateLong(e.date)}{e.time && `, ${e.time}`}</li>
                      <li class="notranslate" translate="no"><span class="sr">Lugar:</span>{e.venue}, {e.city}</li>
                      {e.tickets && <li><span class="sr">Boletos:</span>Boletos: {e.ticketsUrl ? <a href={e.ticketsUrl} rel="noopener" target="_blank">{e.tickets}</a> : e.tickets}</li>}
                    </ul>
                    <div class="tb-ev-actions">

                      {cal && <a class="tb-ev-btn ghost" href={cal} rel="noopener" target="_blank">Añadir al calendario</a>}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <div class="tb-grid">
        <div class="tb-main" id="lo-ultimo">
          {mosaic.length > 0 && (
            <>
              <h2 class="tb-h">Lo último</h2>
              <div class="tb-mosaic">
                {mosaic.map((s, i) => (
                  <a class:list={['tb-tile', { big: spans[i] > 1 }]} style={`--span:${spans[i]}`} href={href(s)}>
                    <Ph sectionId="entretenimiento" image={s.data.image} />
                    <div><span class="tb-place notranslate" translate="no">{s.data.place}</span><h3>{s.data.title}</h3><Time date={s.data.date} /></div>
                  </a>
                ))}
              </div>
            </>
          )}
        </div>

        <aside class="tb-right">
          <section class="tb-box tb-horo">
            <h2><span class="hs-zodiac" aria-hidden="true">{todaySign.symbol}{'︎'}</span> Horóscopo de hoy</h2>
            <p class="tb-date">{todayLong()}</p>
            <ul>
              {SIGNS.map((s, i) => (
                <li class:list={{ today: s.id === todaySign.id }}>
                  <a href={url(`horoscopo#${s.id}`)}><span class="hs-zodiac">{s.symbol}{'︎'}</span><b>{s.name}</b><em>{horoscope(i)}</em></a>
                </li>
              ))}
            </ul>
          </section>
          <section class="tb-box tb-trivia">
            <h2>Trivia NotiCel</h2>
            <p>{trivia.q}</p>
            <a class="tb-btn" href={url('juegos/trivia')}>¡Juega ahora!</a>
          </section>
          <AdSlot size="rectangle" />
        </aside>
      </div>
    </div>
  </div>
</Base>
