---
// Clima: weather page, designed for phones first. Live data from the National Weather Service (NWS/SNM),
// read in the reader's browser: pick a town → current conditions, 24-hour chart, 7-day forecast.
// Maps (radar, satellite, tropics), alerts, and "En la isla hoy" (every town at a glance).
// Layout: phones: news, radar, temperature, forecast, towns · computers: radar + forecast + temperature | news | towns.
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getStories, topOrder, sectionTop, url } from '../../lib/site';

const news = sectionTop(topOrder((await getStories()).filter((s) => s.data.section === 'el-tiempo')));
// Towns: name, latitude, longitude
const TOWNS: Array<[string, number, number]> = [
  ['San Juan', 18.4655, -66.1057], ['Ponce', 18.0111, -66.6141], ['Mayagüez', 18.2013, -67.1397], ['Arecibo', 18.4724, -66.7157],
  ['Caguas', 18.2341, -66.0485], ['Fajardo', 18.3258, -65.6524], ['Aguadilla', 18.4277, -67.1541], ['Humacao', 18.1497, -65.8274],
  ['Utuado', 18.2655, -66.7005], ['Vieques', 18.1263, -65.4401], ['Culebra', 18.3030, -65.3010],
];

---
<Base title="El Tiempo" active="el-tiempo" description="El tiempo en Puerto Rico: condiciones por pueblo, pronóstico por hora y de 7 días, radar, satélite, el trópico y alertas.">
  <main class="wrap cx" id="main" data-cx data-towns={JSON.stringify(TOWNS)}>
    <header class="cx-head">
      <div class="cx-head-row">
        <h1>Clima</h1>
        <label class="cx-pick">
          <span class="sr">Escoge tu pueblo</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.5" fill="currentColor"/></svg>
          <select data-town-select class="notranslate" translate="no">
            {TOWNS.map(([n], i) => <option value={i}>{n}</option>)}
          </select>
        </label>
      </div>
      <p>Datos en vivo del <a href="https://www.weather.gov/sju/" rel="noopener" target="_blank">Servicio Nacional de Meteorología</a> y del <a href="https://www.nhc.noaa.gov/" rel="noopener" target="_blank">Centro Nacional de Huracanes</a>.</p>
    </header>

    <div class="cx-alerts" data-alerts hidden></div>

    <!-- Phones: news (main story + 2 more), then the radar, temperature, forecast and towns.
         Computers: radar, forecast and temperature (left) · news like the front page (middle) · towns (right). -->
    <section class="cx-news" aria-labelledby="cx-news-h">
      <div class="sec-h"><h2 id="cx-news-h">Noticias del tiempo</h2></div>
      {news.length > 0 ? (
        <>
          <StoryCard story={news[0]} variant="big" priority />
          {news.length > 1 && <div class="cx-news-list">{news.slice(1, 6).map((s) => <StoryCard story={s} variant="item" />)}</div>}
        </>
      ) : (
        <p class="cx-loading">No hay noticias del tiempo hoy.</p>
      )}
    </section>

    <div class="cx-left">
    <section class="cx-card cx-maps">
      <h2>Mapas</h2>
      <div class="cx-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-map="radar">Radar</button>
        <button type="button" role="tab" aria-selected="false" data-map="sat">Satélite</button>
        <button type="button" role="tab" aria-selected="false" data-map="t2">Trópico 2 días</button>
        <button type="button" role="tab" aria-selected="false" data-map="t7">Trópico 7 días</button>
      </div>
      <figure class="cx-map">
        <img data-map-img loading="lazy" src="https://radar.weather.gov/ridge/standard/TJUA_loop.gif" alt="Radar Doppler de Puerto Rico, última hora" />
        <figcaption data-map-cap>Radar Doppler de Cayey (TJUA), animación de la última hora. Fuente: NWS.</figcaption>
      </figure>
    </section>


    <section class="cx-card">
      <div class="cx-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-tab="hours">Próximas 24 horas</button>
        <button type="button" role="tab" aria-selected="false" data-tab="days">7 días</button>
      </div>
      <div data-panel="hours">
        <div class="cx-chart" data-chart><p class="cx-loading">Cargando…</p></div>
        <p class="cx-chart-read" data-chart-read>Toca la gráfica para ver cada hora.</p>
      </div>
      <div data-panel="days" hidden><ol class="cx-days" data-days><li class="cx-loading">Cargando…</li></ol></div>
    </section>

    <section class="cx-now" aria-live="polite">
      <div class="cx-now-top">
        <span class="cx-now-icon" data-now-icon aria-hidden="true"></span>
        <div>
          <p class="cx-now-place notranslate" translate="no" data-place>San Juan</p>
          <b class="cx-now-temp" data-now-temp>—</b>
          <p class="cx-now-sky" data-now-sky>Cargando…</p>
          <p class="cx-now-feels" data-now-feels></p>
        </div>
      </div>
      <dl class="cx-facts">
        <div><dt>Humedad</dt><dd data-f="hum">—</dd></div>
        <div><dt>Viento</dt><dd data-f="wind">—</dd></div>
        <div><dt>Punto de rocío</dt><dd data-f="dew">—</dd></div>
        <div><dt>Presión</dt><dd data-f="pres">—</dd></div>
        <div><dt>Salida del sol</dt><dd data-f="rise">—</dd></div>
        <div><dt>Puesta del sol</dt><dd data-f="set">—</dd></div>
      </dl>
      <p class="cx-src" data-now-src></p>
    </section>

    </div>

    <aside class="cx-side">
    <section class="cx-card">
      <h2>En la isla hoy</h2>
      <ul class="cx-island" data-island>{TOWNS.map(([n], i) => <li data-i={i}><button type="button" data-pick={i}><b class="notranslate" translate="no">{n}</b><span class="cx-i-sky">…</span><span class="cx-i-t">—</span></button></li>)}</ul>
    </section>
    </aside>

  </main>

  <script>
    const page = document.querySelector<HTMLElement>('[data-cx]')!;
    const $ = (s: string) => page.querySelector<HTMLElement>(s)!;
    const API = 'https://api.weather.gov';
    const TOWNS: Array<[string, number, number]> = JSON.parse(page.dataset.towns!);
    const get = async (u: string) => { const r = await fetch(u, { headers: { Accept: 'application/geo+json' } }); if (!r.ok) throw new Error(String(r.status)); return r.json(); };
    const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* storage blocked */ } } };

    // ---- Words and icons ----
    const PHRASES: Array<[RegExp, string]> = [
      [/Showers And Thunderstorms Likely/i, 'Aguaceros y tormentas probables'], [/Chance Showers And Thunderstorms/i, 'Posibles aguaceros y tormentas'],
      [/Showers And Thunderstorms/i, 'Aguaceros y tormentas'], [/Slight Chance Rain Showers/i, 'Leve probabilidad de aguaceros'],
      [/Chance Rain Showers/i, 'Posibles aguaceros'], [/Rain Showers Likely/i, 'Aguaceros probables'], [/Scattered Rain Showers/i, 'Aguaceros dispersos'],
      [/Isolated Rain Showers/i, 'Aguaceros aislados'], [/Rain Showers/i, 'Aguaceros'], [/Thunderstorms?/i, 'Tormentas eléctricas'],
      [/Mostly Sunny/i, 'Mayormente soleado'], [/Partly Sunny/i, 'Parcialmente soleado'], [/Sunny/i, 'Soleado'], [/Mostly Clear/i, 'Mayormente despejado'],
      [/Partly Cloudy/i, 'Parcialmente nublado'], [/Mostly Cloudy/i, 'Mayormente nublado'], [/Clear|Fair/i, 'Despejado'], [/Cloudy|Overcast/i, 'Nublado'],
      [/Light Rain/i, 'Lluvia ligera'], [/Rain/i, 'Lluvia'], [/Haze/i, 'Bruma'], [/Fog/i, 'Neblina'],
    ];
    const es = (t = '') => [...new Set(t.split(/\s+then\s+/i).map((p) => PHRASES.find(([re]) => re.test(p))?.[1] ?? p))].join(', luego ');
    const ALERTS: Record<string, string> = {
      'Flood Advisory': 'Aviso de inundaciones', 'Flood Warning': 'Advertencia de inundaciones', 'Flood Watch': 'Vigilancia de inundaciones',
      'Flash Flood Warning': 'Advertencia de inundaciones repentinas', 'Flash Flood Watch': 'Vigilancia de inundaciones repentinas',
      'Heat Advisory': 'Aviso de calor', 'Excessive Heat Warning': 'Advertencia de calor extremo', 'Extreme Heat Warning': 'Advertencia de calor extremo',
      'Small Craft Advisory': 'Aviso a embarcaciones pequeñas', 'High Surf Advisory': 'Aviso de marejada', 'Rip Current Statement': 'Corrientes marinas peligrosas',
      'Tropical Storm Watch': 'Vigilancia de tormenta tropical', 'Tropical Storm Warning': 'Advertencia de tormenta tropical',
      'Hurricane Watch': 'Vigilancia de huracán', 'Hurricane Warning': 'Advertencia de huracán', 'Special Weather Statement': 'Declaración especial del tiempo',
    };
    const DIRS: Record<string, string> = { N: 'N', NNE: 'NNE', NE: 'NE', ENE: 'ENE', E: 'E', ESE: 'ESE', SE: 'SE', SSE: 'SSE', S: 'S', SSW: 'SSO', SW: 'SO', WSW: 'OSO', W: 'O', WNW: 'ONO', NW: 'NO', NNW: 'NNO' };
    const ic = (body: string, size = 34) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
    const SUN = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>';
    const MOON = '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>';
    const CLOUD = '<path d="M7 18h10a4 4 0 0 0 0-8 6 6 0 0 0-11.5 1.5A3.3 3.3 0 0 0 7 18z"/>';
    const PARTLY = '<path d="M8 3v1.5M3.5 8H2M4.6 4.6l1 1M11.4 4.6l-1 1"/><path d="M5.3 10.5A3.5 3.5 0 0 1 11 6.6"/><path d="M9 20h8a3.5 3.5 0 0 0 0-7 5 5 0 0 0-9.6 1.3A2.9 2.9 0 0 0 9 20z"/>';
    const LOW = '<path d="M7 15h10a4 4 0 0 0 0-8 6 6 0 0 0-11.5 1.5A3.3 3.3 0 0 0 7 15z"/>';
    const RAIN = LOW + '<path d="M9 18l-1 3M13 18l-1 3M17 18l-1 3"/>';
    const STORM = LOW + '<path d="M12.5 16l-2 3.5h3l-2 3.5"/>';
    const icon = (t = '', day = true, size?: number) => ic(/thunder/i.test(t) ? STORM : /rain|shower|drizzle/i.test(t) ? RAIN : /mostly cloudy|overcast|^cloudy/i.test(t) ? CLOUD : /partly|mostly sunny|mostly clear/i.test(t) ? PARTLY : day ? SUN : MOON, size);
    const F = (c: number | null) => (c == null ? null : Math.round(c * 9 / 5 + 32));
    const time = (d: Date) => d.toLocaleTimeString('es-PR', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Puerto_Rico' });
    const hourLbl = (iso: string) => new Date(iso).toLocaleTimeString('es-PR', { hour: 'numeric', timeZone: 'America/Puerto_Rico' });

    // Sunrise and sunset (NOAA approximation) for a latitude/longitude
    function sunTimes(lat: number, lon: number, date = new Date()) {
      const rad = Math.PI / 180, day = Math.floor((Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()) - Date.UTC(date.getUTCFullYear(), 0, 0)) / 864e5);
      const g = (2 * Math.PI / 365) * (day - 1);
      const eq = 229.18 * (0.000075 + 0.001868 * Math.cos(g) - 0.032077 * Math.sin(g) - 0.014615 * Math.cos(2 * g) - 0.040849 * Math.sin(2 * g));
      const decl = 0.006918 - 0.399912 * Math.cos(g) + 0.070257 * Math.sin(g) - 0.006758 * Math.cos(2 * g) + 0.000907 * Math.sin(2 * g) - 0.002697 * Math.cos(3 * g) + 0.00148 * Math.sin(3 * g);
      const ha = Math.acos(Math.cos(90.833 * rad) / (Math.cos(lat * rad) * Math.cos(decl)) - Math.tan(lat * rad) * Math.tan(decl)) / rad;
      const base = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());
      return { rise: new Date(base + (720 - 4 * (lon + ha) - eq) * 6e4), set: new Date(base + (720 - 4 * (lon - ha) - eq) * 6e4) };
    }

    // ---- Town data (NWS grid looked up once per visit) ----
    const gridCache = new Map<number, any>();
    async function points(i: number) {
      if (gridCache.has(i)) return gridCache.get(i);
      const [, lat, lon] = TOWNS[i];
      const key = `nc-pts-${i}`;
      let p: any = null;
      try { p = JSON.parse(sessionStorage.getItem(key) || 'null'); } catch { /* storage blocked */ }
      if (!p) { const d = (await get(`${API}/points/${lat},${lon}`)).properties; p = { forecast: d.forecast, hourly: d.forecastHourly, stations: d.observationStations }; try { sessionStorage.setItem(key, JSON.stringify(p)); } catch { /* storage blocked */ } }
      gridCache.set(i, p); return p;
    }

    let current = 0;
    async function showTown(i: number) {
      current = i;
      store.set('nc-clima-town', String(i));
      page.querySelector<HTMLSelectElement>('[data-town-select]')!.value = String(i);
      const [name, lat, lon] = TOWNS[i];
      $('[data-place]').textContent = name;
      $('[data-now-sky]').textContent = 'Cargando…';
      const sun = sunTimes(lat, lon);
      page.querySelector('[data-f="rise"]')!.textContent = time(sun.rise);
      page.querySelector('[data-f="set"]')!.textContent = time(sun.set);
      try {
        const p = await points(i);
        if (current !== i) return;
        loadNow(p, i, sun); loadHours(p, i); loadDays(p, i);
      } catch { $('[data-now-sky]').textContent = 'No pudimos cargar el tiempo. Intenta más tarde.'; }
    }
    async function loadNow(p: any, i: number, sun: { rise: Date; set: Date }) {
      try {
        // Use the nearest station with a recent temperature (some stations report blanks for hours)
        let st: any = null, obs: any = null;
        for (const s of (await get(p.stations)).features.slice(0, 3)) {
          obs = (await get(`${s.id}/observations?limit=6`)).features.map((f: any) => f.properties).find((o: any) => o.temperature?.value != null);
          if (obs) { st = s; break; }
        }
        if (current !== i || !obs) throw new Error('none');
        const t = F(obs.temperature.value)!;
        const isDay = Date.now() > sun.rise.valueOf() && Date.now() < sun.set.valueOf();
        $('[data-now-temp]').textContent = `${t}°`;
        $('[data-now-sky]').textContent = es(obs.textDescription);
        $('[data-now-feels]').textContent = `Sensación de ${F(obs.heatIndex?.value) ?? t}°`;
        $('[data-now-icon]').innerHTML = icon(obs.textDescription, isDay, 72);
        const set = (k: string, v: string) => (page.querySelector(`[data-f="${k}"]`)!.textContent = v);
        set('hum', obs.relativeHumidity?.value != null ? `${Math.round(obs.relativeHumidity.value)}%` : '—');
        const wd = obs.windDirection?.value; const ws = obs.windSpeed?.value;
        set('wind', ws != null && Math.round(ws / 1.609) === 0 ? 'Calma' : ws != null ? `${Math.round(ws / 1.609)} mph${wd != null ? ' ' + DIRS[['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'][Math.round(wd / 22.5) % 16]] : ''}` : '—');
        set('dew', obs.dewpoint?.value != null ? `${F(obs.dewpoint.value)}°` : '—');
        set('pres', obs.barometricPressure?.value != null ? `${(obs.barometricPressure.value / 3386.39).toFixed(2)} in` : '—');
        $('[data-now-src]').textContent = `Estación ${st.properties.name} · ${time(new Date(obs.timestamp))}`;
      } catch { if (current === i) { $('[data-now-sky]').textContent = 'Sin lectura reciente de la estación más cercana.'; $('[data-now-temp]').textContent = '—'; $('[data-now-src]').textContent = ''; } }
    }
    // 24-hour chart: temperature line and rain-chance bars; tap to read an hour
    async function loadHours(p: any, i: number) {
      try {
        const hrs = (await get(p.hourly)).properties.periods.slice(0, 24);
        if (current !== i) return;
        const W = 720, H = 220, pad = 28, n = hrs.length;
        const temps = hrs.map((h: any) => h.temperature), lo = Math.min(...temps) - 2, hi = Math.max(...temps) + 2;
        const x = (k: number) => pad + (k * (W - 2 * pad)) / (n - 1);
        const y = (t: number) => 20 + (H - 80) * (1 - (t - lo) / (hi - lo));
        const bars = hrs.map((h: any, k: number) => { const r = h.probabilityOfPrecipitation?.value ?? 0; const bh = (r / 100) * 50; return `<rect x="${x(k) - 9}" y="${H - 22 - bh}" width="18" height="${bh}" rx="3" class="cx-rain"/>`; }).join('');
        const line = temps.map((t: number, k: number) => `${x(k)},${y(t)}`).join(' ');
        const labels = hrs.map((h: any, k: number) => k % 4 === 0 ? `<text x="${x(k)}" y="${H - 6}" class="cx-lbl">${hourLbl(h.startTime)}</text><text x="${x(k)}" y="${y(h.temperature) - 10}" class="cx-tlbl">${h.temperature}°</text>` : '').join('');
        const hits = hrs.map((_: any, k: number) => `<rect x="${x(k) - (W - 2 * pad) / (n - 1) / 2}" y="0" width="${(W - 2 * pad) / (n - 1)}" height="${H}" fill="transparent" data-h="${k}"/>`).join('');
        $('[data-chart]').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Temperatura y probabilidad de lluvia en las próximas 24 horas">${bars}<polyline points="${line}" class="cx-line"/>${temps.map((t: number, k: number) => `<circle cx="${x(k)}" cy="${y(t)}" r="3.5" class="cx-dot" data-dot="${k}"/>`).join('')}${labels}<line class="cx-cursor" x1="0" x2="0" y1="10" y2="${H - 22}" data-cursor hidden/>${hits}</svg>`;
        const read = (k: number) => {
          const h = hrs[k];
          $('[data-chart-read]').innerHTML = `<b>${hourLbl(h.startTime)}:</b> ${h.temperature}° · ${es(h.shortForecast)} · 💧 ${h.probabilityOfPrecipitation?.value ?? 0}% · viento ${h.windSpeed}`;
          const c = page.querySelector<SVGLineElement>('[data-cursor]')!; c.removeAttribute('hidden'); c.setAttribute('x1', String(x(k))); c.setAttribute('x2', String(x(k)));
        };
        page.querySelectorAll<SVGRectElement>('[data-h]').forEach((r) => { const k = Number(r.dataset.h); r.addEventListener('pointerenter', () => read(k)); r.addEventListener('click', () => read(k)); });
        read(0);
      } catch { $('[data-chart]').innerHTML = '<p class="cx-loading">No disponible.</p>'; }
    }
    async function loadDays(p: any, i: number) {
      try {
        const ps = (await get(p.forecast)).properties.periods;
        if (current !== i) return;
        const out: string[] = [];
        for (let k = 0; k < ps.length && out.length < 7; k++) {
          const d = ps[k]; if (!d.isDaytime && k > 0) continue;
          const night = d.isDaytime ? ps[k + 1] : d;
          const rain = Math.max(d.probabilityOfPrecipitation?.value ?? 0, night?.probabilityOfPrecipitation?.value ?? 0);
          const name = out.length === 0 ? (d.isDaytime ? 'Hoy' : 'Esta noche') : new Date(d.startTime).toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', timeZone: 'America/Puerto_Rico' });
          out.push(`<li><details><summary>${icon(d.shortForecast, d.isDaytime, 30)}<span class="cx-d-name">${name}</span><span class="cx-d-sky">${es(d.shortForecast)}</span><span class="cx-d-rain">💧${rain}%</span><span class="cx-d-t"><b>${d.isDaytime ? d.temperature + '°' : '—'}</b> ${night ? night.temperature + '°' : ''}</span></summary>
            <p>Viento: ${d.windSpeed} del ${DIRS[d.windDirection] ?? d.windDirection}.${night ? ` De noche: ${es(night.shortForecast).toLowerCase()}, mínima de ${night.temperature}°.` : ''}</p></details></li>`);
        }
        $('[data-days]').innerHTML = out.join('');
      } catch { $('[data-days]').innerHTML = '<li class="cx-loading">No disponible.</li>'; }
    }

    // Alerts for Puerto Rico
    get(`${API}/alerts/active?area=PR`).then((d) => {
      const list = d.features.map((x: any) => x.properties); const box = $('[data-alerts]'); box.hidden = false;
      if (!list.length) { box.className = 'cx-alerts ok'; box.textContent = 'No hay alertas del tiempo activas para Puerto Rico.'; return; }
      box.innerHTML = list.slice(0, 5).map((a: any) => `<details><summary><b>${ALERTS[a.event] ?? a.event}</b><small>Hasta ${new Date(a.ends || a.expires).toLocaleString('es-PR', { weekday: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'America/Puerto_Rico' })}</small></summary><p>${(a.areaDesc || '').split(';').join(', ')}</p></details>`).join('');
    }).catch(() => {});

    // Town buttons (top row and "En la isla hoy")
    page.querySelector<HTMLSelectElement>('[data-town-select]')!.addEventListener('change', (e) => showTown(Number((e.target as HTMLSelectElement).value)));
    page.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => { showTown(Number(b.dataset.pick)); page.querySelector('.cx-now')!.scrollIntoView({ behavior: 'smooth', block: 'center' }); }));
    // Hours / days tabs
    page.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      page.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      page.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
    }));
    // Map tabs
    const MAPS: Record<string, [string, string, string]> = {
      radar: ['https://radar.weather.gov/ridge/standard/TJUA_loop.gif', 'Radar Doppler de Puerto Rico, última hora', 'Radar Doppler de Cayey (TJUA), animación de la última hora. Fuente: NWS.'],
      sat: ['https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/pr/GEOCOLOR/600x600.jpg', 'Imagen de satélite de Puerto Rico', 'Satélite GOES-19, imagen en color de Puerto Rico y alrededores. Fuente: NOAA.'],
      t2: ['https://www.nhc.noaa.gov/xgtwo/two_atl_2d0.png', 'Perspectiva tropical de 2 días', 'Áreas vigiladas en el Atlántico en los próximos 2 días. Fuente: Centro Nacional de Huracanes.'],
      t7: ['https://www.nhc.noaa.gov/xgtwo/two_atl_7d0.png', 'Perspectiva tropical de 7 días', 'Áreas vigiladas en el Atlántico en los próximos 7 días. Fuente: Centro Nacional de Huracanes.'],
    };
    page.querySelectorAll<HTMLButtonElement>('[data-map]').forEach((b) => b.addEventListener('click', () => {
      page.querySelectorAll('[data-map]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      const [src, alt, cap] = MAPS[b.dataset.map!];
      const img = page.querySelector<HTMLImageElement>('[data-map-img]')!; img.src = src; img.alt = alt;
      $('[data-map-cap]').textContent = cap;
    }));

    // "En la isla hoy": today's high and sky for every town
    TOWNS.forEach(async (_, i) => {
      const li = page.querySelector<HTMLElement>(`[data-i="${i}"]`)!;
      try {
        const p = await points(i);
        const d = (await get(p.forecast)).properties.periods[0];
        li.querySelector('.cx-i-sky')!.innerHTML = `${icon(d.shortForecast, d.isDaytime, 20)} ${es(d.shortForecast)}`;
        li.querySelector('.cx-i-t')!.textContent = `${d.temperature}°`;
      } catch { li.querySelector('.cx-i-sky')!.textContent = 'No disponible'; }
    });

    const saved = Number(store.get('nc-clima-town'));
    showTown(Number.isInteger(saved) && saved >= 0 && saved < TOWNS.length ? saved : 0);
  </script>
</Base>
