---
// Opiniones page, right column (2026-10-28, the owner's request): only the columnist list, most recent writer first,
// with their picture, name, role and how many columns each has. Replaces the usual sidebar (Tendencias, Lo último, games).
import { url, getStories } from '../../lib/site';
import { COLUMNISTS, initials, columnsBy } from '../../lib/columnists';

const stories = await getStories();
const clean = (n: string) => n.replace(/^Lcd[oa]\.?\s*/u, '');
const TONES = ['#009DE9', '#92D000', '#FFFFFF', '#5CC4F5'];
const writers = COLUMNISTS
  .map((c) => { const mine = columnsBy(stories, c).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()); return { c, last: mine[0], count: mine.length }; })
  .filter((w) => w.last).sort((a, b) => b.last.data.date.valueOf() - a.last.data.date.valueOf());
---
{writers.length > 0 && (
  <aside class="op-side" aria-labelledby="op-side-h">
    <div class="op-voices-h"><h2 id="op-side-h">Nuestras voces</h2><span class="op-count">{writers.length} columnistas</span></div>
    <ul class="op-side-list">
      {writers.map(({ c, count }, i) => (
        <li class="op-side-item">
          <a class="op-item-av" href={url(`opinion/${c.slug}`)} aria-label={c.name}>
            {c.photo
              ? <img class="op-av op-av-img" style={`--ring:${TONES[i % TONES.length]}`} src={c.photo} alt="" width="44" height="44" loading="lazy" />
              : <span class="op-av" style={`--ring:${TONES[i % TONES.length]}`}>{initials(clean(c.name))}</span>}
          </a>
          <a class="op-side-t" href={url(`opinion/${c.slug}`)}>
            <b>{c.name}</b>
            <small>{c.role ?? 'Columnista'}</small>
            <small class="op-side-n">{count} {count === 1 ? 'columna' : 'columnas'}</small>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
