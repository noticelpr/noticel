---
// Deportes hub: light, card-based layout (inspired by big sports portals) in NotiCel colors.
// Left: tendencias + Puerto Rico leagues. Center: lead story, story row, one rail per league.
// Right: titulares + beyond the island.
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import Time from '../../components/Time.astro';
import ScoreStrip from '../../components/deportes/ScoreStrip.astro';
import LeaguePill from '../../components/deportes/LeaguePill.astro';
import LeagueBadge from '../../components/deportes/LeagueBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import GamesTeaser from '../../components/GamesTeaser.astro';
import TeamLogo from '../../components/deportes/TeamLogo.astro';
import { scores, gameTime } from '../../lib/scores';
import { getStories, topOrder, sectionTop, url, type Story , storyUrl } from '../../lib/site';
import { LEAGUES, league } from '../../lib/leagues';

const stories = (await getStories()).filter((s) => s.data.section === 'deportes');
const lead = sectionTop(topOrder(stories))[0]; // local leagues first, unless an MLB/NBA story is trending
const rest = stories.filter((s) => s !== lead);
const related = lead ? rest.filter((s) => s.data.league && s.data.league === lead.data.league).slice(0, 2) : [];
const row = rest.slice(0, 3);
const byLeague = (id: string) => stories.filter((s) => s.data.league === id);
const local = LEAGUES.filter((l) => l.local);
const world = LEAGUES.filter((l) => !l.local);
// Stories already in the lead block are not repeated in "Últimas noticias" or Titulares
const shown = new Set([lead, ...related, ...row].filter(Boolean));
const fresh = (list: Story[]) => list.filter((s) => !shown.has(s));
const latest = fresh(stories).slice(0, 10); // the newest 10, in order; the rest are on /deportes/noticias/
const headlines = fresh(stories).slice(10, 16); // the next ones after "Últimas noticias" (no repeats)
// Side columns: recent results and next games (real and DEMO), so the columns stay full while scrolling
const all = scores(undefined, 60);
const results = all.filter((g) => g.status === 'final').slice(0, 4);
const nextGames = all.filter((g) => g.status === 'programado').slice(0, 4);
const gameHref = (g: (typeof all)[number]) => url(g.id ? `deportes/juego/${g.id}` : `deportes/${g.league}`);
const bsnYT = LEAGUES.find((l) => l.id === 'bsn' && 'youtube' in l) as { youtube?: string } | undefined;
const href = (s: Story) => storyUrl(s);

// Purple news bar: the 5 newest sports stories; a sports story marked "breaking" in the last 12 hours goes first
const HOUR = 36e5;
const urgent = stories.find((s) => s.data.breaking && Date.now() - s.data.date.valueOf() < 12 * HOUR);
const ticker = [urgent, ...stories].filter((s, i, all) => s && all.indexOf(s) === i).slice(0, 5) as Story[];
const ago = (d: Date) => { const m = Math.round((Date.now() - d.valueOf()) / 60000); return m < 60 ? `hace ${Math.max(1, m)} min` : m < 1440 ? `hace ${Math.round(m / 60)} h` : d.toLocaleDateString('es-PR', { day: 'numeric', month: 'short', timeZone: 'America/Puerto_Rico' }); };
---
<Base title="Deportes" active="deportes" description="Deportes de Puerto Rico: BSN, Doble A, La Pro (Liga Roberto Clemente), voleibol masculino y femenino, boxeo, tenis y los boricuas en el mundo.">
  <div class="ys">
    <div class="ys-bar">
      <div class="wrap">
        <h1 class="ys-title">NotiCel <span>Deportes</span></h1>
        <nav class="ys-leagues" aria-label="Ligas">
          {LEAGUES.map((l) => <a href={url(`ligas/${l.id}`)}><LeagueBadge id={l.id} size="sm" />{l.name}</a>)}
        </nav>
      </div>
    </div>

    <div class="wrap ys-page" id="main">
      <ScoreStrip theme="light" />

      {ticker.length > 0 && (
        <div class="ys-promo ys-news" data-ticker>
          <span class:list={['ys-news-tag', { hot: !!urgent }]}>{urgent ? 'Última hora' : 'Lo último'}</span>
          <div class="ys-news-slides">
            {ticker.map((s, i) => (
              <a class:list={['ys-news-item', { on: i === 0 }]} href={href(s)} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? undefined : -1}>
                <strong>{s.data.title}</strong><span>{league(s.data.league)?.name ?? 'Deportes'} · {ago(s.data.date)}</span>
              </a>
            ))}
          </div>
          {ticker.length > 1 && <span class="ys-news-dots" aria-hidden="true">{ticker.map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>}
        </div>
      )}

      <div class="ys-grid">
        <!-- Center -->
        <div class="ys-main">
          {lead ? (
            <article class="ys-card ys-hero">
              <a href={href(lead)} tabindex="-1" aria-hidden="true"><Ph sectionId="deportes" image={lead.data.image} league={lead.data.league} sizes="(max-width:760px) 100vw, 760px" priority /></a>
              <div class="ys-hero-meta"><LeaguePill id={lead.data.league} link /><Time date={lead.data.date} /></div>
              <a href={href(lead)}><h2 class="hl">{lead.data.title}</h2></a>
              <p>{lead.data.description}</p>
              {related.length > 0 && <ul class="ys-related">{related.map((s) => <li><a href={href(s)} class="hl">{s.data.title}</a></li>)}</ul>}
              {row.length > 0 && (
                <div class="ys-row">
                  {row.map((s) => (
                    <a class="ys-mini" href={href(s)}>
                      <Ph sectionId="deportes" image={s.data.image} league={s.data.league} />
                      <h3 class="hl">{s.data.title}</h3>
                      <span class="ys-by">{league(s.data.league)?.name ?? 'Deportes'} · <Time date={s.data.date} /></span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          ) : (
            <div class="ys-card"><p class="sp-note">Muy pronto publicaremos las primeras noticias deportivas.</p></div>
          )}

          {latest.length > 0 && (
            <section class="ys-card ys-latest" aria-labelledby="ys-latest-h">
              <div class="ys-card-h"><h2 id="ys-latest-h">Últimas noticias</h2><a href={url('ligas/noticias')}>Ver todas ›</a></div>
              <ol class="ys-latest-list">
                {latest.map((s) => (
                  <li>
                    <a class="ys-mini" href={href(s)}>
                      <Ph sectionId="deportes" image={s.data.image} league={s.data.league} />
                      <h3 class="hl">{s.data.title}</h3>
                      <span class="ys-by">{league(s.data.league)?.name ?? 'Deportes'} · <Time date={s.data.date} /></span>
                    </a>
                  </li>
                ))}
              </ol>
              <a class="ys-more" href={url('ligas/noticias')}>Ver todas las noticias de deportes ({stories.length}) ›</a>
            </section>
          )}
          <AdSlot size="infeed" />
        </div>

        <!-- Left -->
        <aside class="ys-left">
          <section class="ys-card">
            <div class="ys-card-h"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8M15 7h6v6" /></svg><h2>Tendencias</h2></div>
            <ul class="ys-list">
              {stories.slice(0, 5).map((s) => (
                <li>{s.data.league ? <LeagueBadge id={s.data.league} size="sm" /> : <span class="ys-dot" />}<a href={href(s)} class="hl">{s.data.title}</a></li>
              ))}
            </ul>
          </section>
          <section class="ys-card">
            <div class="ys-card-h"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg><h2>Ligas de Puerto Rico</h2></div>
            <ul class="ys-tree">
              {local.map((l) => {
                const last = byLeague(l.id).slice(0, 1);
                return (
                  <li>
                    <a class="ys-tree-name" href={url(`ligas/${l.id}`)}><LeagueBadge id={l.id} size="sm" />{l.name}</a>
                    {last.length > 0 && <ul>{last.map((s) => <li><a href={href(s)} class="hl">{s.data.title}</a></li>)}</ul>}
                  </li>
                );
              })}
            </ul>
          </section>
          {results.length > 0 && (
            <section class="ys-card">
              <div class="ys-card-h"><h2>Resultados</h2></div>
              <ul class="ys-games">{results.map((g) => (
                <li><a href={gameHref(g)} class="notranslate" translate="no">
                  <span class="ys-g-lg">{league(g.league)?.name}{g.demo && <i class="sp-demo">DEMO</i>}</span>
                  <span class="ys-g-t"><TeamLogo league={g.league} name={g.away} size={18} /><span>{g.away}</span><b class:list={{ lose: (g.awayScore ?? 0) < (g.homeScore ?? 0) }}>{g.awayScore}</b></span>
                  <span class="ys-g-t"><TeamLogo league={g.league} name={g.home} size={18} /><span>{g.home}</span><b class:list={{ lose: (g.homeScore ?? 0) < (g.awayScore ?? 0) }}>{g.homeScore}</b></span>
                </a></li>
              ))}</ul>
            </section>
          )}
          {nextGames.length > 0 && (
            <section class="ys-card">
              <div class="ys-card-h"><h2>Próximos juegos</h2></div>
              <ul class="ys-games">{nextGames.map((g) => (
                <li><a href={gameHref(g)} class="notranslate" translate="no">
                  <span class="ys-g-lg">{league(g.league)?.name} · {gameTime(g.date)}{g.demo && <i class="sp-demo">DEMO</i>}</span>
                  <span class="ys-g-t"><TeamLogo league={g.league} name={g.away} size={18} /><span>{g.away}</span></span>
                  <span class="ys-g-t"><TeamLogo league={g.league} name={g.home} size={18} /><span>{g.home}</span></span>
                </a></li>
              ))}</ul>
            </section>
          )}
          <AdSlot size="rectangle" sticky />
        </aside>

        <!-- Right -->
        <aside class="ys-right">
          {headlines.length > 0 && (
            <section class="ys-card">
              <div class="ys-card-h"><h2>Titulares</h2></div>
              <ul class="ys-heads">
                {headlines.map((s) => <li><a href={href(s)} class="hl">{s.data.title}</a></li>)}
              </ul>
            </section>
          )}
          <AdSlot size="rectangle" />
          {bsnYT?.youtube && (
            <section class="ys-card lg-video">
              <div class="ys-card-h"><h2>Video del BSN</h2><a href={`https://www.youtube.com/channel/${bsnYT.youtube}`} rel="noopener" target="_blank">Canal ↗</a></div>
              <div class="lg-video-frame">
                <iframe data-src={`https://www.youtube-nocookie.com/embed/videoseries?list=UU${bsnYT.youtube.slice(2)}&autoplay=1&mute=1&rel=0&playsinline=1`} title="Último video del BSN en YouTube" loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              </div>
            </section>
          )}
          <section class="ys-card">
            <div class="ys-card-h"><h2>Más allá de la isla</h2></div>
            <ul class="ys-tree">
              {world.map((l) => {
                const last = byLeague(l.id)[0];
                return (
                  <li>
                    <a class="ys-tree-name" href={url(`ligas/${l.id}`)}><LeagueBadge id={l.id} size="sm" />{l.full}</a>
                    <ul><li>{last ? <a href={href(last)} class="hl">{last.data.title}</a> : <span class="sp-muted">{l.about}</span>}</li></ul>
                  </li>
                );
              })}
            </ul>
          </section>
          <section class="ys-card">
            <div class="ys-card-h"><h2>Calendario de temporadas</h2></div>
            <ul class="ys-heads">
              {LEAGUES.filter((l) => 'season' in l && l.season).map((l) => (
                <li><a href={url(`ligas/${l.id}`)} class="ys-season"><LeagueBadge id={l.id} size="sm" /><span><strong>{l.name}</strong>{'season' in l && l.season}</span></a></li>
              ))}
            </ul>
          </section>
          <GamesTeaser compact />
          <AdSlot size="halfpage" sticky />
        </aside>
      </div>
    </div>
  </div>
  <script>
    // Purple news bar: show each headline in turn (pauses on hover/focus; off for reduced motion)
    document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((bar) => {
      const items = [...bar.querySelectorAll<HTMLAnchorElement>('.ys-news-item')];
      const dots = [...bar.querySelectorAll<HTMLElement>('.ys-news-dots i')];
      if (items.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let i = 0, paused = false;
      bar.addEventListener('mouseenter', () => (paused = true)); bar.addEventListener('mouseleave', () => (paused = false));
      bar.addEventListener('focusin', () => (paused = true)); bar.addEventListener('focusout', () => (paused = false));
      setInterval(() => {
        if (paused || document.hidden) return;
        items[i].classList.remove('on'); items[i].setAttribute('aria-hidden', 'true'); items[i].tabIndex = -1; dots[i]?.classList.remove('on');
        i = (i + 1) % items.length;
        items[i].classList.add('on'); items[i].removeAttribute('aria-hidden'); items[i].removeAttribute('tabindex'); dots[i]?.classList.add('on');
      }, 5000);
    });
  </script>
</Base>
