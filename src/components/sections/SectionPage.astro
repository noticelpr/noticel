---
// Every NotiCel section and subsection page (2026-10-08): the same top block as the home page (headline left, photo
// center, stories right), then the rest as rows of three with page numbers, beside Noticias Xtra's sidebar.
// A few sections add their own box, in NotiCel's style: Deportes (leagues and scores), Economía (markets table),
// Opiniones (columnists), El Tiempo (official forecast) and Entretenimiento (upcoming events).
import Base from '../../layouts/Base.astro';
import TopStories from '../TopStories.astro';
import OpinionTop from './OpinionTop.astro';
import OpinionFeed from './OpinionFeed.astro';
import StoryCard from '../StoryCard.astro';
import Sidebar from '../Sidebar.astro';
import AdSlot from '../AdSlot.astro';
import GamesTeaser from '../GamesTeaser.astro';
import LeagueBadge from '../deportes/LeagueBadge.astro';
import { SITE, SECTION_LIVE, CATEGORIES, url, categoryUrl, parentOf, subsectionsOf, getStories, storyUrl, shortDate, type Story } from '../../lib/site';
import { LEAGUES, league } from '../../lib/leagues';
import { scores } from '../../lib/scores';
import MarketsBar from '../MarketsBar.astro';
import { COLUMNISTS, initials } from '../../lib/columnists';
import { upcomingEvents, dateTile } from '../../lib/events';

interface Props { slug: string; list: Story[]; page: number; pages: number; active: string }
const { slug, list, page, pages, active } = Astro.props;
const name = CATEGORIES[slug] ?? slug;
const parent = parentOf(slug);
const subs = subsectionsOf(slug);
const pageUrl = (n: number) => (n === 1 ? categoryUrl(slug) : `${categoryUrl(slug)}page/${n}/`);
// Section boxes and special tops (page 1 only)
const box = page === 1 ? slug : '';
// Page 1: top block (7 stories) and then rows of three; page 2+: rows of three only
const first = page === 1 ? list : [];
const [lead, ...after] = first;
const more = after.slice(0, 2), center = after.slice(2, 4), right = after.slice(4, 6);
const rest = box === 'opiniones' ? list : page === 1 ? after.slice(6) : list;
const rows = Array.from({ length: Math.ceil(rest.length / 3) }, (_, i) => rest.slice(i * 3, i * 3 + 3));
// Section boxes (page 1 only)
const games = box === 'deportes' ? scores(undefined, 8) : [];
const events = box === 'entretenimiento' ? upcomingEvents().slice(0, 4) : [];
---
<Base title={page > 1 ? `${name} (página ${page})` : name} active={active} description={`Noticias de ${name} en ${SITE.name}.`}>
  <main class="wrap ncs-page" id="main">
    <header class="ncs-head">
      {parent && <p class="ncs-crumb"><a href={categoryUrl(parent)}>{CATEGORIES[parent]}</a> <span aria-hidden="true">›</span></p>}
      <div class="ncs-titlerow">
        <h1 class="ncs-title">{name}{page > 1 && <small> · página {page}</small>}</h1>
        {subs.length > 0 && <nav class="sec-subs" aria-label={`Secciones de ${name}`}>{subs.map((s) => <a href={categoryUrl(s)}>{CATEGORIES[s]}</a>)}</nav>}
      </div>
    </header>

    {box === 'deportes' && (
      <section class="ncs-box" aria-label="Ligas y marcadores">
        <div class="ncs-leagues">{LEAGUES.map((l) => <a href={url(`ligas/${l.id}`)}><LeagueBadge id={l.id} size="sm" />{l.name}</a>)}</div>
        {games.length > 0 && (
          <div class="ncs-scores">
            {games.map((g) => (
              <a class="ncs-game" href={url(g.id ? `ligas/juego/${g.id}` : `ligas/${g.league}`)}>
                <span class="ncs-game-h">{league(g.league)?.name} · {g.status === 'en-vivo' ? (g.note ?? 'En vivo') : g.status === 'final' ? 'Final' : 'Próximo'}{g.demo && <i class="sp-demo">DEMO</i>}</span>
                <span class="ncs-team"><b>{g.away}</b><em>{g.awayScore ?? ''}</em></span>
                <span class="ncs-team"><b>{g.home}</b><em>{g.homeScore ?? ''}</em></span>
              </a>
            ))}
          </div>
        )}
      </section>
    )}
    {box === 'economia' && <MarketsBar />}
    {box === 'el-tiempo' && (
      <section class="ncs-tape ncs-wx" aria-label="Pronóstico oficial">
        <span class="ncs-tape-h">Pronóstico</span>
        <span class="ncs-wx-t">Pronóstico, avisos y advertencias oficiales del Servicio Nacional de Meteorología en San Juan</span>
        <a href={SITE.forecastUrl} rel="noopener" target="_blank">Ver el pronóstico ↗</a>
        <a href="https://www.nhc.noaa.gov/" rel="noopener" target="_blank">Huracanes ↗</a>
      </section>
    )}
    {events.length > 0 && (
      <section class="ncs-box" aria-labelledby="sp-ev-h">
        <div class="ncs-box-h"><h2 id="sp-ev-h">Próximos eventos</h2></div>
        <ul class="ncs-events">{events.map((e) => { const d = dateTile(e.date); return <li><span class="ncs-ev-d"><small>{d.top}</small><b>{d.big}</b></span><span><b>{e.title}</b><small>{e.kind} · {e.venue}, {e.city}</small></span></li>; })}</ul>
      </section>
    )}

    {box === 'opiniones' && <OpinionTop columns={list} />}
    {lead && box !== 'opiniones' && <div class="ncs-top"><TopStories lead={lead} more={more} center={center} right={right} h1={false} /></div>}
    {lead && <AdSlot size="leaderboard" class="ad-under-top" />}

    <div class="home-grid ncs-grid">
      <div class="home-main">
        {list.length === 0 && <div class="empty"><p>Todavía no hay noticias de {name} en esta versión del sitio.</p><a class="btn" href={url()}>Ir a la portada</a></div>}
        {rows.length > 0 && (
          <section class="bb-sec">
            <div class="sec-h"><h2>{slug === 'opiniones' ? 'Las columnas más recientes' : page === 1 ? `Más de ${name}` : 'Noticias'}</h2></div>
            {slug === 'opiniones' ? <OpinionFeed columns={rest} /> : rows.map((r, i) => (
              <>
                <div class="bb-row4 ncs-row">{r.map((s) => <StoryCard story={s} />)}</div>
                {i % 2 === 1 && i < rows.length - 1 && <AdSlot size="infeed" />}
              </>
            ))}
          </section>
        )}
        {pages > 1 && (
          <nav class="sec-pager" aria-label="Páginas">
            {page > 1 && <a href={pageUrl(page - 1)} aria-label="Página anterior">←</a>}
            {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (n === page ? <span aria-current="page">{n}</span> : <a href={pageUrl(n)}>{n}</a>))}
            {page < pages && <a href={pageUrl(page + 1)} aria-label="Página siguiente">→</a>}
          </nav>
        )}
        {rows.length < 2 && <AdSlot size="infeed" />}
        <GamesTeaser />
      </div>
      <div class="ncs-right">
        <Sidebar live={SECTION_LIVE[slug]} />
      </div>
    </div>
  </main>
</Base>
