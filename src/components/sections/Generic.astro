---
// A section page (same design as Noticias Xtra's), used for every NotiCel category without a special page, for
// subcategories (Béisbol, Música…) and for pages 2, 3… of every category. NotiCel adds the subcategory buttons
// and the page numbers WordPress had (/category/<path>/page/2/).
import Base from '../../layouts/Base.astro';
import StoryCard from '../StoryCard.astro';
import VideoCard from '../VideoCard.astro';
import Sidebar from '../Sidebar.astro';
import AdSlot from '../AdSlot.astro';
import GamesTeaser from '../GamesTeaser.astro';
import { SITE, VIDEOS, SECTION_LIVE, CATEGORIES, url, categoryUrl, parentOf, type Story } from '../../lib/site';

interface Props { slug: string; list: Story[]; page: number; pages: number; subs: string[]; active: string }
const { slug, list, page, pages, subs, active } = Astro.props;
const name = CATEGORIES[slug] ?? slug;
const parent = parentOf(slug);
const vids = SITE.features.videos && page === 1 ? VIDEOS.filter((v) => v.section === slug) : [];
const pageUrl = (n: number) => (n === 1 ? categoryUrl(slug) : `${categoryUrl(slug)}page/${n}/`);
const lead = page === 1 ? list[0] : undefined;
const items = page === 1 ? list.slice(1, 5) : [];
const grid = page === 1 ? list.slice(5) : list;
---
<Base title={page > 1 ? `${name} (página ${page})` : name} active={active} description={`Noticias de ${name} en ${SITE.name}.`}>
  <main class="wrap" id="main">
    {parent && <p class="lg-crumb"><a href={categoryUrl(parent)}>{CATEGORIES[parent]}</a> <span aria-hidden="true">›</span> {name}</p>}
    <div class="sec-h" style="margin-top:0"><h1 style="font-size:32px;margin:0;color:var(--purple)">{name}{page > 1 && <small class="time"> · página {page}</small>}</h1></div>
    {subs.length > 0 && <nav class="sec-subs" aria-label={`Secciones de ${name}`}>{subs.map((s) => <a href={categoryUrl(s)}>{CATEGORIES[s]}</a>)}</nav>}
    <div class="art-grid">
      <div>
        {list.length > 0 ? (
          <>
            {lead && (
              <div class="block">
                <h2 class="sr">Últimas noticias</h2>
                <StoryCard story={lead} variant="big" priority />
                <div class="list">{items.map((s) => <StoryCard story={s} variant="item" />)}</div>
              </div>
            )}
            {grid.length > 0 && (
              <section>
                <div class="sec-h"><h2>{page === 1 ? `Más de ${name}` : 'Noticias'}</h2></div>
                <div class="grid3">{grid.map((s) => <StoryCard story={s} />)}</div>
              </section>
            )}
          </>
        ) : (
          <div class="empty"><p>Todavía no hay noticias de {name.toLowerCase()} en esta versión del sitio.</p><a class="btn" href={url()}>Ir a la portada</a></div>
        )}
        {pages > 1 && (
          <nav class="sec-pager" aria-label="Páginas">
            {page > 1 && <a href={pageUrl(page - 1)} aria-label="Página anterior">←</a>}
            {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (n === page ? <span aria-current="page">{n}</span> : <a href={pageUrl(n)}>{n}</a>))}
            {page < pages && <a href={pageUrl(page + 1)} aria-label="Página siguiente">→</a>}
          </nav>
        )}
        <AdSlot size="infeed" />
        <GamesTeaser />
        {vids.length > 0 && (
          <>
            <div class="sec-h"><h2>Videos de {name}</h2></div>
            <div class="autogrid">{vids.map((v) => <VideoCard video={v} />)}</div>
          </>
        )}
      </div>
      <Sidebar live={SECTION_LIVE[slug]} />
    </div>
  </main>
</Base>
