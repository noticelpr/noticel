---
// Renders a date. A small script in the layout turns it into "Hace 2 horas" in the browser.
import { formatDate } from '../lib/site';
interface Props { date: Date | string; class?: string }
const d = new Date(Astro.props.date);
---
<time class:list={['time', Astro.props.class]} datetime={d.toISOString()} data-rel>{formatDate(d)}</time>
