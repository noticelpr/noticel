---
// Ad space in standard sizes. Shows only while SITE.features.ads is on.
// Order of priority (see src/lib/ads.ts):
//   1. Direct campaigns paid by our clients (a "toma de portada" takes every space). Several ads in the same
//      space rotate like a billboard every ROTATE_SECONDS.
//   2. Google AdSense, only when there is no direct campaign for this space and GOOGLE is filled in.
//   3. Otherwise the "Anúnciate aquí" placeholder below.
// leaderboard: 728×90 on computers, 320×100 on phones · rectangle: 300×250 · halfpage: 300×600 · infeed: 728×90
// Which ad sizes each space holds and how they're scaled (the fit rule): SPACE_BOXES and boxFor in src/lib/ads.ts.
// Placement: a campaign may be limited to some pages (Portada, noticias, secciones, a section…) and, for the wide
// banner, to the top or the bottom one (placementFits in src/lib/ads.ts).
import { SITE, url } from '../lib/site';
import type { AdSize } from '../lib/ads';
interface Props { size: AdSize; sticky?: boolean; class?: string; quiet?: boolean } // quiet: hidden unless an ad fills it (no "Anúnciate aquí" box)
const { size, sticky = false, class: extra, quiet = false } = Astro.props;
const label: Record<AdSize, string> = { leaderboard: '728 × 90', rectangle: '300 × 250', halfpage: '300 × 600', infeed: '728 × 90' };
---
{SITE.features.ads && (
  <div class:list={['ad-slot', `ad-${size}`, { 'ad-sticky': sticky }, extra]} role="complementary" aria-label="Publicidad" data-ad-size={size} data-quiet={quiet ? '' : undefined} data-test-site={SITE.testSite ? '' : undefined} hidden={quiet}>
    <span class="ad-label">Publicidad</span>
    <a class="ad-box" href={url('publicidad')}>
      <strong>Espacio publicitario</strong>
      <span class="ad-dims">{label[size]}{size === 'leaderboard' && <span class="ad-mob"> · 320 × 100 en celular</span>}</span>
      <span class="ad-cta">Anúnciate aquí</span>
    </a>
  </div>
)}
<script>
  import { CAMPAIGNS, DEMO_CAMPAIGNS, GOOGLE, ROTATE_SECONDS, FORMATS, MAX_PER_SPACE, boxFor, shownSize, placementFits, type AdSize, type Campaign, type Creative, type PageKind } from '../lib/ads';
  import { isDemo } from '../lib/demo';
  import { hasBackend, liveCampaigns, countView, countClick } from '../lib/backend';
  const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  // Readers in Puerto Rico vs the diaspora, from the device's time zone (no location permission needed)
  let where: 'island' | 'diaspora' = 'diaspora';
  try { if (Intl.DateTimeFormat().resolvedOptions().timeZone === 'America/Puerto_Rico') where = 'island'; } catch { /* old browser */ }
  const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' }); // YYYY-MM-DD
  // PREVIEW: ads approved in the staff panel on this device show here right away (with a "Vista previa" tag), so the
  // employee sees where they go. Everyone else sees them once they're published in CAMPAIGNS.
  type Req = { id: string; status: string; formats: string[]; link?: string; views?: number; takeoverViews?: number; start?: string; client: { business: string }; art?: { files?: Array<{ data: string; w: number; h: number }> } };
  // Views counted on this device for preview campaigns (with the backend, views are counted for everyone)
  const VIEWS_KEY = 'nc-ad-views';
  const localViews = (): Record<string, number> => { try { return JSON.parse(localStorage.getItem(VIEWS_KEY) || '{}'); } catch { return {}; } };
  const addLocalView = (id: string) => { const v = localViews(); v[id] = (v[id] ?? 0) + 1; try { localStorage.setItem(VIEWS_KEY, JSON.stringify(v)); } catch { /* storage blocked */ } };
  const approvedHere = (): Array<Campaign & { preview?: boolean }> => {
    let reqs: Req[] = []; try { reqs = JSON.parse(localStorage.getItem('nc-ad-requests') || '[]'); } catch { /* storage blocked */ }
    return reqs.filter((r) => r.status === 'aprobada' && r.art?.files?.length).map((r) => {
      const fmts = FORMATS.filter((f) => r.formats.includes(f.id));
      return { id: r.id, client: r.client.business, start: '0000-00-00', end: '9999-12-31', preview: true, takeover: fmts.some((f) => f.id === 'takeover'), views: r.takeoverViews ?? r.views,
        sizes: [...new Set(fmts.flatMap((f) => (f.slots.length ? f.slots : ['leaderboard', 'rectangle', 'halfpage', 'infeed'] as AdSize[])))],
        creatives: r.art!.files!.map((f) => ({ img: f.data, url: r.link || '#', alt: r.client.business, w: f.w, h: f.h })) };
    });
  };
  // Paid views already delivered → the campaign is done and leaves the rotation
  const seenSoFar = localViews();
  const notDone = (c: Campaign & { preview?: boolean; delivered?: number }) => !c.views || (c.delivered ?? (c.preview ? seenSoFar[c.id] ?? 0 : 0)) < c.views;
  const remote = hasBackend() ? await liveCampaigns() : [];
  // Sample ads show in demo mode and on the whole test site (SITE.testSite), so every space looks filled; off on the real site
  const testSite = !!document.querySelector('[data-ad-size][data-test-site]');
  const demoAds = isDemo() || testSite ? DEMO_CAMPAIGNS.map((c) => ({ ...c, demo: true })) : [];
  const live = [...CAMPAIGNS, ...demoAds, ...remote, ...approvedHere()].filter((c) => c.start <= today && today <= c.end && c.creatives.length && notDone(c) && (!c.regions || c.regions === 'all' || c.regions === where));
  // Each space only shows ads whose shape fits one of its boxes (src/lib/ads.ts, boxFor); if a campaign has none, it
  // skips the space. An image without a known size is trusted to be the space's first box.
  const sizeOf = (cr: Creative) => (cr.w && cr.h ? [cr.w, cr.h] : (cr.img.match(/(\d+)x(\d+)\.\w+$/) ?? []).slice(1).map(Number));
  const narrow = matchMedia('(max-width:760px)').matches;
  const rankOf = (cr: Creative, size: AdSize) => { const [w, h] = sizeOf(cr); return !w || !h ? 0 : boxFor(w, h, size, narrow)?.rank ?? -1; };
  const fits = (cr: Creative, size: AdSize) => rankOf(cr, size) >= 0;
  // This page, for campaigns limited to some pages (Ventas → placement)
  const BASE_PATH = BASE.replace(/\/$/, '');
  const page: PageKind = (() => {
    const p = location.pathname.replace(/\/$/, '');
    const sec = document.querySelector<HTMLElement>('[data-ad-section]')?.dataset.adSection || undefined;
    if (p === BASE_PATH || p === `${BASE_PATH}/index.html`) return { kind: 'portada' };
    if (document.querySelector('article.art[data-read-url]')) return { kind: 'notas', section: sec };
    if (p.startsWith(`${BASE_PATH}/category/`)) return { kind: 'secciones', section: sec ?? p.split('/').pop() };
    return { kind: 'otras' };
  })();
  const takeover = live.find((c) => c.takeover);
  const track = (name: string, c: Campaign & { preview?: boolean; demo?: boolean }, size: string) => {
    if (c.demo) return; // sample ads are never counted
    (window as any).gtag?.('event', name, { ad_campaign: c.id, ad_client: c.client, ad_size: size });
    if (name === 'ad_impression') { if (c.preview) addLocalView(c.id); else countView(c.id); }
    if (name === 'ad_click' && !c.preview) countClick(c.id);
  };
  const src = (p: string) => (/^https?:/.test(p) ? p : BASE + p.replace(/^\//, ''));

  if (takeover?.skin && location.pathname.replace(/\/$/, '') === BASE.replace(/\/$/, '')) {
    document.body.classList.add('ad-skin');
    document.body.style.setProperty('--ad-skin', `url("${src(takeover.skin)}")`);
  }

  let googleLoaded = false;
  function google(slot: HTMLElement, size: AdSize) {
    if (!GOOGLE.client || !GOOGLE.slots[size]) return;
    slot.querySelector('.ad-box')?.remove();
    const ins = document.createElement('ins');
    ins.className = 'adsbygoogle ad-google';
    ins.dataset.adClient = GOOGLE.client; ins.dataset.adSlot = GOOGLE.slots[size];
    if (size === 'leaderboard' || size === 'infeed') { ins.dataset.adFormat = 'horizontal'; ins.dataset.fullWidthResponsive = 'true'; }
    slot.append(ins);
    if (!googleLoaded) {
      googleLoaded = true;
      const s = document.createElement('script');
      s.async = true; s.crossOrigin = 'anonymous';
      s.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${GOOGLE.client}`;
      document.head.append(s);
    }
    ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
  }

  const esc = (t: string) => t.replace(/"/g, '&quot;');
  const file = (p: string) => (/^data:/.test(p) ? p : src(p));
  // A still or animated image, or a video (muted, plays only while on screen; `img` is its first picture)
  // Shown at the size the fit rule gives (scaled down inside its box, never enlarged or cropped)
  const look = (cr: Creative, size: AdSize) => {
    const [w, h] = sizeOf(cr); const fit = w && h ? boxFor(w, h, size, narrow) : null;
    if (!fit) return '';
    const [sw] = shownSize(w, h, fit.box);
    return ` style="width:${sw}px;max-width:100%;height:auto;aspect-ratio:${w}/${h};object-fit:contain;max-height:none"`;
  };
  const media = (cr: Creative, size: AdSize) => cr.video
    ? `<video src="${file(cr.video)}" poster="${file(cr.img)}" muted playsinline preload="none" aria-label="${esc(cr.alt)}"${look(cr, size)}></video>`
    : `<img src="${file(cr.img)}" alt="${esc(cr.alt)}" loading="lazy"${look(cr, size)} />`;

  function direct(slot: HTMLElement, size: AdSize, pool: Array<{ c: Campaign; cr: Creative }>) {
    const box = document.createElement('div');
    box.className = 'ad-rot';
    box.innerHTML = pool.map(({ c, cr }, i) => `<a href="${cr.url}" target="_blank" rel="sponsored noopener" data-k="${i}"${i ? ' hidden' : ''}>${(c as any).demo ? '' /* the image itself says "ANUNCIO DE EJEMPLO" */ : (c as any).preview ? '<span class="ad-prev">Vista previa · solo en este dispositivo</span>' : ''}${media(cr, size)}</a>`).join('')
      + (pool.some(({ cr }) => cr.video) ? '<button type="button" class="ad-snd" aria-label="Activar sonido" aria-pressed="false" hidden>🔇</button>' : '')
      + (pool.length > 1 ? `<span class="ad-dots" aria-hidden="true">${pool.map((_, i) => `<i${i ? '' : ' class="on"'}></i>`).join('')}</span>` : '');
    slot.querySelector('.ad-box')?.replaceWith(box);
    const links = [...box.querySelectorAll<HTMLAnchorElement>('a')];
    const dots = [...box.querySelectorAll('.ad-dots i')];
    const seen = new Set<number>();
    let k = 0, visible = false, hover = false;
    const vids = links.map((a) => a.querySelector('video'));
    const snd = box.querySelector<HTMLButtonElement>('.ad-snd');
    let sound = false;
    // Only the video on screen plays; the sound button shows while a video is the ad being shown
    const playback = () => {
      vids.forEach((v, i) => { if (!v) return; v.muted = !sound; if (i === k && visible && !document.hidden) void v.play().catch(() => {}); else v.pause(); });
      if (snd) { snd.hidden = !vids[k]; snd.textContent = sound ? '🔊' : '🔇'; snd.setAttribute('aria-pressed', String(sound)); snd.setAttribute('aria-label', sound ? 'Quitar sonido' : 'Activar sonido'); }
    };
    snd?.addEventListener('click', () => { sound = !sound; playback(); });
    document.addEventListener('visibilitychange', playback);
    const show = (n: number) => {
      links[k].hidden = true; dots[k]?.classList.remove('on');
      k = n; links[k].hidden = false; dots[k]?.classList.add('on');
      countSoon();
      playback();
    };
    // A view counts only after the ad has been at least half on screen for 1 continuous second (the MRC/IAB standard
    // big advertisers trust; user, 2026-11-06): scrolling straight past it doesn't count
    let viewTimer = 0;
    function countSoon() {
      clearTimeout(viewTimer);
      if (!visible || document.hidden || seen.has(k)) return;
      const shown = k;
      viewTimer = window.setTimeout(() => { if (visible && !document.hidden && k === shown && !seen.has(k)) { seen.add(k); track('ad_impression', pool[k].c, size); } }, 1000);
    }
    document.addEventListener('visibilitychange', countSoon);
    // A video plays to the end before the next ad rotates in
    vids.forEach((v, i) => v?.addEventListener('ended', () => { if (pool.length > 1 && i === k) show((k + 1) % pool.length); else void v.play().catch(() => {}); }));
    links.forEach((a, i) => a.addEventListener('click', () => track('ad_click', pool[i].c, size)));
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) show(k); else { clearTimeout(viewTimer); playback(); } }, { threshold: 0.5 }).observe(box);
    if (pool.length > 1) {
      box.addEventListener('pointerenter', () => (hover = true));
      box.addEventListener('pointerleave', () => (hover = false));
      setInterval(() => { if (visible && !hover && !document.hidden && !vids[k]) show((k + 1) % pool.length); }, ROTATE_SECONDS * 1000);
    }
  }

  // Equal turns through the day (user, 2026-11-06): the ad with the fewest views today (for its weight) is the likeliest to
  // show first, so no ad gets everything in the morning and nothing at night. Still random, so readers who load at the
  // same moment don't all see the same one.
  function fairStart(pool: Array<{ c: Campaign }>) {
    const share = (c: Campaign) => ((c as any).today_views ?? 0) / Math.max(1, c.weight ?? 1);
    const avg = pool.reduce((a, { c }) => a + share(c), 0) / pool.length;
    const w = pool.map(({ c }) => Math.min(2, Math.max(0.2, 1 + (avg - share(c)) / (avg + 20))));
    let r = Math.random() * w.reduce((a, b) => a + b, 0);
    for (let i = 0; i < w.length; i++) { r -= w[i]; if (r <= 0) return i; }
    return 0;
  }

  // A campaign with several sizes shows the one this space and screen prefer (e.g. 728×90 on computers, 320×100 on
  // phones in the top banner; the square first in a phone space); versions of the same size rotate
  const artFor = (c: Campaign, size: AdSize) => {
    const ok = c.creatives.filter((cr) => fits(cr, size));
    const best = Math.min(...ok.map((cr) => rankOf(cr, size)));
    return ok.filter((cr) => rankOf(cr, size) === best);
  };

  // Spaces the layout hides on this screen (phone-only, computer-only, too narrow) get no ad at all
  const shown = (s: HTMLElement) => s.hidden || getComputedStyle(s).display !== 'none';
  // The banner at the very bottom only when no other ad is within one screen above it (no two ads in one screenful)
  const crowded = (s: HTMLElement) => {
    const top = s.getBoundingClientRect().top;
    return [...document.querySelectorAll<HTMLElement>('[data-ad-size]')].some((o) => o !== s && !o.hidden && shown(o) && o.getBoundingClientRect().bottom > top - innerHeight && o.getBoundingClientRect().bottom <= top);
  };
  // Phones (user, 2026-11-04): ads at least 1.5 screens apart, top to bottom (never two in one screenful), so the
  // news always leads; a space that would land too close to the one above it is dropped
  // Squares first (user, 2026-11-06): on phones every space shows a 300 × 250 square (the size readers see best and
  // that counts the most views), 1.25 screens apart, and ads never take more than a quarter of the page
  let lastBottom = -Infinity, adPx = 0;
  const pageH = document.documentElement.scrollHeight;
  const tooClose = (s: HTMLElement) => {
    if (!narrow) return false;
    const r = s.getBoundingClientRect(), top = r.top + scrollY;
    if (top - lastBottom < innerHeight * 1.25 || adPx + 270 > pageH * 0.25) return true;
    lastBottom = top + 270; adPx += 270;
    return false;
  };
  document.querySelectorAll<HTMLElement>('[data-ad-size]').forEach((slot) => {
    if (!shown(slot)) return;
    if (slot.classList.contains('ad-bottom') && crowded(slot)) { slot.remove(); return; }
    if (!slot.hidden && tooClose(slot)) { slot.remove(); return; }
    const booked = slot.dataset.adSize as AdSize;
    const banner = slot.classList.contains('ad-bottom') ? 'bottom' : booked === 'leaderboard' ? 'top' : undefined;
    // Phones: banners and tall ads become squares (campaigns sold only as banners still show their banner)
    const size: AdSize = narrow && booked !== 'rectangle' && !slot.classList.contains('ad-top') ? 'rectangle' : booked;
    if (size !== booked) { slot.classList.add('ad-as-square'); slot.classList.remove('ad-sticky'); }
    // A phone square takes square campaigns and the campaigns sold for this space (banners show their square image)
    // At most MAX_PER_SPACE ads share a space (first booked first), so each gets a fair share (src/lib/ads.ts)
    const capped = (list: typeof live) => [...list].sort((a, b) => a.start.localeCompare(b.start)).slice(0, MAX_PER_SPACE);
    const here = live.filter((c) => placementFits(c.placement, page, banner));
    const camps = takeover ? [takeover] : [...new Set([...capped(here.filter((c) => c.sizes.includes(size))), ...(size !== booked ? capped(here.filter((c) => c.sizes.includes(booked))) : [])])];
    // Each campaign appears `weight` times per round, interleaved; start at a random spot so every client gets first view
    const rounds = Math.max(1, ...camps.map((c) => c.weight ?? 1));
    const pool = Array.from({ length: rounds }, (_, r) => camps.filter((c) => r < (c.weight ?? 1)).flatMap((c) => artFor(c, size).map((cr) => ({ c, cr })))).flat(); // only creatives that fit this space on this screen (a banner campaign shows its square or phone banner on phones)
    const quiet = slot.hasAttribute('data-quiet');
    if (pool.length) {
      const start = fairStart(pool);
      direct(slot, size, [...pool.slice(start), ...pool.slice(0, start)]);
      slot.hidden = false;
    } else if (GOOGLE.client && (GOOGLE.slots[size] || GOOGLE.slots[booked])) {
      // Google ads load only when the reader is about one screen away (user, 2026-11-06): more of them are actually
      // seen (what advertisers pay for) and the page opens faster. The space keeps its size meanwhile, so nothing jumps.
      const which = GOOGLE.slots[size] ? size : booked;
      slot.hidden = false;
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); google(slot, which); } }, { rootMargin: '100% 0px' });
      io.observe(slot);
    }
    else if (quiet || narrow) slot.remove(); // phones: no empty "Anúnciate aquí" boxes between the news
  });
</script>
