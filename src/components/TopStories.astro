---
// The top of the home page and of every section page (NotiCel, 2026-10-08; inspired by BBC News' front page):
// the main headline on the left in large type, its photo in the middle with two stories under it, two stories on the
// right. Phones: the main headline first (visible right away), then its photo, then the other stories.
// Sections with few stories: without stories for the right column, the block uses two columns.
import Ph from './Ph.astro';
import Label from './Label.astro';
import Time from './Time.astro';
import AdSlot from './AdSlot.astro';
import { storyUrl, type Story } from '../lib/site';

interface Props { lead: Story; more?: Story[]; center?: Story[]; right?: Story[]; h1?: boolean }
const { lead, more = [], center = [], right = [], h1 = true } = Astro.props;
const H = h1 ? 'h1' : 'h2';
---
<div class:list={['bb-hero', { 'bb-noright': right.length === 0 }]}>
  <div class="bb-lead">
    <Label story={lead} />
    <a href={storyUrl(lead)}><H class="hl">{lead.data.title}</H></a>
    {/* Phones only: the photo goes right under the main headline (wider screens show it in the middle column) */}
    <a class="bb-lead-photo" href={storyUrl(lead)} tabindex="-1" aria-hidden="true">
      <Ph sectionId={lead.data.section} image={lead.data.image} league={lead.data.league} sizes="100vw" priority />
    </a>
    {lead.data.description && <p class="bb-dek">{lead.data.description}</p>}
    <Time date={lead.data.date} />
    {more.length > 0 && <ul class="bb-more">{more.map((s) => <li><a href={storyUrl(s)} class="hl">{s.data.title}</a></li>)}</ul>}
    {/* Wide screens: an ad fills the space under the left column's headlines (hidden on phones) */}
    <AdSlot size="rectangle" class="bb-lead-ad bb-fit-ad" />
  </div>
  <div class="bb-center">
    <a class="bb-photo" href={storyUrl(lead)} tabindex="-1" aria-hidden="true">
      <Ph sectionId={lead.data.section} image={lead.data.image} league={lead.data.league} sizes="(max-width:1100px) 60vw, 620px" priority />
    </a>
    {center.length > 0 && (
      <div class="bb-center-two">
        {center.map((s) => (
          <article class="bb-side-item">
            <a href={storyUrl(s)} tabindex="-1" aria-hidden="true"><Ph sectionId={s.data.section} image={s.data.image} league={s.data.league} sizes="300px" /></a>
            <Label story={s} />
            <a href={storyUrl(s)}><h3 class="hl">{s.data.title}</h3></a>
            <Time date={s.data.date} />
          </article>
        ))}
      </div>
    )}
    <AdSlot size="infeed" class="bb-center-ad bb-fit-ad" />
  </div>
  {right.length > 0 && (
    <div class="bb-side">
      {right.map((s) => (
        <article class="bb-side-item">
          <a href={storyUrl(s)} tabindex="-1" aria-hidden="true"><Ph sectionId={s.data.section} image={s.data.image} league={s.data.league} sizes="320px" /></a>
          <Label story={s} />
          <a href={storyUrl(s)}><h3 class="hl">{s.data.title}</h3></a>
          <Time date={s.data.date} />
        </article>
      ))}
    </div>
  )}
</div>
<script>
  // The ads inside the top block only fill empty space: each one shows where its column already ends before the
  // block's tallest column does, and only if it fits there, so it never makes the block taller (2026-10-30)
  const fitTopAds = () => {
    document.querySelectorAll<HTMLElement>('.bb-hero').forEach((hero) => {
      const heroBottom = Math.max(...[...hero.children].map((col) => {
        const kids = [...col.children].filter((e) => !e.classList.contains('bb-fit-ad') && e.tagName !== 'SCRIPT' && e.getBoundingClientRect().height > 0);
        return kids.length ? kids[kids.length - 1].getBoundingClientRect().bottom : col.getBoundingClientRect().top;
      }));
      hero.querySelectorAll<HTMLElement>('.bb-fit-ad').forEach((ad) => {
        const col = ad.parentElement!;
        const kids = [...col.children].filter((e) => e !== ad && e.tagName !== 'SCRIPT' && e.getBoundingClientRect().height > 0);
        const end = kids.length ? kids[kids.length - 1].getBoundingClientRect().bottom : col.getBoundingClientRect().top;
        const wide = ad.classList.contains('bb-center-ad');
        const need = (wide ? Math.min(col.clientWidth, 728) * 90 / 728 : 250) + 40; // the ad plus its label and a gap
        const fits = !matchMedia('(max-width:760px)').matches && heroBottom - end >= need;
        ad.classList.toggle('fits', fits);
        if (fits) ad.style.top = `${end - col.getBoundingClientRect().top + 16}px`;
      });
    });
  };
  fitTopAds();
  addEventListener('load', fitTopAds);
  addEventListener('resize', fitTopAds);
  document.fonts?.ready.then(fitTopAds);
</script>
