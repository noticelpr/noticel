---
import Ph from './Ph.astro';
import Kicker from './Kicker.astro';
import Meta from './Meta.astro';
import { url, type Story } from '../lib/site';
interface Props { story: Story; dek?: boolean }
const { story, dek = true } = Astro.props;
const href = url(story.data.path);
---
<article class="card">
  <a href={href} tabindex="-1" aria-hidden="true"><Ph src={story.data.image} /></a>
  <div style="margin-top:12px"><Kicker story={story} /></div>
  <a href={href}><h3 class="hl" style="margin-top:0">{story.data.title}</h3></a>
  {dek && story.data.description && <p>{story.data.description}</p>}
  <Meta story={story} />
</article>
