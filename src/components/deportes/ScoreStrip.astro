---
// Score carousel (home, Deportes, league pages). Renders only when there are games.
// Cards: two-color team bar on top, status + league, team badges with scores, abbreviations.
// Faded edges with arrow buttons.
import { scores, type Game } from '../../lib/scores';
import { league } from '../../lib/leagues';
import { team } from '../../lib/teams';
import { url } from '../../lib/site';
import TeamLogo from './TeamLogo.astro';
interface Props { only?: string; title?: boolean; theme?: string }
const { only } = Astro.props;
const games = scores(only);
const link = (g: Game) => url(g.id ? `deportes/juego/${g.id}` : `deportes/${g.league}`);

const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });
function status(g: Game): { text: string; live?: boolean } {
  if (g.status === 'en-vivo') return { text: g.note ?? 'En vivo', live: true };
  if (g.status === 'final') {
    const extra = g.note?.match(/^(\d+)\s*entradas?$/i); // "10 entradas" -> "Final/10"
    return { text: extra ? `Final/${extra[1]}` : g.note ? (/^final/i.test(g.note) ? g.note : `Final · ${g.note}`) : 'Final' };
  }
  const d = new Date(g.date);
  const time = d.toLocaleTimeString('es-PR', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Puerto_Rico' });
  const day = d.toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' }) === today ? 'Hoy' : d.toLocaleDateString('es-PR', { weekday: 'short', timeZone: 'America/Puerto_Rico' });
  return { text: `${day} ${time}` };
}
---
{games.length > 0 && (
  <div class="sc" data-sc>
    {/* No header row: the score cards start right away */}
    <div class="sc-rail">
      <button type="button" class="sc-arrow prev" aria-label="Ver juegos anteriores" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <div class="sc-track">
        {games.map((g) => {
          const a = team(g.league, g.away);
          const h = team(g.league, g.home);
          const st = status(g);
          const done = g.status !== 'programado';
          const awayWin = g.status === 'final' && (g.awayScore ?? 0) > (g.homeScore ?? 0);
          const homeWin = g.status === 'final' && (g.homeScore ?? 0) > (g.awayScore ?? 0);
          return (
            <a class="sc-card" href={link(g)} data-league={g.league} style={`--a:${a.color};--h:${h.color}`}
               aria-label={`${g.awayFull ?? g.away} ${done ? g.awayScore : ''}, ${g.homeFull ?? g.home} ${done ? g.homeScore : ''}. ${st.text}`}>
              <div class="sc-meta">
                <span class:list={['sc-status', { live: st.live }]}>{st.live && <i class="sc-dot" />}{st.text}</span>
                <span class="sc-lg">{league(g.league)?.name}{g.demo && <i class="sp-demo">DEMO</i>}</span>
              </div>
              {/* One line: logo + abbreviation + score on each side (wide and short card) */}
              <div class="sc-row notranslate" translate="no">
                <TeamLogo league={g.league} name={g.away} size={26} />
                <span class="sc-ab">{a.abbr}</span>
                {done ? <b class:list={['sc-score', { lose: homeWin }]}>{g.awayScore}</b> : <span class="sc-rec">{g.awayRecord}</span>}
                <span class="sc-gap" />
                {done ? <b class:list={['sc-score', { lose: awayWin }]}>{g.homeScore}</b> : <span class="sc-rec">{g.homeRecord}</span>}
                <span class="sc-ab">{h.abbr}</span>
                <TeamLogo league={g.league} name={g.home} size={26} />
              </div>
            </a>
          );
        })}
      </div>
      <button type="button" class="sc-arrow next" aria-label="Ver más juegos" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
)}

<script>
  // Arrows slide the cards; faded edges and arrows only show where there is more to see.
  document.querySelectorAll<HTMLElement>('[data-sc]').forEach((sc) => {
    const track = sc.querySelector<HTMLElement>('.sc-track')!;
    const prev = sc.querySelector<HTMLButtonElement>('.sc-arrow.prev')!;
    const next = sc.querySelector<HTMLButtonElement>('.sc-arrow.next')!;
    const update = () => {
      const start = track.scrollLeft <= 2;
      const end = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      prev.hidden = start;
      next.hidden = end;
      track.classList.toggle('fade-l', !start);
      track.classList.toggle('fade-r', !end);
    };
    const step = () => Math.max(track.clientWidth * 0.8, 240);
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
