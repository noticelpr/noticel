---
// League page: live, upcoming and recent games in a list
import { scores, gameTime, type Game } from '../../lib/scores';
import { url } from '../../lib/site';
interface Props { league: string; season?: string }
const { league, season } = Astro.props;
const all = scores(league, 60);
const groups: Array<[string, Game[]]> = [
  ['En vivo', all.filter((g) => g.status === 'en-vivo')],
  ['Próximos juegos', all.filter((g) => g.status === 'programado').slice(0, 10)],
  ['Resultados', all.filter((g) => g.status === 'final').slice(0, 10)],
];
---
<section class="sp-panel">
  <h2>Juegos{all.some((g) => g.demo) && <span class="sp-demo">DEMO</span>}</h2>
  {all.length === 0 ? (
    <p class="sp-note">No hay juegos publicados todavía.{season && <> {season}</>}</p>
  ) : groups.filter(([, gs]) => gs.length).map(([name, gs]) => (
    <>
      <h3 class:list={{ live: name === 'En vivo' }}>{name}</h3>
      <ul class="sp-games">
        {gs.map((g) => (
          <li>
            <a class="sp-games-teams" href={g.id ? url(`ligas/juego/${g.id}`) : undefined}>
              <span class:list={{ win: g.status === 'final' && (g.awayScore ?? 0) > (g.homeScore ?? 0) }}>{g.away}{g.status !== 'programado' && <strong>{g.awayScore}</strong>}</span>
              <span class:list={{ win: g.status === 'final' && (g.homeScore ?? 0) > (g.awayScore ?? 0) }}>{g.home}{g.status !== 'programado' && <strong>{g.homeScore}</strong>}</span>
            </a>
            <div class="sp-games-meta">
              {g.status === 'en-vivo' ? <b class="live">● EN VIVO</b> : g.status === 'final' ? <b>Final</b> : <b>{gameTime(g.date)}</b>}
              {g.note && <span>{g.note}</span>}
              {g.id && <a href={url(`ligas/juego/${g.id}`)}>{g.status === 'programado' ? 'Previa ›' : 'Ver juego ›'}</a>}
            </div>
          </li>
        ))}
      </ul>
    </>
  ))}
</section>
