// del día (the publisher's choice, 2026-10-08); the file keeps Noticias Xtra's name so the sidebar matches its copy.
import { url } from '../lib/site';
---
<a class="dmx" href={url('juegos/crucigrama')}>
  <img src={url('images/juegos/crucigrama.svg')} alt="" loading="lazy" />
  <span class="dmx-body">
    <span class="dmx-tag">Juegos NotiCel</span>
    <strong>¿Te atreves con el crucigrama de hoy?</strong>
    <span>Un crucigrama boricua nuevo cada día. Juega gratis en tu celular o tu computadora.</span>
    <span class="dmx-btn">Jugar el crucigrama ›</span>
  </span>
</a>
